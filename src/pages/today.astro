---
import BaseLayout from '../layouts/BaseLayout.astro';
import Postcard from '../components/Postcard.astro';
import TodaysPaper from '../components/TodaysPaper.astro';
import { getLang, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---
<!-- `noindex` because the built HTML holds only the masthead: the edition is
     set at the edge by functions/_middleware.ts, and the client script below
     fills #edition with the same renderer when the edge did not. The sitemap
     filter in astro.config.mjs excludes it for the same reason — a noindex
     URL in the sitemap is a reported error. -->
<BaseLayout title="Today in Science — UniverLab" description="Every science event that happened on this day in history." bg={false} circadian noindex>
  <section class="wrap today-page">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">TODAY IN SCIENCE</span>
        <h1>Today</h1>
        <p class="intro">Scientific events that happened on this day in history.</p>
      </div>
      <Postcard page="today" alt={t.postcards.today} />
    </div>
    <TodaysPaper />
  </section>

  <style is:global>
    /* The newspaper needs the full wrap: three columns from 48rem, as in the
       mockup. The old list layout capped the page at 42rem. */
    .today-page { max-width: 72rem; padding-block: 4rem 5rem; }
    h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.3rem; }
    .intro { color: var(--ink-dim); font-size: 1rem; line-height: 1.7; margin: 0 0 0.5rem; }
  </style>

  <script>
    // The client fallback for the newspaper: when the edge did not set the
    // type (#edition is still empty), fetch the day's pool and the lab's
    // announcements and fill it with the same renderer the edge uses.
    import { readOtdCache, fetchPool, FULL_POOL } from '../lib/science-filter';
    import { todayEditionHtml, editionDate } from '../lib/today-edition';

    (function () {
      var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
      var ed = document.getElementById('edition');
      if (!ed || (ed.textContent || '').replace(/\s/g, '')) return;

      var loading = document.getElementById('today-loading');
      var failed = function () {
        if (loading) loading.style.display = 'none';
        var err = document.getElementById('today-error');
        if (err) {
          err.style.display = 'block';
          // Copy lives in src/i18n (t.today.error), set by the component.
          err.textContent = err.getAttribute('data-msg') || '';
        }
      };

      var facts = readOtdCache(lang);
      var factsP = facts && facts.length
        ? Promise.resolve(facts)
        // The same day the edge asks for: the lab's date (UTC−5), not the
        // visitor's, so a reader abroad never prints another day's letters.
        : fetchPool(fetch, lang, editionDate(), FULL_POOL);
      // The lab mailbox is optional: a failed announcements read (CORS, an
      // outage) still prints the day's letters, just without that box.
      var labP = fetch('https://announcements.univerlab.org/?limit=10')
        .then(function (res) {
          if (!res.ok) throw new Error('API ' + res.status);
          return res.json();
        })
        .then(function (data) {
          return Array.isArray(data?.entries) ? data.entries : [];
        })
        .catch(function () { return []; });

      Promise.all([factsP, labP]).then(
        function (parts) {
          if (!parts[0] || !parts[0].length) { failed(); return; }
          ed.innerHTML = todayEditionHtml({ facts: parts[0], lab: parts[1] }, lang, editionDate());
        },
        function () { failed(); },
      );
    })();
  </script>
</BaseLayout>
