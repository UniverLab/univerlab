---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Postcard from '../../components/Postcard.astro';
import { es } from '../../i18n/es';
import '../../styles/sign.css';
---
<BaseLayout title={es.sign.shellTitle} description={es.sign.shellDescription} circadian noindex>
  <section class="wrap sign">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">{es.sign.viewerLabel}</span>
        <div id="sign"></div>
      </div>
      <Postcard page="sign" alt={es.postcards.sign} />
    </div>
  </section>

  <script>
    import { initSignPage } from '../../lib/sign/client';
    initSignPage();
  </script>
</BaseLayout>
