---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Postcard from '../../components/Postcard.astro';
import TodaysPaper from '../../components/TodaysPaper.astro';
import { getLang, useTranslations } from '../../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---
<!-- `noindex` porque el HTML construido solo trae el cabezal: la edición la
     compone el edge (functions/_middleware.ts), y el script de abajo llena
     #edition con el mismo renderer cuando el edge no lo hizo. El filtro del
     sitemap en astro.config.mjs la excluye por lo mismo — una URL noindex en
     el sitemap es un error reportado. -->
<BaseLayout title="Hoy en la Ciencia — UniverLab" description="Todos los eventos científicos que ocurrieron este día en la historia." bg={false} circadian noindex>
  <section class="wrap today-page">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">HOY EN LA CIENCIA</span>
        <h1>Hoy</h1>
        <p class="intro">Eventos científicos que ocurrieron este día en la historia.</p>
      </div>
      <Postcard page="today" alt={t.postcards.today} />
    </div>
    <TodaysPaper />
  </section>

  <style is:global>
    /* El periódico necesita el ancho completo: tres columnas desde 48rem,
       como en el mockup. La lista anterior limitaba la página a 42rem. */
    .today-page { max-width: 72rem; padding-block: 4rem 5rem; }
    h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.3rem; }
    .intro { color: var(--ink-dim); font-size: 1rem; line-height: 1.7; margin: 0 0 0.5rem; }
  </style>

  <script>
    // El respaldo del cliente para el periódico: cuando el edge no compuso la
    // plana (#edition sigue vacío), trae el acopio del día y los anuncios del
    // laboratorio y la llena con el mismo renderer que usa el edge.
    import { readOtdCache, fetchPool, FULL_POOL } from '../../lib/science-filter';
    import { todayEditionHtml, editionDate } from '../../lib/today-edition';

    (function () {
      var lang = 'es';
      var ed = document.getElementById('edition');
      if (!ed || (ed.textContent || '').replace(/\s/g, '')) return;

      var loading = document.getElementById('today-loading');
      var failed = function () {
        if (loading) loading.style.display = 'none';
        var err = document.getElementById('today-error');
        if (err) {
          err.style.display = 'block';
          // El texto vive en src/i18n (t.today.error), lo pone el componente.
          err.textContent = err.getAttribute('data-msg') || '';
        }
      };

      var facts = readOtdCache(lang);
      var factsP = facts && facts.length
        ? Promise.resolve(facts)
        : fetchPool(fetch, lang, new Date(), FULL_POOL);
      // El buzón del laboratorio es opcional: si su lectura falla (CORS, una
      // caída) igual se imprimen las cartas del día, sin ese recuadro.
      var labP = fetch('https://announcements.univerlab.org/?limit=10')
        .then(function (res) {
          if (!res.ok) throw new Error('API ' + res.status);
          return res.json();
        })
        .then(function (data) {
          return Array.isArray(data?.entries) ? data.entries : [];
        })
        .catch(function () { return []; });

      Promise.all([factsP, labP]).then(
        function (parts) {
          if (!parts[0] || !parts[0].length) { failed(); return; }
          ed.innerHTML = todayEditionHtml({ facts: parts[0], lab: parts[1] }, lang, editionDate());
        },
        function () { failed(); },
      );
    })();
  </script>
</BaseLayout>
