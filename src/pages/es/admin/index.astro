---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Postcard from '../../../components/Postcard.astro';
import { useTranslations } from '../../../i18n';
import { bookTarget } from '../../../lib/book-target';
import '../../../styles/sign.css';

const t = useTranslations('es');
const a = t.admin;
const bookingApi = import.meta.env.PUBLIC_BOOKING_API || 'https://booking.univerlab.org';
---
<!-- The owner's control room: the edge only serves it to an allowlisted
     address (functions/_middleware.ts), it is never indexed, and every
     request it makes carries the owner's Access JWT. -->
<BaseLayout title={a.title} description={a.description} circadian noindex>
  <section class="wrap sign-owner">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">{a.auditsTitle}</span>
        <h1>{a.h1}</h1>
        <p class="intro">{a.intro}</p>
      </div>
      <Postcard page="status" alt={t.postcards.status} />
    </div>

    <div class="admin-glance">
      <div class="admin-card">
        <h2>{a.auditsTitle}</h2>
        <p class="admin-stat" id="admin-audits-counts" role="status"></p>
        <p><a href="#admin-upload">{a.uploadTitle}</a></p>
      </div>
      <div class="admin-card">
        <h2>{a.signTitle}</h2>
        <p class="admin-stat" id="admin-sign-counts" role="status"></p>
        <p><a href="/es/sign/owner/">{a.openSign}</a></p>
      </div>
      <div class="admin-card">
        <h2>{a.bookingTitle}</h2>
        <p class="admin-stat" id="admin-booking-status" role="status" data-booking-api={bookingApi}></p>
        <p><a href={bookTarget('es')}>{a.openBooking}</a></p>
      </div>
    </div>

    <section id="admin-audits-section">
      <h2>{a.auditsTitle}</h2>
      <p class="sign-error" id="admin-error" hidden></p>
      <p id="admin-empty" hidden>{a.auditsEmpty}</p>
      <table class="sign-table admin-table">
        <thead>
          <tr><th>{a.thAudit}</th><th>{a.thDate}</th><th>{a.thVisibility}</th><th>{a.thFindings}</th><th>{a.thDoi}</th><th>{a.thActions}</th></tr>
        </thead>
        <tbody
          id="admin-audits"
          data-visibility-public={a.visibilityPublic}
          data-visibility-private={a.visibilityPrivate}
          data-findings-line={a.findingsLine}
          data-audit-counts-pub-one={a.auditCountsPubOne}
          data-audit-counts-pub-other={a.auditCountsPubOther}
          data-audit-counts-priv-one={a.auditCountsPrivOne}
          data-audit-counts-priv-other={a.auditCountsPrivOther}
          data-audit-counts-high-one={a.auditCountsHighOne}
          data-audit-counts-high-other={a.auditCountsHighOther}
          data-th-audit={a.thAudit}
          data-th-date={a.thDate}
          data-th-visibility={a.thVisibility}
          data-th-findings={a.thFindings}
          data-th-doi={a.thDoi}
          data-th-actions={a.thActions}
          data-publish={a.publish}
          data-unpublish={a.unpublish}
          data-refused={a.refused}
          data-remove={a.remove}
          data-confirm-remove={a.confirmRemove}
          data-sign-counts={a.signCounts}
          data-booking-ok={a.bookingOk}
          data-booking-down={a.bookingDown}
          data-booking-line={a.bookingLine}
          data-load-error={a.loadError}
          data-audits-empty={a.auditsEmpty}
          data-action-missing={a.actionMissing}
          data-action-network={a.actionNetwork}
          data-action-failed={a.actionFailed}
        >
        </tbody>
      </table>
    </section>

    <section
      id="admin-upload"
      class="admin-card"
      data-upload-system={a.uploadSystem}
      data-upload-edition={a.uploadEdition}
      data-upload-folder={a.uploadFolder}
      data-upload-zip={a.uploadZip}
      data-upload-send={a.uploadSend}
      data-upload-replace={a.uploadReplace}
      data-upload-cancel={a.uploadCancel}
      data-upload-cancelled={a.uploadCancelled}
      data-upload-stored={a.uploadStored}
      data-upload-exists={a.uploadExists}
      data-upload-invalid-one={a.uploadInvalidOne}
      data-upload-invalid-other={a.uploadInvalidOther}
      data-upload-issues-one={a.uploadIssuesOne}
      data-upload-issues-other={a.uploadIssuesOther}
      data-upload-files-one={a.uploadFilesOne}
      data-upload-files-other={a.uploadFilesOther}
      data-upload-preview-title={a.uploadPreviewTitle}
      data-upload-preview-client={a.uploadPreviewClient}
      data-upload-preview-language={a.uploadPreviewLanguage}
      data-upload-preview-version={a.uploadPreviewVersion}
      data-upload-preview-findings={a.uploadPreviewFindings}
      data-upload-preview-files={a.uploadPreviewFiles}
      data-upload-empty={a.uploadEmpty}
      data-upload-reading={a.uploadReading}
      data-upload-sending={a.uploadSending}
      data-severity-critical={t.audit.severity.critical}
      data-severity-high={t.audit.severity.high}
      data-severity-medium={t.audit.severity.medium}
      data-severity-low={t.audit.severity.low}
      data-severity-info={t.audit.severity.info}
    >
      <h2>{a.uploadTitle}</h2>
      <p>{a.uploadHint}</p>
      <p>
        <button type="button" id="admin-upload-pick-folder" class="sign-btn-secondary">{a.uploadFolder}</button>
        <button type="button" id="admin-upload-pick-zip" class="sign-btn-secondary">{a.uploadZip}</button>
      </p>
      <input type="file" id="admin-upload-folder" class="admin-file-input" webkitdirectory tabindex="-1" aria-hidden="true" />
      <input type="file" id="admin-upload-zip" class="admin-file-input" accept=".zip" tabindex="-1" aria-hidden="true" />
      <div id="admin-upload-preview" hidden></div>
      <div id="admin-upload-target" hidden>
        <p class="sign-field">
          <label for="admin-upload-system">{a.uploadSystem}</label>
          <input type="text" id="admin-upload-system" list="admin-upload-systems" autocomplete="off" />
          <datalist id="admin-upload-systems"></datalist>
        </p>
        <p class="sign-field">
          <label for="admin-upload-edition">{a.uploadEdition}</label>
          <input type="text" id="admin-upload-edition" autocomplete="off" />
        </p>
      </div>
      <progress id="admin-upload-progress" hidden max="100" value="0"></progress>
      <p>
        <button type="button" id="admin-upload-send" class="sign-btn" disabled>{a.uploadSend}</button>
        <button type="button" id="admin-upload-replace" class="sign-btn-secondary" hidden>{a.uploadReplace}</button>
        <button type="button" id="admin-upload-cancel" class="sign-btn-secondary" hidden>{a.uploadCancel}</button>
      </p>
      <ul id="admin-upload-errors" hidden></ul>
      <p class="admin-note" id="admin-upload-note" role="status"></p>
    </section>
  </section>

  <script>
    import { initAdminPage } from '../../../lib/admin/panel-client';
    const el = document.getElementById('admin-audits');
    const up = document.getElementById('admin-upload');
    initAdminPage(
      {
        visibilityPublic: el?.dataset['visibilityPublic'] ?? '',
        visibilityPrivate: el?.dataset['visibilityPrivate'] ?? '',
        findingsLine: el?.dataset['findingsLine'] ?? '',
        auditCountsPubOne: el?.dataset['auditCountsPubOne'] ?? '',
        auditCountsPubOther: el?.dataset['auditCountsPubOther'] ?? '',
        auditCountsPrivOne: el?.dataset['auditCountsPrivOne'] ?? '',
        auditCountsPrivOther: el?.dataset['auditCountsPrivOther'] ?? '',
        auditCountsHighOne: el?.dataset['auditCountsHighOne'] ?? '',
        auditCountsHighOther: el?.dataset['auditCountsHighOther'] ?? '',
        thAudit: el?.dataset['thAudit'] ?? '',
        thDate: el?.dataset['thDate'] ?? '',
        thVisibility: el?.dataset['thVisibility'] ?? '',
        thFindings: el?.dataset['thFindings'] ?? '',
        thDoi: el?.dataset['thDoi'] ?? '',
        thActions: el?.dataset['thActions'] ?? '',
        publish: el?.dataset['publish'] ?? '',
        unpublish: el?.dataset['unpublish'] ?? '',
        refused: el?.dataset['refused'] ?? '',
        remove: el?.dataset['remove'] ?? '',
        confirmRemove: el?.dataset['confirmRemove'] ?? '',
        signCounts: el?.dataset['signCounts'] ?? '',
        bookingOk: el?.dataset['bookingOk'] ?? '',
        bookingDown: el?.dataset['bookingDown'] ?? '',
        bookingLine: el?.dataset['bookingLine'] ?? '',
        loadError: el?.dataset['loadError'] ?? '',
        auditsEmpty: el?.dataset['auditsEmpty'] ?? '',
        actionMissing: el?.dataset['actionMissing'] ?? '',
        actionNetwork: el?.dataset['actionNetwork'] ?? '',
        actionFailed: el?.dataset['actionFailed'] ?? '',
        uploadSystem: up?.dataset['uploadSystem'] ?? '',
        uploadEdition: up?.dataset['uploadEdition'] ?? '',
        uploadSend: up?.dataset['uploadSend'] ?? '',
        uploadReplace: up?.dataset['uploadReplace'] ?? '',
        uploadCancel: up?.dataset['uploadCancel'] ?? '',
        uploadCancelled: up?.dataset['uploadCancelled'] ?? '',
        uploadStored: up?.dataset['uploadStored'] ?? '',
        uploadExists: up?.dataset['uploadExists'] ?? '',
        uploadInvalidOne: up?.dataset['uploadInvalidOne'] ?? '',
        uploadInvalidOther: up?.dataset['uploadInvalidOther'] ?? '',
        uploadIssuesOne: up?.dataset['uploadIssuesOne'] ?? '',
        uploadIssuesOther: up?.dataset['uploadIssuesOther'] ?? '',
        uploadFilesOne: up?.dataset['uploadFilesOne'] ?? '',
        uploadFilesOther: up?.dataset['uploadFilesOther'] ?? '',
        uploadPreviewTitle: up?.dataset['uploadPreviewTitle'] ?? '',
        uploadPreviewClient: up?.dataset['uploadPreviewClient'] ?? '',
        uploadPreviewLanguage: up?.dataset['uploadPreviewLanguage'] ?? '',
        uploadPreviewVersion: up?.dataset['uploadPreviewVersion'] ?? '',
        uploadPreviewFindings: up?.dataset['uploadPreviewFindings'] ?? '',
        uploadPreviewFiles: up?.dataset['uploadPreviewFiles'] ?? '',
        uploadEmpty: up?.dataset['uploadEmpty'] ?? '',
        uploadReading: up?.dataset['uploadReading'] ?? '',
        uploadSending: up?.dataset['uploadSending'] ?? '',
        severityCritical: up?.dataset['severityCritical'] ?? '',
        severityHigh: up?.dataset['severityHigh'] ?? '',
        severityMedium: up?.dataset['severityMedium'] ?? '',
        severityLow: up?.dataset['severityLow'] ?? '',
        severityInfo: up?.dataset['severityInfo'] ?? '',
      },
      { bookingApi: document.getElementById('admin-booking-status')?.dataset['bookingApi'] ?? '' },
    );
  </script>
</BaseLayout>
