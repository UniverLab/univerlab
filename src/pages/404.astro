---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, useTranslations, localizePath } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const srcset = (phase: 'day' | 'night', ext: 'avif' | 'webp') =>
  `/bench/mapa/kraken-${phase}-1600.${ext} 1600w, /bench/mapa/kraken-${phase}-800.${ext} 800w`;
const sizes = '(max-width: 64rem) 100vw, 64rem';
---
<BaseLayout title="404 — UniverLab" circadian markdownTwin={false}>
  <section class="wrap notfound">
    <p class="kicker mono">{t.notFound.kicker}</p>
    <!-- The edge of the known world: both charts ship, CSS picks by theme the
         same way the postcards do, so a theme flip never repaints blank. -->
    <picture class="kraken kraken-day">
      <source srcset={srcset('day', 'avif')} sizes={sizes} type="image/avif" />
      <source srcset={srcset('day', 'webp')} sizes={sizes} type="image/webp" />
      <img
        src="/bench/mapa/kraken-day-800.webp"
        alt={t.notFound.alt}
        width="1600"
        height="914"
        decoding="async"
        loading="lazy"
      />
    </picture>
    <picture class="kraken kraken-night">
      <source srcset={srcset('night', 'avif')} sizes={sizes} type="image/avif" />
      <source srcset={srcset('night', 'webp')} sizes={sizes} type="image/webp" />
      <img
        src="/bench/mapa/kraken-night-800.webp"
        alt={t.notFound.alt}
        width="1600"
        height="914"
        decoding="async"
        loading="lazy"
      />
    </picture>

    <!-- Both charts ship loading=lazy: an eager img would be fetched by the
         preload scanner before any script can decide, so every visitor would
         download both charts. Lazy + the CSS display:none above means the
         off-theme one is never fetched at all; this script (the postcards'
         swap, keyed to the same test the theme script in <head> uses) promotes
         the current chart to fetchpriority=high before the first layout. -->
    <script is:inline data-kraken-swap>
      (function () {
        function eager(img) {
          img.setAttribute('fetchpriority', 'high');
          img.removeAttribute('loading');
        }
        function lazy(img) {
          img.setAttribute('loading', 'lazy');
          img.removeAttribute('fetchpriority');
        }
        function sync() {
          var night = document.documentElement.dataset.benchTheme === 'night';
          var day = document.querySelector('picture.kraken-day > img');
          var dark = document.querySelector('picture.kraken-night > img');
          if (day && dark) {
            if (night) { lazy(day); eager(dark); }
            else { lazy(dark); eager(day); }
          }
        }
        sync();
        window.addEventListener('univerlab:themechange', sync);
      })();
    </script>
    <h1 lang="la">{t.notFound.title}</h1>
    <p class="lede">{t.notFound.line}</p>
    <p class="links">
      <a href={localizePath('/', lang)}>{t.notFound.back}</a>
      <a href={localizePath('/experiments', lang)}>{t.notFound.encyclopedia}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(5rem, 18vh, 10rem);
    display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
    text-align: center;
  }
  .kicker {
    margin: 0;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .kraken {
    display: block;
    width: 100%;
    max-width: 64rem;
    margin: 0;
  }
  /* No forced aspect ratio: the charts ship 1600x914, and the width/height
     attributes carry that true ratio for layout (a 16/9 here would squish). */
  .kraken img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* By day the chart's paper melts into the parchment ground. */
  .kraken-day img { mix-blend-mode: multiply; }
  html[data-bench-theme='night'] .kraken-day { display: none; }
  html:not([data-bench-theme='night']) .kraken-night { display: none; }
  .notfound h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.2rem, 6vw, 3rem);
    margin: 0;
  }
  .lede { color: var(--ink-dim); max-width: 48ch; margin: 0; }
  .links { display: flex; gap: 1.6rem; margin-top: 0.6rem; flex-wrap: wrap; justify-content: center; }
  .links a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  .links a:hover { border-bottom-color: var(--accent); }
  @media (max-width: 40rem) {
    .notfound { overflow-x: clip; }
    .notfound h1 { font-size: 2.2rem; }
  }
</style>
