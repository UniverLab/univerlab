---
import BaseLayout from '../layouts/BaseLayout.astro';
import Postcard from '../components/Postcard.astro';
import Watermark from '../components/Watermark.astro';
import { en } from '../i18n/en';
import { liveExperiments } from '../lib/experiments';
import { loadRoadmap } from '../lib/lab-feed';
import { roadmapLanesHtml } from '../lib/roadmap-board';

const rmStrings = en.roadmap;
const topicColors: Record<string, string> = Object.fromEntries(
  liveExperiments.map((e) => [e.id, e.essenceHex]),
);
// The client script reads this from #roadmap-board[data-topic-colors]: it is a
// processed <script> (bundled, TS stripped), so it cannot take define:vars —
// that would force is:inline and ship raw imports as a classic script.
const topicColorsJson = JSON.stringify(topicColors);

let initialItems: any[] = [];
let unavailable = '';
try {
  initialItems = await loadRoadmap();
} catch (err) {
  console.warn('roadmap: build-time fetch failed, page ships empty and fills client-side');
  initialItems = [];
  unavailable = rmStrings.unavailable;
}
const initialHtml = roadmapLanesHtml(initialItems, rmStrings, { colors: topicColors });
const boardLanes = (['now', 'next', 'later', 'done'] as const).map((id) => ({
  id,
  label: rmStrings.lanes[id],
}));
---
<BaseLayout title="Roadmap — what UniverLab is building now, next and later" description="Every UniverLab roadmap item by lane — now, next, later and recently shipped — rendered as plain HTML and kept live from the public announcements API." circadian>
  <Watermark kind="blueprint" />
  <section class="wrap board" id="roadmap-board" data-topic-colors={topicColorsJson}>
    <header class="board-head">
      <div class="board-titles">
        <span class="label">ROADMAP</span>
        <h1>Roadmap</h1>
        <p class="intro">What UniverLab is building now, next, later, and what has shipped.</p>
        <div class="board-actions">
          <a href="/logbook/" class="feed-link">{rmStrings.statusFeedLink}</a>
        </div>
      </div>
      <figure class="board-figure">
        <Postcard page="roadmap" alt={en.postcards.roadmap} />
      </figure>
    </header>
    <div class="board-filters">
      <nav class="topic-index" aria-label="Board topics">
        <span class="topic-index-label">TOPICS</span>
        <div id="topic-filters" class="topic-filters"><!-- built by JS --></div>
      </nav>
    </div>
    <nav class="lane-tabs" role="tablist" aria-label="Lanes">
      {boardLanes.map((lane) => (
        <button type="button" role="tab" data-lane-tab={lane.id} aria-selected={lane.id === 'now' ? 'true' : 'false'}>{lane.label}</button>
      ))}
    </nav>
    <p id="roadmap-notice" class="rm-notice" role="status" hidden={!unavailable}>{unavailable}</p>
    <div id="roadmap-lanes" class="rm-board" data-active-lane="now" set:html={initialHtml}></div>
  </section>

  <style is:global>
    .wrap.board { max-width: 88rem; padding-block: 4rem 6rem; }
    .board .label { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); display: block; }
    .board-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; margin-bottom: 2rem; }
    .board-titles { min-width: 0; }
    .board-titles .label { margin-bottom: 1.2rem; }
    .board-actions { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.2rem; }
    .board-filters { display: flex; flex-direction: column; margin-bottom: 2.5rem; }
    .board-figure { margin: 0; justify-self: center; width: min(22rem, 100%); }
    .board h1 { font-family: var(--font-mono); font-size: 1.6rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); margin-bottom: 0.6rem; }
    .board .intro { color: var(--ink-dim); font-size: 0.95rem; line-height: 1.6; margin-bottom: 0; max-width: 42rem; }
    .topic-index { display: flex; align-items: baseline; gap: 1rem; padding-block: 0.5rem; }
    .topic-index-label { flex: 0 0 auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; color: var(--ink-faint); }
    .topic-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .topic-filter { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.3rem 0.65rem; border: none; border-radius: 100px; background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; cursor: pointer; transition: color 0.2s ease, background 0.2s ease; }
    .topic-filter:hover, .topic-filter:focus-visible { background: color-mix(in srgb, var(--ink) 12%, transparent); color: var(--ink); }
    .topic-filter.is-active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
    .topic-filter-count { color: var(--ink-faint); font-size: 0.58rem; }
    .filter-empty { padding-block: 3rem; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.82rem; text-align: center; }
    .feed-link { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); text-decoration: none; border: 1px solid var(--line); padding: 0.15rem 0.45rem; border-radius: 3px; transition: color 0.15s ease, border-color 0.15s ease; }
    .feed-link:hover, .feed-link:focus-visible { color: var(--ink); border-color: var(--accent); }
    .rm-notice { font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-faint); padding-block: 1rem; }
    .lane-tabs { display: none; }
    #roadmap-lanes.rm-board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 1.75rem; align-items: start; }
    .rm-seg { min-width: 0; padding-block: 0.4rem 1.1rem; }
    .rm-seg > h2 { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); display: flex; gap: 0.5rem; margin-block: 0.9rem 0.7rem; align-items: baseline; line-height: 1; }
    .rm-seg[data-lane="now"] > h2 { color: var(--accent); }
    .rm-count { color: var(--ink-faint); font-size: 0.58rem; }
    .rm-card { background: color-mix(in srgb, var(--bg) 80%, transparent); border: 1px solid var(--line); border-radius: 3px; padding: 0.85rem 0.95rem; margin-top: 0.7rem; }
    .rm-title { font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--ink); line-height: 1.35; }
    .rm-seg[data-lane="done"] .rm-title { color: var(--ink-dim); font-weight: 500; }
    .rm-summary { color: var(--ink-dim); font-size: 0.88rem; line-height: 1.65; margin-top: 0.25rem; }
    .rm-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.7rem; margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-faint); }
    .rm-topic { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 100px; border: 1px solid color-mix(in srgb, var(--topic, var(--accent)) 45%, transparent); background: color-mix(in srgb, var(--topic, var(--accent)) 8%, transparent); color: var(--topic, var(--ink-dim)); }
    .rm-entries { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; opacity: 0.9; }
    .rm-landed { color: var(--ink-faint); }
    .rm-hold { margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.5; color: color-mix(in srgb, #b45309 60%, var(--ink) 40%); background: color-mix(in srgb, #b45309 10%, transparent); border: 1px solid color-mix(in srgb, #b45309 35%, transparent); border-radius: 3px; padding: 0.25rem 0.5rem; }
    .rm-more { background: none; border: 0; color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer; padding: 0.3rem 0 0 0; opacity: 0.8; }
    .rm-more:hover { opacity: 1; text-decoration: underline; }
    @media (max-width: 59.99rem) {
      .board-head { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
      .board-figure { width: min(9rem, 45%); justify-self: start; }
      .lane-tabs { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 0.25rem; }
      .lane-tabs button { font-family: 'Old Standard TT', serif; font-size: 15px; letter-spacing: 0.04em; color: var(--bench-line); background: color-mix(in srgb, var(--bench-line) 6%, transparent); border: 1px solid var(--bench-line-soft); border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 16px 5px; margin: 0 2px; cursor: pointer; }
      .lane-tabs button[aria-selected="true"] { background: var(--bench-line); color: var(--bench-ground); }
      #roadmap-lanes.rm-board { grid-template-columns: minmax(0, 1fr); }
      #roadmap-lanes.rm-board[data-active-lane="now"] .rm-seg:not([data-lane="now"]) { display: none; }
      #roadmap-lanes.rm-board[data-active-lane="next"] .rm-seg:not([data-lane="next"]) { display: none; }
      #roadmap-lanes.rm-board[data-active-lane="later"] .rm-seg:not([data-lane="later"]) { display: none; }
      #roadmap-lanes.rm-board[data-active-lane="done"] .rm-seg:not([data-lane="done"]) { display: none; }
    }
  </style>

  <script>
    import { roadmapLanesHtml } from '../lib/roadmap-board';
    import { en } from '../i18n/en';

    const API = 'https://announcements.univerlab.org';
    const RM_STR = en.roadmap;
    const RM_COLORS = JSON.parse(document.getElementById('roadmap-board')?.dataset.topicColors || '{}');
    const TOPIC_DEFS = [
      { id: 'general', label: 'General' },
      { id: 'canopy', label: 'Canopy' },
      { id: 'astro-denoise', label: 'Astro-denoise' },
      { id: 'texforge', label: 'Texforge' },
      { id: 'gitkit', label: 'Gitkit' },
      { id: 'ghscaff', label: 'Ghscaff' },
      { id: 'demostage', label: 'DemoStage' },
      { id: 'quorum', label: 'Quorum' },
      { id: 'facetmedia', label: 'FacetMedia' },
    ];
    const isDev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    const laneEl = document.getElementById('roadmap-lanes');
    const laneTabs = document.querySelector('.lane-tabs');
    const topicFilters = document.getElementById('topic-filters');
    const noticeEl = document.getElementById('roadmap-notice');

    let rmItems: any[] = [];
    let rmVersion = -1;
    let rmOpen: Record<string, boolean> = {};
    let activeTopic = 'all';
    let activeLane = 'now';

    function fillTpl(tpl: string, vars: Record<string, string | number>): string {
      let out = String(tpl ?? '');
      for (const k of Object.keys(vars)) out = out.split('{' + k + '}').join(String(vars[k]));
      return out;
    }
    function topicLabel(id: string): string {
      const topic = TOPIC_DEFS.find((t) => t.id === id);
      return topic ? topic.label : id;
    }
    function visibleItems(): any[] {
      return activeTopic === 'all' ? rmItems : rmItems.filter((i) => i.topic === activeTopic);
    }
    function updateTopicFilters(): void {
      if (!topicFilters) return;
      const counts: Record<string, number> = {};
      for (const i of rmItems) counts[i.topic] = (counts[i.topic] || 0) + 1;
      const tabs = [{ id: 'all', label: 'All', count: rmItems.length }]
        .concat(TOPIC_DEFS.map((t) => ({ id: t.id, label: t.label, count: counts[t.id] || 0 })))
        .filter((t) => t.id === 'all' || t.count > 0);
      topicFilters.innerHTML = '';
      for (const topic of tabs) {
        const button = document.createElement('button');
        button.className = 'topic-filter' + (activeTopic === topic.id ? ' is-active' : '');
        button.type = 'button';
        button.dataset.topic = topic.id;
        button.setAttribute('aria-pressed', activeTopic === topic.id ? 'true' : 'false');
        button.appendChild(document.createTextNode(topic.label));
        const count = document.createElement('span');
        count.className = 'topic-filter-count';
        count.textContent = String(topic.count);
        button.appendChild(count);
        topicFilters.appendChild(button);
      }
    }
    function syncLaneTabs(): void {
      laneTabs?.querySelectorAll<HTMLElement>('[data-lane-tab]').forEach((btn) => {
        btn.setAttribute('aria-selected', btn.dataset.laneTab === activeLane ? 'true' : 'false');
      });
      if (laneEl) laneEl.dataset.activeLane = activeLane;
    }
    function rmRender(): void {
      if (!laneEl) return;
      const html = roadmapLanesHtml(visibleItems(), RM_STR, { colors: RM_COLORS, doneOpen: !!rmOpen.done });
      laneEl.innerHTML = html;
      if (!html) {
        const empty = document.createElement('p');
        empty.className = 'filter-empty';
        empty.textContent = activeTopic === 'all'
          ? (RM_STR.empty || 'Nothing on the roadmap yet.')
          : fillTpl(RM_STR.emptyTopic || 'Nothing on the roadmap under {topic}.', { topic: topicLabel(activeTopic) });
        laneEl.appendChild(empty);
      }
      syncLaneTabs();
      updateTopicFilters();
    }
    // Re-renders only when the payload is newer than what is on screen.
    function rmApply(data: any): void {
      if (typeof data?.version === 'number') {
        if (data.version <= rmVersion) return;
        rmVersion = data.version;
      }
      rmItems = (data?.items || []).filter((i: any) => i.archived_at == null);
      if (noticeEl) noticeEl.hidden = true;
      rmRender();
    }
    function rmFetchAll(): void {
      fetch(API + '/roadmap?limit=100')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then(rmApply)
        .catch(() => {
          if (rmItems.length || !noticeEl || laneEl?.querySelector('.rm-card')) return;
          noticeEl.textContent = RM_STR.unavailable || 'Roadmap unavailable.';
          noticeEl.hidden = false;
        });
    }
    function applyTopic(topic: string): void {
      activeTopic = topic || 'all';
      rmRender();
    }

    laneEl?.addEventListener('click', (event) => {
      const more = (event.target as HTMLElement).closest<HTMLElement>('[data-lane-more]');
      if (!more || !laneEl.contains(more)) return;
      const lane = more.dataset.laneMore || '';
      rmOpen[lane] = !rmOpen[lane];
      rmRender();
    });
    laneTabs?.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLElement>('[data-lane-tab]');
      if (!tab || !laneTabs.contains(tab)) return;
      activeLane = tab.dataset.laneTab || 'now';
      syncLaneTabs();
    });
    topicFilters?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('button[data-topic]');
      if (!button) return;
      applyTopic(button.dataset.topic || 'all');
    });

    // The server-rendered lanes are already on screen; this upgrades them in place.
    rmFetchAll();
    if (!isDev) {
      const source = new EventSource(API + '/events');
      source.addEventListener('roadmap', (e) => {
        try {
          const payload = JSON.parse((e as MessageEvent).data);
          if (payload && typeof payload.version === 'number') rmApply(payload);
        } catch {}
      });
      source.onerror = () => {};
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && !isDev) rmFetchAll();
    });
  </script>
</BaseLayout>
