---
import BaseLayout from '../layouts/BaseLayout.astro';
import Postcard from '../components/Postcard.astro';
import Watermark from '../components/Watermark.astro';
import { liveExperiments } from '../lib/experiments';
import { en } from '../i18n/en';
const topicColors: Record<string, string> = Object.fromEntries(
  liveExperiments.map((e) => [e.id, e.essenceHex]),
);
const rmStrings = en.roadmap;
---
<BaseLayout title="Logbook — live status of every UniverLab experiment" description="Real-time logbook entries and roadmap from every UniverLab experiment — filter by topic, follow along live, or subscribe via the RSS feed." circadian>
  <Watermark kind="blueprint" />
  <section class="wrap board" id="status-board">
    <header class="board-head">
      <div class="page-open">
        <div class="board-titles page-open-text">
          <span class="label">STATUS</span>
          <h1>Status</h1>
          <p class="intro">Real-time activity from UniverLab experiments and tools.</p>
        </div>
        <Postcard page="status" alt={en.postcards.status} />
      </div>
      <div class="board-actions">
        <a href="/roadmap/" class="feed-link">{rmStrings.roadmapLink}</a>
        <a href="/feed/" class="feed-link">RSS</a>
      </div>
    </header>
    <div class="board-filters">
      <nav class="topic-index" aria-label="Board topics">
        <span class="topic-index-label">TOPICS</span>
        <div id="topic-filters" class="topic-filters"><!-- built by JS --></div>
      </nav>
      <nav class="topic-index" aria-label="Board types">
        <span class="topic-index-label">TYPES</span>
        <div id="type-filters" class="topic-filters"><!-- built by JS --></div>
      </nav>
    </div>
    <div class="board-cols">
      <section class="board-col board-log" aria-label="Logbook">
        <div class="col-label" aria-hidden="true"><span class="label">LOGBOOK</span></div>
        <div id="roadmap-clear" class="rm-clear" hidden></div>
        <div id="log-scroller" class="log-scroller" tabindex="0" aria-label="Logbook entries">
          <div id="log-entries">
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
          </div>
        </div>
      </section>
    </div>
  </section>

  <style is:global>
    /* Board shell — one header, one filter bar, the mission log. */
    .wrap.board { max-width: 88rem; padding-block: 4rem 6rem; }
    .board .label { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); display: block; }
    .board-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2.5rem; margin-bottom: 2rem; }
    .board-titles { min-width: 0; }
    .board-titles .label { margin-bottom: 1.2rem; }
    .board-actions { display: flex; align-items: center; gap: 0.6rem; }
    .col-label { margin-bottom: 1.2rem; }
    .board-filters { display: flex; flex-direction: column; margin-bottom: 2.5rem; }
    .board-cols { display: flex; flex-direction: column; gap: 3rem; }
    .board-col { min-width: 0; width: 100%; max-width: 42rem; margin-inline: auto; }
    .log-scroller { min-width: 0; }
    .scroll-sentinel { display: block; min-height: 1px; }
    .feed-link { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); text-decoration: none; border: 1px solid var(--line); padding: 0.15rem 0.45rem; border-radius: 3px; transition: color 0.15s ease, border-color 0.15s ease; }
    .feed-link:hover, .feed-link:focus-visible { color: var(--ink); border-color: var(--accent); }
    .board h1 { font-family: var(--font-mono); font-size: 1.6rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); margin-bottom: 0.6rem; }
    .board .intro { color: var(--ink-dim); font-size: 0.95rem; line-height: 1.6; margin-bottom: 0; max-width: 42rem; }
    .topic-index { display: flex; align-items: baseline; gap: 1rem; padding-block: 0.5rem; }
    .topic-index + .topic-index { padding-top: 0; margin-top: -0.15rem; }
    .topic-index-label { flex: 0 0 auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; color: var(--ink-faint); }
    .topic-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .topic-filter { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.3rem 0.65rem; border: none; border-radius: 100px; background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; cursor: pointer; transition: color 0.2s ease, background 0.2s ease; }
    .topic-filter:hover, .topic-filter:focus-visible { background: color-mix(in srgb, var(--ink) 12%, transparent); color: var(--ink); }
    .topic-filter.is-active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
    .topic-filter-count { color: var(--ink-faint); font-size: 0.58rem; }
    .topic-filter.is-active .topic-filter-count, .topic-filter:hover .topic-filter-count { color: currentColor; }
    .filter-empty { padding-block: 3rem; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.82rem; text-align: center; }
    #log-entries { display: flex; flex-direction: column; }
    .entry { display: grid; grid-template-columns: 7rem 1fr auto; grid-template-rows: auto auto; gap: 0.4rem 1.2rem; padding-block: 1.8rem; border-bottom: 1px solid var(--line); align-items: start; background: color-mix(in srgb, var(--bg) 80%, transparent); }
    .entry time { grid-column: 1; grid-row: 1; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint); white-space: nowrap; }
    .entry .type-badge { grid-column: 3; grid-row: 1; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); padding: 0.15rem 0.5rem; border-radius: 3px; align-self: start; opacity: 0.8; }
    .entry .entry-body { grid-column: 1 / -1; grid-row: 2; }
    .entry h3 { font-family: var(--font-mono); font-size: 0.95rem; color: var(--accent); margin-bottom: 0.3rem; }
    .entry p { color: var(--ink-dim); font-size: 0.88rem; line-height: 1.65; white-space: pre-line; }
    .entry p a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
    .entry p a:hover { color: var(--ink); }
    .entry-link { display: inline-block; margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); text-decoration: none; letter-spacing: 0.05em; }
    .entry-link:hover { text-decoration: underline; color: var(--ink); }

    /* Skeleton */
    .skeleton .entry-body { height: 3rem; border-radius: 4px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; }
    .skeleton time { height: 0.8rem; border-radius: 3px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; display: block; }
    .skeleton .type-badge { height: 0.9rem; width: 3rem; border-radius: 3px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; }
    @keyframes skeleton-pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* Empty state */
    #log-entries:empty::after { content: 'No entries yet. The log is waiting for its first transmission.'; display: block; font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-faint); padding-block: 3rem; text-align: center; }

    /* Scroll-driven fade-in (progressive enhancement) */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .entry { animation: entry-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
        @keyframes entry-rise { from { opacity: 0.1; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
      }
    }
    .rm-clear { margin-bottom: 1rem; }
    .rm-clear-btn { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.3rem 0.65rem; border: none; border-radius: 100px; background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; cursor: pointer; }
    .rm-clear-btn:hover, .rm-clear-btn:focus-visible { background: color-mix(in srgb, var(--accent) 25%, transparent); color: var(--ink); }

    /* Topic filter dims log rows instead of removing them, so the whole log stays in view. */
    .entry.is-dimmed > time,
    .entry.is-dimmed > .entry-body,
    .entry.is-dimmed > .type-badge { opacity: 0.35; }

    /* Wide screens: the mission log is its own scroll context. Below the
       breakpoint this block is inert and the page scrolls. */
    @media (min-width: 78rem) {
      .board-log .log-scroller { max-height: calc(100dvh - 16rem); min-height: 24rem; overflow-y: auto; overscroll-behavior: contain; }
      /* Quiet scroll: the two wide-split scrollers only. Page tokens via
         color-mix, no new colours, no arrow buttons; the lower edge dissolves
         instead of cutting a hard line. Inert below the breakpoint. */
      .board-log .log-scroller {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--ink-faint) 45%, transparent) transparent;
        mask-image: linear-gradient(to bottom, #000 calc(100% - 1.2rem), transparent);
      }
      .board-log .log-scroller::-webkit-scrollbar { width: 6px; }
      .board-log .log-scroller::-webkit-scrollbar-track { background: transparent; }
      .board-log .log-scroller::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--ink-faint) 45%, transparent); border-radius: 999px; }
      .board-log .log-scroller::-webkit-scrollbar-thumb:hover { background: var(--ink-faint); }
      .board-log .log-scroller::-webkit-scrollbar-button { display: none; }
    }
    /* Mobile overrides last: media queries add no specificity, so these must
       follow the base rules above or they are silently overridden. */
    @media (max-width: 640px) {
      .topic-index { align-items: flex-start; flex-direction: column; gap: 0.6rem; }
      .topic-filters { flex-wrap: wrap; max-width: 100%; }
      .topic-filter { flex: 0 0 auto; }
      .entry { grid-template-columns: 1fr auto; }
      .entry time { grid-column: 1 / -1; }
      .entry .entry-body { grid-column: 1 / -1; }
    }
  </style>

  <script is:inline define:vars={{ topicColors, rmStrings }}>
    (function () {
      var API = 'https://announcements.univerlab.org';
      var TOPIC_COLORS = topicColors;
      var RM_STR = rmStrings || {};
      var container = document.getElementById('log-entries');
      if (!container) return;
      var logScroller = document.getElementById('log-scroller') || container.parentElement;
      var sentinel = null;

      // The sentinel must stay the last child of the log scroll container or
      // infinite scroll stops firing once rows are re-rendered above it.
      function placeSentinel() {
        if (!sentinel || !logScroller) return;
        if (sentinel.parentNode !== logScroller || logScroller.lastElementChild !== sentinel) {
          logScroller.appendChild(sentinel);
        }
      }

      var isDev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      var MOCK = [
        { date: '2026-07-18T10:00:00Z', type: 'launch', title: 'New release', body: 'This release brings parallel agents with shared context and a new DAG designer in the canopy UI — drag nodes, wire outputs to inputs, and run the whole graph with one click. The designer supports conditional branches, fan-out patterns, and error recovery nodes that automatically retry failed steps with exponential backoff. You can also define subgraphs that act as reusable components, similar to functions in a programming language, which keeps complex workflows manageable as they grow.\n\nPerformance is up: cold starts dropped from 1.2s to 400ms after moving to a lighter isolate. Memory per agent went from 45MB to 28MB. The new scheduler supports priority queues, so critical agents can preempt lower-priority work when resources are tight. We benchmarked a 12-agent DAG running end-to-end in 3.4s, down from 8.1s.\n\nOn observability, every agent run now emits structured traces compatible with OpenTelemetry. Pipe them to Jaeger, Grafana Tempo, or any OTLP collector. The flight log shows trace spans inline. There is also a new /metrics endpoint with Prometheus-compatible counters for agent starts, completions, failures, and queue depth.\n\nBreaking changes: config format moved from YAML to TOML. Run `canopy migrate-config` to rewrite every file in place. Check the full changelog at https://github.com/UniverLab/harness-canopy/releases and the migration guide at https://univerlab.org/canopy/docs/migration. Open a thread at https://github.com/UniverLab/harness-canopy/discussions if you run into issues.', link: 'https://github.com/UniverLab/harness-canopy/releases/tag/v0.5.0' },
        { date: '2026-07-17T22:00:00Z', type: 'note', title: 'Dress rehearsal', body: 'Before a vehicle flies, it runs a dress rehearsal: the full countdown on the pad, tanks loaded, every system exercised in sequence, stopping just short of ignition. Nothing leaves the ground. The point is to find out what breaks while breaking it is still cheap.' },
        { date: '2026-07-17T18:00:00Z', type: 'launch', title: 'First light', body: 'Astronomers call it first light: the moment a new instrument opens its eye and returns an image. That first picture is never the best one the telescope will ever take. It is the proof that the optics align, the detector responds, the data path is open.' },
        { date: '2026-07-17T12:00:00Z', type: 'deploy', title: 'Announcements worker online', body: 'The announcements Durable Object is live. Entries serialize through SQLite, fan out over SSE, and mirror to KV for fast reads. The first transmission reached the log without incident.' },
        { date: '2026-07-17T09:00:00Z', type: 'note', title: 'Status page ships', body: 'The status page is now part of the public site. Real-time entries, infinite scroll, toast notifications for live updates, and a cosmic background that matches the mission log aesthetic.' },
        { date: '2026-07-16T20:00:00Z', type: 'bugfix', title: 'Skeleton placeholders cleared', body: 'The skeleton loading placeholders were not being removed when the first batch of entries loaded. A one-line fix clears the container before appending real entries.' }
      ];
      MOCK[0].topic = 'canopy';
      MOCK[1].topic = 'canopy';
      MOCK[2].topic = 'general';
      MOCK[3].topic = 'general';
      MOCK[4].topic = 'general';
      MOCK[5].topic = null;

      var TOPIC_DEFS = [
        { id: 'general', label: 'General' },
        { id: 'canopy', label: 'Canopy' },
        { id: 'astro-denoise', label: 'Astro-denoise' },
        { id: 'texforge', label: 'Texforge' },
        { id: 'gitkit', label: 'Gitkit' },
        { id: 'ghscaff', label: 'Ghscaff' },
        { id: 'demostage', label: 'DemoStage' },
        { id: 'quorum', label: 'Quorum' }
      ];
      var topicFilters = document.getElementById('topic-filters');
      var typeFilters = document.getElementById('type-filters');
      var allEntries = [];
      var activeTopic = new URLSearchParams(location.search).get('topic') || 'all';
      var activeType = 'all';
      var TYPE_DEFS = [
        { id: 'launch', label: 'Launch' },
        { id: 'deploy', label: 'Deploy' },
        { id: 'bugfix', label: 'Bugfix' },
        { id: 'note', label: 'Note' },
        { id: 'incident', label: 'Incident' }
      ];
      var PAGE = 20;
      var offset = 0;
      var loading = false;
      var hasMore = true;

      function formatDate(iso) {
        // Sol day-of-year shared with src/lib/mission-time.ts (solDayOfYear):
        // local-midnight epoch on purpose — keep byte-for-byte in sync.
        var d = new Date(iso);
        var y = d.getFullYear();
        var start = new Date(y, 0, 0);
        var dayOfYear = Math.floor((d - start) / 86400000);
        var hh = String(d.getUTCHours()).padStart(2, '0');
        var mm = String(d.getUTCMinutes()).padStart(2, '0');
        return y + ' \u00b7 Sol ' + dayOfYear + ' \u00b7 ' + hh + ':' + mm + ' UTC';
      }
      function solOf(iso) {
        var d = new Date(iso);
        var y = d.getFullYear();
        var start = new Date(y, 0, 0);
        return Math.floor((d - start) / 86400000);
      }
      function fillTpl(tpl, vars) {
        var out = String(tpl == null ? '' : tpl);
        for (var k in vars) {
          if (Object.prototype.hasOwnProperty.call(vars, k)) {
            out = out.split('{' + k + '}').join(String(vars[k]));
          }
        }
        return out;
      }

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function linkify(text) {
        var escaped = escapeHtml(text);
        return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
          return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
        });
      }

      function normalizeEntry(entry) {
        var knownTopic = TOPIC_DEFS.some(function (topic) { return topic.id === entry.topic; });
        return Object.assign({}, entry, { topic: knownTopic ? entry.topic : 'general' });
      }

      function topicLabel(id) {
        var topic = TOPIC_DEFS.filter(function (item) { return item.id === id; })[0];
        return topic ? topic.label : 'General';
      }

      function updateTopicFilters() {
        if (!topicFilters) return;
        var counts = {};
        TOPIC_DEFS.forEach(function (topic) { counts[topic.id] = 0; });
        allEntries.forEach(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeType !== 'all' && ne.type !== activeType) return;
          counts[ne.topic]++;
        });
        var total = activeType === 'all'
          ? allEntries.length
          : allEntries.filter(function (e) { return normalizeEntry(e).type === activeType; }).length;

        topicFilters.innerHTML = '';
        [{ id: 'all', label: 'All', count: total }].concat(TOPIC_DEFS.map(function (topic) {
          return { id: topic.id, label: topic.label, count: counts[topic.id] };
        })).filter(function (t) { return t.id === 'all' || t.count > 0; }).forEach(function (topic) {
          var button = document.createElement('button');
          button.className = 'topic-filter' + (activeTopic === topic.id ? ' is-active' : '');
          button.type = 'button';
          button.dataset.topic = topic.id;
          button.setAttribute('aria-pressed', activeTopic === topic.id ? 'true' : 'false');
          button.appendChild(document.createTextNode(topic.label));

          var count = document.createElement('span');
          count.className = 'topic-filter-count';
          count.textContent = String(topic.count);
          button.appendChild(count);
          topicFilters.appendChild(button);
        });
      }

      function updateTypeFilters() {
        if (!typeFilters) return;
        var counts = {};
        TYPE_DEFS.forEach(function (t) { counts[t.id] = 0; });
        allEntries.forEach(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeTopic !== 'all' && ne.topic !== activeTopic) return;
          if (entry.type && counts[entry.type] !== undefined) counts[entry.type]++;
        });
        var total = activeTopic === 'all'
          ? allEntries.length
          : allEntries.filter(function (e) { return normalizeEntry(e).topic === activeTopic; }).length;

        typeFilters.innerHTML = '';
        [{ id: 'all', label: 'All', count: total }].concat(TYPE_DEFS.map(function (t) {
          return { id: t.id, label: t.label, count: counts[t.id] };
        })).filter(function (t) { return t.id === 'all' || t.count > 0; }).forEach(function (t) {
          var button = document.createElement('button');
          button.className = 'topic-filter' + (activeType === t.id ? ' is-active' : '');
          button.type = 'button';
          button.dataset.type = t.id;
          button.setAttribute('aria-pressed', activeType === t.id ? 'true' : 'false');
          button.appendChild(document.createTextNode(t.label));

          var count = document.createElement('span');
          count.className = 'topic-filter-count';
          count.textContent = String(t.count);
          button.appendChild(count);
          typeFilters.appendChild(button);
        });
      }

      // Topic selection dims non-matching log rows instead of removing them, so
      // the log keeps its scroll position. Type still hard-filters. A roadmap
      // entries-link (?roadmap=ID) sets activeRoadmapId and dims by roadmap_id as well.
      var activeRoadmapId = null;
      function entryIsDimmed(entry) {
        if (activeRoadmapId) {
          if ((entry.roadmap_id || null) !== activeRoadmapId) return true;
        }
        if (activeTopic === 'all') return false;
        return normalizeEntry(entry).topic !== activeTopic;
      }

      function renderEntries() {
        container.innerHTML = '';
        placeSentinel();
        var visible = allEntries.filter(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeType !== 'all' && ne.type !== activeType) return false;
          return true;
        });

        if (!visible.length) {
          var empty = document.createElement('p');
          empty.className = 'filter-empty';
          empty.textContent = activeType === 'all'
            ? 'No entries yet. The log is waiting for its first transmission.'
            : 'No ' + activeType + ' entries yet.';
          container.appendChild(empty);
          return;
        }
        appendEntries(visible);
      }

      function renderEntry(entry) {
        var article = document.createElement('article');
        article.className = 'entry';

        var time = document.createElement('time');
        time.setAttribute('datetime', entry.date);
        time.setAttribute('data-mission', '');
        time.textContent = formatDate(entry.date);
        article.appendChild(time);

        var body = document.createElement('div');
        body.className = 'entry-body';

        if (entry.type) {
          var badge = document.createElement('div');
          badge.className = 'type-badge';
          badge.textContent = entry.type;
          article.appendChild(badge);
        }

        var h3 = document.createElement('h3');
        h3.textContent = entry.title;
        body.appendChild(h3);

        var p = document.createElement('p');
        p.innerHTML = linkify(entry.body);
        body.appendChild(p);

        if (entry.link) {
          var a = document.createElement('a');
          a.className = 'entry-link';
          a.href = entry.link;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = 'View \u2192';
          body.appendChild(a);
        }

        article.appendChild(body);
        return article;
      }

      function appendEntries(entries) {
        if (!Array.isArray(entries) || !entries.length) return;
        var frag = document.createDocumentFragment();
        entries.forEach(function (e) {
          var article = renderEntry(e);
          if (entryIsDimmed(e)) article.classList.add('is-dimmed');
          frag.appendChild(article);
        });
        container.appendChild(frag);
      }

      function loadMore() {
        if (loading || !hasMore) return;
        loading = true;

        if (isDev) {
          var batch = MOCK.slice(offset, offset + PAGE);
          allEntries = allEntries.concat(batch.map(normalizeEntry));
          offset += batch.length;
          hasMore = offset < MOCK.length;
          loading = false;
          updateTopicFilters();
          updateTypeFilters();
          renderEntries();
          if (!hasMore) observer.disconnect();
          return;
        }

        fetch(API + '?offset=' + offset + '&limit=' + PAGE)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var entries = Array.isArray(data.entries) ? data.entries.map(normalizeEntry) : [];
            allEntries = allEntries.concat(entries);
            offset += entries.length;
            hasMore = data.hasMore;
            loading = false;
            updateTopicFilters();
            updateTypeFilters();
            renderEntries();
            if (!hasMore) observer.disconnect();
          })
          .catch(function () { loading = false; });
      }

      function prependEntry(entry) {
        allEntries.unshift(normalizeEntry(entry));
        offset++;
        updateTopicFilters();
        updateTypeFilters();
        renderEntries();
        showToast(entry.title);
      }

      function updateEntry(entry) {
        var updated = normalizeEntry(entry);
        var index = allEntries.findIndex(function (item) { return item.id === updated.id; });
        if (index === -1) return;
        allEntries[index] = updated;
        updateTopicFilters();
        updateTypeFilters();
        renderEntries();
      }

      // A slip of old paper taped to the lower right — the shared notice skin
      // for everything that is not mail (the global .slip rules in global.css).
      function slipNotice(html, ms) {
        var old = document.querySelectorAll('.slip.notice');
        for (var i = 0; i < old.length; i++) old[i].remove();
        var el = document.createElement('div');
        el.className = 'slip tip notice';
        el.setAttribute('role', 'status');
        el.innerHTML = html;
        document.body.appendChild(el);
        var bye = function () { if (el.isConnected) el.remove(); };
        el.addEventListener('click', bye);
        setTimeout(bye, ms || 5000);
        return el;
      }

      function showToast(title) {
        slipNotice('New entry: ' + title);
      }

      function applyTopic(topic) {
        activeTopic = topic || 'all';
        var nextUrl = activeTopic === 'all'
          ? location.pathname
          : location.pathname + '?topic=' + encodeURIComponent(activeTopic);
        history.replaceState(null, '', nextUrl);
        updateTypeFilters();
        updateTopicFilters();
        renderEntries();
      }

      var rmClearEl = document.getElementById('roadmap-clear');
      function rmApplyRoadmapFilter(id, title) {
        activeRoadmapId = id || null;
        renderEntries();
        rmRenderClear(title);
      }
      function rmRenderClear(title) {
        if (!rmClearEl) return;
        rmClearEl.innerHTML = '';
        if (!activeRoadmapId) { rmClearEl.hidden = true; return; }
        rmClearEl.hidden = false;
        var btn = document.createElement('button');
        btn.className = 'rm-clear-btn';
        btn.type = 'button';
        btn.setAttribute('aria-label', (RM_STR.clearRoadmapFilter || 'Clear roadmap filter') + (title ? ': ' + title : ''));
        btn.textContent = (title ? title + ' \u00d7' : (RM_STR.clearRoadmapFilter || 'Clear roadmap filter \u00d7'));
        btn.title = RM_STR.clearRoadmapFilter || 'Clear roadmap filter';
        btn.addEventListener('click', function () { rmApplyRoadmapFilter(null); });
        rmClearEl.appendChild(btn);
      }

      if (topicFilters) {
        topicFilters.addEventListener('click', function (event) {
          var button = event.target.closest('button[data-topic]');
          if (!button) return;
          applyTopic(button.dataset.topic);
        });
      }

      if (typeFilters) {
        typeFilters.addEventListener('click', function (event) {
          var button = event.target.closest('button[data-type]');
          if (!button) return;
          activeType = button.dataset.type || 'all';
          updateTopicFilters();
          updateTypeFilters();
          renderEntries();
        });
      }

      // Infinite scroll sentinel — last child of the log scroll container, kept
      // there by placeSentinel(). The observer root follows the layout: the
      // scroller while the split is active, the document viewport below the
      // breakpoint. An element root that is not a scroll box contains its last
      // child at all times, so a fixed root: logScroller would report the
      // sentinel as always-intersecting and strand pagination on narrow.
      sentinel = document.createElement('div');
      sentinel.className = 'scroll-sentinel';
      placeSentinel();

      var splitMq = window.matchMedia('(min-width: 78rem)');
      var observer = null;
      function bindSentinelObserver() {
        if (observer) observer.disconnect();
        var wide = splitMq.matches;
        // The scroller is only keyboard-scrollable when it actually scrolls.
        logScroller.tabIndex = wide ? 0 : -1;
        observer = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) loadMore();
        }, { root: wide ? logScroller : null, rootMargin: '200px' });
        if (hasMore) observer.observe(sentinel);
      }
      bindSentinelObserver();
      if (splitMq.addEventListener) splitMq.addEventListener('change', bindSentinelObserver);

      // Initial load
      loadMore();

      var rmParam = new URLSearchParams(location.search).get('roadmap');
      if (rmParam) rmApplyRoadmapFilter(rmParam, rmParam);

      // Force announcement notice in dev mode
      if (isDev) {
        setTimeout(function () {
          var mockAnnouncement = MOCK[0];

          function escapeHtml(s) {
            return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          }
          function linkify(text) {
            var escaped = escapeHtml(text);
            return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
              return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" style="color:#87222c;text-decoration:underline;text-underline-offset:2px">' + url + '</a>';
            });
          }

          var html = '<strong style="font-weight:600">' + escapeHtml(mockAnnouncement.title) + '</strong>';
          if (mockAnnouncement.body) {
            html += '<div style="margin-top:0.4rem">' + linkify(mockAnnouncement.body) + '</div>';
          }
          if (mockAnnouncement.link) {
            html += '<br><a href="' + escapeHtml(mockAnnouncement.link) + '" target="_blank" rel="noopener noreferrer" style="color:#87222c;text-decoration:underline;text-underline-offset:2px">View &rarr;</a>';
          }

          var toast = slipNotice(html, 8000);
          if (mockAnnouncement.link) {
            toast.addEventListener('click', function (ev) {
              if (ev.target.tagName === 'A') return;
              window.open(mockAnnouncement.link, '_blank', 'noopener,noreferrer');
            });
          }
        }, 1500);
      }

      // SSE
      if (!isDev) {
        var source = new EventSource(API + '/events');
        source.addEventListener('entry', function (e) {
          try {
            var entry = JSON.parse(e.data);
            prependEntry(entry);
          } catch (err) {}
        });
        source.addEventListener('update', function (e) {
          try {
            updateEntry(JSON.parse(e.data));
          } catch (err) {}
        });
        source.onerror = function () {};
      }
    })();
  </script>
</BaseLayout>
