        }
        var acc = [];
        var version = 0;
        var off = 0;
        function step() {
          fetch(API + '/roadmap?offset=' + off + '&limit=100')
            .then(function (r) { return r.json(); })
            .then(function (data) {
              acc = acc.concat(data.items || []);
              version = data.version || 0;
              if (data.hasMore) { off += (data.items || []).length; step(); return; }
              rmItems = acc.filter(function (i) { return i.archived_at == null; }).map(rmNormalize);
              rmVersion = version;
              rmSort();
              rmRender();
              if (cb) cb();
            })
            .catch(function () {
              if (rmItems.length) return;
              rmNotice(RM_STR.unavailable || 'Roadmap unavailable.');
              rmRender();
            });
        }
        step();
      }
      if (rmContainer) {
        rmContainer.addEventListener('click', function (event) {
          var entriesBtn = event.target.closest('[data-roadmap-entries]');
          if (entriesBtn && rmContainer.contains(entriesBtn)) {
            var rid = entriesBtn.getAttribute('data-roadmap-entries');
            var card = entriesBtn.closest('.rm-card');
            var rtitle = null;
            if (card) {
              var t = card.querySelector('.rm-title');
              if (t) rtitle = t.textContent;
            }
            rmApplyRoadmapFilter(activeRoadmapId === rid ? null : rid, activeRoadmapId === rid ? null : rtitle);
            return;
          }
          var chip = event.target.closest('.rm-chip');
          if (chip && rmContainer.contains(chip)) {
            var t2 = chip.getAttribute('data-topic') || 'all';
            applyTopic(activeTopic === t2 ? 'all' : t2);
            return;
          }
          var more = event.target.closest('[data-lane-more]');
          if (more && rmContainer.contains(more)) {
            var lane = more.getAttribute('data-lane-more');
            if (lane && rmOpen[lane] !== undefined) {
              rmOpen[lane] = !rmOpen[lane];
              rmRender();
            }
            return;
          }
        });
      }
      // Infinite scroll sentinel — last child of the log scroll container, kept
      // there by placeSentinel(). The observer root follows the layout: the
      // scroller while the split is active, the document viewport below the
      // breakpoint. An element root that is not a scroll box contains its last
      // child at all times, so a fixed root: logScroller would report the
      // sentinel as always-intersecting and strand pagination on narrow.
      sentinel = document.createElement('div');
      sentinel.className = 'scroll-sentinel';
      placeSentinel();

      var splitMq = window.matchMedia('(min-width: 78rem)');
      var observer = null;
      function bindSentinelObserver() {
        if (observer) observer.disconnect();
        var wide = splitMq.matches;
        // The scroller is only keyboard-scrollable when it actually scrolls.
        logScroller.tabIndex = wide ? 0 : -1;
        observer = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) loadMore();
        }, { root: wide ? logScroller : null, rootMargin: '200px' });
        if (hasMore) observer.observe(sentinel);
      }
      bindSentinelObserver();
      if (splitMq.addEventListener) splitMq.addEventListener('change', bindSentinelObserver);

      // Initial load
      loadMore();
      rmFetchAll();

      // Force announcement toast in dev mode
      if (isDev) {
        setTimeout(function () {
          var mockAnnouncement = MOCK[0];

          function escapeHtml(s) {
            return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          }
          function linkify(text) {
            var escaped = escapeHtml(text);
            return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
              return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" style="color:#d4a843;text-decoration:underline;text-underline-offset:2px">' + url + '</a>';
            });
          }

          var backdrop = document.createElement('div');
          backdrop.className = 'gl-toast-backdrop';
          document.body.appendChild(backdrop);

          var toast = document.createElement('div');
          toast.className = 'gl-toast';
          var html = '<button class="gl-toast-close" aria-label="Close">&times;</button><span>' + escapeHtml(mockAnnouncement.title) + '</span>';
          if (mockAnnouncement.body) {
            var bodyHtml = linkify(mockAnnouncement.body);
            html += '<div class="gl-toast-body"><div class="gl-toast-body-inner">' + bodyHtml + '</div><button class="gl-toast-expand" type="button">ver más</button></div>';
          }
          if (mockAnnouncement.link) {
            html += '<br><a href="' + escapeHtml(mockAnnouncement.link) + '" target="_blank" rel="noopener noreferrer" style="color:#d4a843;text-decoration:underline;text-underline-offset:2px">View &rarr;</a>';
          }
          toast.innerHTML = html;

          var expandBtn = toast.querySelector('.gl-toast-expand');
          if (expandBtn) {
            var inner = toast.querySelector('.gl-toast-body-inner');
            requestAnimationFrame(function () {
              if (inner.scrollHeight <= inner.clientHeight + 2) {
                expandBtn.style.display = 'none';
              } else {
                expandBtn.addEventListener('click', function (ev) {
                  ev.stopPropagation();
                  inner.classList.toggle('expanded');
                  expandBtn.textContent = inner.classList.contains('expanded') ? 'ver menos' : 'ver más';
                });
              }
            });
          }

          var dismiss = function () {
            backdrop.classList.add('gl-toast-out');
            toast.classList.add('gl-toast-out');
            setTimeout(function () { backdrop.remove(); toast.remove(); }, 300);
          };

          toast.querySelector('.gl-toast-close').addEventListener('click', dismiss);
          backdrop.addEventListener('click', dismiss);
          if (mockAnnouncement.link) {
            toast.style.cursor = 'pointer';
            toast.addEventListener('click', function (ev) {
              if (ev.target.tagName === 'A' || ev.target.tagName === 'BUTTON') return;
              window.open(mockAnnouncement.link, '_blank', 'noopener,noreferrer');
            });
          }

          document.body.appendChild(toast);
          setTimeout(dismiss, 8000);
        }, 1500);
      }

      // SSE
      if (!isDev) {
        var source = new EventSource(API + '/events');
        source.addEventListener('entry', function (e) {
          try {
            var entry = JSON.parse(e.data);
            prependEntry(entry);
          } catch (err) {}
        });
        source.addEventListener('update', function (e) {
          try {
            updateEntry(JSON.parse(e.data));
          } catch (err) {}
        });
        source.addEventListener('roadmap', function (e) {
          try {
            var payload = JSON.parse(e.data);
            if (!payload || typeof payload.version !== 'number' || payload.version < rmVersion) return;
            rmItems = (payload.items || []).filter(function (i) { return i.archived_at == null; }).map(rmNormalize);
            rmVersion = payload.version;
            rmSort();
            rmRender();
          } catch (err) {}
        });
        source.onerror = function () {};
      }
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && !isDev) rmFetchAll();
      });
    })();
  </script>
</BaseLayout>
