---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Mission Log — UniverLab" description="Real-time activity from UniverLab experiments." bg="cosmic" circadian>
  <section class="wrap log">
    <span class="label">MISSION LOG</span>
    <h1>Status</h1>
    <p class="intro">Real-time activity from UniverLab experiments and tools.</p>
    <nav class="topic-index" aria-label="Mission log topics">
      <span class="topic-index-label">TOPICS</span>
      <div id="topic-filters" class="topic-filters">
        <button class="topic-filter is-active" type="button" data-topic="all" aria-pressed="true">All</button>
      </div>
    </nav>
    <nav class="topic-index" aria-label="Mission log types">
      <span class="topic-index-label">TYPES</span>
      <div id="type-filters" class="topic-filters">
        <button class="topic-filter is-active" type="button" data-type="all" aria-pressed="true">All</button>
      </div>
    </nav>
    <div id="log-entries">
      <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
      <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
      <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
    </div>
  </section>

  <style is:global>
    .log {
      max-width: 42rem;
      padding-block: 4rem 6rem;
    }
    .log .label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-faint);
      display: block;
      margin-bottom: 1.2rem;
    }
    .log h1 {
      font-family: var(--font-mono);
      font-size: 1.6rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink);
      margin-bottom: 0.6rem;
    }
    .log .intro {
      color: var(--ink-dim);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 3rem;
    }
    .topic-index {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding-block: 0.5rem;
    }
    .topic-index + .topic-index {
      padding-top: 0;
      margin-top: -0.15rem;
    }
    .topic-index-label {
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      color: var(--ink-faint);
    }
    .topic-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .topic-filter {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      padding: 0.3rem 0.65rem;
      border: none;
      border-radius: 100px;
      background: color-mix(in srgb, var(--ink) 6%, transparent);
      color: var(--ink-dim);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: color 0.2s ease, background 0.2s ease;
    }
    .topic-filter:hover,
    .topic-filter:focus-visible {
      background: color-mix(in srgb, var(--ink) 12%, transparent);
      color: var(--ink);
    }
    .topic-filter.is-active {
      background: color-mix(in srgb, var(--accent) 15%, transparent);
      color: var(--accent);
    }
    .topic-filter-count {
      color: var(--ink-faint);
      font-size: 0.58rem;
    }
    .topic-filter.is-active .topic-filter-count,
    .topic-filter:hover .topic-filter-count {
      color: currentColor;
    }
    .filter-empty {
      padding-block: 3rem;
      color: var(--ink-faint);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      text-align: center;
    }
    #log-entries { display: flex; flex-direction: column; }
    .entry {
      display: grid;
      grid-template-columns: 7rem 1fr auto;
      grid-template-rows: auto auto;
      gap: 0.4rem 1.2rem;
      padding-block: 1.8rem;
      border-bottom: 1px solid var(--line);
      align-items: start;
    }
    .entry time {
      grid-column: 1;
      grid-row: 1;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--ink-faint);
      white-space: nowrap;
    }
    .entry .type-badge {
      grid-column: 3;
      grid-row: 1;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--accent);
      padding: 0.15rem 0.5rem;
      border-radius: 3px;
      align-self: start;
      opacity: 0.8;
    }
    .entry .entry-body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .entry h3 {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      color: var(--accent);
      margin-bottom: 0.3rem;
    }
    .entry p {
      color: var(--ink-dim);
      font-size: 0.88rem;
      line-height: 1.65;
      white-space: pre-line;
    }
    .entry p a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .entry p a:hover {
      color: var(--ink);
    }
    .entry-link {
      display: inline-block;
      margin-top: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--accent);
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    .entry-link:hover {
      text-decoration: underline;
      color: var(--ink);
    }

    /* Skeleton */
    .skeleton .entry-body {
      height: 3rem;
      border-radius: 4px;
      background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%);
      background-size: 200% 100%;
      animation: skeleton-pulse 1.8s ease-in-out infinite;
    }
    .skeleton time {
      height: 0.8rem;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%);
      background-size: 200% 100%;
      animation: skeleton-pulse 1.8s ease-in-out infinite;
      display: block;
    }
    .skeleton .type-badge {
      height: 0.9rem;
      width: 3rem;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%);
      background-size: 200% 100%;
      animation: skeleton-pulse 1.8s ease-in-out infinite;
    }
    @keyframes skeleton-pulse {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Empty state */
    #log-entries:empty::after {
      content: 'No entries yet. The log is waiting for its first transmission.';
      display: block;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--ink-faint);
      padding-block: 3rem;
      text-align: center;
    }

    /* Toast — same style as the announcement toast in BaseLayout */
    .gl-toast-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 319;
      animation: gl-backdrop-in 0.2s ease;
    }
    .gl-toast {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(18, 18, 22, 0.95);
      color: #fff;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.88rem;
      padding: 0.9rem 2.4rem 0.9rem 1.4rem;
      border-radius: 8px;
      border: 1px solid #d4a843;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 30px rgba(212, 168, 67, 0.25), 0 0 60px rgba(212, 168, 67, 0.1);
      animation: gl-toast-in 0.2s ease;
      z-index: 320;
      text-align: center;
      max-width: 90vw;
      cursor: pointer;
      max-height: 80vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .gl-toast span {
      color: #d4a843;
      font-weight: 600;
    }
    .gl-toast-close {
      position: absolute;
      top: 0.3rem;
      right: 0.5rem;
      background: none;
      border: none;
      color: #d4a843;
      font-size: 1.2rem;
      cursor: pointer;
      line-height: 1;
      padding: 0 0.2rem;
      opacity: 0.7;
    }
    .gl-toast-close:hover {
      opacity: 1;
    }
    .gl-toast.gl-toast-out {
      animation: gl-toast-out 0.3s ease forwards;
    }
    .gl-toast-backdrop.gl-toast-out {
      animation: gl-backdrop-out 0.3s ease forwards;
    }
    .gl-toast-body {
      margin-top: 0.5rem;
      text-align: left;
      overflow: hidden;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .gl-toast-body-inner {
      color: #ccc;
      font-size: 0.82rem;
      line-height: 1.5;
      max-height: 4.5em;
      overflow: hidden;
      transition: max-height 0.3s ease;
      white-space: pre-line;
    }
    .gl-toast-body-inner.expanded {
      max-height: none;
      overflow-y: auto;
    }
    .gl-toast-expand {
      background: none;
      border: 0;
      color: #d4a843;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.72rem;
      cursor: pointer;
      padding: 0.3rem 0 0;
      text-align: left;
      opacity: 0.8;
    }
    .gl-toast-expand:hover {
      opacity: 1;
      text-decoration: underline;
    }
    @keyframes gl-toast-in {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes gl-toast-out {
      from { opacity: 1; }
      to { opacity: 0; transform: scale(0.95); }
    }
    @keyframes gl-backdrop-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes gl-backdrop-out {
      from { opacity: 1; }
      to { opacity: 0; }
    }

    /* Scroll-driven fade-in (progressive enhancement) */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .entry {
          animation: entry-rise linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 30%;
        }
        @keyframes entry-rise {
          from { opacity: 0.1; transform: translateY(12px); }
          to { opacity: 1; transform: translateY(0); }
        }
      }
    }

    @media (max-width: 640px) {
      .topic-index {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.6rem;
      }
      .topic-filters {
        flex-wrap: nowrap;
        max-width: 100%;
        overflow-x: auto;
        padding-bottom: 0.2rem;
        -webkit-overflow-scrolling: touch;
      }
      .topic-filter {
        flex: 0 0 auto;
      }
      .entry {
        grid-template-columns: 1fr auto;
      }
      .entry time {
        grid-column: 1 / -1;
      }
      .entry .entry-body {
        grid-column: 1 / -1;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var API = 'https://announcements.univerlab.org';
      var container = document.getElementById('log-entries');
      if (!container) return;

      var isDev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      var MOCK = [
        { date: '2026-07-18T10:00:00Z', type: 'launch', title: 'New release', body: 'This release brings parallel agents with shared context and a new DAG designer in the canopy UI — drag nodes, wire outputs to inputs, and run the whole graph with one click. The designer supports conditional branches, fan-out patterns, and error recovery nodes that automatically retry failed steps with exponential backoff. You can also define subgraphs that act as reusable components, similar to functions in a programming language, which keeps complex workflows manageable as they grow.\n\nPerformance is up: cold starts dropped from 1.2s to 400ms after moving to a lighter isolate. Memory per agent went from 45MB to 28MB. The new scheduler supports priority queues, so critical agents can preempt lower-priority work when resources are tight. We benchmarked a 12-agent DAG running end-to-end in 3.4s, down from 8.1s.\n\nOn observability, every agent run now emits structured traces compatible with OpenTelemetry. Pipe them to Jaeger, Grafana Tempo, or any OTLP collector. The flight log shows trace spans inline. There is also a new /metrics endpoint with Prometheus-compatible counters for agent starts, completions, failures, and queue depth.\n\nBreaking changes: config format moved from YAML to TOML. Run `canopy migrate-config` to rewrite every file in place. Check the full changelog at https://github.com/UniverLab/harness-canopy/releases and the migration guide at https://univerlab.org/canopy/docs/migration. Open a thread at https://github.com/UniverLab/harness-canopy/discussions if you run into issues.', link: 'https://github.com/UniverLab/harness-canopy/releases/tag/v0.5.0' },
        { date: '2026-07-17T22:00:00Z', type: 'note', title: 'Dress rehearsal', body: 'Before a vehicle flies, it runs a dress rehearsal: the full countdown on the pad, tanks loaded, every system exercised in sequence, stopping just short of ignition. Nothing leaves the ground. The point is to find out what breaks while breaking it is still cheap.' },
        { date: '2026-07-17T18:00:00Z', type: 'launch', title: 'First light', body: 'Astronomers call it first light: the moment a new instrument opens its eye and returns an image. That first picture is never the best one the telescope will ever take. It is the proof that the optics align, the detector responds, the data path is open.' },
        { date: '2026-07-17T12:00:00Z', type: 'deploy', title: 'Announcements worker online', body: 'The announcements Durable Object is live. Entries serialize through SQLite, fan out over SSE, and mirror to KV for fast reads. The first transmission reached the log without incident.' },
        { date: '2026-07-17T09:00:00Z', type: 'note', title: 'Status page ships', body: 'The status page is now part of the public site. Real-time entries, infinite scroll, toast notifications for live updates, and a cosmic background that matches the mission log aesthetic.' },
        { date: '2026-07-16T20:00:00Z', type: 'bugfix', title: 'Skeleton placeholders cleared', body: 'The skeleton loading placeholders were not being removed when the first batch of entries loaded. A one-line fix clears the container before appending real entries.' }
      ];
      MOCK[0].topic = 'canopy';
      MOCK[1].topic = 'canopy';
      MOCK[2].topic = 'general';
      MOCK[3].topic = 'general';
      MOCK[4].topic = 'general';
      MOCK[5].topic = null;

      var TOPIC_DEFS = [
        { id: 'general', label: 'General' },
        { id: 'canopy', label: 'Canopy' },
        { id: 'astro-denoise', label: 'Astro-denoise' },
        { id: 'texforge', label: 'Texforge' },
        { id: 'gitkit', label: 'Gitkit' },
        { id: 'ghscaff', label: 'Ghscaff' },
        { id: 'cadspec', label: 'Cadspec' },
        { id: 'demostage', label: 'DemoStage' },
        { id: 'quorum', label: 'Quorum' }
      ];
      var topicFilters = document.getElementById('topic-filters');
      var typeFilters = document.getElementById('type-filters');
      var allEntries = [];
      var activeTopic = new URLSearchParams(location.search).get('topic') || 'all';
      var activeType = 'all';
      var TYPE_DEFS = [
        { id: 'launch', label: 'Launch' },
        { id: 'deploy', label: 'Deploy' },
        { id: 'bugfix', label: 'Bugfix' },
        { id: 'note', label: 'Note' },
        { id: 'incident', label: 'Incident' }
      ];
      var PAGE = 20;
      var offset = 0;
      var loading = false;
      var hasMore = true;

      function formatDate(iso) {
        var d = new Date(iso);
        var y = d.getFullYear();
        var start = new Date(y, 0, 0);
        var dayOfYear = Math.floor((d - start) / 86400000);
        var hh = String(d.getUTCHours()).padStart(2, '0');
        var mm = String(d.getUTCMinutes()).padStart(2, '0');
        return 'TERRA ' + y + ' \u00b7 Sol ' + dayOfYear + ' \u00b7 ' + hh + ':' + mm + ' UTC';
      }

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function linkify(text) {
        var escaped = escapeHtml(text);
        return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
          return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
        });
      }

      function normalizeEntry(entry) {
        var knownTopic = TOPIC_DEFS.some(function (topic) { return topic.id === entry.topic; });
        return Object.assign({}, entry, { topic: knownTopic ? entry.topic : 'general' });
      }

      function topicLabel(id) {
        var topic = TOPIC_DEFS.filter(function (item) { return item.id === id; })[0];
        return topic ? topic.label : 'General';
      }

      function updateTopicFilters() {
        if (!topicFilters) return;
        var counts = {};
        TOPIC_DEFS.forEach(function (topic) { counts[topic.id] = 0; });
        allEntries.forEach(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeType !== 'all' && ne.type !== activeType) return;
          counts[ne.topic]++;
        });
        var total = activeType === 'all'
          ? allEntries.length
          : allEntries.filter(function (e) { return normalizeEntry(e).type === activeType; }).length;

        topicFilters.innerHTML = '';
        [{ id: 'all', label: 'All', count: total }].concat(TOPIC_DEFS.map(function (topic) {
          return { id: topic.id, label: topic.label, count: counts[topic.id] };
        })).filter(function (t) { return t.id === 'all' || t.count > 0; }).forEach(function (topic) {
          var button = document.createElement('button');
          button.className = 'topic-filter' + (activeTopic === topic.id ? ' is-active' : '');
          button.type = 'button';
          button.dataset.topic = topic.id;
          button.setAttribute('aria-pressed', activeTopic === topic.id ? 'true' : 'false');
          button.appendChild(document.createTextNode(topic.label));

          var count = document.createElement('span');
          count.className = 'topic-filter-count';
          count.textContent = String(topic.count);
          button.appendChild(count);
          topicFilters.appendChild(button);
        });
      }

      function updateTypeFilters() {
        if (!typeFilters) return;
        var counts = {};
        TYPE_DEFS.forEach(function (t) { counts[t.id] = 0; });
        allEntries.forEach(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeTopic !== 'all' && ne.topic !== activeTopic) return;
          if (entry.type && counts[entry.type] !== undefined) counts[entry.type]++;
        });
        var total = activeTopic === 'all'
          ? allEntries.length
          : allEntries.filter(function (e) { return normalizeEntry(e).topic === activeTopic; }).length;

        typeFilters.innerHTML = '';
        [{ id: 'all', label: 'All', count: total }].concat(TYPE_DEFS.map(function (t) {
          return { id: t.id, label: t.label, count: counts[t.id] };
        })).filter(function (t) { return t.id === 'all' || t.count > 0; }).forEach(function (t) {
          var button = document.createElement('button');
          button.className = 'topic-filter' + (activeType === t.id ? ' is-active' : '');
          button.type = 'button';
          button.dataset.type = t.id;
          button.setAttribute('aria-pressed', activeType === t.id ? 'true' : 'false');
          button.appendChild(document.createTextNode(t.label));

          var count = document.createElement('span');
          count.className = 'topic-filter-count';
          count.textContent = String(t.count);
          button.appendChild(count);
          typeFilters.appendChild(button);
        });
      }

      function renderEntries() {
        container.innerHTML = '';
        var visible = allEntries.filter(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeTopic !== 'all' && ne.topic !== activeTopic) return false;
          if (activeType !== 'all' && ne.type !== activeType) return false;
          return true;
        });

        if (!visible.length) {
          var empty = document.createElement('p');
          empty.className = 'filter-empty';
          if (activeTopic !== 'all' && activeType !== 'all') {
            empty.textContent = 'No ' + activeType + ' entries under ' + topicLabel(activeTopic) + ' yet.';
          } else if (activeTopic !== 'all') {
            empty.textContent = 'No entries under ' + topicLabel(activeTopic) + ' yet.';
          } else if (activeType !== 'all') {
            empty.textContent = 'No ' + activeType + ' entries yet.';
          } else {
            empty.textContent = 'No entries yet. The log is waiting for its first transmission.';
          }
          container.appendChild(empty);
          return;
        }
        appendEntries(visible);
      }

      function renderEntry(entry) {
        var article = document.createElement('article');
        article.className = 'entry';

        var time = document.createElement('time');
        time.setAttribute('datetime', entry.date);
        time.textContent = formatDate(entry.date);
        article.appendChild(time);

        var body = document.createElement('div');
        body.className = 'entry-body';

        if (entry.type) {
          var badge = document.createElement('div');
          badge.className = 'type-badge';
          badge.textContent = entry.type;
          article.appendChild(badge);
        }

        var h3 = document.createElement('h3');
        h3.textContent = entry.title;
        body.appendChild(h3);

        var p = document.createElement('p');
        p.innerHTML = linkify(entry.body);
        body.appendChild(p);

        if (entry.link) {
          var a = document.createElement('a');
          a.className = 'entry-link';
          a.href = entry.link;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = 'View \u2192';
          body.appendChild(a);
        }

        article.appendChild(body);
        return article;
      }

      function appendEntries(entries) {
        if (!Array.isArray(entries) || !entries.length) return;
        var frag = document.createDocumentFragment();
        entries.forEach(function (e) { frag.appendChild(renderEntry(e)); });
        container.appendChild(frag);
      }

      function loadMore() {
        if (loading || !hasMore) return;
        loading = true;

        if (isDev) {
          var batch = MOCK.slice(offset, offset + PAGE);
          allEntries = allEntries.concat(batch.map(normalizeEntry));
          offset += batch.length;
          hasMore = offset < MOCK.length;
          loading = false;
          updateTopicFilters();
          updateTypeFilters();
          renderEntries();
          if (!hasMore) observer.disconnect();
          return;
        }

        fetch(API + '?offset=' + offset + '&limit=' + PAGE)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var entries = Array.isArray(data.entries) ? data.entries.map(normalizeEntry) : [];
            allEntries = allEntries.concat(entries);
            offset += entries.length;
            hasMore = data.hasMore;
            loading = false;
            updateTopicFilters();
            updateTypeFilters();
            renderEntries();
            if (!hasMore) observer.disconnect();
          })
          .catch(function () { loading = false; });
      }

      function prependEntry(entry) {
        allEntries.unshift(normalizeEntry(entry));
        offset++;
        updateTopicFilters();
        updateTypeFilters();
        renderEntries();
        showToast(entry.title);
      }

      function updateEntry(entry) {
        var updated = normalizeEntry(entry);
        var index = allEntries.findIndex(function (item) { return item.id === updated.id; });
        if (index === -1) return;
        allEntries[index] = updated;
        updateTopicFilters();
        updateTypeFilters();
        renderEntries();
      }

      function showToast(title) {
        var backdrop = document.createElement('div');
        backdrop.className = 'gl-toast-backdrop';
        document.body.appendChild(backdrop);

        var toast = document.createElement('div');
        toast.className = 'gl-toast';
        toast.innerHTML = '<button class="gl-toast-close" aria-label="Close">&times;</button><span>New entry: ' + title + '</span>';

        var dismiss = function () {
          backdrop.classList.add('gl-toast-out');
          toast.classList.add('gl-toast-out');
          setTimeout(function () { backdrop.remove(); toast.remove(); }, 300);
        };

        toast.querySelector('.gl-toast-close').addEventListener('click', dismiss);
        backdrop.addEventListener('click', dismiss);

        document.body.appendChild(toast);
        setTimeout(dismiss, 4000);
      }

      if (topicFilters) {
        topicFilters.addEventListener('click', function (event) {
          var button = event.target.closest('button[data-topic]');
          if (!button) return;
          activeTopic = button.dataset.topic || 'all';
          var nextUrl = activeTopic === 'all'
            ? location.pathname
            : location.pathname + '?topic=' + encodeURIComponent(activeTopic);
          history.replaceState(null, '', nextUrl);
          updateTypeFilters();
          updateTopicFilters();
          renderEntries();
        });
      }

      if (typeFilters) {
        typeFilters.addEventListener('click', function (event) {
          var button = event.target.closest('button[data-type]');
          if (!button) return;
          activeType = button.dataset.type || 'all';
          updateTopicFilters();
          updateTypeFilters();
          renderEntries();
        });
      }

      // Infinite scroll sentinel
      var sentinel = document.createElement('div');
      sentinel.className = 'scroll-sentinel';
      container.parentElement.appendChild(sentinel);

      var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) loadMore();
      }, { rootMargin: '200px' });
      observer.observe(sentinel);

      // Initial load
      loadMore();

      // Force announcement toast in dev mode
      if (isDev) {
        setTimeout(function () {
          var mockAnnouncement = MOCK[0];

          function escapeHtml(s) {
            return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          }
          function linkify(text) {
            var escaped = escapeHtml(text);
            return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
              return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" style="color:#d4a843;text-decoration:underline;text-underline-offset:2px">' + url + '</a>';
            });
          }

          var backdrop = document.createElement('div');
          backdrop.className = 'gl-toast-backdrop';
          document.body.appendChild(backdrop);

          var toast = document.createElement('div');
          toast.className = 'gl-toast';
          var html = '<button class="gl-toast-close" aria-label="Close">&times;</button><span>' + escapeHtml(mockAnnouncement.title) + '</span>';
          if (mockAnnouncement.body) {
            var bodyHtml = linkify(mockAnnouncement.body);
            html += '<div class="gl-toast-body"><div class="gl-toast-body-inner">' + bodyHtml + '</div><button class="gl-toast-expand" type="button">ver más</button></div>';
          }
          if (mockAnnouncement.link) {
            html += '<br><a href="' + escapeHtml(mockAnnouncement.link) + '" target="_blank" rel="noopener noreferrer" style="color:#d4a843;text-decoration:underline;text-underline-offset:2px">View &rarr;</a>';
          }
          toast.innerHTML = html;

          var expandBtn = toast.querySelector('.gl-toast-expand');
          if (expandBtn) {
            var inner = toast.querySelector('.gl-toast-body-inner');
            requestAnimationFrame(function () {
              if (inner.scrollHeight <= inner.clientHeight + 2) {
                expandBtn.style.display = 'none';
              } else {
                expandBtn.addEventListener('click', function (ev) {
                  ev.stopPropagation();
                  inner.classList.toggle('expanded');
                  expandBtn.textContent = inner.classList.contains('expanded') ? 'ver menos' : 'ver más';
                });
              }
            });
          }

          var dismiss = function () {
            backdrop.classList.add('gl-toast-out');
            toast.classList.add('gl-toast-out');
            setTimeout(function () { backdrop.remove(); toast.remove(); }, 300);
          };

          toast.querySelector('.gl-toast-close').addEventListener('click', dismiss);
          backdrop.addEventListener('click', dismiss);
          if (mockAnnouncement.link) {
            toast.style.cursor = 'pointer';
            toast.addEventListener('click', function (ev) {
              if (ev.target.tagName === 'A' || ev.target.tagName === 'BUTTON') return;
              window.open(mockAnnouncement.link, '_blank', 'noopener,noreferrer');
            });
          }

          document.body.appendChild(toast);
          setTimeout(dismiss, 8000);
        }, 1500);
      }

      // SSE
      if (!isDev) {
        var source = new EventSource(API + '/events');
        source.addEventListener('entry', function (e) {
          try {
            var entry = JSON.parse(e.data);
            prependEntry(entry);
          } catch (err) {}
        });
        source.addEventListener('update', function (e) {
          try {
            updateEntry(JSON.parse(e.data));
          } catch (err) {}
        });
        source.onerror = function () {};
      }
    })();
  </script>
</BaseLayout>
