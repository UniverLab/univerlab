---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiments } from '../lib/experiments';
import { en } from '../i18n/en';
const topicColors: Record<string, string> = Object.fromEntries(
  experiments.map((e) => [e.id, e.essenceHex]),
);
const rmStrings = en.roadmap;
---
<BaseLayout title="Mission Log — UniverLab" description="Real-time activity from UniverLab experiments." bg="cosmic" circadian>
  <section class="wrap board" id="status-board">
    <header class="board-head">
      <div class="board-titles">
        <span class="label">STATUS</span>
        <h1>Status</h1>
        <p class="intro">Real-time activity from UniverLab experiments and tools.</p>
      </div>
      <div class="board-actions">
        <a href="/feed/" class="feed-link">RSS</a>
      </div>
    </header>
    <div class="board-filters">
      <nav class="topic-index" aria-label="Board topics">
        <span class="topic-index-label">TOPICS</span>
        <div id="topic-filters" class="topic-filters"><!-- built by JS --></div>
      </nav>
      <nav class="topic-index" aria-label="Board types">
        <span class="topic-index-label">TYPES</span>
        <div id="type-filters" class="topic-filters"><!-- built by JS --></div>
      </nav>
    </div>
    <div class="board-cols">
      <section class="board-col board-roadmap" id="roadmap-section" aria-label="Roadmap" hidden>
        <div class="col-label" aria-hidden="true"><span class="label">ROADMAP</span></div>
        <div id="roadmap-clear" class="rm-clear" hidden></div>
        <p id="roadmap-notice" class="rm-notice" role="status" hidden></p>
        <div id="roadmap" class="rm-flight">
          <div class="rm-skeleton"></div>
          <div class="rm-skeleton"></div>
          <div class="rm-skeleton"></div>
        </div>
      </section>
      <section class="board-col board-log" aria-label="Mission log">
        <div class="col-label" aria-hidden="true"><span class="label">MISSION LOG</span></div>
        <div id="log-scroller" class="log-scroller" tabindex="0" aria-label="Mission log entries">
          <div id="log-entries">
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
            <article class="entry skeleton"><time></time><div class="entry-body"></div><div class="type-badge"></div></article>
          </div>
        </div>
      </section>
    </div>
  </section>

  <style is:global>
    /* Board shell — one header, one filter bar, two columns. Narrow keeps the
       stacked order (roadmap, then log) via plain document flow. */
    .wrap.board { max-width: 88rem; padding-block: 4rem 6rem; }
    .board .label { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); display: block; }
    .board-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2.5rem; margin-bottom: 2rem; }
    .board-titles { min-width: 0; }
    .board-titles .label { margin-bottom: 1.2rem; }
    .board-actions { display: flex; align-items: center; gap: 0.6rem; }
    .col-label { margin-bottom: 1.2rem; }
    .board-filters { display: flex; flex-direction: column; margin-bottom: 2.5rem; }
    .board-cols { display: flex; flex-direction: column; gap: 3rem; }
    .board-col { min-width: 0; width: 100%; max-width: 42rem; margin-inline: auto; }
    .log-scroller { min-width: 0; }
    .scroll-sentinel { display: block; min-height: 1px; }
    .feed-link { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); text-decoration: none; border: 1px solid var(--line); padding: 0.15rem 0.45rem; border-radius: 3px; transition: color 0.15s ease, border-color 0.15s ease; }
    .feed-link:hover, .feed-link:focus-visible { color: var(--ink); border-color: var(--accent); }
    .board h1 { font-family: var(--font-mono); font-size: 1.6rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); margin-bottom: 0.6rem; }
    .board .intro { color: var(--ink-dim); font-size: 0.95rem; line-height: 1.6; margin-bottom: 0; max-width: 42rem; }
    .topic-index { display: flex; align-items: baseline; gap: 1rem; padding-block: 0.5rem; }
    .topic-index + .topic-index { padding-top: 0; margin-top: -0.15rem; }
    .topic-index-label { flex: 0 0 auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; color: var(--ink-faint); }
    .topic-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .topic-filter { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.3rem 0.65rem; border: none; border-radius: 100px; background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; cursor: pointer; transition: color 0.2s ease, background 0.2s ease; }
    .topic-filter:hover, .topic-filter:focus-visible { background: color-mix(in srgb, var(--ink) 12%, transparent); color: var(--ink); }
    .topic-filter.is-active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
    .topic-filter-count { color: var(--ink-faint); font-size: 0.58rem; }
    .topic-filter.is-active .topic-filter-count, .topic-filter:hover .topic-filter-count { color: currentColor; }
    .filter-empty { padding-block: 3rem; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.82rem; text-align: center; }
    #log-entries { display: flex; flex-direction: column; }
    .entry { display: grid; grid-template-columns: 7rem 1fr auto; grid-template-rows: auto auto; gap: 0.4rem 1.2rem; padding-block: 1.8rem; border-bottom: 1px solid var(--line); align-items: start; }
    .entry time { grid-column: 1; grid-row: 1; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint); white-space: nowrap; }
    .entry .type-badge { grid-column: 3; grid-row: 1; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); padding: 0.15rem 0.5rem; border-radius: 3px; align-self: start; opacity: 0.8; }
    .entry .entry-body { grid-column: 1 / -1; grid-row: 2; }
    .entry h3 { font-family: var(--font-mono); font-size: 0.95rem; color: var(--accent); margin-bottom: 0.3rem; }
    .entry p { color: var(--ink-dim); font-size: 0.88rem; line-height: 1.65; white-space: pre-line; }
    .entry p a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
    .entry p a:hover { color: var(--ink); }
    .entry-link { display: inline-block; margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); text-decoration: none; letter-spacing: 0.05em; }
    .entry-link:hover { text-decoration: underline; color: var(--ink); }

    /* Skeleton */
    .skeleton .entry-body { height: 3rem; border-radius: 4px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; }
    .skeleton time { height: 0.8rem; border-radius: 3px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; display: block; }
    .skeleton .type-badge { height: 0.9rem; width: 3rem; border-radius: 3px; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; }
    @keyframes skeleton-pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* Empty state */
    #log-entries:empty::after { content: 'No entries yet. The log is waiting for its first transmission.'; display: block; font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-faint); padding-block: 3rem; text-align: center; }

    /* Toast — same style as the announcement toast in BaseLayout */
    .gl-toast-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 319; animation: gl-backdrop-in 0.2s ease; }
    .gl-toast {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(18, 18, 22, 0.95);
      color: #fff;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.88rem;
      padding: 0.9rem 2.4rem 0.9rem 1.4rem;
      border-radius: 8px;
      border: 1px solid #d4a843;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 30px rgba(212, 168, 67, 0.25), 0 0 60px rgba(212, 168, 67, 0.1);
      animation: gl-toast-in 0.2s ease;
      z-index: 320;
      text-align: center;
      max-width: 90vw;
      cursor: pointer;
      max-height: 80vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .gl-toast span { color: #d4a843; font-weight: 600; }
    .gl-toast-close { position: absolute; top: 0.3rem; right: 0.5rem; background: none; border: none; color: #d4a843; font-size: 1.2rem; cursor: pointer; line-height: 1; padding: 0 0.2rem; opacity: 0.7; }
    .gl-toast-close:hover { opacity: 1; }
    .gl-toast.gl-toast-out { animation: gl-toast-out 0.3s ease forwards; }
    .gl-toast-backdrop.gl-toast-out { animation: gl-backdrop-out 0.3s ease forwards; }
    .gl-toast-body { margin-top: 0.5rem; text-align: left; overflow: hidden; flex: 1; display: flex; flex-direction: column; }
    .gl-toast-body-inner { color: #ccc; font-size: 0.82rem; line-height: 1.5; max-height: 4.5em; overflow: hidden; transition: max-height 0.3s ease; white-space: pre-line; }
    .gl-toast-body-inner.expanded { max-height: none; overflow-y: auto; }
    .gl-toast-expand { background: none; border: 0; color: #d4a843; font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; cursor: pointer; padding: 0.3rem 0 0; text-align: left; opacity: 0.8; }
    .gl-toast-expand:hover { opacity: 1; text-decoration: underline; }
    @keyframes gl-toast-in { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    @keyframes gl-toast-out { from { opacity: 1; } to { opacity: 0; transform: scale(0.95); } }
    @keyframes gl-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes gl-backdrop-out { from { opacity: 1; } to { opacity: 0; } }

    /* Scroll-driven fade-in (progressive enhancement) */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .entry { animation: entry-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
        @keyframes entry-rise { from { opacity: 0.1; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
      }
    }
    .rm-notice { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); padding: 0.4rem 0.6rem; border-radius: 3px; margin-bottom: 1rem; }
    .rm-clear { margin-bottom: 1rem; }
    .rm-clear-btn { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.3rem 0.65rem; border: none; border-radius: 100px; background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; cursor: pointer; }
    .rm-clear-btn:hover, .rm-clear-btn:focus-visible { background: color-mix(in srgb, var(--accent) 25%, transparent); color: var(--ink); }

    /* Flight plan — one continuous rail in the left gutter; each segment
       tints it. Content is padded so the rail never causes overflow. */
    #roadmap.rm-flight { position: relative; padding-left: 1.6rem; }
    #roadmap.rm-flight::before { content: ''; position: absolute; left: 0.45rem; top: 0.4rem; bottom: 0.4rem; width: 2px; background: color-mix(in srgb, var(--ink) 18%, transparent); border-radius: 2px; }
    .rm-seg { position: relative; padding-block: 0.4rem 1.1rem; }
    .rm-seg-label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); display: flex; gap: 0.5rem; margin-block: 0.9rem 0.7rem; align-items: baseline; line-height: 1; }
    .rm-seg[data-lane="now"] .rm-seg-label { color: var(--accent); }
    .rm-seg[data-lane="idea"] .rm-seg-label { font-style: italic; }
    .rm-count { color: var(--ink-faint); font-size: 0.58rem; }
    .rm-card { position: relative; padding-block: 0.55rem; }
    .rm-dot { position: absolute; left: -1.6rem; top: 0.85rem; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--dot, var(--accent)); transform: translateX(0.1rem); border: 2px solid var(--surface, #fff); box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 18%, transparent); }
    .rm-seg[data-lane="now"] .rm-dot { box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 60%, transparent), 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent); }
    .rm-seg[data-lane="next"] .rm-dot { opacity: 0.9; }
    .rm-seg[data-lane="later"] .rm-dot { opacity: 0.65; }
    .rm-seg[data-lane="idea"] .rm-dot { opacity: 0.5; background: transparent; border: 2px dashed var(--dot, var(--ink-faint)); box-shadow: none; width: 0.6rem; height: 0.6rem; }
    .rm-seg[data-lane="done"] .rm-dot { opacity: 0.55; }
    .rm-card-body { min-width: 0; }
    .rm-title { font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--ink); line-height: 1.35; }
    .rm-seg[data-lane="done"] .rm-title { color: var(--ink-dim); font-weight: 500; }
    .rm-summary { color: var(--ink-dim); font-size: 0.88rem; line-height: 1.65; margin-top: 0.25rem; max-width: 36rem; }
    .rm-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.7rem; margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-faint); }
    .rm-chip { border: 1px solid color-mix(in srgb, var(--chip, var(--accent)) 45%, transparent); background: color-mix(in srgb, var(--chip, var(--accent)) 12%, transparent); color: var(--chip, var(--accent)); padding: 0.12rem 0.5rem; font-size: 0.58rem; border-radius: 100px; cursor: pointer; font-family: var(--font-mono); letter-spacing: 0.04em; }
    .rm-chip:hover, .rm-chip:focus-visible { color: var(--ink); border-color: var(--accent); }
    .rm-chip.is-active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
    .rm-entries { background: none; border: 0; padding: 0; color: var(--accent); font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; opacity: 0.9; }
    .rm-entries:hover, .rm-entries:focus-visible { color: var(--ink); opacity: 1; }
    .rm-entries.is-active { color: var(--ink); font-weight: 600; }
    .rm-landed { color: var(--ink-faint); }
    .rm-hold { margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.5; color: color-mix(in srgb, #b45309 80%, var(--ink) 20%); background: color-mix(in srgb, #b45309 10%, transparent); border: 1px solid color-mix(in srgb, #b45309 35%, transparent); border-radius: 3px; padding: 0.25rem 0.5rem; max-width: 36rem; }
    .rm-more { background: none; border: 0; color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer; padding: 0.3rem 0 0 0; opacity: 0.8; }
    .rm-more:hover { opacity: 1; text-decoration: underline; }
    .rm-skeleton { height: 0.9rem; border-radius: 3px; margin-block: 0.6rem; background: linear-gradient(90deg, var(--line) 25%, transparent 50%, var(--line) 75%); background-size: 200% 100%; animation: skeleton-pulse 1.8s ease-in-out infinite; }

    /* Topic filter dims log rows instead of removing them — the roadmap lanes
       hard-filter instead, so the two columns read as one board. */
    .entry.is-dimmed > time,
    .entry.is-dimmed > .entry-body,
    .entry.is-dimmed > .type-badge { opacity: 0.35; }

    /* Wide split: roadmap and mission log side by side, each its own scroll
       context. Below the breakpoint this whole block is inert — narrow keeps
       the stacked order and page scroll. */
    @media (min-width: 78rem) {
      .board-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
      .board-col { max-width: 100%; margin-inline: 0; }
      .board-roadmap #roadmap,
      .board-log .log-scroller { max-height: calc(100dvh - 26rem); min-height: 24rem; overflow-y: auto; overscroll-behavior: contain; }
      /* Quiet scroll: the two wide-split scrollers only. Page tokens via
         color-mix, no new colours, no arrow buttons; the lower edge dissolves
         instead of cutting a hard line. Inert below the breakpoint. */
      .board-roadmap #roadmap,
      .board-log .log-scroller {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--ink-faint) 45%, transparent) transparent;
        mask-image: linear-gradient(to bottom, #000 calc(100% - 1.2rem), transparent);
      }
      .board-roadmap #roadmap::-webkit-scrollbar,
      .board-log .log-scroller::-webkit-scrollbar { width: 6px; }
      .board-roadmap #roadmap::-webkit-scrollbar-track,
      .board-log .log-scroller::-webkit-scrollbar-track { background: transparent; }
      .board-roadmap #roadmap::-webkit-scrollbar-thumb,
      .board-log .log-scroller::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--ink-faint) 45%, transparent); border-radius: 999px; }
      .board-roadmap #roadmap::-webkit-scrollbar-thumb:hover,
      .board-log .log-scroller::-webkit-scrollbar-thumb:hover { background: var(--ink-faint); }
      .board-roadmap #roadmap::-webkit-scrollbar-button,
      .board-log .log-scroller::-webkit-scrollbar-button { display: none; }
    }
    /* Mobile overrides last: media queries add no specificity, so these must
       follow the base `.rm-dot` / `#roadmap.rm-flight` rules above or they are
       silently overridden. */
    @media (max-width: 640px) {
      .topic-index { align-items: flex-start; flex-direction: column; gap: 0.6rem; }
      .topic-filters { flex-wrap: wrap; max-width: 100%; }
      .topic-filter { flex: 0 0 auto; }
      .entry { grid-template-columns: 1fr auto; }
      .entry time { grid-column: 1 / -1; }
      .entry .entry-body { grid-column: 1 / -1; }
      #roadmap.rm-flight { padding-left: 1.4rem; overflow-x: clip; }
      #roadmap.rm-flight::before { left: 0.3rem; }
      .rm-dot { left: -1.5rem; }
      .rm-summary { overflow-wrap: anywhere; }
    }
  </style>

  <script is:inline define:vars={{ topicColors, rmStrings }}>
    (function () {
      var API = 'https://announcements.univerlab.org';
      var TOPIC_COLORS = topicColors;
      var RM_STR = rmStrings || {};
      var container = document.getElementById('log-entries');
      if (!container) return;
      var logScroller = document.getElementById('log-scroller') || container.parentElement;
      var sentinel = null;

      // The sentinel must stay the last child of the log scroll container or
      // infinite scroll stops firing once rows are re-rendered above it.
      function placeSentinel() {
        if (!sentinel || !logScroller) return;
        if (sentinel.parentNode !== logScroller || logScroller.lastElementChild !== sentinel) {
          logScroller.appendChild(sentinel);
        }
      }

      var isDev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      var MOCK = [
        { date: '2026-07-18T10:00:00Z', type: 'launch', title: 'New release', body: 'This release brings parallel agents with shared context and a new DAG designer in the canopy UI — drag nodes, wire outputs to inputs, and run the whole graph with one click. The designer supports conditional branches, fan-out patterns, and error recovery nodes that automatically retry failed steps with exponential backoff. You can also define subgraphs that act as reusable components, similar to functions in a programming language, which keeps complex workflows manageable as they grow.\n\nPerformance is up: cold starts dropped from 1.2s to 400ms after moving to a lighter isolate. Memory per agent went from 45MB to 28MB. The new scheduler supports priority queues, so critical agents can preempt lower-priority work when resources are tight. We benchmarked a 12-agent DAG running end-to-end in 3.4s, down from 8.1s.\n\nOn observability, every agent run now emits structured traces compatible with OpenTelemetry. Pipe them to Jaeger, Grafana Tempo, or any OTLP collector. The flight log shows trace spans inline. There is also a new /metrics endpoint with Prometheus-compatible counters for agent starts, completions, failures, and queue depth.\n\nBreaking changes: config format moved from YAML to TOML. Run `canopy migrate-config` to rewrite every file in place. Check the full changelog at https://github.com/UniverLab/harness-canopy/releases and the migration guide at https://univerlab.org/canopy/docs/migration. Open a thread at https://github.com/UniverLab/harness-canopy/discussions if you run into issues.', link: 'https://github.com/UniverLab/harness-canopy/releases/tag/v0.5.0' },
        { date: '2026-07-17T22:00:00Z', type: 'note', title: 'Dress rehearsal', body: 'Before a vehicle flies, it runs a dress rehearsal: the full countdown on the pad, tanks loaded, every system exercised in sequence, stopping just short of ignition. Nothing leaves the ground. The point is to find out what breaks while breaking it is still cheap.' },
        { date: '2026-07-17T18:00:00Z', type: 'launch', title: 'First light', body: 'Astronomers call it first light: the moment a new instrument opens its eye and returns an image. That first picture is never the best one the telescope will ever take. It is the proof that the optics align, the detector responds, the data path is open.' },
        { date: '2026-07-17T12:00:00Z', type: 'deploy', title: 'Announcements worker online', body: 'The announcements Durable Object is live. Entries serialize through SQLite, fan out over SSE, and mirror to KV for fast reads. The first transmission reached the log without incident.' },
        { date: '2026-07-17T09:00:00Z', type: 'note', title: 'Status page ships', body: 'The status page is now part of the public site. Real-time entries, infinite scroll, toast notifications for live updates, and a cosmic background that matches the mission log aesthetic.' },
        { date: '2026-07-16T20:00:00Z', type: 'bugfix', title: 'Skeleton placeholders cleared', body: 'The skeleton loading placeholders were not being removed when the first batch of entries loaded. A one-line fix clears the container before appending real entries.' }
      ];
      MOCK[0].topic = 'canopy';
      MOCK[0].roadmap_id = 'rm-now-1';
      MOCK[1].topic = 'canopy';
      MOCK[1].roadmap_id = 'rm-now-1';
      MOCK[2].topic = 'general';
      MOCK[2].roadmap_id = null;
      MOCK[3].topic = 'general';
      MOCK[4].topic = 'general';
      MOCK[5].topic = null;

      var MOCK_ROADMAP = [
        { id: 'rm-now-1', title: 'Ship SSE reconcile', state: 'now', topic: 'canopy', essence_hex: '#5dd39e', blocked_reason: null, pos: 0, archived_at: null, updatedAt: '2026-09-20T10:00:00Z', summary: 'Live entries reconcile over SSE so the log never shows a stale gap.', entries: { count: 2, last_date: '2026-07-18T10:00:00Z', last_id: 'm1' }, shipped_at: null },
