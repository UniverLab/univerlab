        allEntries.forEach(function (entry) {
          var ne = normalizeEntry(entry);
          if (activeType !== 'all' && ne.type !== activeType) return;
          counts[ne.topic]++;
        });
        var total = activeType === 'all'
          ? allEntries.length
          : allEntries.filter(function (e) { return normalizeEntry(e).type === activeType; }).length;

        topicFilters.innerHTML = '';
        [{ id: 'all', label: 'All', count: total }].concat(TOPIC_DEFS.map(function (topic) {
          return { id: topic.id, label: topic.label, count: counts[topic.id] };
        })).filter(function (t) { return t.id === 'all' || t.count > 0; }).forEach(function (topic) {
          var button = document.createElement('button');
