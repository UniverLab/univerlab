---
import { resolve } from 'node:path';
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { experiments } from '../../../lib/experiments';
import { DOCS_BASES } from '../../../data/docs-bases';

export async function getStaticPaths() {
  const ids = experiments.filter((e) => e.hasDocs).map((e) => e.id);
  const paths = [];
  for (const id of ids) {
    const entries = await getCollection(`docs-${id}` as any);
    const sorted = entries.sort((a: any, b: any) => a.data.order - b.data.order);
    const links = sorted.map((e: any) => ({
      slug: e.id === 'index' ? '' : e.id,
      title: e.data.title ?? e.id,
    }));
    for (const entry of sorted as any[]) {
      const slug = entry.id === 'index' ? undefined : entry.id;
      // Rebuilt from the collection base + the entry id rather than taken from
      // `entry.filePath`: this is the exact absolute path the markdown
      // plugin sees as its `ctx.fileURL`, so both date call sites resolve to
      // the same string, hit the same memo, and cannot disagree (see
      // src/lib/doc-last-modified.ts).
      const sourceFile = resolve(process.cwd(), DOCS_BASES[id], `${entry.id}.md`);
      paths.push({
        params: { id, slug },
        props: { id, entry, links, current: entry.id === 'index' ? '' : entry.id, sourceFile },
      });
    }
  }
  return paths;
}

const { id, entry, links, current, sourceFile } = Astro.props as any;
const { Content } = await render(entry);
---
<DocsLayout
  id={id}
  title={entry.data.title ?? entry.id}
  description={entry.data.description}
  links={links}
  current={current}
  sourceFile={sourceFile}
>
  <Content />
</DocsLayout>
