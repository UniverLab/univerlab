---
import BaseLayout from '../layouts/BaseLayout.astro';
import Postcard from '../components/Postcard.astro';
import { useTranslations } from '../i18n';
import { archivedExperiments } from '../lib/experiments';
const t = useTranslations('en');
const s = t.secret;
const a = s.archive;
const copyOf = (id: string) =>
  (a as unknown as Record<string, Record<string, string>>)[id] ?? {};
const monthYear = (d?: string) =>
  d ? new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---
<BaseLayout
  title="The Archive — abandoned UniverLab ideas, recorded"
  description={s.description}
  circadian
>
  <section class="wrap opening">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">{s.kicker}</span>
        <h1>{s.title}</h1>
        <p class="intro">{s.intro}</p>
      </div>
      <Postcard page="archive" alt={t.postcards.archive} />
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap built">
    <h2 class="built-heading label">{a.heading}</h2>
    {archivedExperiments.map((exp) => {
      const c = copyOf(exp.id);
      return (
        <article class="built-entry" id={exp.number.toLowerCase()} style={`--essence: ${exp.essenceHex}`}>
          <div class="b-head">
            <span class="b-num mono">{exp.number}</span>
            <h3 class="b-name">{exp.name}</h3>
          </div>
          <p class="b-meta mono">
            {monthYear(exp.startDate)} – {monthYear(exp.endDate)} · {a.wasBeta}
          </p>
          <dl class="t-dl">
            <dt class="t-dt label">{a.labels.built}</dt>
            <dd class="t-dd" set:html={c.built} />
            <dt class="t-dt label">{a.labels.learned}</dt>
            <dd class="t-dd" set:html={c.learned} />
            <dt class="t-dt label">{a.labels.closed}</dt>
            <dd class="t-dd" set:html={c.closed} />
            <dt class="t-dt label">{a.labels.instead}</dt>
            <dd class="t-dd" set:html={c.instead} />
            <dt class="t-dt label">{a.repo}</dt>
            <dd class="t-dd"><a class="b-repo mono" href={exp.github} target="_blank" rel="noopener noreferrer">{exp.github.replace('https://', '')}</a></dd>
          </dl>
        </article>
      );
    })}
  </section>

  <hr class="rule" />

  <section class="wrap ideas">
    <h2 class="built-heading label">{a.neverHeading}</h2>
    {s.ideas.map((idea, i) => (
      <article class="tombstone">
        <div class="t-num mono">{String(i + 1).padStart(2, '0')}</div>
        <div class="t-body">
          <h2 class="t-name">{idea.name}</h2>
          <dl class="t-dl">
            <dt class="t-dt label">{s.what}</dt>
            <dd class="t-dd">{idea.what}</dd>
            <dt class="t-dt label">{s.why}</dt>
            <dd class="t-dd t-why">{idea.why}</dd>
          </dl>
        </div>
      </article>
    ))}
  </section>

  <hr class="rule" />

  <section class="wrap epitaph-section">
    <p class="epitaph">{s.epitaph}</p>
  </section>
</BaseLayout>

<style>
  .opening { padding-block: 4rem 2.5rem; display: flex; flex-direction: column; gap: 0.8rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .intro { max-width: 46rem; color: var(--ink-dim); font-size: 1rem; line-height: 1.7; margin: 0; }

  .ideas { padding-block: 2.5rem; display: flex; flex-direction: column; }
  .tombstone {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 1.2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .tombstone:first-child { border-top: 1px solid var(--line); }

  .t-num { color: var(--ink-faint); font-size: 0.78rem; padding-top: 0.22rem; }
  .t-name { font-family: var(--font-serif); font-style: italic; font-size: 1.18rem; font-weight: 500; margin: 0 0 1rem; color: var(--ink); }

  .t-dl { margin: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .t-dt { display: block; color: var(--ink-faint); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.2rem; }
  .t-dd { margin: 0; color: var(--ink-dim); font-size: 0.95rem; line-height: 1.65; max-width: 46rem; }
  .t-why { color: var(--ink-faint); }

  /* Built and archived: the essence colour is mixed mostly back to grey, so a
     discontinued experiment reads as closed rather than active. */
  .built { padding-block: 2.5rem 1rem; display: flex; flex-direction: column; }
  .built-heading { margin: 0 0 1.2rem; color: var(--ink-faint); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; }
  .built-entry {
    display: grid; gap: 0.9rem;
    padding: 1.8rem 0 1.8rem 1.4rem;
    border-left: 2px solid color-mix(in srgb, var(--essence) 28%, var(--ink-faint));
    margin-bottom: 1.5rem;
  }
  .b-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .b-num { color: var(--ink-faint); font-size: 0.78rem; }
  .b-name { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: 1.18rem; font-weight: 500; color: var(--ink-dim); }
  .b-meta { margin: 0; color: var(--ink-faint); font-size: 0.74rem; letter-spacing: 0.04em; }
  .b-repo { color: var(--ink-dim); font-size: 0.8rem; text-decoration-color: var(--ink-faint); }
  .built-entry .t-dl { margin-top: 0.2rem; }
  .built-entry .t-dd :global(code) { font-family: var(--font-mono); font-size: 0.88em; }

  .epitaph-section { padding-block: 2.5rem 5rem; }
  .epitaph {
    font-family: var(--font-serif); font-style: italic;
    font-size: 1.05rem; color: var(--ink-faint);
    max-width: 38rem; line-height: 1.65;
    border-left: 1px solid var(--ink-faint);
    padding-left: 1.3rem;
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tombstone {
        animation: step-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 26%;
      }
    }
  }
  @keyframes step-rise {
    from { opacity: 0.1; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }
</style>
