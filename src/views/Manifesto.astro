<script>
  // §3 rail: one observer marks the current link (8 targets).
  (function () {
    const rail = document.querySelector<HTMLElement>('.rail');
    if (!rail) return;
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));

    const set = (id: string | null) => {
      for (const a of links) {
        const on = id !== null && a.getAttribute('href') === `#${id}`;
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        a.classList.toggle('rail-current', on);
      }
    };

    // The band across the middle of the viewport: the section crossing it is
    // "current". Ratios accumulate so the marker only moves when a section
    // really enters the band — it never flickers to empty between sections.
    const ratios = new Map<Element, number>();
    const observer = new IntersectionObserver((entries) => {
      for (const e of entries) ratios.set(e.target, e.isIntersecting ? e.intersectionRatio : 0);
      let best: Element | null = null;
      let bestRatio = 0;
      for (const [el, r] of ratios) {
        if (r > bestRatio) { bestRatio = r; best = el; }
      }
      if (best) set((best as HTMLElement).id);
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.1, 0.5, 1] });

    document.querySelectorAll<HTMLElement>(
      '[id="perspective"],[id="dissipative"],[id="the-other"],[id="heuristics"],' +
      '[id="partial-success"],[id="provenance"],[id="practice"],[id="observatory"]',
    ).forEach((s) => observer.observe(s));
  })();
</script>
