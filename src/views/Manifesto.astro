---
import BaseLayout from '../layouts/BaseLayout.astro';
import AttackMap from '../components/AttackMap.astro';
import { getLang, useTranslations } from '../i18n';
import { series, toSvgCoords, toSvgPoints, SVG_W, SVG_H, SVG_LPAD, SVG_TPAD, SVG_RPAD, SVG_BPAD } from '../data/observatory';
import { startSolLabel } from '../lib/mission-time';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const m = t.manifesto;
const f = t.fundamentos;
const c = t.cosmos;
const obs = t.observatory;
// Living-document header (§4). `docVersion`/`docDate` are facts in the dict;
// the TERRA year and the Sol are derived from `docDate` so a date bump
// auto-updates both — nothing here is hand-typed.
const docYear = new Date(m.docDate + 'T00:00:00').getFullYear();
const docSol = startSolLabel(m.docDate);
const docHeader = `${m.docStatus} · v${m.docVersion} · TERRA ${docYear} · ${docSol}`;
// Section rail canonical order (§3). Numerals are generated by `roman()` below,
// never stored in the dictionary; this array is the order the rail lists and the
// order the section-order test asserts against.
const railSections = [
  { id: 'what-we-value', label: m.purposeTitle },
  { id: 'perspective', label: c.kicker },
  { id: 'million-year-test', label: m.millionYearTestTitle },
  { id: 'transition', label: m.transitionTitle },
  { id: 'imperatives', label: m.imperativesTitle },
  { id: 'pillars', label: m.pillarsTitle },
  { id: 'what-changes', label: m.pathTitle },
  { id: 'attack', label: f.label },
  { id: 'in-development', label: m.worksTitle },
  { id: 'observatory', label: obs.kicker },
] as const;
const roman = (n: number): string => {
  const d = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
  return d[n] ?? String(n);
};
---
<BaseLayout title={m.metaTitle} description={m.description} bg="cosmic" circadian>
  <section class="wrap opening">
    <span class="label">{m.kicker}</span>
    <h1>{m.title}</h1>
    <p class="sub label">{m.sub}</p>
    <!-- Living-document header. Mono voice, --ink-faint. Version, TERRA year and
         Sol are computed from m.docDate in the frontmatter; only `docStatus` is
         localised. NOT aria-hidden: build-md's stripAriaHidden would delete the
         line from the markdown twin, which §5 requires it to keep. -->
    <p class="doc-header"><time datetime={m.docDate} data-mission>{docHeader}</time></p>
    <blockquote class="prose">{m.epigraph}</blockquote>
  </section>

  <!-- §3 Section rail. <nav> is deliberate: build-md strips <nav> from the
       markdown twin, so the labels never duplicate the section headings
       the twin already carries. aria-label reuses m.kicker — no new dictionary
       key. Numerals come from roman() in the frontmatter. -->
  <nav class="rail" aria-label={m.kicker}>
    <ol>
      {railSections.map((s, i) => (
        <li>
          <a href={`#${s.id}`}>
            <span class="rail-num">{roman(i + 1)}</span>
            <span class="rail-label">{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <hr class="rule" />

  <section id="what-we-value" class="wrap section purpose-section">
    <h2 class="label">{m.purposeTitle}</h2>
    <p class="purpose-body">{m.purposeBody}</p>
    <ol class="purpose-list">
      {m.purpose.map((p) => <li>{p}</li>)}
    </ol>
  </section>

  <!-- The cosmic perspective, placed after the manifesto's first argument. One
       inline SVG, two acts, driven by native scroll: Act I is deep time — a
       single linear line anchored at "now" that zooms from the age of the
       universe down to a human life and collapses into a glowing point. Act II
       is the cosmic address — that point at the centre, horizons shrinking in
       true ratio from Earth out to the observable universe, then a coda where
       the point reappears and asks what all of it is. Reduced motion / no JS
       show the same SVG as a static poster. -->
  <section id="perspective" class="cosmos-section">
    <div class="wrap cosmos-head">
      <h2 class="label">{c.kicker}</h2>
    </div>
    <div
      class="cosmos-scrolly"
      data-cosmos
      data-cosmos-data={JSON.stringify({
        spans: c.timescalesSpans,
        addr: c.addressSpans,
        times: c.timescales,
        places: c.address,
      })}
    >
      <div class="cosmos-sticky">
          <svg class="cosmos-svg" viewBox="0 0 1000 1000" role="img" aria-labelledby="cosmos-caption">
            <!-- Act I: deep time -->
            <g class="act-time">
              <text class="scene-title" x="500" y="80" text-anchor="middle">{c.timelineTitle}</text>
              <g class="tl-dyn">
                <line class="tl-line" x1="100" y1="500" x2="900" y2="500" />
                <line class="tl-prev" x1="100" y1="482" x2="900" y2="482" opacity="0" />
                <line class="tl-tick" x1="900" y1="490" x2="900" y2="510" />
              </g>
              <text class="tl-span" x="500" y="455" text-anchor="middle">{c.timescales[0][0]}</text>
              <text class="tl-name" x="500" y="545" text-anchor="middle">{c.timescales[0][1]}</text>
              <text class="tl-factor" x="885" y="478" text-anchor="end"></text>
            </g>

            <!-- The dot (shared: Act I end -> Act II start -> coda) -->
            <circle class="dot" cx="900" cy="500" r="7" opacity="0" />
            <text class="dot-you" x="890" y="462" text-anchor="end" opacity="0">{c.you}</text>
            <text class="dot-detail" x="890" y="552" text-anchor="end" opacity="0">{c.youDetail}</text>
            <text class="dot-us" x="500" y="462" text-anchor="middle" opacity="0">{c.us}</text>

            <!-- Act II: cosmic address -->
            <g class="act-space" opacity="0">
              <text class="scene-title" x="60" y="66" text-anchor="start">{c.addressTitle}</text>
              <text class="scene-sub" x="60" y="108" text-anchor="start">{c.addressIntro}</text>
              {c.address.map(([_name, scale], i) => {
                const r = (i + 1) * (400 / c.address.length);
                return (
                  <g key={i}>
                    <circle class="ring" cx="500" cy="500" r={r} opacity="0" />
                    <text class="ring-scale" x="500" y={500 - r - 12} text-anchor="middle" opacity="0">{scale}</text>
                  </g>
                );
              })}
              <line class="dim" x1="400" y1="500" x2="600" y2="500" opacity="0" />
              <text class="dim-ratio" x="500" y="535" text-anchor="middle" opacity="0"></text>
            </g>

            <!-- Address stack (script-owned positions) -->
            <text class="addr-item" data-age="0" x="60" y="160" text-anchor="start" opacity="0">{c.us}</text>
            {c.address.map(([name], i) => (
              <text class="addr-item" data-age={i + 1} x="60" y={160 + (i + 1) * 48} text-anchor="start" opacity="0">{name}</text>
            ))}

            <!-- Coda -->
            <text class="coda" x="500" y="560" text-anchor="middle" opacity="0">{c.coda}</text>
          </svg>

          <!-- Static poster: shown by default and under reduced motion / no JS.
               The live SVG replaces it when data-cosmos-ready is set. -->
          <svg class="cosmos-poster" viewBox="0 0 1000 1000" role="img" aria-labelledby="cosmos-caption">
            {/* Act I — linear deep-time line, right end = "now" */}
            <text class="scene-title" x="500" y="120" text-anchor="middle">{c.timelineTitle}</text>
            <line class="tl-line" x1="100" y1="300" x2="900" y2="300" />
            {c.timescales.map(([_span, _name], i) => {
              const x = 900 - 800 * (c.timescalesSpans[i] / c.timescalesSpans[0]);
              const tall = i === c.timescales.length - 1 ? 24 : 16;
              return <line key={i} class="tl-tick" x1={x} y1={300 - tall} x2={x} y2={300} />;
            })}
            <circle class="dot" cx="900" cy="300" r="8" />
            {c.timescales.map(([span], i) => {
              const positions: [number, number, string][] = [
                [105, 346, 'start'],
                [633, 252, 'end'],
                [649, 386, 'end'],
                [690, 214, 'end'],
                [884, 346, 'end'],
                [884, 386, 'end'],
              ];
              // The table is hand-tuned for the six steps. A seventh span has
              // no row, so it falls back to its own tick instead of reading
              // `positions[i][0]` of `undefined` and failing the build.
              const tick = c.timescalesSpans[i] ?? 0;
              const px = positions[i]?.[0] ?? (tick > 0 ? 900 - 800 * (tick / c.timescalesSpans[0]) : 900);
              const py = positions[i]?.[1] ?? (i % 2 === 0 ? 346 : 386);
              const anchor = positions[i]?.[2] ?? 'end';
              return <text key={i} class="poster-tl-span" x={px} y={py} text-anchor={anchor as 'start' | 'end' | 'middle'}>{span}</text>;
            })}
            <text class="dot-you" x="884" y="252" text-anchor="end">{c.you}</text>
            <text class="dot-detail" x="884" y="430" text-anchor="end">{c.youDetail}</text>

            {/* Act II — nested horizons (schematic radius) with a legible legend
                beside them; the scale strings carry the true proportions. */}
            <text class="scene-title" x="500" y="492" text-anchor="middle">{c.addressTitle}</text>
            <text class="scene-sub" x="500" y="530" text-anchor="middle">{c.addressIntro}</text>
            {c.address.map(([_name, _scale], i) => (
              <circle key={i} class="ring" cx="260" cy="755" r={(i + 1) * (160 / c.address.length)} />
            ))}
            <text class="poster-addr-us" x="450" y="600" text-anchor="start">{c.us}</text>
            {c.address.map(([name, scale], i) => (
              <text key={i} class="poster-addr" x="450" y={646 + i * 44} text-anchor="start">{name}<tspan class="poster-addr-scale"> — {scale}</tspan></text>
            ))}
            <text class="coda" x="500" y="985" text-anchor="middle">{c.coda}</text>
          </svg>

        <p id="cosmos-caption" class="visually-hidden">{c.caption}</p>
        <div class="visually-hidden">
          <ol>
            {c.timescales.map(([span, name]) => <li>{span} — {name}</li>)}
          </ol>
          <dl>
            {c.address.map(([name, scale]) => <> <dt>{name}</dt><dd>{scale}</dd> </>)}
          </dl>
          <p>{c.coda}</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- §III The million-year test. Question = the page's serif-italic pull voice
       (blockquote.prose); answer = body prose; closing line = the mono label
       voice. Desktop: SVG beside the text (right column); mobile: SVG above the
       text (CSS `order`). Static, no animation. -->
  <section id="million-year-test" class="wrap section mtt-section">
    <h2 class="label">{m.millionYearTestTitle}</h2>
    <div class="mtt-grid">
      <div class="mtt-text">
        <blockquote class="prose mtt-question">{m.millionYearTestQuestion}</blockquote>
        <p class="mtt-answer">{m.millionYearTestAnswer}</p>
        <p class="label mtt-closing">{m.millionYearTestClosing}</p>
      </div>
      <svg class="mtt-illustration" viewBox="0 0 240 280" aria-hidden="true" focusable="false">
        <!-- Tree (loss): one dashed --ink-faint outline, no fill; its branch tips
             seed the forest. Forest (continuity): 28 --accent points, fill only. -->
        <path class="mtt-tree" fill="none" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="2 2" vector-effect="non-scaling-stroke" d="M120,240 L120,150 C120,150 95,125 80,115 C65,105 55,95 55,80 M120,150 C120,150 145,125 160,115 C175,105 185,95 185,80 M120,170 L95,135 L75,110 M120,170 L145,135 L165,110 M120,185 L105,150 L90,125 M120,185 L135,150 L150,125" />
        <g class="mtt-forest" fill="var(--accent)">
          <circle cx="55" cy="80" r="1.3" /><circle cx="62" cy="73" r="1.3" /><circle cx="68" cy="66" r="1.3" /><circle cx="74" cy="62" r="1.3" />
          <circle cx="80" cy="60" r="1.3" /><circle cx="86" cy="58" r="1.3" /><circle cx="92" cy="56" r="1.3" /><circle cx="98" cy="58" r="1.3" />
          <circle cx="104" cy="62" r="1.3" /><circle cx="110" cy="68" r="1.3" /><circle cx="116" cy="76" r="1.3" /><circle cx="122" cy="84" r="1.3" />
          <circle cx="128" cy="92" r="1.3" /><circle cx="134" cy="100" r="1.3" /><circle cx="140" cy="108" r="1.3" /><circle cx="146" cy="76" r="1.3" />
          <circle cx="152" cy="68" r="1.3" /><circle cx="158" cy="62" r="1.3" /><circle cx="164" cy="60" r="1.3" /><circle cx="170" cy="58" r="1.3" />
          <circle cx="176" cy="60" r="1.3" /><circle cx="182" cy="66" r="1.3" /><circle cx="188" cy="74" r="1.3" /><circle cx="194" cy="82" r="1.3" />
          <circle cx="200" cy="90" r="1.3" /><circle cx="120" cy="120" r="1.3" /><circle cx="100" cy="128" r="1.3" /><circle cx="140" cy="128" r="1.3" />
        </g>
      </svg>
    </div>
  </section>

  <hr class="rule" />

  <!-- §IV The transition that matters. Body prose at the "What we value"
       measure (52rem, same as .purpose-section). -->
  <section id="transition" class="wrap section transition-section">
    <h2 class="label">{m.transitionTitle}</h2>
    <p class="transition-body">{m.transitionBody}</p>
  </section>

  <hr class="rule" />

  <section id="imperatives" class="wrap section imperatives-section">
    <h2 class="label">{m.imperativesTitle}</h2>
    <ol class="imperatives">
      {m.imperatives.map(([name, body]) => (
        <li>
          <span class="mono imp-name">{name}</span>
          <blockquote class="prose">{body}</blockquote>
        </li>
      ))}
    </ol>
    <p class="imp-note">{m.imperativesNote}</p>
  </section>

  <hr class="rule" />

  <section id="pillars" class="wrap section">
    <h2 class="label">{m.pillarsTitle}</h2>
    <ol class="pillars">
      {m.pillars.map(([name, body], i) => (
        <li>
          <span class="mono p-num">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{name}</h3><p>{body}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <hr class="rule" />

  <section id="what-changes" class="wrap section">
    <h2 class="label">{m.pathTitle}</h2>
    <ul class="path">
      {m.path.map(([from, to]) => (
        <li><span class="from">{from}</span><span class="arrow">→</span><span class="to">{to}</span></li>
      ))}
    </ul>
  </section>

  <hr class="rule" />

  <AttackMap />

  <hr class="rule" />

  <section id="in-development" class="wrap section works-section">
    <h2 class="label">{m.worksTitle}</h2>
    <p class="works-body">{m.worksBody}</p>
    <ul class="works">
      {m.works.map(([name, desc], i) => (
        <li>
          <span class="badge label">{m.worksBadge}</span>
          <h3>{name}</h3>
          <p>{desc}</p>
          {/* Fundamentos card (index 1) gains a link to the map; copy unchanged. */}
          {i === 1 && <a class="works-attack" href="#attack">{m.attackLink}</a>}
        </li>
      ))}
    </ul>
  </section>

  <hr class="rule" />

  <!-- Continuity Observatory — four data series that give the manifesto's
       imperatives empirical weight. Build-time static data; no runtime fetch.
       SVG charts include Y-axis labels and a hover crosshair (wired in the
       script block below). -->
  <section id="observatory" class="wrap section obs-section">
    <h2 class="label">{obs.kicker}</h2>
    <p class="obs-intro">{obs.intro}</p>
    <div class="obs-grid">
      {series.map((s) => {
        const copy = obs.series[s.id as keyof typeof obs.series];
        const coords = toSvgCoords(s.points);
        const pts = toSvgPoints(coords);
        const rising = s.family !== 'fragility';
        const yVals = s.points.map((p) => p.value);
        const yMin = Math.min(...yVals);
        const yMax = Math.max(...yVals);
        const yTopPx = SVG_TPAD;
        const yBotPx = SVG_H - SVG_BPAD;
        const fmtY = (v: number) =>
          v >= 1000 ? Math.round(v).toLocaleString('en-US') : v % 1 !== 0 ? v.toFixed(1) : String(v);
        return (
          <article class={`obs-card obs-${s.family}`}>
            <header class="obs-card-head">
              <span class={`obs-dir mono ${rising ? 'obs-up' : 'obs-down'}`} aria-hidden="true">
                {rising ? '↑' : '↓'}
              </span>
              <h3 class="obs-title">{copy.title}</h3>
            </header>
            <div class="obs-chart">
              <svg
                viewBox={`0 0 ${SVG_W} ${SVG_H}`}
                class="obs-svg"
                data-pts={JSON.stringify(coords)}
                role="img"
                aria-label={copy.title}
              >
                {/* Horizontal guide lines at top/bottom of chart area */}
                <line x1={SVG_LPAD} y1={yTopPx} x2={SVG_W - SVG_RPAD} y2={yTopPx} class="obs-guide" />
                <line x1={SVG_LPAD} y1={yBotPx} x2={SVG_W - SVG_RPAD} y2={yBotPx} class="obs-guide" />
                {/* Y-axis value labels (left of chart) */}
                <text x={SVG_LPAD - 3} y={yTopPx + 5} text-anchor="end" class="obs-axis-label">{fmtY(yMax)}</text>
                <text x={SVG_LPAD - 3} y={yBotPx - 2} text-anchor="end" class="obs-axis-label">{fmtY(yMin)}</text>
                {/* X-axis year labels */}
                <text x={SVG_LPAD} y={SVG_H - 3} class="obs-axis-label">{s.points[0].year}</text>
                <text x={SVG_W - SVG_RPAD} y={SVG_H - 3} text-anchor="end" class="obs-axis-label">{s.points[s.points.length - 1].year}</text>
                {/* Data polyline */}
                <polyline points={pts} class={`obs-line obs-line-${s.family}`} />
                {/* Hover crosshair + dot — positioned by JS, hidden until hover */}
                <line class="obs-crosshair" x1="0" y1={yTopPx} x2="0" y2={yBotPx} visibility="hidden" />
                <circle class={`obs-dot obs-dot-${s.family}`} cx="0" cy="0" r="3" visibility="hidden" />
              </svg>
              {/* Strip below chart: updates year + value on hover */}
              <div class="obs-hover-strip">
                <span class="obs-hover-year mono">—</span>
                <span class="obs-hover-val mono"></span>
                <span class="obs-unit">{copy.unit}</span>
              </div>
            </div>
            <p class="obs-why">{copy.why}</p>
            <footer class="obs-attr">
              <span class="obs-attr-source">{obs.source}: {s.source}</span>
              <span class="obs-attr-license">{obs.license}: {s.license}</span>
            </footer>
          </article>
        );
      })}
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap section closing">
    <p class="prose final">{m.closing}</p>
    <p class="note">{m.note}</p>
    <p class="label">{m.why}</p>
  </section>
</BaseLayout>

<style>
  .opening { padding-block: 4.5rem 3rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  h1 { font-size: clamp(2.3rem, 6vw, 3.8rem); }
  .sub { margin: 0; }
  blockquote { margin: 1.4rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--ink-dim); border-left: 1px solid var(--ink-faint); padding-left: 1.4rem; }
  .section { padding-block: 3rem; }

  /* Purpose & Vision — prose + numbered list */
  .purpose-section { max-width: 52rem; }
  .purpose-body {
    margin: 1.4rem 0 1.6rem;
    color: var(--ink-dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .purpose-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: purpose;
  }
  .purpose-list li {
    counter-increment: purpose;
    display: flex;
    gap: 1.6rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
  }
  .purpose-list li:first-child { border-top: 1px solid var(--line); }
  .purpose-list li::before {
    content: counter(purpose, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    flex-shrink: 0;
    padding-top: 0.22rem;
    min-width: 1.8rem;
  }

  /* The two imperatives — the core derivation, shown as quoted statements */
  .imperatives { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 2rem; max-width: 52rem; }
  .imp-name { display: block; color: var(--ink); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.7rem; }
  .imperatives blockquote { margin: 0; font-family: var(--font-serif); font-size: 1.12rem; line-height: 1.6; color: var(--ink-dim); border-left: 2px solid var(--ink-faint); padding-left: 1.3rem; }
  .imp-note { max-width: 52rem; margin: 2rem 0 0; color: var(--ink-faint); font-size: 0.92rem; line-height: 1.65; }

  .pillars { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 2.2rem 3rem; }
  .pillars li { display: flex; gap: 1.1rem; }
  .p-num { color: var(--ink-faint); font-size: 0.8rem; padding-top: 0.3rem; }
  .pillars h3 { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: 1.08rem; margin-bottom: 0.4rem; }
  .pillars p { margin: 0; color: var(--ink-dim); font-size: 0.95rem; }
  /* The path of transformation — from → to pairs */
  .path { list-style: none; margin: 1.8rem 0 0; padding: 0; }
  .path li { display: grid; grid-template-columns: 1fr auto 1.4fr; gap: 1.2rem; align-items: baseline; padding-block: 0.8rem; border-bottom: 1px solid var(--line); }
  .path li:first-child { border-top: 1px solid var(--line); }
  .path .from { font-family: var(--font-serif); font-style: italic; color: var(--ink-dim); }
  .path .arrow { color: var(--ink-faint); }
  .path .to { color: var(--ink); }
  @media (max-width: 38rem) { .path li { grid-template-columns: 1fr; gap: 0.15rem; } .path .arrow { display: none; } }

  /* In development — future documents, as cards (mirrors astro-denoise) */
  .works-body { max-width: 46rem; margin: 1.2rem 0 0; color: var(--ink-dim); font-size: 0.98rem; line-height: 1.65; }
  .works { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1rem; }
  .works li {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border: 1px solid var(--line);
    border-left: 2px solid transparent;
    padding: 1.6rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    transition: background 0.15s ease, border-left-color 0.15s ease;
    backdrop-filter: blur(2px);
  }
  .works li:hover { background: var(--bg-raise); border-left-color: var(--accent); }
  .works .badge {
    display: inline-block; align-self: flex-start;
    padding: 0.15rem 0.45rem; margin-bottom: 0.3rem;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 2px; font-size: 0.65rem;
  }
  .works h3 { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: 1.1rem; margin: 0; color: var(--ink); }
  .works p { color: var(--ink-dim); font-size: 0.92rem; margin: 0; line-height: 1.6; }
  .works-attack { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); margin-top: 0.4rem; }
  /* MAN3 map section + styles live in AttackMap.astro. */

  /* Continuity Observatory — four interactive mini line-charts. Always 2×2
     grid, responsive to 1 column on mobile. SVG has baked-in Y/X axis labels
     and a JS-driven hover crosshair. */
  .obs-section { padding-block: 3rem; }
  .obs-intro { max-width: 52rem; margin: 1.2rem 0 2rem; color: var(--ink-dim); font-size: 1.02rem; line-height: 1.7; }
  .obs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 38rem) { .obs-grid { grid-template-columns: 1fr; } }

  .obs-card {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border: 1px solid var(--line);
    border-top: 2px solid var(--line);
    padding: 1.2rem 1.3rem 1rem;
    display: flex; flex-direction: column; gap: 0.85rem;
    transition: border-top-color 0.18s ease;
    backdrop-filter: blur(2px);
  }
  .obs-card.obs-flourishing { border-top-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .obs-card.obs-knowledge { border-top-color: color-mix(in srgb, var(--accent) 90%, transparent); }
  .obs-card.obs-fragility { border-top-color: #e0605a66; }

  .obs-card-head { display: flex; align-items: flex-start; gap: 0.55rem; }
  .obs-dir { font-size: 0.85rem; flex-shrink: 0; padding-top: 0.22rem; }
  .obs-up { color: var(--accent); }
  .obs-down { color: #e0605a; }
  .obs-title { font-family: var(--font-serif); font-style: italic; font-size: 1.02rem; font-weight: 500; margin: 0; color: var(--ink); line-height: 1.35; }

  /* Chart container + SVG */
  .obs-chart { display: flex; flex-direction: column; }
  .obs-svg { width: 100%; height: auto; display: block; cursor: crosshair; }

  /* Data polyline */
  .obs-line { fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .obs-line-flourishing { stroke: var(--accent); }
  .obs-line-knowledge { stroke: var(--accent); }
  .obs-line-fragility { stroke: #e0605a; }

  /* Y/X axis guide lines and labels (SVG elements) */
  .obs-guide { stroke: var(--line); stroke-width: 0.5; }
  .obs-axis-label { font-family: var(--font-mono); font-size: 7px; fill: var(--ink-faint); }

  /* Hover crosshair line + value dot */
  .obs-crosshair { stroke: var(--ink-faint); stroke-width: 0.8; stroke-dasharray: 2 2; }
  .obs-dot-flourishing, .obs-dot-knowledge { fill: var(--accent); }
  .obs-dot-fragility { fill: #e0605a; }

  /* Hover strip below SVG: shows year + value + unit when mouse is over chart */
  .obs-hover-strip {
    display: flex; align-items: baseline; gap: 0.35rem;
    padding: 0.3rem 0 0;
    min-height: 1.55rem;
    border-top: 1px solid var(--line);
  }
  .obs-hover-year { font-size: 0.74rem; color: var(--ink-dim); min-width: 2.5rem; }
  .obs-hover-val { font-size: 0.82rem; color: var(--accent); }
  .obs-card.obs-fragility .obs-hover-val { color: #e0605a; }
  .obs-unit { font-size: 0.65rem; color: var(--ink-faint); }

  .obs-why { margin: 0; color: var(--ink-dim); font-size: 0.9rem; line-height: 1.62; flex: 1; }

  .obs-attr {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .obs-attr-source, .obs-attr-license {
    font-family: var(--font-mono); font-size: 0.65rem;
    letter-spacing: 0.02em; color: var(--ink-faint);
  }

  .closing { padding-block: 3.5rem 5rem; }
  .final { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; color: var(--ink); margin-bottom: 1.4rem; }
  .closing .note { max-width: 46rem; margin: 0 0 1.6rem; color: var(--ink-faint); font-size: 0.92rem; line-height: 1.65; }

  /* Cosmic perspective — one inline SVG, two acts, driven by native scroll.
     Act I is deep time: a single linear line anchored at "now" (its right
     end); each step zooms by the true ratio of the numeric spans, paced
     ease-in so the vast scales linger and a human life passes in a flash.
     Act II is the cosmic address: the point at the centre and horizons
     shrinking in true ratio from Earth out to the observable universe.
     Reduced motion / no JS shows the same SVG as a static poster. */
  .cosmos-section { padding-block: 3rem; }
  .cosmos-head { margin-bottom: 1.2rem; }

  /* Default: no track — the static poster. The script sets data-cosmos-ready
     only when the live scene will really run (it ran, the data parsed, motion
     is allowed), which swaps in the track + sticky stage + live SVG. No-JS and
     reduced-motion therefore get the poster and never a 500vh empty box. */
  .cosmos-scrolly { position: relative; height: auto; }
  .cosmos-sticky { display: block; }
  .cosmos-svg { display: none; }
  .cosmos-poster { display: block; width: min(100%, 42rem); height: auto; margin-inline: auto; }

  .cosmos-scrolly[data-cosmos-ready] { height: 500vh; }
  .cosmos-scrolly[data-cosmos-ready] .cosmos-sticky {
    position: sticky; top: 0; height: 100vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .cosmos-scrolly[data-cosmos-ready] .cosmos-svg {
    display: block; width: min(100%, 42rem); height: 72vh; min-height: 26rem;
  }
  .cosmos-scrolly[data-cosmos-ready] .cosmos-poster { display: none; }

  /* SVG element styles — palette through tokens only, so the circadian day /
     night swap keeps working. Font sizes are viewBox user units: at 390 px the
     drawing scale is ~0.39, so 32 units ≈ 12.5 px — the legibility floor.
     Nothing here goes below 32. Accent belongs only to the point and the focus
     line; the labels stay ink. */
  .tl-line { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .tl-prev { stroke: var(--ink-faint); stroke-width: 1; stroke-dasharray: 3 2; vector-effect: non-scaling-stroke; }
  .tl-tick { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .tl-span { font-family: var(--font-mono); font-size: 48px; fill: var(--ink); }
  .tl-name { font-family: var(--font-serif); font-style: italic; font-size: 34px; fill: var(--ink-dim); }
  .tl-factor { font-family: var(--font-mono); font-size: 32px; fill: var(--ink-dim); letter-spacing: 0.05em; }

  .dot { fill: var(--accent); filter: drop-shadow(0 0 12px var(--accent)); }
  .dot-you { font-family: var(--font-serif); font-style: italic; font-size: 40px; fill: var(--accent); }
  .dot-us { font-family: var(--font-serif); font-style: italic; font-size: 40px; fill: var(--accent); }
  .dot-detail { font-family: var(--font-serif); font-style: italic; font-size: 32px; fill: var(--ink-faint); }

  .ring { fill: none; stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ring-scale { font-family: var(--font-mono); font-size: 32px; fill: var(--accent); }
  .dim { stroke: var(--accent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .dim-ratio { font-family: var(--font-mono); font-size: 32px; fill: var(--ink-dim); }

  /* No `text-anchor` here: the live Act I titles centre themselves and the live
     Act II pair anchors left at (60, …); each element carries its own anchor. */
  .scene-title { font-family: var(--font-serif); font-style: italic; font-size: 44px; fill: var(--ink); }
  .scene-sub { font-family: var(--font-mono); font-size: 32px; fill: var(--ink-dim); }
  /* No `font-size` here: the script shrinks the older stack echoes through the
     presentation attribute, and a CSS rule would override that attribute. */
  .addr-item { font-family: var(--font-serif); font-style: italic; fill: var(--ink-dim); }
  .addr-item[data-age="0"] { fill: var(--ink); }

  .coda { font-family: var(--font-serif); font-style: italic; font-size: 32px; fill: var(--ink); }

  /* Poster-only reading labels (reduced motion / no JS). */
  .poster-tl-span { font-family: var(--font-mono); font-size: 32px; fill: var(--ink); }
  .poster-addr-us { font-family: var(--font-serif); font-style: italic; font-size: 34px; fill: var(--ink); }
  .poster-addr { font-family: var(--font-serif); font-style: italic; font-size: 32px; fill: var(--ink-dim); }
  .poster-addr-scale { font-family: var(--font-mono); font-size: 32px; fill: var(--ink-dim); }

  /* Defense in depth: the script guard is the real switch (it never sets
     data-cosmos-ready under reduced motion), but the poster must win anyway. */
  @media (prefers-reduced-motion: reduce) {
    .cosmos-scrolly { height: auto; }
  }

  /* Visually-hidden but accessible */
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* Mobile: only the stage height shrinks — never the SVG type (its units are
     viewBox-relative and already at the legibility floor). */
  @media (max-width: 34rem) {
    .cosmos-scrolly[data-cosmos-ready] .cosmos-svg { height: 65vh; min-height: 22rem; }
  }

  /* Scrollytelling reveal — pure CSS scroll-driven. Every block and list item
     rises and brightens as it scrolls up into the reading zone, tied to scroll
     position: the effect plays live as you move and reverses when you scroll
     back, so the page guides you idea by idea. Each list item gets its own
     view() timeline, so they arrive in turn as the list passes. Where scroll
     timelines are unsupported (or motion is reduced) nothing animates and the
     page is fully visible — progressive enhancement, no JS needed. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .opening > *,
      .section > *,
      .purpose-list li,
      .imperatives li,
      .pillars li,
      .path li,
      .works li {
        animation: step-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 28%;
      }
      /* The lists animate their items, so don't also animate the <ol> block. */
      .purpose-list, .imperatives, .pillars, .path { animation: none; }
      /* Dim sibling lines once they leave the top, keeping the eye on the
         block currently in the reading zone. */
      .imperatives li, .pillars li, .path li, .purpose-list li {
        animation: step-rise linear both, step-dim linear both;
        animation-timeline: view(), view();
        animation-range: entry 0% cover 28%, exit 40% exit 100%;
      }
    }
  }
  @keyframes step-rise {
    from { opacity: 0.12; transform: translateY(36px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes step-dim {
    from { opacity: 1; }
    to   { opacity: 0.35; }
  }

  /* §4 Living-document header — the page's mono voice, quietest ink. Case is
     kept exactly as written (mixed), so no text-transform here. */
  .doc-header {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  /* §3 Section rail — desktop only, fixed in the left margin. Numerals are
     baked at build time by roman() (frontmatter); nothing here stores them. */
  .rail {
    display: none;
    position: fixed;
    top: 4.5rem;
    left: 2rem;
    width: 14rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: 0;
    z-index: 5;
  }
  .rail ol { list-style: none; margin: 0; padding: 0; }
  .rail-num {
    display: inline-block;
    width: 1.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    text-align: center;
  }
  .rail-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .rail a {
    display: block;
    padding: 0.5rem;
    color: inherit;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .rail a:hover { color: var(--ink); }
  .rail a[aria-current="true"],
  .rail a.rail-current {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  /* Below 1200px the rail is not rendered; nothing replaces it. */
  @media (max-width: 1199.98px) { .rail { display: none; } }
  /* At/above 1200px: reserve the left gutter so the fixed rail can never
     overlap the centred reading column, then show the rail inside it. */
  @media (min-width: 1200px) {
    :global(main#main) { padding-inline-start: 20rem; }
    .rail { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail a { transition: none; }
  }

  /* §III The million-year test */
  .mtt-question {
    margin: 0 0 1.1em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-dim);
    border-left: 1px solid var(--ink-faint);
    padding-left: 1.4rem;
  }
  .mtt-answer {
    margin: 0 0 1.4em;
    color: var(--ink-dim);
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .mtt-closing { color: var(--ink-dim); }
  .mtt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-top: 1.2rem;
  }
  .mtt-illustration {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    order: -1; /* mobile: the SVG sits ABOVE the text */
  }
  /* §IV The transition that matters — body prose at the purpose measure. */
  .transition-section { max-width: 52rem; }
  .transition-body {
    margin: 1.2rem 0 0;
    color: var(--ink-dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  /* Desktop: the SVG moves beside the text (right column), not above it. */
  @media (min-width: 1200px) {
    .mtt-grid { grid-template-columns: minmax(0, 1fr) 260px; gap: 2.5rem; }
    .mtt-illustration { order: 0; margin: 0; }
  }
  @media (max-width: 30rem) { .mtt-illustration { width: 200px; } }
</style>

<script>
  // The cosmic-perspective scene: one inline SVG, two acts, driven by native
  // scroll. Progress is the fraction scrolled through the tall section, read in
  // a single rAF loop that runs only while the section intersects the viewport.
  // Per frame it writes SVG attributes only — no nodes are created and no layout
  // is read beyond the section's rect. Keyboard, trackpad, touch and the
  // scrollbar all drive it the same way, in both directions. Under
  // prefers-reduced-motion, or without JS, the CSS shows the static poster and
  // none of this runs.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrolly = document.querySelector<HTMLElement>('[data-cosmos]');

  if (scrolly && !reduceMotion) {
    const svg = scrolly.querySelector<SVGSVGElement>('.cosmos-svg');
    const raw = scrolly.dataset.cosmosData;
    if (svg && raw) {
      // All copy and the numeric spans come from the dictionary, serialized by
      // the template — nothing is hard-coded in one language.
      const data = JSON.parse(raw) as {
        spans: number[];
        addr: number[];
        times: string[][];
        places: string[][];
      };
      const spans = data.spans;
      const sizes = data.addr;
      const times = data.times;
      const N = spans.length;
      const M = sizes.length;

      // Only now does the track go live: a malformed payload or drifted array
      // lengths must fall back to the static poster, never a 500vh track with
      // a half-painted scene.
      if (N >= 2 && M >= 2 && N === times.length && M === data.places.length) {
        scrolly.dataset.cosmosReady = '1';

        const one = (sel: string) => svg.querySelector(sel);
        const many = (sel: string) => Array.from(svg.querySelectorAll(sel));

        const actTime = one('.act-time');
        const actSpace = one('.act-space');
        const tlPrev = one('.tl-prev');
        const tlLine = one('.tl-dyn .tl-line');
        const tlTick = one('.tl-tick');
        const tlSpan = one('.tl-span');
        const tlName = one('.tl-name');
        const tlFactor = one('.tl-factor');
        const dot = one('.dot');
        const dotYou = one('.dot-you');
        const dotUs = one('.dot-us');
        const dotDetail = one('.dot-detail');
        const rings = many('.ring');
        const ringScales = many('.ring-scale');
        const dim = one('.dim');
        const dimRatio = one('.dim-ratio');
        const addrItems = many('.addr-item');
        const coda = one('.coda');

        const X0 = 100, XN = 900, W = XN - X0, CX = 500, CY = 500, RF = 400;
        const STEP_T = 0.72;          // the six steps occupy this share of Act I
        const ACT1 = 0.42, TRANS = 0.47, ACT2 = 0.90;

        const set = (el: Element | null, attrs: Record<string, string | number>) => {
          if (!el) return;
          for (const k in attrs) el.setAttribute(k, String(attrs[k]));
        };
        // Label text changes only at step boundaries, but the loop runs every
        // frame; assigning `textContent` unconditionally would rebuild the text
        // node each frame, so the write is guarded — per frame the loop only
        // writes attributes, never nodes.
        const setText = (el: Element | null, text: string) => {
          if (el && el.textContent !== text) el.textContent = text;
        };
        const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
        const smooth = (t: number) => t * t * (3 - 2 * t);
        const easeOut = (t: number) => 1 - (1 - t) * (1 - t);
        // Unitless multipliers derived from the numeric spans — never parsed out
        // of the localized label strings. Grouped with thin spaces.
        const fmt = (n: number) => {
          const r = n < 10 ? Math.round(n * 100) / 100 : Math.round(n);
          return r.toLocaleString('en-US').replace(/,/g, '\u00a0');
        };

        // The address accumulates as a short stack under the top-left title. `cur`
        // is the horizon now in focus (Earth = 0, or -1 for the bare `Us` of the
        // morph); the newest entry is the largest at the top, and only its three
        // older neighbours stay — the rest dissolve toward the bottom.
        const paintStack = (cur: number) => {
          addrItems.forEach((el, j) => {
            const age = cur - (j - 1);
            if (age < 0 || age >= 4) { set(el, { opacity: 0 }); return; }
            set(el, {
              x: 60,
              'text-anchor': 'start',
              y: 160 + age * 48,
              // The taper stops at the 32-unit legibility floor the CSS below
              // documents (12 px at the 390 px drawing scale), so no echo ever
              // renders smaller than the labels can be read at.
              'font-size': Math.max(32, 42 - age * 4),
              'data-age': age,
              opacity: clamp01(1 - 0.32 * age).toFixed(2),
            });
          });
        };

        // ---- Act I: deep time ------------------------------------------------
        const paintTime = (t: number) => {
          set(actSpace, { opacity: 0 });
          // The stack lives outside `.act-space`, so hide it explicitly — needed
          // when scrolling back up out of Act II.
          addrItems.forEach((el) => set(el, { opacity: 0 }));
          let step: number, frac: number, contract = 0;
          if (t < STEP_T) {
            const sf = (N - 1) * (t / STEP_T) * (t / STEP_T);  // ease-in: the vast linger
            step = Math.min(N - 2, Math.floor(sf));
            frac = sf - step;
          } else {
            step = N - 1;
            frac = 1;
            contract = clamp01((t - STEP_T) / (1 - STEP_T));
          }
          const d = frac < 0.5 ? step : Math.min(step + 1, N - 1);
          const ra = step > 0 ? spans[step - 1] / spans[step] : 1;
          const rb = step < N - 1 ? spans[step] / spans[step + 1] : ra;
          // Only ever blend between two adjacent ratios, never across the whole
          // range, so the float stays precise.
          const fac = frac < 1 ? ra * Math.pow(rb / ra, frac) : rb;

          set(actTime, { opacity: 1 });
          set(tlLine, { x1: X0 + W * contract, x2: XN, y1: CY, y2: CY });
          // The previous span, in the same true proportion, runs far off the left
          // edge; the coordinate is bounded because anything past the edge reads
          // identically.
          const px = Math.max(-1600, XN - W * fac);
          set(tlPrev, { x1: px, x2: XN, y1: CY - 18, y2: CY - 18, opacity: clamp01((fac - 1) * 2) * (1 - contract) });
          set(tlTick, { opacity: 1 - contract });
          // The factor belongs to the step being read: the first has no previous
          // span, so it carries no factor.
          const facOfStep = d > 0 ? spans[d - 1] / spans[d] : 0;
          set(tlSpan, { opacity: 1 - clamp01(contract * 1.6) });
          set(tlName, { opacity: 1 - clamp01(contract * 1.6) });
          set(tlFactor, { opacity: facOfStep > 1 ? 1 - clamp01(contract * 1.6) : 0 });
          if (tlSpan) setText(tlSpan, times[d][0]);
          if (tlName) setText(tlName, times[d][1]);
          setText(tlFactor, facOfStep > 1 ? '×' + fmt(facOfStep) : '');

          // Labels sit at the right edge, so they anchor there rather than
          // centring past the SVG box.
          set(dot, { cx: XN, cy: CY, r: 3 + 7 * contract, opacity: clamp01(contract / 0.2) });
          set(dotYou, { x: XN - 10, y: CY - 38, 'text-anchor': 'end', opacity: clamp01((contract - 0.3) / 0.3) });
          set(dotDetail, { x: XN - 10, y: CY + 52, 'text-anchor': 'end', opacity: clamp01((contract - 0.55) / 0.3) });
          set(dotUs, { opacity: 0 });
          set(coda, { opacity: 0 });
        };

        // ---- Act II: the cosmic address --------------------------------------
        // `g` runs 0 (Earth in focus) to M−1 (Observable Universe in focus);
        // the coda pushes it past M−1 so the last horizon keeps collapsing there
        // too, dropping below one pixel instead of lingering by the point.
        const paintAddress = (g: number) => {
          let i = Math.floor(g);
          if (i < 0) i = 0;
          if (i > M - 2) i = M - 2;
          const frac = clamp01(g - i);
          const tail = Math.max(0, g - (M - 1));            // the coda's extra collapse
          const uw = smooth(frac);
          const ratio = sizes[i + 1] / sizes[i];
          const rOut = RF * Math.pow(ratio, -(uw + tail));   // the horizon collapsing
          const enter = clamp01((uw - 0.3) / 0.7);
          const rIn = RF * (1.25 - 0.25 * smooth(enter));  // the next one entering at the edge

          rings.forEach((ring, j) => {
            if (j === i) set(ring, { cx: CX, cy: CY, r: rOut.toFixed(2), opacity: rOut > 1 ? 1 : 0 });
            else if (j === i + 1) set(ring, { cx: CX, cy: CY, r: rIn.toFixed(2), opacity: enter });
            // The horizon that was in focus keeps collapsing on the same clock —
            // always in true ratio to the one now entering — until it drops
            // below one pixel; only then is it removed, never left as a stray
            // ring and never popped out while still visible.
            else if (j === i - 1 && i > 0) {
              const pr = ((RF * sizes[i - 1]) / sizes[i]) * Math.pow(ratio, -(uw + tail));
              set(ring, { cx: CX, cy: CY, r: pr.toFixed(2), opacity: pr > 1 ? 1 : 0 });
            }
            else set(ring, { r: 0, opacity: 0 });
          });

          const focus = uw < 0.5 ? i : i + 1;
          const fR = focus === i ? rOut : rIn;
          const dimOp = clamp01(1 - Math.abs(fR - RF) / (RF * 0.35));
          set(dim, { x1: CX - fR, x2: CX + fR, y1: CY, y2: CY, opacity: fR > 1 ? dimOp : 0 });
          set(dimRatio, { y: CY + fR + 30, opacity: dimOp > 0.05 && focus > 0 ? 1 : 0 });
          setText(dimRatio, focus > 0 ? '×' + fmt(sizes[focus] / sizes[focus - 1]) : '');

          // The focus ring's scale label sits above it, but never high enough to
          // run into the top-left act title, and it fades out before the ring
          // collapses into the `Us` label at the centre.
          ringScales.forEach((el, j) => {
            if (j === focus && fR >= 60) set(el, { x: CX, y: Math.max(130, CY - fR - 12), opacity: 1 });
            else set(el, { opacity: 0 });
          });

          paintStack(Math.max(0, Math.min(M - 1, Math.round(g))));
        };

        // The point slides from "now" to the centre and "You" becomes "Us". Earth's
        // horizon only enters at the stage edge (r 500 -> 400) in the second half,
        // so the address never starts already in focus.
        const paintMorph = (u: number) => {
          set(actTime, { opacity: 1 - clamp01(u / 0.6) });
          set(actSpace, { opacity: clamp01(u / 0.5) });
          const x = XN - (XN - CX) * u;
          // Act I leaves the point at r 10 (3 + 7 · contract) and Act II wants it
          // at 7 — glide between the two so the glow never blinks at the seam.
          set(dot, { cx: x, cy: CY, r: 10 - 3 * smooth(u), opacity: 1 });
          // Anchor the labels to the left of the moving point (as at "now"), so
          // they never run off the right edge while the point is still far right.
          set(dotYou, { x: x - 10, y: CY - 38, 'text-anchor': 'end', opacity: 1 - clamp01(u / 0.3) });
          set(dotDetail, { x: x - 10, y: CY + 52, 'text-anchor': 'end', opacity: 1 - clamp01(u / 0.3) });
          set(dotUs, { x: CX, y: CY - 40, 'text-anchor': 'middle', opacity: clamp01((u - 0.4) / 0.4) });

          const e = clamp01((u - 0.45) / 0.55);            // Earth enters at the edge
          const rIn = 500 - 100 * smooth(e);               // 500 -> 400
          rings.forEach((ring, j) =>
            set(ring, { cx: CX, cy: CY, r: j === 0 ? rIn.toFixed(2) : 0, opacity: j === 0 && e > 0 ? 1 : 0 }),
          );
          const dimOp = e > 0 ? clamp01((u - 0.85) / 0.15) : 0;
          set(dim, { x1: CX - rIn, x2: CX + rIn, y1: CY, y2: CY, opacity: dimOp });
          // Earth is the first horizon: there is no previous one, so no ratio.
          set(dimRatio, { opacity: 0 });
          setText(dimRatio, '');
          ringScales.forEach((el, j) =>
            set(el, { x: CX, y: Math.max(130, CY - rIn - 12), opacity: j === 0 ? dimOp : 0 }),
          );
          paintStack(u < 0.45 ? -1 : 0);
          set(coda, { opacity: 0 });
        };

        const paintSpace = (u: number) => {
          set(actTime, { opacity: 0 });
          set(actSpace, { opacity: 1 });
          const g = (M - 1) * easeOut(u);
          paintAddress(g);
          // The observer shrinks with the zoom and is gone well before the
          // observable universe is in focus.
          const fade = clamp01(1 - g / 2.5);
          set(dot, { cx: CX, cy: CY, r: Math.max(0.05, 7 * Math.pow(0.5, g)), opacity: fade });
          set(dotUs, { x: CX, y: CY - 40, opacity: fade });
          set(dotYou, { opacity: 0 });
          set(dotDetail, { opacity: 0 });
          set(coda, { opacity: 0 });
        };

        const paintCoda = (c: number) => {
          set(actTime, { opacity: 0 });
          set(actSpace, { opacity: 1 });
          // Past M−1: the Observable Universe stays in focus while the last
          // inner horizon finishes collapsing below one pixel, then the point
          // reappears at the centre with its glow.
          paintAddress(M - 1 + c);
          set(dot, { cx: CX, cy: CY, r: 7, opacity: clamp01((c - 0.5) / 0.25) });
          set(dotYou, { opacity: 0 });
          set(dotUs, { opacity: 0 });
          set(dotDetail, { opacity: 0 });
          set(coda, { opacity: clamp01((c - 0.5) / 0.3) });
        };

        // ---- The single scroll-driven loop -----------------------------------
        const paint = () => {
          const rect = scrolly.getBoundingClientRect();  // the only layout read
          const track = rect.height - window.innerHeight;
          const p = track > 0 ? clamp01(-rect.top / track) : 0;
          if (p < ACT1) paintTime(p / ACT1);
          else if (p < TRANS) paintMorph((p - ACT1) / (TRANS - ACT1));
          else if (p < ACT2) paintSpace((p - TRANS) / (ACT2 - TRANS));
          else paintCoda(clamp01((p - ACT2) / (1 - ACT2)));
        };

        let raf = 0;
        const frame = () => {
          paint();
          raf = requestAnimationFrame(frame);
        };
        // Run only while the section is on screen; stop entirely when it is not.
        new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            if (!raf) raf = requestAnimationFrame(frame);
          } else if (raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }, { threshold: 0 }).observe(scrolly);
      }
    }
  }
</script>

<script>
  // Observatory interactive hover: crosshair + data strip for each chart.
  // SVG_W / SVG_LPAD must match the constants in observatory.ts.
  const OBS_W = 280, OBS_LPAD = 38, OBS_RPAD = 4;

  document.querySelectorAll<SVGSVGElement>('.obs-svg').forEach((svg) => {
    const raw = svg.dataset.pts;
    if (!raw) return;
    type Coord = { year: number; value: number; x: number; y: number };
    let pts: Coord[];
    try { pts = JSON.parse(raw); } catch { return; }
    if (!pts.length) return;

    const crosshair = svg.querySelector<SVGLineElement>('.obs-crosshair');
    const dot = svg.querySelector<SVGCircleElement>('.obs-dot');
    const chart = svg.closest<HTMLElement>('.obs-chart');
    const yearEl = chart?.querySelector<HTMLElement>('.obs-hover-year');
    const valEl = chart?.querySelector<HTMLElement>('.obs-hover-val');

    const closestPt = (svgX: number) =>
      pts.reduce((best, p) =>
        Math.abs(p.x - svgX) < Math.abs(best.x - svgX) ? p : best);

    const fmtVal = (v: number) =>
      v >= 1000 ? v.toLocaleString() : v % 1 !== 0 ? v.toFixed(1) : String(v);

    const toSvgX = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      return (clientX - r.left) * (OBS_W / r.width);
    };

    const showPt = (svgX: number) => {
      const p = closestPt(svgX);
      crosshair?.setAttribute('x1', p.x.toFixed(1));
      crosshair?.setAttribute('x2', p.x.toFixed(1));
      crosshair?.removeAttribute('visibility');
      dot?.setAttribute('cx', p.x.toFixed(1));
      dot?.setAttribute('cy', p.y.toFixed(1));
      dot?.removeAttribute('visibility');
      if (yearEl) yearEl.textContent = String(p.year);
      if (valEl) valEl.textContent = fmtVal(p.value);
    };

    const hidePt = () => {
      crosshair?.setAttribute('visibility', 'hidden');
      dot?.setAttribute('visibility', 'hidden');
      if (yearEl) yearEl.textContent = '—';
      if (valEl) valEl.textContent = '';
    };

    svg.addEventListener('mousemove', (e) => {
      const svgX = toSvgX(e.clientX);
      if (svgX < OBS_LPAD || svgX > OBS_W - OBS_RPAD) { hidePt(); return; }
      showPt(svgX);
    });

    svg.addEventListener('mouseleave', hidePt);

    svg.addEventListener('touchmove', (e) => {
      if (e.touches.length !== 1) return;
      e.preventDefault();
      const svgX = toSvgX(e.touches[0].clientX);
      if (svgX < OBS_LPAD || svgX > OBS_W - OBS_RPAD) { hidePt(); return; }
      showPt(svgX);
    }, { passive: false });

    svg.addEventListener('touchend', hidePt);
  });
</script>

<script>
  // §3 rail: one observer marks the current link (10 targets).
  (function () {
    const rail = document.querySelector<HTMLElement>('.rail');
    if (!rail) return;
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));

    const set = (id: string | null) => {
      for (const a of links) {
        const on = id !== null && a.getAttribute('href') === `#${id}`;
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        a.classList.toggle('rail-current', on);
      }
    };

    // The band across the middle of the viewport: the section crossing it is
    // "current". Ratios accumulate so the marker only moves when a section
    // really enters the band — it never flickers to empty between sections.
    const ratios = new Map<Element, number>();
    const observer = new IntersectionObserver((entries) => {
      for (const e of entries) ratios.set(e.target, e.isIntersecting ? e.intersectionRatio : 0);
      let best: Element | null = null;
      let bestRatio = 0;
      for (const [el, r] of ratios) {
        if (r > bestRatio) { bestRatio = r; best = el; }
      }
      if (best) set((best as HTMLElement).id);
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.1, 0.5, 1] });

    document.querySelectorAll<HTMLElement>(
      '[id="what-we-value"],[id="perspective"],[id="million-year-test"],[id="transition"],' +
      '[id="imperatives"],[id="pillars"],[id="what-changes"],[id="attack"],[id="in-development"],[id="observatory"]',
    ).forEach((s) => observer.observe(s));
  })();
</script>
