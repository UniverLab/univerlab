---
import BaseLayout from '../layouts/BaseLayout.astro';
import Postcard from '../components/Postcard.astro';
import Watermark from '../components/Watermark.astro';
import CosmicPlate from '../components/CosmicPlate.astro';
import ManifestoFigure from '../components/ManifestoFigure.astro';
import { getLang, useTranslations } from '../i18n';
import { series, toSvgCoords, toSvgPoints, SVG_W, SVG_H, SVG_LPAD, SVG_TPAD, SVG_RPAD, SVG_BPAD } from '../data/observatory';
import { startSolLabel } from '../lib/mission-time';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const m = t.manifesto;
const c = t.cosmos;
const obs = t.observatory;
// Living-document header. `docVersion`/`docDate` are facts in the dict;
// the year and the Sol are derived from `docDate` so a date bump
// auto-updates both — nothing here is hand-typed.
const docYear = new Date(m.docDate + 'T00:00:00').getFullYear();
const docSol = startSolLabel(m.docDate);
const docHeader = `${m.docStatus} · v${m.docVersion} · ${docYear} · ${docSol}`;
// v4 follows the paper's five movements (Pensamiento Cósmico, 19 Oct 2026),
// then the practice and the observatory. Numerals are generated by `roman()`,
// never stored in the dictionary; this array is the order the index lists and
// the order the section-order test asserts against.
const railSections = [
  { id: 'perspective', label: c.kicker },
  { id: 'dissipative', label: m.dissipativeTitle },
  { id: 'the-other', label: m.otherTitle },
  { id: 'heuristics', label: m.ethicsTitle },
  { id: 'partial-success', label: m.partialTitle },
  { id: 'provenance', label: m.provenanceTitle },
  { id: 'practice', label: m.practiceTitle },
  { id: 'observatory', label: obs.kicker },
] as const;
const roman = (n: number): string => {
  const d = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
  return d[n] ?? String(n);
};
const num = (id: (typeof railSections)[number]['id']) => roman(railSections.findIndex((s) => s.id === id) + 1);
const PDF = 'https://papers.univerlab.org/pensamiento-cosmico/pensamiento-cosmico.pdf';
---
<BaseLayout title={m.metaTitle} description={m.description} circadian>
  <div class="manifesto">
  <Watermark kind="celestial" />
  <section class="wrap opening">
    <div class="page-open">
      <div class="page-open-text">
        <span class="label">{m.kicker}</span>
        <h1>{m.title}</h1>
        <p class="sub label">{m.sub}</p>
        <!-- The paper itself, citable: a PDF on papers.univerlab.org (published
             to R2 by hand before this ships — no upload step here). -->
        <a class="paper-link" href={PDF} target="_blank" rel="noopener noreferrer" type="application/pdf">{m.paper}</a>
        <!-- Living-document header. Mono voice, --ink-faint. Version, year and
             Sol are computed from m.docDate in the frontmatter; only `docStatus`
             is localised. NOT aria-hidden: build-md's stripAriaHidden would
             delete the line from the markdown twin, which must keep it. -->
        <p class="doc-header"><time datetime={m.docDate} data-mission>{docHeader}</time></p>
        <p class="m-lead">{m.lead}</p>
      </div>
      <Postcard page="manifesto" alt={t.postcards.manifesto} />
      <!-- The epigraph sits under the postcard, so the image column carries as
           much as the text column beside it. -->
      <blockquote class="prose epigraph">{m.epigraph}</blockquote>
    </div>
  </section>

  <div class="m-body wrap">
    <!-- Section index. <nav> is deliberate: build-md strips <nav> from the
         markdown twin, so the labels never duplicate the section headings the
         twin already carries. Sticky beside the text from 1100px; a folded
         index above the text below that. -->
    <nav class="rail" aria-label={m.kicker}>
      <details class="rail-fold" open>
        <summary class="rail-summary">{m.toc}</summary>
        <ol>
          {railSections.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="rail-num">{roman(i + 1)}</span>
                <span class="rail-label">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>

    <div class="m-main">
      <section id="perspective" class="section">
        <p class="sec-num" aria-hidden="true">{num('perspective')}</p>
        <h2 class="sec-h">{c.kicker}</h2>
        <p class="body">{c.intro}</p>
        <CosmicPlate copy={c} />
      </section>

      <section id="dissipative" class="section">
        <p class="sec-num" aria-hidden="true">{num('dissipative')}</p>
        <h2 class="sec-h">{m.dissipativeTitle}</h2>
        <p class="body">{m.dissipative[0]}</p>
        <p class="body">{m.dissipative[1]}</p>
        <ManifestoFigure kind="membrane" numeral={`Lám. ${num('dissipative')}`} labels={m.membrane} />
        <p class="body">{m.dissipative[2]}</p>
        <blockquote class="pull">
          <p class="pull-q">{m.dissipativeQuote}</p>
          <p class="pull-g">{m.dissipativeGloss}</p>
        </blockquote>
      </section>

      <section id="the-other" class="section">
        <p class="sec-num" aria-hidden="true">{num('the-other')}</p>
        <h2 class="sec-h">{m.otherTitle}</h2>
        <p class="body">{m.other[0]}</p>
        <p class="body">{m.other[1]}</p>
        <ManifestoFigure kind="foci" numeral={`Lám. ${num('the-other')}`} labels={m.foci} />
        <p class="body">{m.other[2]}</p>
        <p class="body">{m.other[3]}</p>
      </section>

      <section id="heuristics" class="section">
        <p class="sec-num" aria-hidden="true">{num('heuristics')}</p>
        <h2 class="sec-h">{m.ethicsTitle}</h2>
        <p class="body">{m.ethicsIntro}</p>
        <div class="heur">
          <ol class="heur-list">
            {m.heuristics.map(([code, name, question]) => (
              <li>
                <span class="heur-code">{code}</span>
                <h3 class="heur-name">{name}</h3>
                <p class="heur-q">{question}</p>
              </li>
            ))}
          </ol>
          <ManifestoFigure kind="triangle" numeral={`Lám. ${num('heuristics')}`} labels={{}} heuristics={m.heuristics} />
        </div>
        <p class="body">{m.heuristicsCheck}</p>
        <aside class="eraser">
          <span class="label">{m.nihilismLabel}</span>
          <p class="eraser-q">{m.nihilismQuestion}</p>
          <p class="body">{m.nihilismBody}</p>
        </aside>
        <p class="body note">{m.ethicsLimit}</p>
      </section>

      <section id="partial-success" class="section">
        <p class="sec-num" aria-hidden="true">{num('partial-success')}</p>
        <h2 class="sec-h">{m.partialTitle}</h2>
        {m.partial.map((p) => <p class="body">{p}</p>)}
        <blockquote class="pull"><p class="pull-q">{m.partialQuote}</p></blockquote>
      </section>

      <section id="provenance" class="section">
        <p class="sec-num" aria-hidden="true">{num('provenance')}</p>
        <h2 class="sec-h">{m.provenanceTitle}</h2>
        <p class="body">{m.provenanceIntro}</p>
        <!-- Figure 1 of the paper as a flow: each level supports the next; the
             dashed bracket marks the one step that is not deduced. -->
        <ol class="prov">
          {m.provenance.map(([level, body], i) => (
            <li class={i === 0 ? 'prov-base' : i === 2 ? 'prov-ethics' : undefined}>
              <h3 class="prov-h">{level}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
        <p class="prov-gap"><span aria-hidden="true">⇢</span> {m.provenanceGap}</p>
        <h3 class="limits-h">{m.limitsTitle}</h3>
        <ul class="limits">
          {m.limits.map((l) => <li>{l}</li>)}
        </ul>
        <p class="body note">{m.limitsNote}</p>
      </section>

      <section id="practice" class="section works-section">
        <p class="sec-num" aria-hidden="true">{num('practice')}</p>
        <h2 class="sec-h">{m.practiceTitle}</h2>
        {m.practice.map((p) => <p class="body">{p}</p>)}
        <blockquote class="pull"><p class="pull-q">{m.practiceQuote}</p></blockquote>
        <h3 class="works-h">{m.worksTitle}</h3>
        <p class="works-body">{m.worksBody}</p>
        <ul class="works">
          {/* The paper showcase plate: the developed, citable form of the argument.
              Wax seal (same asset as the mail ritual), title, blurb, PDF + DOI. */}
          <li class="works-paper">
            <div class="works-paper-head">
              <img class="works-seal" src="/bench/identidad/sello-lacre.svg" width="32" height="32" alt="" aria-hidden="true" loading="lazy" />
              <h3>{m.title}</h3>
            </div>
            <p>{m.paperShowcaseBlurb}</p>
            <p class="works-links">
              <a class="paper-link" href={PDF} target="_blank" rel="noopener noreferrer" type="application/pdf">{m.paper}</a>
              <a class="works-doi" href="https://doi.org/10.5281/zenodo.23503658" target="_blank" rel="noopener noreferrer">{m.paperDoiLabel}</a>
            </p>
          </li>
          {m.works.map(([name, desc]) => (
            <li>
              <span class="badge label">{m.worksBadge}</span>
              <h3>{name}</h3>
              <p>{desc}</p>
            </li>
          ))}
        </ul>
      </section>

    <!-- Continuity Observatory — four data series that give the manifesto's
         heuristics empirical weight. Build-time static data; no runtime fetch.
         SVG charts include Y-axis labels and a hover crosshair (wired in the
         script block below). -->
    <section id="observatory" class="section obs-section">
      <p class="sec-num" aria-hidden="true">{num('observatory')}</p>
      <h2 class="sec-h">{obs.kicker}</h2>
      <p class="obs-intro">{obs.intro}</p>
      <div class="obs-grid">
        {series.map((s) => {
          const copy = obs.series[s.id as keyof typeof obs.series];
          const coords = toSvgCoords(s.points);
          const pts = toSvgPoints(coords);
          const rising = s.family !== 'fragility';
          const yVals = s.points.map((p) => p.value);
          const yMin = Math.min(...yVals);
          const yMax = Math.max(...yVals);
          const yTopPx = SVG_TPAD;
          const yBotPx = SVG_H - SVG_BPAD;
          const fmtY = (v: number) =>
            v >= 1000 ? Math.round(v).toLocaleString('en-US') : v % 1 !== 0 ? v.toFixed(1) : String(v);
          return (
            <article class={`obs-card obs-${s.family}`}>
              <header class="obs-card-head">
                <span class={`obs-dir mono ${rising ? 'obs-up' : 'obs-down'}`} aria-hidden="true">
                  {rising ? '↑' : '↓'}
                </span>
                <h3 class="obs-title">{copy.title}</h3>
              </header>
              <div class="obs-chart">
                <svg
                  viewBox={`0 0 ${SVG_W} ${SVG_H}`}
                  class="obs-svg"
                  data-pts={JSON.stringify(coords)}
                  role="img"
                  aria-label={copy.title}
                >
                  {/* Horizontal guide lines at top/bottom of chart area */}
                  <line x1={SVG_LPAD} y1={yTopPx} x2={SVG_W - SVG_RPAD} y2={yTopPx} class="obs-guide" />
                  <line x1={SVG_LPAD} y1={yBotPx} x2={SVG_W - SVG_RPAD} y2={yBotPx} class="obs-guide" />
                  {/* Y-axis value labels (left of chart) */}
                  <text x={SVG_LPAD - 3} y={yTopPx + 5} text-anchor="end" class="obs-axis-label">{fmtY(yMax)}</text>
                  <text x={SVG_LPAD - 3} y={yBotPx - 2} text-anchor="end" class="obs-axis-label">{fmtY(yMin)}</text>
                  {/* X-axis year labels */}
                  <text x={SVG_LPAD} y={SVG_H - 3} class="obs-axis-label">{s.points[0].year}</text>
                  <text x={SVG_W - SVG_RPAD} y={SVG_H - 3} text-anchor="end" class="obs-axis-label">{s.points[s.points.length - 1].year}</text>
                  {/* Data polyline */}
                  <polyline points={pts} class={`obs-line obs-line-${s.family}`} />
                  {/* Hover crosshair + dot — positioned by JS, hidden until hover */}
                  <line class="obs-crosshair" x1="0" y1={yTopPx} x2="0" y2={yBotPx} visibility="hidden" />
                  <circle class={`obs-dot obs-dot-${s.family}`} cx="0" cy="0" r="3" visibility="hidden" />
                </svg>
                {/* Strip below chart: updates year + value on hover */}
                <div class="obs-hover-strip">
                  <span class="obs-hover-year mono">—</span>
                  <span class="obs-hover-val mono"></span>
                  <span class="obs-unit">{copy.unit}</span>
                </div>
              </div>
              <p class="obs-why">{copy.why}</p>
              <footer class="obs-attr">
                <span class="obs-attr-source">{obs.source}: {s.source}</span>
                <span class="obs-attr-license">{obs.license}: {s.license}</span>
              </footer>
            </article>
          );
        })}
      </div>
    </section>


      <section class="section closing">
        <p class="prose final">{m.closing}</p>
        <p class="label">{m.why}</p>
      </section>
    </div>
  </div>
  </div>
</BaseLayout>

<style>
  /* Opening — the hero keeps its own width; the lead and the epigraph read
     at the body measure under it. */
  .opening { padding-block: 4.5rem 2.5rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  h1 { font-size: clamp(2.3rem, 6vw, 3.8rem); }
  .sub { margin: 0; }
  .paper-link { display: inline-block; margin-top: 0.5rem; color: var(--accent); }
  .m-lead { max-width: 62ch; margin: 2rem 0 0; font-size: clamp(1.12rem, 1.05rem + 0.3vw, 1.3rem); line-height: 1.6; color: var(--ink); }
  blockquote { margin: 1.4rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--ink-dim); border-left: 1px solid var(--ink-faint); padding-left: 1.4rem; }
  /* The opening as three areas: text beside the postcard, the epigraph under
     the postcard. One column on phones: postcard, text, epigraph. */
  .opening .page-open { width: 100%; grid-template-areas: 'card' 'text' 'quote'; }
  .page-open-text { grid-area: text; }
  .opening :global(.pc) { grid-area: card; }
  .epigraph { grid-area: quote; margin: 0; align-self: start; }
  @media (min-width: 64rem) {
    .opening .page-open { grid-template-columns: 1fr 42%; grid-template-rows: auto 1fr; grid-template-areas: 'text card' 'text quote'; column-gap: 4rem; }
    .epigraph { margin-top: 2.2rem; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; }
  }

  /* Body grid: the index beside the text from 1100px. The text column is wide
     (figures and plates use all of it); prose alone keeps a 66ch measure. */
  .m-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-bottom: 4rem; }
  @media (min-width: 1100px) {
    .m-body { grid-template-columns: 13.5rem minmax(0, 1fr); gap: 4.5rem; }
  }
  .m-main { min-width: 0; }
  .section { margin: 0; padding-block: 4.5rem 1rem; }
  .section + .section { border-top: 1px solid var(--line); }
  .sec-num { margin: 0 0 0.4rem; font-family: var(--font-serif); font-size: 1rem; letter-spacing: 0.2em; color: var(--accent); }
  .sec-h { font-size: clamp(1.7rem, 3.4vw, 2.3rem); margin-block: 0 1.6rem; }
  .body { max-width: 70ch; margin: 0 0 1.15rem; }
  .note { color: var(--ink-faint); font-size: 0.95rem; }

  /* Pull quotes — the lines the section turns on. */
  .pull { border: 0; padding: 0; margin: 2.4rem 0 2rem; max-width: 52rem; }
  .pull-q { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.25; color: var(--ink); }
  .pull-g { margin: 0.7rem 0 0; max-width: 60ch; font-size: 1rem; color: var(--ink-dim); font-style: normal; }

  /* IV — the three questions beside their triangle. */
  .heur { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 2.5rem; align-items: center; margin: 0.6rem 0 1rem; }
  @media (min-width: 900px) { .heur { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .heur-list { list-style: none; margin: 0; padding: 0; }
  .heur-list li { padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .heur-list li:first-child { border-top: 1px solid var(--line); }
  .heur-code { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); }
  .heur-name { font-size: 1.15rem; margin: 0.2rem 0 0.3rem; }
  .heur-q { margin: 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-dim); }
  .eraser { margin: 2.4rem 0; padding: 1.8rem 0; border-block: 1px solid var(--ink-faint); }
  .eraser-q { margin: 0.6rem 0 1rem; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.4rem); line-height: 1.2; color: var(--ink); }

  /* VI — the paper's Figure 1 as a flow of levels. */
  .prov { list-style: none; margin: 1.6rem 0 0; padding: 0 0 0 1.6rem; position: relative; max-width: 52rem; counter-reset: prov; }
  .prov::before { content: ''; position: absolute; left: 0.45rem; top: 0.6rem; bottom: 0.6rem; border-left: 1px solid var(--ink-faint); }
  .prov li { position: relative; padding: 0.2rem 0 1.3rem; }
  .prov li::before { content: ''; position: absolute; left: -1.43rem; top: 0.55rem; width: 0.55rem; height: 0.55rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--bg); }
  .prov-ethics::before { background: var(--accent) !important; border-color: var(--accent) !important; }
  .prov-h { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .prov p { margin: 0; max-width: 62ch; color: var(--ink-dim); font-size: 0.98rem; }
  .prov-gap { margin: 0.2rem 0 2.2rem 1.6rem; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em; color: var(--accent); }
  .limits-h { font-size: 1.2rem; margin: 0 0 0.8rem; }
  .limits { list-style: none; margin: 0 0 1.4rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.6rem 2rem; max-width: 56rem; }
  .limits li { padding: 0.7rem 0; border-top: 1px solid var(--line); font-family: var(--font-serif); font-style: italic; }

  /* VII — the practice, then the works: the paper plate and one future work. */
  .works-h { font-size: 1.2rem; margin: 2.6rem 0 0.4rem; }
  .works-body { max-width: 62ch; margin: 0; color: var(--ink-dim); font-size: 0.98rem; line-height: 1.65; }
  .works { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .works li { border: 1px solid var(--line); border-left: 2px solid transparent; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; transition: border-left-color 0.15s ease; }
  .works li:hover { border-left-color: var(--accent); }
  .works .badge { display: inline-block; align-self: flex-start; padding: 0.15rem 0.45rem; margin-bottom: 0.3rem; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 2px; font-size: 0.65rem; }
  .works h3 { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: 1.1rem; margin: 0; color: var(--ink); }
  .works p { color: var(--ink-dim); font-size: 0.92rem; margin: 0; line-height: 1.6; }
  .works-paper-head { display: flex; align-items: center; gap: 0.75rem; }
  .works-seal { width: 32px; height: 32px; flex-shrink: 0; }
  .works-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 0.4rem; }
  .works-links .paper-link { margin-top: 0; }
  .works-doi { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); align-self: center; }

  /* Continuity Observatory — four interactive mini line-charts. Always 2×2
     grid, responsive to 1 column on mobile. SVG has baked-in Y/X axis labels
     and a JS-driven hover crosshair. */
  .obs-intro { max-width: 52rem; margin: 1.2rem 0 2rem; color: var(--ink-dim); font-size: 1.02rem; line-height: 1.7; }
  .obs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  .obs-card {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border: 1px solid var(--line);
    border-top: 2px solid var(--line);
    padding: 1.2rem 1.3rem 1rem;
    display: flex; flex-direction: column; gap: 0.85rem;
    transition: border-top-color 0.18s ease;
    backdrop-filter: blur(2px);
  }
  .obs-card.obs-flourishing { border-top-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .obs-card.obs-knowledge { border-top-color: color-mix(in srgb, var(--accent) 90%, transparent); }
  .obs-card.obs-fragility { border-top-color: #e0605a66; }

  .obs-card-head { display: flex; align-items: flex-start; gap: 0.55rem; }
  .obs-dir { font-size: 0.85rem; flex-shrink: 0; padding-top: 0.22rem; }
  .obs-up { color: var(--accent); }
  .obs-down { color: #e0605a; }
  .obs-title { font-family: var(--font-serif); font-style: italic; font-size: 1.02rem; font-weight: 500; margin: 0; color: var(--ink); line-height: 1.35; }

  /* Chart container + SVG */
  .obs-chart { display: flex; flex-direction: column; }
  .obs-svg { width: 100%; height: auto; display: block; cursor: crosshair; }

  /* Data polyline */
  .obs-line { fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .obs-line-flourishing { stroke: var(--accent); }
  .obs-line-knowledge { stroke: var(--accent); }
  .obs-line-fragility { stroke: #e0605a; }

  /* Y/X axis guide lines and labels (SVG elements) */
  .obs-guide { stroke: var(--line); stroke-width: 0.5; }
  .obs-axis-label { font-family: var(--font-mono); font-size: 7px; fill: var(--ink-faint); }

  /* Hover crosshair line + value dot */
  .obs-crosshair { stroke: var(--ink-faint); stroke-width: 0.8; stroke-dasharray: 2 2; }
  .obs-dot-flourishing, .obs-dot-knowledge { fill: var(--accent); }
  .obs-dot-fragility { fill: #e0605a; }

  /* Hover strip below SVG: shows year + value + unit when mouse is over chart */
  .obs-hover-strip {
    display: flex; align-items: baseline; gap: 0.35rem;
    padding: 0.3rem 0 0;
    min-height: 1.55rem;
    border-top: 1px solid var(--line);
  }
