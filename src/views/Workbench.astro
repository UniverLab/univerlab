---
import BaseLayout from '../layouts/BaseLayout.astro';
import Watermark from '../components/Watermark.astro';
import Machine from '../components/Machine.astro';
import { byId } from '../lib/experiments';
import { getLang, localizePath, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const w = t.workbench;
const WHATSAPP = 'https://wa.me/573053892323';
const waHref = `${WHATSAPP}?text=${encodeURIComponent(w.ctaMessage)}`;
const [headPre, headPost] = w.head.split(w.headEm);
const proof = w.proof.items.map((id) => ({
  href: localizePath(`/${id}`, lang),
  name: byId(id).name,
  tagline: (t.experiments as Record<string, { tagline: string }>)[id].tagline,
}));
---
<BaseLayout title={w.title} description={w.description} circadian>
  <Watermark kind="blueprint" />
  <section class="wrap workbench">
    <header class="wb-hero">
      <div class="wb-hero-text">
        <span class="label">{w.label}</span>
        <div class="wb-thumb"><Machine id="workbench" ink="theme" height="112px" /></div>
        <h1>{headPre}<em>{w.headEm}</em>{headPost}</h1>
        <p class="wb-intro">{w.intro}</p>
        <p class="wb-ctas">
          <a class="wb-btn" href={waHref} target="_blank" rel="noopener"><span class="wb-long">{w.cta}</span><span class="wb-short">{w.ctaShort}</span></a>
          <small>{w.ctaNote}</small>
        </p>
      </div>
      <figure class="wb-figure">
        <Machine id="workbench" ink="theme" height="260px" class="wb-machine" />
      </figure>
    </header>
    <section class="wb-tags" aria-label={w.tags.kicker}>
      {w.tags.items.map(([title, price, body], i) => (
        <div class="wb-tag"><h2>{title}</h2><div class="wb-price">{price}</div><p>{body}</p>{i === 2 && <p><a class="wb-more" href={localizePath('/workbench/audits', lang)}>{w.audits.cardLink}</a></p>}</div>
      ))}
    </section>
    <section class="wb-block">
      <span class="label">{w.how.kicker}</span>
      <ol class="wb-steps">
        {w.how.steps.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wb-block wb-proof">
      <span class="label">{w.proof.kicker}</span>
      <ul>
        {proof.map((p) => (
          <li><a href={p.href}><b>{p.name}</b> · {p.tagline}</a></li>
        ))}
      </ul>
    </section>
    <section class="wb-block wb-policy">
      <span class="label">{w.policy.kicker}</span>
      <p>{w.policy.summary}</p>
      <p><a href={localizePath('/terms', lang) + '#workbench-bookings'}>{w.policy.link}</a></p>
    </section>
    <section class="wb-close">
      <h2>{w.close.head}</h2>
      <p><a class="wb-btn" href={waHref} target="_blank" rel="noopener">{w.close.cta}</a></p>
      <small>{w.close.phone}</small>
    </section>
  </section>
  <div class="wb-sticky"><a class="wb-btn" href={waHref} target="_blank" rel="noopener">{w.ctaShort}</a><span>{w.ctaNote}</span></div>
</BaseLayout>

{/* Inlined so the page ships no CSS chunk: every chunk is linked site-wide
    and counted on the budgeted pages, and this design must not move them. */}
<style is:inline>
  .workbench { max-width: 64rem; padding-block: 4rem 6rem; }
  .wb-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; }
  .wb-hero h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; margin: 0.6rem 0 1rem; text-wrap: balance; }
  .wb-hero h1 em { color: var(--accent); }
  .wb-intro { max-width: 40rem; color: var(--ink-dim); font-size: 1.1rem; line-height: 1.7; margin: 0 0 1.4rem; }
  .wb-ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; margin: 0; }
  .wb-ctas small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wb-btn { text-decoration: none; border: 1px solid var(--accent);
         color: var(--accent); padding: 0.55rem 1.1rem;
         font-family: var(--font-mono); font-size: 0.85rem;
         transition: background 0.15s ease, color 0.15s ease; }
  .wb-btn:hover { background: var(--accent); color: var(--bg); }
  .wb-ctas .wb-short { display: none; }
  .wb-thumb { display: none; }
  .wb-figure { margin: 0; }
  .wb-machine { justify-self: center; width: min(22rem, 100%); }
  .wb-tags { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; padding-block: 2rem; border-block: 1px solid var(--line); margin-top: 3rem; }
  .wb-tag { background: var(--bg-raise); border: 1px solid var(--line); padding: 1.4rem 1.2rem 1.1rem; }
  .wb-tag h2 { font-family: var(--font-mono); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; color: var(--accent); }
  .wb-tag .wb-price { font-family: var(--font-serif); font-size: 1.75rem; line-height: 1; margin: 0.5rem 0 0.25rem; }
  .wb-tag p { margin: 0.5rem 0 0; font-size: 1rem; color: var(--ink-dim); line-height: 1.6; }
  .wb-more { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); }
  .wb-block { margin-top: 3rem; }
  .wb-steps { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; counter-reset: step; }
  .wb-steps li { counter-increment: step; padding-left: 2.6rem; position: relative; }
  .wb-steps li::before { content: counter(step, upper-roman) '.'; position: absolute; left: 0; font-family: var(--font-serif); color: var(--accent); font-size: 1.4rem; }
  .wb-steps li b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem; margin: 0.1rem 0 0.25rem; }
  .wb-steps li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wb-proof ul { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .wb-proof li { font-family: var(--font-mono); font-size: 0.82rem; border: 1px dashed var(--line); padding: 0.5rem 0.75rem; }
  .wb-proof li a { color: inherit; text-decoration: none; }
  .wb-proof li b { font-weight: 500; }
  .wb-policy p { max-width: 46rem; color: var(--ink-dim); line-height: 1.7; }
  .wb-policy a { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); }
  .wb-close { background: var(--bg-raise); border-block: 1px solid var(--line); margin-top: 3rem; padding: 2.5rem 1.5rem; text-align: center; display: grid; gap: 1rem; justify-items: center; }
  .wb-close h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0; text-wrap: balance; max-width: 44rem; }
  .wb-close p { margin: 0; }
  .wb-close small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wb-sticky { display: none; }
  @media (max-width: 47.99rem) {
    .workbench { padding-block: 1.5rem 7rem; }
    .wb-hero { grid-template-columns: minmax(0, 1fr); }
    .wb-figure { display: none; }
    .wb-thumb { display: block; float: right; --machine-h-phone: 112px; margin: -0.4rem -0.25rem 0.25rem 0.65rem; }
    .wb-intro { clear: both; }
    .wb-hero h1 { font-size: 1.95rem; }
    .wb-ctas .wb-btn { width: 100%; display: flex; justify-content: center; }
    .wb-ctas .wb-long { display: none; }
    .wb-ctas .wb-short { display: inline; }
    .wb-tags { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78%; overflow-x: auto; scroll-snap-type: x mandatory; padding-block: 1.25rem; margin-inline: calc(-1 * var(--space)); padding-inline: var(--space); scrollbar-width: none; }
    .wb-tag { scroll-snap-align: start; }
    .wb-tag .wb-price { font-size: 1.5rem; }
    .wb-sticky { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 5; align-items: center; gap: 0.65rem; padding: 0.65rem var(--space) calc(0.65rem + env(safe-area-inset-bottom, 0px)); background: color-mix(in srgb, var(--bg) 92%, transparent); border-top: 1px solid var(--line); backdrop-filter: blur(6px); }
    .wb-sticky .wb-btn { flex: 1; display: flex; justify-content: center; }
    .wb-sticky span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-dim); letter-spacing: 0.06em; }
  }
</style>
