---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabLantern from '../components/LabLantern.astro';
import { getLang, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const room = t.lanternRoom;
---
<BaseLayout
  title={room.title}
  description={room.description}
  circadian
>
  <section class="enc" aria-labelledby="t-enc">
    <header class="enc-head">
      <h1 id="t-enc" class="enc-h1">{room.head}</h1>
      <p class="enc-tome">{t.home.plate.lead} · {t.home.plate.title}</p>
      <p class="enc-intro">{room.intro}</p>
    </header>

    <div class="wrap hall"><LabLantern /></div>
  </section>
</BaseLayout>

<style>
  .enc { position: relative; display: grid; gap: 18px; max-width: 1120px; margin: 0 auto; padding: 10px clamp(16px, 4vw, 48px) 0; min-width: 0; }
  .enc-head { display: grid; gap: 4px; text-align: center; justify-items: center; }
  .enc-h1 { font-family: 'Old Standard TT', serif; font-size: clamp(32px, 6vw, 54px); letter-spacing: 0.04em; margin: 0; }
  .enc-tome { margin: 0; font-family: 'Old Standard TT', serif; font-variant: small-caps; letter-spacing: 0.12em; color: var(--bench-line-soft); font-size: 15px; }
  .enc-intro { margin: 6px auto 0; max-width: 56ch; color: var(--bench-line-soft); font-size: 16px; }

  @media (max-width: 520px) {
    .enc-tome { font-size: 15px; }
  }
</style>
