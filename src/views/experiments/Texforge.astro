---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import GalleyProof from '../../components/GalleyProof.astro';
import { getLang, useTranslations } from '../../i18n';
import { byId } from '../../lib/experiments';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments.texforge;
const exp = byId('texforge');
// Rendered via an expression: literal `{…}` in template text is read as JSX.
const tfInitial =
  '\\begin{mermaid}\nflowchart LR\n  tex[.tex] --> lint --> typeset\n  typeset --> pdf[(PDF)]\n  lint -.->|error| log\n\\end{mermaid}';
---
<ExperimentLayout id="texforge">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">{exp.motif}</p>
  <GalleyProof slot="hero-visual" />
  <!-- Pull quote: the strongest line, set as an editorial pull with the curly
       opening mark generated by CSS (copy stays byte-identical). It is the one
       and only rendering of the `need` sentence on the page — so it is content,
       not decoration: no aria-hidden, or the line would vanish for assistive
       tech and from the build-md agent export (which drops aria-hidden trees). -->
  <section class="wrap quote-band">
    <blockquote class="pull">{e.need}</blockquote>
  </section>

  <!-- `trule` = wide section divider (T1 of the dash vocabulary): one dashed
       hairline per section boundary, never one per item. -->
  <section class="wrap section trule">
    <p class="label eyebrow">{e.press.kicker}</p>
    <div class="galley">
      <figure class="plate-fig" id="tf-figure" data-figures={JSON.stringify(e.figures)}>
        <pre class="mono plate"><code>{tfInitial}</code></pre>
        <figcaption class="fig-cap"><span class="fig-label">Fig. 1 · {e.figures[0]} · mermaid</span></figcaption>
      </figure>
      <div class="colophon">
        <ul>
          {e.press.items.map(([term, def], i) => (
            <li><span class="press-no">{String(i + 1).padStart(2, '0')}</span><strong>{term}</strong> — {def}</li>
          ))}
        </ul>
      </div>
    </div>
    <!-- The printed listing: a crop of examples/texforge-capabilites as
         texforge compiled it — the real output beside the source plates. -->
    <figure class="listing-fig">
      <img src="/demos/texforge-listing.webp" width="1166" height="402" loading="lazy" decoding="async" alt={e.listing.alt} />
      <figcaption class="fig-cap"><span class="fig-label">Fig. {e.figures.length + 1} · {e.listing.caption}</span></figcaption>
    </figure>
  </section>

  <section class="wrap section trule">
    <div class="sub">
      <span class="label">{e.subproject.kicker}</span>
      <h3><a href={e.subproject.link}>{e.subproject.name} ↗</a></h3>
      <p set:html={e.subproject.body} />
    </div>
  </section>
</ExperimentLayout>

<script>
  // The figure cycles through the custom diagram environments texforge
  // intercepts — \begin{mermaid|graphviz|d2|code}…\end — each captioned as a figure,
  // the same crossfade idea as the home wordmark. Reduced-motion rests on the
  // first; pauses when scrolled off screen.
  (function () {
    const fig = document.getElementById('tf-figure');
    if (!fig) return;
    const code = fig.querySelector('.plate code');
    const label = fig.querySelector('.fig-label');
    if (!code || !label) return;
    let figures = [];
    try { figures = JSON.parse(fig.dataset.figures || '[]'); } catch (err) {}

    const envs = [
      { name: 'mermaid', src: 'flowchart LR\n  tex[.tex] --> lint --> typeset\n  typeset --> pdf[(PDF)]\n  lint -.->|error| log' },
      { name: 'graphviz', src: 'digraph {\n  spec -> figures -> pdf\n  spec -> refs -> pdf\n}' },
      { name: 'd2', src: 'spec -> typeset: lint\ntypeset -> pdf: tectonic\ndiagrams -> typeset\ndiagrams: mermaid | d2' },
      { name: 'code', open: '[lang=python, numbers=true]', src: 'def gauss(n=1000):\n    x = np.linspace(-10, 10, n)\n    dx = x[1] - x[0]\n    return np.exp(-x**2).sum() * dx' },
    ];
    const block = (x) => '\\begin{' + x.name + '}' + (x.open || '') + '\n' + x.src + '\n\\end{' + x.name + '}';
    const caption = (n) => 'Fig. ' + (n + 1) + ' · ' + (figures[n] || '') + ' · ' + envs[n].name;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const HOLD = 3400; // time to read each environment
    const FADE = 260; // crossfade duration (matches the CSS transition)
    let i = 0;
    function swap() {
      i = (i + 1) % envs.length;
      code.classList.add('fade');
      label.classList.add('fade');
      setTimeout(() => {
        code.textContent = block(envs[i]);
        label.textContent = caption(i);
        code.classList.remove('fade');
        label.classList.remove('fade');
      }, FADE);
    }

    let timer = 0;
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        clearInterval(timer);
        if (en.isIntersecting) timer = window.setInterval(swap, HOLD);
      }
    });
    io.observe(fig);
  })();
</script>

<style>
  /* The galley-proof figure keeps the old hero-visual footprint (same
     24rem measure, same centred block) so the hero layout does not shift;
     the SVG scales down fluidly, so there is no horizontal scroll on mobile.
     The figure's own ink, marks and proof-pass loop live in GalleyProof. */
  .ascii-motif { font: 400 .68rem/1.4 var(--font-mono); letter-spacing: .08em; }

  .section { padding-block: 60px; }
  /* Wide section divider (T1): one dashed hairline rules each major section
     off from the one above it — never one per item, never a solid rule. */
  .section.trule { border-top: 1px dashed var(--rule-t1); }
  .galley { display: grid; grid-template-columns: minmax(16rem, 1fr) 1.3fr; gap: 3rem; align-items: start; }
  /* Grid items default to min-width:auto, so the plate's unbreakable `pre`
     (white-space: pre) sets the track's min-content and blows the single
     column past the viewport at 320–390px. Zeroing it lets the track take the
     column, and the plate scrolls its own long lines instead of the page —
     measured: documentElement.scrollWidth goes 398 → 320 at a 320px viewport
     (no horizontal scroll, no clipped figure). */
  .galley > * { min-width: 0; }
  @media (max-width: 50rem) { .galley { grid-template-columns: 1fr; } }
  /* A typeset figure plate, not a card: a dashed hairline frame on parchment,
     flat on the page (no card shadow), holding the sheet's own tone. It cycles
     through the diagram environments texforge intercepts, captioned
     "Fig. N · <env>". */
  .plate-fig { margin: 0; }
  .plate {
    margin: 0; padding: 2.5rem;
    border: 1px dashed var(--rule-t1);
    background: var(--bg-raise); color: var(--ink);
    font-size: 0.9rem; line-height: 1.9;
    min-height: 11.8rem; /* fits the tallest environment, so cycling never jumps */
    overflow-x: auto; /* long diagram lines scroll inside the plate, not the page */
    scrollbar-width: thin;
  }
  .plate code { display: block; transition: opacity 0.26s cubic-bezier(0.4, 0, 0.2, 1); }
  .plate code.fade { opacity: 0; }
  /* Dashed figure-meta row (T3) above the caption — the third and last
     treatment in the dash vocabulary (dashed is the only hairline here). */
  .fig-cap {
    margin-top: 0.8rem; padding-top: 0.6rem;
    border-top: 1px dashed var(--rule-t3);
    font-family: var(--font-mono);
    font-size: 0.7rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .fig-label { transition: opacity 0.26s cubic-bezier(0.4, 0, 0.2, 1); }
  .fig-label.fade { opacity: 0; }
  /* The printed listing sits under the galley as a plate of real output: the
     same dashed frame as the source plates, the page crop flat inside it. */
  .listing-fig { margin: 3rem auto 0; max-width: 46rem; }
  .listing-fig img {
    display: block; width: 100%; height: auto;
    padding: 1.5rem;
    border: 1px dashed var(--rule-t1);
    background: #fff;
  }
  .colophon ul { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .colophon li { display: flex; align-items: baseline; gap: 0.8rem; padding-block: 0.7rem; border-bottom: 1px dashed var(--rule-t2); color: var(--ink-dim); font-size: 0.97rem; }
  .press-no { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); min-width: 1.5rem; }
  /* Press terms are headline voice: system serif at 400, upright, bistre. */
  .colophon strong { color: var(--ink); font-family: var(--font-serif); font-weight: 400; font-style: normal; }
  .sub { max-width: 46rem; }
  .sub h3 { font-size: 1.1rem; margin: 0.5rem 0; }
  /* Bistre link with a dashed underline — the amber essence has no contrast on
     cream and isn't this surface's accent. */
  .sub h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-color: var(--rule-t2);
    text-underline-offset: 0.3em;
  }
  .sub p { margin: 0; color: var(--ink-dim); font-size: 0.97rem; }
  .sub :global(code) { color: var(--ink); font-size: 0.9em; }

  /* ── Antimetal editorial register (docs/landing-poc/styles/antimetal.md).
       Everything below is page-local: `html[data-surface='paper'] .exp …` is
       only ever this page (the surface is set by texforge alone), and the extra
       `.exp` class lifts each rule above ExperimentLayout's and surfaces.css's
       competing paper rules without relying on emit order. ────────────────── */

  /* Separator law: dashed 1px bistre @ 10% is the ONLY content separator —
     every T1/T2/T3 consumer retints in one move. The numbered-eyebrow section
     counter resets here too (the first increment is the genesis kicker). */
  :global(html[data-surface='paper'] .exp) {
    --rule-t1: rgba(26, 22, 20, 0.10);
    --rule-t2: rgba(26, 22, 20, 0.10);
    --rule-t3: rgba(26, 22, 20, 0.10);
    counter-reset: sect;
  }

  /* The install slip joins the bistre hairline — surfaces.css pins a flint
     border at (0,3,0), so this needs the `.exp` host to outrank it (0,3,1). */
  :global(html[data-surface='paper'] .exp .cmd) {
    border: 1px dashed var(--rule-t1);
    background: var(--bg-raise);
  }

  /* Numbered section markers — "01 · GENESIS" … the four openers only: the
     install head, demo caption, figure meta and exp-nav numbers must neither
     increment the counter nor gain a marker. */
  :global(html[data-surface='paper'] .exp .genesis .label),
  :global(html[data-surface='paper'] .exp .label.eyebrow),
  :global(html[data-surface='paper'] .exp .sub .label),
  :global(html[data-surface='paper'] .exp .faq-section .label) {
    counter-increment: sect;
  }
  :global(html[data-surface='paper'] .exp .genesis .label)::before,
  :global(html[data-surface='paper'] .exp .label.eyebrow)::before,
  :global(html[data-surface='paper'] .exp .sub .label)::before,
  :global(html[data-surface='paper'] .exp .faq-section .label)::before {
    content: counter(sect, decimal-leading-zero) ' · ';
  }
  /* Geist Mono 10–11px, uppercase (already), tracked 0.1em, graphite. */
  :global(html[data-surface='paper'] .exp .label) {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--ink-dim);
  }

  /* The CTA pair: dark pill (the one filled button) + rectangular ghost.
     Equal font and padding so the pair reads as one typographic rhythm; the
     hovers kill ExperimentLayout's rule that fills the ghost on hover — never
     two filled buttons. (0,5,1)/(0,6,1) outrank (0,3,1)/(0,4,0) and (0,4,1). */
  :global(html[data-surface='paper'] .exp .actions .btn),
  :global(html[data-surface='paper'] .exp .actions .btn.ghost) {
    font: 500 0.875rem/1.4 var(--font-body);
    padding: 0.78rem 1.55rem;
  }
  :global(html[data-surface='paper'] .exp .actions .btn:hover) {
    background: #2a2724; /* Ash */
    color: #f4f4e7;
  }
  /* The ghost is rectangular — surfaces.css rounds every `.actions .btn` to
     9999px, which would make two pills (the guide's paired-contrast rule). */
  :global(html[data-surface='paper'] .exp .actions .btn.ghost) {
    border-radius: 0;
  }
  :global(html[data-surface='paper'] .exp .actions .btn.ghost:hover) {
    background: transparent;
    border-color: rgba(26, 22, 20, 0.92);
    color: #1a1614;
  }

  /* The hero closes on ONE centred pair: the install slip and the ASCII
     wordmark share a measure and an axis. Both rules keep the `.exp` host so
     they outrank surfaces.css's paper hero grid (0,4,0 / 0,3,0) without
     !important — the layout, the grid areas and the row order are untouched.

     The slip: clamped to the 42rem measure, `width:100%` + `margin-inline:auto`
     centres it inside its full-width grid row; `text-align:center` centres the
     command in the bar so the bar's own content sits on the same axis as the
     art above it.

     The banner: `justify-self:center` + `width:fit-content` shrink-wraps the art
     and centres THAT box in the same row — the load-bearing choice is that the
     box hugs the art, so the block letters stay flush left inside it (never
     `text-align:center` on the art: centring each line shears the letters).
     `max-width:min(100%,42rem)` clamps the wordmark to the slip's measure, and
     Banner.astro's own guards (max-width:100%, min-width:0, overflow:hidden)
     still hold underneath. Both hold at every width: in the 52rem single-column
     stack the grid row IS the hero width, so `margin-inline:auto` and
     `justify-self:center` keep the pair on the axis, and the art (82 cols at
     ~0.6em, clamped to a 6px floor below 40rem) stays inside the gutter down to
     320px — no overflow, nothing to restate per breakpoint. */
  :global(html[data-surface='paper'] .exp .install) {
    max-width: 42rem;
    width: 100%;
    margin-inline: auto;
    text-align: center;
  }
  :global(html[data-surface='paper'] .exp .hero > .banner) {
    justify-self: center;
    width: fit-content;
    max-width: min(100%, 42rem);
  }

  /* Drop cap on the genesis long-form paragraph — serif 400 initial at 2.2×,
     negative margin pulling it back into the line (locale-agnostic). */
  :global(html[data-surface='paper'] .exp .genesis .prose::first-letter) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.2em;
    line-height: 0.9;
    float: left;
    margin: 0.04em -0.08em 0 0;
    padding-right: 0.08em;
    color: var(--ink);
  }

  /* Pull quote: serif 36–48px at 400, curly opening mark generated by CSS
     (typographic, not a glyph asset), no background, no border, no accent. */
  .quote-band { padding-block: 60px; }
  .pull {
    margin: 0 auto;
    max-width: 34rem;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(36px, 4.2vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.021em;
    color: var(--ink);
  }
  .pull::before {
    content: '\201C';
    display: block;
    line-height: 1;
    font-size: 1em;
    color: var(--ink-faint); /* flint mark, bistre quote */
  }

  /* 120px section rhythm: each band carries 60px, so two neighbours' paddings
     sum to exactly 120px — measured in the built HTML, not assumed (the T1
     hairline sits in the seam and adds its own 1px to the visual gap). Every
     band in the chain — hero, genesis-row, quote-band, press, sub, faq — is
     covered: `.section` and `.quote-band` above carry their own 60, and the
     two layout-owned ends are pinned here. The hero's grid rule closes at
     3rem (48px), so it needs the explicit 60px bottom to open the rhythm. */
  :global(html[data-surface='paper'] .exp .hero) { padding-block-end: 60px; }
  :global(html[data-surface='paper'] .exp .genesis-row) { padding-block: 60px; }
  :global(html[data-surface='paper'] .exp .faq-section) { padding-block: 60px; }
  /* exp-nav keeps ExperimentLayout's 0.5rem top (every other surface's
     rhythm), but on paper it is the last band after the FAQ: 60px + 60px
     closes the chain at 120 like the rest. Its 3.5rem bottom is untouched. */
  :global(html[data-surface='paper'] .exp .exp-nav) { padding-block-start: 60px; }

  /* Motion law: every interaction transition on this surface eases on the
     guide's curve. Inert on elements with no transition (durations untouched);
     the 0.5s page-reveal entrance is a load fade, not an interaction. */
  :global(html[data-surface='paper'] .exp *) {
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
