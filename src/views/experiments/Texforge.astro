---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments.texforge;
// Rendered via an expression: literal `{…}` in template text is read as JSX.
const tfInitial =
  '\\begin{mermaid}\nflowchart LR\n  tex[.tex] --> lint --> typeset\n  typeset --> pdf[(PDF)]\n  lint -.->|error| log\n\\end{mermaid}';
---
<ExperimentLayout id="texforge">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">.tex ──→ lint ──→ typeset ──→ PDF</p>
  <div slot="hero-visual" class="network-mark" aria-hidden="true">
    <svg viewBox="0 0 420 340" role="presentation">
      <g class="network-lines">
        <path d="M210 170 L92 58 M210 170 L170 35 M210 170 L292 47 M210 170 L362 112 M210 170 L340 250 M210 170 L236 310 M210 170 L88 260 M210 170 L52 160" />
        <path d="M92 58 L170 35 M292 47 L362 112 M340 250 L236 310 M88 260 L52 160" />
      </g>
      <g class="network-nodes">
        <circle cx="210" cy="170" r="8" />
        <circle cx="92" cy="58" r="4" /><circle cx="170" cy="35" r="4" />
        <circle cx="292" cy="47" r="5" /><circle cx="362" cy="112" r="4" />
        <circle cx="340" cy="250" r="4" /><circle cx="236" cy="310" r="5" />
        <circle cx="88" cy="260" r="4" /><circle cx="52" cy="160" r="4" />
      </g>
    </svg>
  </div>
  <!-- `trule` = wide section divider (T1 of the dash vocabulary): one dashed
       hairline per section boundary, never one per item. -->
  <section class="wrap section trule">
    <div class="galley">
      <figure class="plate-fig" id="tf-figure" data-figures={JSON.stringify(e.figures)}>
        <pre class="mono plate"><code>{tfInitial}</code></pre>
        <figcaption class="fig-cap"><span class="fig-label">Fig. 1 · {e.figures[0]} · mermaid</span></figcaption>
      </figure>
      <div class="colophon">
        <span class="label">{e.press.kicker}</span>
        <ul>
          {e.press.items.map(([term, def], i) => (
            <li><span class="press-no">{String(i + 1).padStart(2, '0')}</span><strong>{term}</strong> — {def}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section trule">
    <div class="sub">
      <span class="label">{e.subproject.kicker}</span>
      <h3><a href={e.subproject.link}>{e.subproject.name} ↗</a></h3>
      <p set:html={e.subproject.body} />
    </div>
  </section>
</ExperimentLayout>

<script>
  // The figure cycles through the custom diagram environments texforge
  // intercepts — \begin{mermaid|graphviz|d2}…\end — each captioned as a figure,
  // the same crossfade idea as the home wordmark. Reduced-motion rests on the
  // first; pauses when scrolled off screen.
  (function () {
    const fig = document.getElementById('tf-figure');
    if (!fig) return;
    const code = fig.querySelector('.plate code');
    const label = fig.querySelector('.fig-label');
    if (!code || !label) return;
    let figures = [];
    try { figures = JSON.parse(fig.dataset.figures || '[]'); } catch (err) {}

    const envs = [
      { name: 'mermaid', src: 'flowchart LR\n  tex[.tex] --> lint --> typeset\n  typeset --> pdf[(PDF)]\n  lint -.->|error| log' },
      { name: 'graphviz', src: 'digraph {\n  spec -> figures -> pdf\n  spec -> refs -> pdf\n}' },
      { name: 'd2', src: 'spec -> typeset: lint\ntypeset -> pdf: tectonic\ndiagrams -> typeset\ndiagrams: mermaid | d2' },
    ];
    const block = (x) => '\\begin{' + x.name + '}\n' + x.src + '\n\\end{' + x.name + '}';
    const caption = (n) => 'Fig. ' + (n + 1) + ' · ' + (figures[n] || '') + ' · ' + envs[n].name;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const HOLD = 3400; // time to read each environment
    const FADE = 260; // crossfade duration (matches the CSS transition)
    let i = 0;
    function swap() {
      i = (i + 1) % envs.length;
      code.classList.add('fade');
      label.classList.add('fade');
      setTimeout(() => {
        code.textContent = block(envs[i]);
        label.textContent = caption(i);
        code.classList.remove('fade');
        label.classList.remove('fade');
      }, FADE);
    }

    let timer = 0;
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        clearInterval(timer);
        if (en.isIntersecting) timer = window.setInterval(swap, HOLD);
      }
    });
    io.observe(fig);
  })();
</script>

<style>
  .network-mark { width: min(100%, 24rem); margin: 0 auto; }
  .network-mark svg { display: block; width: 100%; height: auto; }
  .network-lines path { fill: none; stroke: #a8a7a1; stroke-width: 1; stroke-dasharray: 3 5; }
  .network-nodes { fill: #1a1614; }
  .network-nodes circle:first-child { fill: #e2e67d; }
  .ascii-motif { font: 400 .68rem/1.4 var(--font-mono); letter-spacing: .08em; }

  .section { padding-block: 1.5rem; }
  /* Wide section divider (T1): one dashed hairline rules each major section
     off from the one above it — never one per item, never a solid rule. */
  .section.trule { border-top: 1px dashed var(--rule-t1); }
  .galley { display: grid; grid-template-columns: minmax(16rem, 1fr) 1.3fr; gap: 3rem; align-items: start; }
  @media (max-width: 50rem) { .galley { grid-template-columns: 1fr; } }
  /* A typeset figure plate, not a card: a dashed hairline frame on parchment,
     flat on the page (no card shadow), holding the sheet's own tone. It cycles
     through the diagram environments texforge intercepts, captioned
     "Fig. N · <env>". */
  .plate-fig { margin: 0; }
  .plate {
    margin: 0; padding: 1.9rem 2.1rem;
    border: 1px dashed var(--rule-t1);
    background: var(--bg-raise); color: var(--ink);
    font-size: 0.9rem; line-height: 1.9;
    min-height: 10.6rem; /* fits the tallest environment, so cycling never jumps */
  }
  .plate code { display: block; transition: opacity 0.26s ease; }
  .plate code.fade { opacity: 0; }
  /* Dotted figure-meta row (T3) above the caption — the third and last
     treatment in the dash vocabulary. */
  .fig-cap {
    margin-top: 0.8rem; padding-top: 0.6rem;
    border-top: 1px dotted var(--rule-t3);
    font-family: var(--font-mono);
    font-size: 0.7rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .fig-label { transition: opacity 0.26s ease; }
  .fig-label.fade { opacity: 0; }
  .colophon ul { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .colophon li { display: flex; align-items: baseline; gap: 0.8rem; padding-block: 0.7rem; border-bottom: 1px dashed var(--rule-t2); color: var(--ink-dim); font-size: 0.97rem; }
  .press-no { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); min-width: 1.5rem; }
  /* Press terms are headline voice: system serif at 400, upright, bistre. */
  .colophon strong { color: var(--ink); font-family: var(--font-serif); font-weight: 400; font-style: normal; }
  .sub { max-width: 46rem; }
  .sub h3 { font-size: 1.1rem; margin: 0.5rem 0; }
  /* Bistre link with a dashed underline — the amber essence has no contrast on
     cream and isn't this surface's accent. */
  .sub h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-color: var(--rule-t2);
    text-underline-offset: 0.3em;
  }
  .sub p { margin: 0; color: var(--ink-dim); font-size: 0.97rem; }
  .sub :global(code) { color: var(--ink); font-size: 0.9em; }
</style>
