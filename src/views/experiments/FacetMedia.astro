---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
import { byId } from '../../lib/experiments';
import {
  readFacetCatalog,
  groupFacetCapabilities,
  facetLabelsFor,
  capabilitySummary,
  facetTryCommand,
  facetPullCommand,
} from '../../lib/catalogs';
import { iconSvg } from '../../lib/icon-svg';
import { copy } from '../../lib/icons';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments['facetmedia'];
const exp = byId('facetmedia');
const { caps, facets: regFacets } = readFacetCatalog();
const facets = groupFacetCapabilities(caps, facetLabelsFor(regFacets, lang));
const groups = [{ facet: 'all', label: e.capabilities.all, caps }, ...facets];

// The record beside every asset, laid out over 10 lines as in the mockup.
// Yellow (span.ok) marks only what was verified: the status and the metrics.
const recordHtml = [
  '{',
  '  "capability": "comfy.still",',
  '  "package": { "name": "comfy",',
  '    "version": "0.1.0" },',
  '  "models": [ "flux2-klein-4b" ],',
  '  "params": { "seed": 300, "width": 1344, "height": 768 },',
  '  "verification": { "status": <span class="ok">"passed"</span>,',
  '    "metrics": { "width": <span class="ok">1344</span>, "height": <span class="ok">768</span> } },',
  '  "licenses": [ { "spdx": "Apache-2.0", "commercial_use": true } ]',
  '}',
].join('\n');
---

<ExperimentLayout id="facetmedia">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">{exp.motif}</p>
  <Fragment slot="hero-visual">
    <div class="fm-hero">
      <div class="fm-hero-text">
        <p class="fm-headline">{e.headline}</p>
        <p class="fm-meta"><span>{exp.number} · {e.release}</span><span>{facets.map((f) => f.label).join(' / ')}</span></p>
      </div>
    </div>
  </Fragment>

  <section id="capacidades" class="wrap section fm-index fm-cap" data-fm-tabs>
    {caps.length > 0 ? (
      <>
        <div class="thumbs" role="tablist" aria-label={e.capabilities.tabsAria}>
          {groups.map((g, j) => (
            <button
              type="button"
              role="tab"
              id={`fm-tab-${g.facet}`}
              aria-controls={`fm-panel-${g.facet}`}
              aria-selected={j === 0 ? 'true' : 'false'}
              tabindex={j === 0 ? 0 : -1}
            >{g.label} ({g.caps.length})</button>
          ))}
        </div>
        <div class="fm-panels">
          {groups.map((g) => (
            <div
              class="fm-panel"
              role="tabpanel"
              id={`fm-panel-${g.facet}`}
              aria-labelledby={`fm-tab-${g.facet}`}
              tabindex="0"
            >
              <h2 class="fm-panel-head">{g.label} ({g.caps.length})</h2>
              {g.facet !== 'all' && (
                <p class="fm-cmd">
                  <code translate="no">{facetPullCommand(g.facet)}</code>
                  <button
                    type="button"
                    class="copy-btn"
                    data-cmd={facetPullCommand(g.facet)}
                    data-copy={e.capabilities.copy}
                    data-copied={e.capabilities.copied}
                    aria-label={e.capabilities.copy}
                    title={e.capabilities.copy}
                  ><span class="copy-icon" set:html={iconSvg(copy, { size: 16 })} /></button>
                </p>
              )}
              <div class="fm-row fm-head">
                {e.capabilities.columns.map((c) => <span>{c}</span>)}
              </div>
              {g.caps.map((cap, i) => (
                <div class="fm-row">
                  <span class="fm-no">{String(i + 1).padStart(2, '0')}</span>
                  <span translate="no">{cap.id}</span>
                  <span>{cap.tool}</span>
                  <span>{cap.kind}</span>
                  <span>{capabilitySummary(cap, lang)}{cap.gpu && (<span class="fm-gpu">{e.capabilities.gpu}{cap.vramGb ? ` · ${cap.vramGb} ${e.capabilities.vram}` : ''}</span>)}</span>
                  <span class="fm-try">
                    <code translate="no">{facetTryCommand(cap.id)}</code>
                    <button
                      type="button"
                      class="copy-btn"
                      data-cmd={facetTryCommand(cap.id)}
                      data-copy={e.capabilities.copy}
                      data-copied={e.capabilities.copied}
                      aria-label={e.capabilities.copy}
                      title={e.capabilities.copy}
                    ><span class="copy-icon" set:html={iconSvg(copy, { size: 16 })} /></button>
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="sub">
        <span class="label">{e.subproject.kicker}</span>
        <h3><a href={e.subproject.link}>{e.subproject.name}</a></h3>
        <p>{e.subproject.body}</p>
      </div>
    )}
  </section>

  <section class="wrap section fm-record">
    <h2>{e.record.title}</h2>
    <p>{e.record.body}</p>
    <figure class="fm-figure">
      <pre class="fm-pre" translate="no" set:html={recordHtml} />
      <figcaption>{e.record.caption}</figcaption>
    </figure>
  </section>

  <section class="wrap section fm-verbs">
    <h2>{e.verbs.title}</h2>
    <ol class="fm-verb-list">
      {e.verbs.items.map(([verb, gloss]) => (
        <li>
          <span class="fm-verb">{verb}</span>
          <span class="fm-gloss">{gloss}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section fm-faq">
    <h2>{e.faq.title}</h2>
    <dl class="fm-faq-list">
      {e.faq.items.map(([q, a]) => (
        <div class="fm-faq-item">
          <dt>{q}</dt>
          <dd set:html={a} />
        </div>
      ))}
    </dl>
  </section>
</ExperimentLayout>

<script>
  import { COPY_DONE_MS, setCopyState } from '../../lib/copy-morph';
  (function () {
    // Copy a facet install or capability try command. On success the icon
    // morphs to a check and the accessible name reads "Copied"; when the
    // Clipboard API is missing or the context is insecure, the write rejects
    // and the button is left untouched.
    document.querySelectorAll('[data-fm-tabs] .copy-btn').forEach(function (btn) {
      var label = btn.getAttribute('aria-label') || '';
      btn.addEventListener('click', async function () {
        var cmd = btn.getAttribute('data-cmd') || '';
        try { await navigator.clipboard.writeText(cmd); } catch { return; }
        var copied = btn.getAttribute('data-copied') || '';
        setCopyState(btn, true);
        if (copied) btn.setAttribute('aria-label', copied);
        setTimeout(function () {
          setCopyState(btn, false);
          if (label) btn.setAttribute('aria-label', label);
        }, COPY_DONE_MS);
      });
    });
    var root = document.querySelector('[data-fm-tabs]');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role=tabpanel]'));
    if (!tabs.length || tabs.length !== panels.length) return;
    function select(i) {
      tabs.forEach(function (btn, j) {
        var on = j === i;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (p, j) { p.hidden = j !== i; });
    }
    tabs.forEach(function (btn, i) {
      btn.addEventListener('click', function () { select(i); });
      btn.addEventListener('keydown', function (ev) {
        var k = ev.key;
        var n = tabs.length;
        var next = -1;
        if (k === 'ArrowRight') next = (i + 1) % n;
        else if (k === 'ArrowLeft') next = (i - 1 + n) % n;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = n - 1;
        else return;
        ev.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
    root.setAttribute('data-ready', '');
    select(0);
  })();
</script>

<style>
  .fm-headline {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(42px, 7.2vw, 108px);
    line-height: 0.92;
    text-wrap: balance;
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
    border-radius: 0;
  }
  .fm-hero {
    display: grid;
    gap: 0;
  }
  .fm-index .fm-row {
    display: grid;
    grid-template-columns: 3rem 1.4fr 0.8fr 1.6fr 1fr 1.8fr;
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--surface-line);
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-cmd {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--surface-ink-dim);
  }
  .fm-cmd code, .fm-try code {
    background: color-mix(in srgb, var(--surface-ink) 7%, transparent);
    padding: 2px 6px;
    overflow-wrap: anywhere;
  }
  .fm-try {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  /* Same chip as the encyclopedia's copy button, in this page's palette: the
     bench roles are the parchment ground's ink and vanish on the dark facet
     surface (--bench-line is 1.01:1 here). */
  .copy-btn { flex: none; }
  .copy-btn { font-family: var(--font-mono); font-size: 11px; background: none; border: 1px solid var(--surface-line); color: var(--surface-ink-dim); padding: 2px 6px; cursor: pointer; border-radius: 4px; display: inline-flex; align-items: center; }
  .copy-btn .copy-icon { display: inline-flex; width: 16px; height: 16px; line-height: 0; }
  .copy-btn .copy-icon > svg, .copy-btn .copy-icon morph-icon { width: 16px; height: 16px; display: block; }
  .copy-btn .copy-icon[data-icon='check'] { color: var(--surface-ink); }
  .fm-index .fm-head {
    font-family: var(--font-mono);
    color: var(--surface-ink-faint);
    border-bottom: 1px solid var(--surface-line);
  }
  .fm-index .fm-no {
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
  }
  .fm-gpu {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border: 1px solid var(--surface-line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--surface-ink-dim);
  }
  .fm-cap .thumbs { display: flex; justify-content: center; gap: 0; flex-wrap: wrap; overflow-x: auto; }
  .fm-cap .thumbs button { font-family: 'Old Standard TT', serif; font-size: 15px; letter-spacing: 0.04em; color: var(--surface-ink); background: color-mix(in srgb, var(--surface-ink) 6%, transparent); border: 1px solid var(--surface-line); border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 16px 5px; margin: 0 2px; cursor: pointer; flex: none; }
  .fm-cap .thumbs button[aria-selected="true"] { background: var(--surface-ink); color: var(--surface-bg); }
  .fm-panels { border-top: 3px double var(--surface-line); padding-top: 18px; }
  .fm-panel[hidden] { display: none; }
  .fm-panel-head { font-family: var(--font-mono); color: var(--surface-ink-dim); margin: 0 0 0.5rem; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
  @media (max-width: 520px) {
    .fm-cap .thumbs { justify-content: flex-start; flex-wrap: nowrap; }
    .fm-cap .thumbs button { font-size: 13px; padding: 5px 9px 4px; margin: 0 1px; }
  }
  .ok {
    color: var(--essence);
  }
  .fm-record {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-record h2 {
    margin-block: 2.2rem 1rem;
  }
  .fm-record p {
    color: var(--surface-ink-dim);
  }
  .fm-figure {
    margin: 1.5rem 0 0;
    border-radius: 0;
    min-width: 0;
  }
  .fm-pre {
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
    border: 1px solid var(--surface-line);
    border-radius: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  .fm-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    color: var(--surface-ink-faint);
  }
  .fm-verbs,
  .fm-faq {
    padding-block: 2.5rem 0;
  }
  .fm-verbs {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-verb-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .fm-verb-list li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--surface-line);
    border-radius: 0;
  }
  .fm-verb {
    font-family: var(--font-mono);
    color: var(--surface-ink);
  }
  .fm-gloss {
    color: var(--surface-ink-dim);
  }
  .fm-faq {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-faq-list {
    margin: 1.5rem 0 0;
  }
  .fm-faq-item {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--surface-line);
    border-radius: 0;
  }
  .fm-faq-item dt {
    font-family: var(--font-mono);
    color: var(--surface-ink);
  }
  .fm-faq-item dd {
    margin: 0.4rem 0 0;
    color: var(--surface-ink-dim);
  }
  @media (max-width: 47.99rem) {
    .fm-index .fm-head {
      display: none;
    }
    .fm-index .fm-row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "no name"
        "tool out"
        "sum sum"
        "try try";
      gap: 0.2rem 0.6rem;
    }
    .fm-index .fm-no {
      grid-area: no;
    }
    .fm-index .fm-row > span:nth-child(2) {
      grid-area: name;
    }
    .fm-index .fm-row > span:nth-child(3) {
      grid-area: tool;
    }
    .fm-index .fm-row > span:nth-child(4) {
      grid-area: out;
    }
    .fm-index .fm-row > span:nth-child(5) {
      grid-area: sum;
    }
    .fm-index .fm-try {
      grid-area: try;
      flex-wrap: wrap;
    }
    .fm-hero-text {
      min-width: 0;
      max-width: 100%;
    }
    .fm-headline {
      font-size: clamp(34px, 11vw, 52px);
    }
  }
</style>
