---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
import { byId } from '../../lib/experiments';
import { readFacetCapabilities, groupFacetCapabilities } from '../../lib/catalogs';
import { dialArcs, demoCap, demoText } from '../../lib/facet-dial';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments['facetmedia'];
const exp = byId('facetmedia');
const caps = readFacetCapabilities();
const facets = groupFacetCapabilities(caps, e.capabilities.facetLabels);
const arcs = dialArcs(facets, caps.length);
const summaryFor = (id: string, fallback: string) =>
  lang === 'es' ? (e.capabilities.summaries[id] ?? fallback) : fallback;

// The record beside every asset, laid out over 10 lines as in the mockup.
// Yellow (span.ok) marks only what was verified: the status and the metrics.
const recordHtml = [
  '{',
  '  "capability": "comfy.still",',
  '  "package": { "name": "comfy",',
  '    "version": "0.1.0" },',
  '  "models": [ "flux2-klein-4b" ],',
  '  "params": { "seed": 300, "width": 1344, "height": 768 },',
  '  "verification": { "status": <span class="ok">"passed"</span>,',
  '    "metrics": { "width": <span class="ok">1344</span>, "height": <span class="ok">768</span> } },',
  '  "licenses": [ { "spdx": "Apache-2.0", "commercial_use": true } ]',
  '}',
].join('\n');
---

<ExperimentLayout id="facetmedia">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">{exp.motif}</p>
  <Fragment slot="hero-visual">
    <div class="fm-hero">
      <div class="fm-hero-text">
        <p class="fm-headline">{e.headline}</p>
        <p class="fm-meta"><span>{exp.number} · {e.release}</span><span>{e.facets}</span></p>
      </div>
      <figure class="fm-dial" data-fm-dial>
        <svg viewBox="0 0 240 240" role="img" aria-label={e.capabilities.dial.aria}>
          <circle class="fm-dial-track" cx="120" cy="120" r="96"></circle>
          {arcs.map((a) => (
            <path class="fm-dial-arc" data-facet={a.facet} d={a.d}></path>
          ))}
        </svg>
        <span class="fm-dial-center">{caps.length} {e.capabilities.dial.capabilities} · {facets.length} {e.capabilities.dial.facets}</span>
        <a class="fm-more" href="#capacidades">{e.capabilities.kicker}</a>
        <figcaption class="fm-dial-demos" hidden>
          {facets.map((f) => {
            const cap = demoCap(f);
            return cap && <span class="fm-dial-demo" data-facet={f.facet} hidden>{cap.id} → {demoText(cap, e.capabilities.dial)}</span>;
          })}
        </figcaption>
      </figure>
    </div>
  </Fragment>

  <section id="capacidades" class="wrap section fm-index fm-cap" data-fm-tabs>
    {caps.length > 0 ? (
      <>
        <div class="thumbs" role="tablist" aria-label={e.capabilities.tabsAria}>
          {facets.map((f, j) => (
            <button
              type="button"
              role="tab"
              id={`fm-tab-${f.facet}`}
              aria-controls={`fm-panel-${f.facet}`}
              aria-selected={j === 0 ? 'true' : 'false'}
              tabindex={j === 0 ? 0 : -1}
            >{f.label} ({f.caps.length})</button>
          ))}
        </div>
        <div class="fm-panels">
          {facets.map((f, j) => (
            <div
              class="fm-panel"
              role="tabpanel"
              id={`fm-panel-${f.facet}`}
              aria-labelledby={`fm-tab-${f.facet}`}
              tabindex="0"
            >
              <h2 class="fm-panel-head">{f.label} ({f.caps.length})</h2>
              <div class="fm-row fm-head">
                {e.capabilities.columns.map((c) => <span>{c}</span>)}
              </div>
              {f.caps.map((cap, i) => (
                <div class="fm-row">
                  <span class="fm-no">{String(i + 1).padStart(2, '0')}</span>
                  <span translate="no">{cap.id}</span>
                  <span>{cap.tool}</span>
                  <span>{cap.kind}</span>
                  <span>{summaryFor(cap.id, cap.summary)}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="sub">
        <span class="label">{e.subproject.kicker}</span>
        <h3><a href={e.subproject.link}>{e.subproject.name}</a></h3>
        <p>{e.subproject.body}</p>
      </div>
    )}
  </section>

  <section class="wrap section fm-record">
    <h2>{e.record.title}</h2>
    <p>{e.record.body}</p>
    <figure class="fm-figure">
      <pre class="fm-pre" translate="no" set:html={recordHtml} />
      <figcaption>{e.record.caption}</figcaption>
    </figure>
  </section>

  <section class="wrap section fm-verbs">
    <h2>{e.verbs.title}</h2>
    <ol class="fm-verb-list">
      {e.verbs.items.map(([verb, gloss]) => (
        <li>
          <span class="fm-verb">{verb}</span>
          <span class="fm-gloss">{gloss}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section fm-faq">
    <h2>{e.faq.title}</h2>
    <dl class="fm-faq-list">
      {e.faq.items.map(([q, a]) => (
        <div class="fm-faq-item">
          <dt>{q}</dt>
          <dd set:html={a} />
        </div>
      ))}
    </dl>
  </section>
</ExperimentLayout>

<script>
  (function () {
    var dial = document.querySelector('[data-fm-dial]');
    if (dial && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var arcs = Array.prototype.slice.call(dial.querySelectorAll('.fm-dial-arc'));
      var demos = Array.prototype.slice.call(dial.querySelectorAll('.fm-dial-demo'));
      var caption = dial.querySelector('.fm-dial-demos');
      if (arcs.length && arcs.length === demos.length) {
        var i = 0;
        var show = function (n) {
          i = n % arcs.length;
          arcs.forEach(function (a, j) { a.classList.toggle('is-lit', j === i); });
          demos.forEach(function (d, j) { d.hidden = j !== i; });
          if (caption) caption.hidden = false;
        };
        show(0);
        setInterval(function () { show(i + 1); }, 4000);
      }
    }
    var root = document.querySelector('[data-fm-tabs]');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role=tabpanel]'));
    if (!tabs.length || tabs.length !== panels.length) return;
    function select(i) {
      tabs.forEach(function (btn, j) {
        var on = j === i;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (p, j) { p.hidden = j !== i; });
    }
    tabs.forEach(function (btn, i) {
      btn.addEventListener('click', function () { select(i); });
      btn.addEventListener('keydown', function (ev) {
        var k = ev.key;
        var n = tabs.length;
        var next = -1;
        if (k === 'ArrowRight') next = (i + 1) % n;
        else if (k === 'ArrowLeft') next = (i - 1 + n) % n;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = n - 1;
        else return;
        ev.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
    root.setAttribute('data-ready', '');
    select(0);
  })();
</script>

<style>
  .fm-headline {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(42px, 7.2vw, 108px);
    line-height: 0.92;
    text-wrap: balance;
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
    border-radius: 0;
  }
  .fm-hero {
    display: grid;
    gap: 0;
  }
  .fm-dial {
    position: relative;
    margin: 1.2rem 0 0;
    aspect-ratio: 2 / 1;
    max-width: 100%;
  }
  .fm-dial svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .fm-dial-track {
    fill: none;
    stroke: var(--surface-line);
    stroke-width: 10;
  }
  .fm-dial-arc {
    fill: none;
    stroke: var(--surface-ink-faint);
    stroke-width: 10;
  }
  .fm-dial-arc.is-lit {
    stroke: var(--essence);
  }
  .fm-dial-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
  }
  .fm-dial-demos {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--surface-ink-dim);
  }
  .fm-more {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
  }
  @media (min-width: 48rem) {
    .fm-hero {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2rem;
    }
    .fm-dial {
      margin: 0;
      width: clamp(180px, 20vw, 260px);
      aspect-ratio: 1 / 1;
    }
  }
  .fm-index .fm-row {
    display: grid;
    grid-template-columns: 3rem 1.4fr 0.8fr 1.6fr 1fr;
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--surface-line);
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-index .fm-head {
    font-family: var(--font-mono);
    color: var(--surface-ink-faint);
    border-bottom: 1px solid var(--surface-line);
  }
  .fm-index .fm-no {
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
  }
  .fm-cap .thumbs { display: flex; justify-content: center; gap: 0; flex-wrap: wrap; overflow-x: auto; }
  .fm-cap .thumbs button { font-family: 'Old Standard TT', serif; font-size: 15px; letter-spacing: 0.04em; color: var(--surface-ink); background: color-mix(in srgb, var(--surface-ink) 6%, transparent); border: 1px solid var(--surface-line); border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 16px 5px; margin: 0 2px; cursor: pointer; flex: none; }
  .fm-cap .thumbs button[aria-selected="true"] { background: var(--surface-ink); color: var(--surface-bg); }
  .fm-panels { border-top: 3px double var(--surface-line); padding-top: 18px; }
  .fm-panel[hidden] { display: none; }
  .fm-panel-head { font-family: var(--font-mono); color: var(--surface-ink-dim); margin: 0 0 0.5rem; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
  @media (max-width: 520px) {
    .fm-cap .thumbs { justify-content: flex-start; flex-wrap: nowrap; }
    .fm-cap .thumbs button { font-size: 13px; padding: 5px 9px 4px; margin: 0 1px; }
  }
  .ok {
    color: var(--essence);
  }
  .fm-record {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-record h2 {
    margin-block: 2.2rem 1rem;
  }
  .fm-record p {
    color: var(--surface-ink-dim);
  }
  .fm-figure {
    margin: 1.5rem 0 0;
    border-radius: 0;
  }
  .fm-pre {
    font-family: var(--font-mono);
    color: var(--surface-ink-dim);
    border: 1px solid var(--surface-line);
    border-radius: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }
  .fm-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    color: var(--surface-ink-faint);
  }
  .fm-verbs,
  .fm-faq {
    padding-block: 2.5rem 0;
  }
  .fm-verbs {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-verb-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .fm-verb-list li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--surface-line);
    border-radius: 0;
  }
  .fm-verb {
    font-family: var(--font-mono);
    color: var(--surface-ink);
  }
  .fm-gloss {
    color: var(--surface-ink-dim);
  }
  .fm-faq {
    color: var(--surface-ink);
    border-radius: 0;
  }
  .fm-faq-list {
    margin: 1.5rem 0 0;
  }
  .fm-faq-item {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--surface-line);
    border-radius: 0;
  }
  .fm-faq-item dt {
    font-family: var(--font-mono);
    color: var(--surface-ink);
  }
  .fm-faq-item dd {
    margin: 0.4rem 0 0;
    color: var(--surface-ink-dim);
  }
  @media (max-width: 47.99rem) {
    .fm-index .fm-row {
      grid-template-columns: 3rem 1fr;
    }
  }
</style>
