---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
import { byId } from '../../lib/experiments';
import { readFileSync, existsSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments.canopy;
const exp = byId('canopy');
// Same figure caption the layout uses for the recorded demo, reused here.
const demoCaption = `${exp.name} — ${t.common.demoBy}`;

// Read supported platforms with accent colors from canopy-registry at build time.
// Glob the platforms/ directory in one pass; silently skips when the registry
// sibling repo isn't checked out (CI, forks).
const registryDir = resolve(process.cwd(), '../canopy-registry');
const platformsDir = resolve(registryDir, 'platforms');
const platformEntries: { name: string; stem: string; color: string }[] = [];

if (existsSync(platformsDir)) {
  const files = readdirSync(platformsDir).filter((f) => f.endsWith('.toml'));
  for (const file of files) {
    const stem = file.replace('.toml', '');
    const content = readFileSync(resolve(platformsDir, file), 'utf-8');
    const rootSection = content.split(/^\[/m)[0] || '';
    const toolNameMatch = rootSection.match(/tool_name\s*=\s*["']([^"']+)["']/);
    const name = toolNameMatch ? toolNameMatch[1] : stem;
    const cliSection = content.split('[cli]')[1] || '';
    const colorMatch = cliSection.match(/accent_color\s*=\s*\[(\d+),\s*(\d+),\s*(\d+)\]/);
    const color = colorMatch ? `rgb(${colorMatch[1]}, ${colorMatch[2]}, ${colorMatch[3]})` : 'var(--canopy)';
    platformEntries.push({ name, stem, color });
  }
}

// The graph-engine figure: a static graph that runs on its own clock — a token
// travelling the happy path, forever, with no scroll position involved. Harness
// accents come from the registry read above.
const hue = (id: string, fallback: string) =>
  platformEntries.find((p) => p.name === id || p.stem === id)?.color ?? fallback;

const NEUTRAL = 'var(--ink-dim)';
const gbNodes = [
  { id: 'spec', kind: 'chip', x: 7, y: 32, label: 'spec', harness: '', color: NEUTRAL },
  { id: 'implement', kind: 'agent', x: 46, y: 32, label: 'implement', harness: 'claude', color: hue('claude', '#d97757') },
  { id: 'gates', kind: 'check', x: 64, y: 13, label: 'gates', harness: 'sh', color: NEUTRAL },
  { id: 'review', kind: 'agent', x: 84, y: 32, label: 'review', harness: 'opencode', color: hue('opencode', '#5c9cf5') },
  { id: 'resilience', kind: 'agent', x: 64, y: 53, label: 'resilience', harness: 'mimo', color: hue('mimo', '#fb8147') },
  { id: 'p1', kind: 'agent', x: 21, y: 11, label: 'propose', harness: 'codex', color: hue('codex', '#57c7c3') },
  { id: 'p2', kind: 'agent', x: 24, y: 32, label: 'propose', harness: 'gemini', color: hue('gemini', '#c09ee4') },
  { id: 'p3', kind: 'agent', x: 21, y: 53, label: 'propose', harness: 'copilot', color: hue('copilot', '#aa00aa') },
  { id: 'quorum', kind: 'gate', x: 34, y: 32, label: 'quorum', harness: '', color: NEUTRAL },
];
const gbEdges = [
  { from: 'spec', to: 'implement', cond: 'pass' },
  { from: 'implement', to: 'gates', cond: 'pass' },
  { from: 'gates', to: 'implement', cond: 'fail' },
  { from: 'gates', to: 'review', cond: 'pass' },
  { from: 'review', to: 'implement', cond: 'fail' },
  { from: 'implement', to: 'resilience', cond: 'fail' },
  { from: 'resilience', to: 'implement', cond: 'pass' },
  { from: 'spec', to: 'p1', cond: 'pass' },
  { from: 'spec', to: 'p2', cond: 'pass' },
  { from: 'spec', to: 'p3', cond: 'pass' },
  { from: 'p1', to: 'quorum', cond: 'pass' },
  { from: 'p2', to: 'quorum', cond: 'pass' },
  { from: 'p3', to: 'quorum', cond: 'pass' },
  { from: 'quorum', to: 'implement', cond: 'pass' },
];
const gbNode = (id: string) => gbNodes.find((n) => n.id === id)!;
// Happy-path pulses: one token flowing spec → implement → gates → review, and in
// parallel the ensemble route spec → p2 → quorum → implement. `d` staggers the
// legs on a shared CSS clock so the token appears to hop node to node.
const gbPulses = [
  { from: 'spec', to: 'implement', d: 0 },
  { from: 'implement', to: 'gates', d: 1 },
  { from: 'gates', to: 'review', d: 2 },
  { from: 'spec', to: 'p2', d: 0 },
  { from: 'p2', to: 'quorum', d: 1 },
  { from: 'quorum', to: 'implement', d: 2 },
];
const ORBIT_DOTS = [
  [50, 9], [68, 14], [81, 29], [78, 50], [61, 67], [39, 68], [20, 54],
  [15, 32], [29, 16], [50, 22], [66, 32], [58, 50], [39, 49], [33, 32],
];
---
<ExperimentLayout id="canopy">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">⠿⠶⠦⠤ · ⠤⠦⠶⠿</p>
  <div slot="hero-visual" class="orb-stage" aria-hidden="true">
    <svg viewBox="0 0 100 78" role="presentation">
      <ellipse class="orb-ring ring-a" cx="50" cy="39" rx="35" ry="22" />
      <ellipse class="orb-ring ring-b" cx="50" cy="39" rx="23" ry="34" />
      <circle class="orb-core" cx="50" cy="39" r="17" />
      {ORBIT_DOTS.map(([x, y], i) => <circle class="orb-dot" style={`--i:${i}`} cx={x} cy={y} r={i % 3 === 0 ? 1.4 : 0.85} />)}
      <path class="orb-trace" d="M18 39 C28 21 36 57 50 39 S72 20 82 39" />
    </svg>
    <span class="orb-readout mono">GRAPH ENGINE · LIVE</span>
  </div>
  <Fragment slot="before-genesis">
    <div class="wrap section">
      <p class="mono-kicker">
        <span class="kicker-badge">daemon</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">tui</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">graph engine</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">mcp</span>
      </p>

      <section class="platforms-section">
        <span class="label">{e.platforms.kicker}</span>
        <ul class="platforms">
          {platformEntries.map(({ name, color }) => (
            <li style={`--pcolor: ${color}`}>{name}</li>
          ))}
        </ul>
      </section>
    </div>
  </Fragment>

  <section class="wrap section">
    <span class="label">{e.layer.kicker}</span>
    <div class="cols">
      {e.layer.cols.map(([h, b]) => (
        <div class="col"><h3>{h}</h3><p>{b}</p></div>
      ))}
    </div>
  </section>

  <!-- Graph engine — a graph that runs on its own. Every edge is already there
       and a token travels the happy path on a pure CSS loop, so the figure
       reads the same at any scroll position: nothing here waits for you. Each
       agent node sits on a different harness color from the registry. -->
  <section class="wrap section auto-graph">
    <span class="label">{e.builder.kicker}</span>
    <div class="ag-stage">
      <svg class="ag-svg" viewBox="0 0 100 64" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        {gbEdges.map((edge) => {
          const a = gbNode(edge.from);
          const b = gbNode(edge.to);
          return edge.cond === 'fail' ? (
            <line
              class="ag-edge ag-edge-fail"
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            />
          ) : (
            <line
              class="ag-edge ag-edge-pass"
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            />
          );
        })}
        {gbPulses.map((p) => {
          const a = gbNode(p.from);
          const b = gbNode(p.to);
          return (
            <circle
              class="ag-pulse"
              r="0.9"
              style={`--x1:${a.x}px; --y1:${a.y}px; --x2:${b.x}px; --y2:${b.y}px; --d:${p.d}s`}
            />
          );
        })}
        {gbNodes.map((n) => (
          <g
            class={`ag-node ag-${n.kind}`}
            style={`--nc:${n.color}`}
            transform={`translate(${n.x}, ${n.y})`}
          >
            {n.kind === 'chip' && <rect x="-4.5" y="-2.6" width="9" height="5.2" rx="1" class="ag-shape" />}
            {n.kind === 'agent' && <circle r="3" class="ag-shape" />}
            {n.kind === 'check' && <rect x="-2.7" y="-2.7" width="5.4" height="5.4" rx="0.6" class="ag-shape" />}
            {n.kind === 'gate' && <rect x="-2.5" y="-2.5" width="5" height="5" rx="0.5" class="ag-shape ag-diamond" />}
            <text class="ag-label" dy={n.kind === 'chip' ? 1 : 5.8} text-anchor="middle">{n.label}</text>
            {n.harness && <text class="ag-harness" dy="8.4" text-anchor="middle">{n.harness}</text>}
          </g>
        ))}
      </svg>
      <div class="ag-caption">
        <h2>{e.builder.title}</h2>
        <ol class="ag-steps">
          {e.builder.steps.map(([h, b], i) => (
            <li class="ag-step">
              <span class="ag-step-num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{h}</h3>
              <p>{b}</p>
            </li>
          ))}
        </ol>
        <p class="ag-outro">{e.builder.outro}</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <span class="label">{e.graphs.kicker}</span>
    <div class="cols">
      {e.graphs.cols.map(([h, b]) => (
        <div class="col"><h3>{h}</h3><p>{b}</p></div>
      ))}
    </div>
  </section>
</ExperimentLayout>

<style>
  .section { padding-block: 2rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.2rem; margin-top: 1.4rem; }
  .col { background: var(--bg-raise); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 1.5rem 1.5rem 1.4rem; }
  .col h3 { color: var(--ink-hi, #ffffff); font-size: 1.05rem; margin-bottom: 0.5rem; }
  .col p { margin: 0; color: var(--ink-dim); font-size: 0.95rem; }

  /* ── Hero extras ──────────────────────────────────────────────────────
     A fragment of the field the TUI actually draws, and a mono kicker row.
     The machine's own vocabulary, on hairlines. (The empty 16:9 placeholder
     that used to live here is gone: the layout renders the real recorded
     demo, and a second empty frame would say the same thing twice.) */

  .ascii-motif {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--canopy);
    opacity: 0.5;
    margin: 0 0 0.5rem;
  }

  .orb-stage {
    width: min(100%, 27rem);
    aspect-ratio: 1.45;
    position: relative;
    margin: 0.25rem auto 0.5rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 50%, rgba(0,130,124,.2), transparent 68%);
  }
  .orb-stage svg { width: 100%; height: 100%; overflow: visible; }
  .orb-ring { fill: none; stroke: rgba(203,255,252,.26); stroke-width: .3; }
  .ring-a { transform-origin: 50px 39px; animation: orb-spin 24s linear infinite; }
  .ring-b { transform-origin: 50px 39px; animation: orb-spin 31s linear infinite reverse; }
  .orb-core { fill: rgba(0,55,52,.7); stroke: rgba(203,255,252,.54); stroke-width: .5; }
  .orb-dot { fill: #cbfffc; opacity: .55; }
  .orb-dot:nth-of-type(3n) { opacity: .9; }
  .orb-dot:nth-of-type(2n) { fill: #edfffe; opacity: .7; }
  .orb-trace { fill: none; stroke: #00a9a0; stroke-width: .55; opacity: .8; stroke-dasharray: 2 2; }
  .orb-readout { position: absolute; bottom: .25rem; color: var(--ink-dim); font-size: .58rem; letter-spacing: .14em; }
  @keyframes orb-spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .ring-a, .ring-b { animation: none; } }

  .mono-kicker {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem;
    margin: 0 0 1.6rem;
    font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .kicker-badge {
    border: 1px solid var(--line);
    border-radius: var(--radius-ctl);
    padding: 0.2rem 0.55rem;
    color: var(--ink-dim);
  }
  .kicker-sep { color: var(--ink-faint); }

  /* Platforms — colored badges from registry */
  .platforms-section { padding-block: 0.5rem 1rem; }
  .platforms { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .platforms li {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;
    color: var(--pcolor); padding: 0.3rem 0.65rem;
    background: var(--bg-deep, #011d1c);
    border: 1px solid var(--pcolor);
    border-radius: var(--radius-ctl);
    white-space: nowrap;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .platforms li:hover {
    background: color-mix(in srgb, var(--pcolor) 15%, #011d1c);
  }

  /* ── Graph engine figure ──────────────────────────────────────────────
     Nothing here is driven by scroll. Every node and edge is drawn at full
     strength from the start; the only motion is the token, which rides a
     shared CSS clock (--d staggers the legs) and loops forever. Under
     prefers-reduced-motion the loop is never declared, so the graph is
     simply a still, fully assembled figure. */
  .auto-graph { padding-block: 2rem 3rem; }
  .ag-stage {
    display: flex; align-items: flex-start; justify-content: center; gap: 4rem;
    margin-top: 1.6rem;
  }
  .ag-svg { width: min(38rem, 54vw); height: auto; flex-shrink: 0; }
  .ag-caption { max-width: 24rem; }
  .ag-caption h2 { font-size: 1.7rem; margin: 0 0 1.4rem; }

  /* The quietest *text* on this page carries the AA lift, not the token: the
     surface block pins --ink-faint to Slate Deep #707777 (3.52:1 on the Abyss
     canvas — a decorative tint, fine for fills), so the step numerals and the
     outro below use the same Silver-Mist-family grey global.css declares for
     the tui substrate (6.54:1). Numbers that no one can read are not quiet. */
  .ag-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.4rem; }
  .ag-step-num { display: block; color: #9aa8a7; font-size: 0.72rem; letter-spacing: 0.1em; margin-bottom: 0.4rem; }
  .ag-step h3 { color: var(--ink-hi, #ffffff); font-size: 1.05rem; margin: 0 0 0.5rem; }
  .ag-step p { margin: 0; color: var(--ink-dim); font-size: 0.95rem; line-height: 1.65; }
  .ag-outro { margin: 1.4rem 0 0; color: #9aa8a7; font-size: 0.88rem; line-height: 1.6; }

  /* Nodes */
  .ag-shape {
    fill: color-mix(in srgb, var(--nc) 12%, var(--bg));
    stroke: var(--nc); stroke-width: 0.4;
  }
  .ag-diamond { rotate: 45deg; }
  .ag-label { font-family: var(--font-mono); font-size: 2.7px; fill: var(--ink); }
  .ag-chip .ag-label { fill: var(--ink-dim); }
  .ag-harness { font-family: var(--font-mono); font-size: 2.2px; fill: var(--nc); letter-spacing: 0.02em; }

  /* Edges — pass routes in essence, failures in red dashes, both always lit */
  .ag-edge { stroke-width: 0.35; }
  .ag-edge-pass { stroke: color-mix(in srgb, var(--canopy) 65%, var(--line)); }
  .ag-edge-fail {
    stroke: color-mix(in srgb, #e0605a 55%, var(--line));
    stroke-dasharray: 1.3 1; opacity: 0.55;
  }

  /* The travelling token. It is invisible by default and only ever shown
     moving, so the static figure stays clean. */
  .ag-pulse { fill: var(--canopy); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .ag-pulse {
      animation: ag-travel 4s linear infinite;
      animation-delay: var(--d);
    }
  }
  @keyframes ag-travel {
    0%    { transform: translate(var(--x1), var(--y1)); opacity: 0; }
    4%    { opacity: 0.85; }
    24%   { opacity: 0.85; }
    27.5% { transform: translate(var(--x2), var(--y2)); opacity: 0; }
    100%  { transform: translate(var(--x2), var(--y2)); opacity: 0; }
  }

  @media (max-width: 52rem) {
    .ag-stage { flex-direction: column; align-items: center; gap: 2rem; }
    .ag-svg { width: min(34rem, 90vw); }
    .ag-caption { max-width: 100%; }
  }
</style>
