---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
import { byId } from '../../lib/experiments';
import { readFileSync, existsSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import GraphMorph from '../../components/GraphMorph.astro';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments.canopy;
const exp = byId('canopy');
// Same figure caption the layout uses for the recorded demo, reused here.
const demoCaption = `${exp.name} — ${t.common.demoBy}`;

// Read supported platforms with accent colors from canopy-registry at build time.
// Glob the platforms/ directory in one pass; silently skips when the registry
// sibling repo isn't checked out (CI, forks).
const registryDir = resolve(process.cwd(), '../canopy-registry');
const platformsDir = resolve(registryDir, 'platforms');
const platformEntries: { name: string; stem: string; color: string }[] = [];

if (existsSync(platformsDir)) {
  const files = readdirSync(platformsDir).filter((f) => f.endsWith('.toml'));
  for (const file of files) {
    const stem = file.replace('.toml', '');
    const content = readFileSync(resolve(platformsDir, file), 'utf-8');
    const rootSection = content.split(/^\[/m)[0] || '';
    const toolNameMatch = rootSection.match(/tool_name\s*=\s*["']([^"']+)["']/);
    const name = toolNameMatch ? toolNameMatch[1] : stem;
    const cliSection = content.split('[cli]')[1] || '';
    const colorMatch = cliSection.match(/accent_color\s*=\s*\[(\d+),\s*(\d+),\s*(\d+)\]/);
    const color = colorMatch ? `rgb(${colorMatch[1]}, ${colorMatch[2]}, ${colorMatch[3]})` : 'var(--canopy)';
    platformEntries.push({ name, stem, color });
  }
}

// One spec survives the graph: a single 18s autonomous loop — spec →
// implement → gates RED (bounce back) → implement → gates GREEN (latches) →
// review → ensemble fan-out (3 proposers + quorum) → resilience (quota death
// + clock wake) → review → commit (aurora badge) → 2s hold → restart.
// Harness accents come from the registry read above.
const hue = (id: string, fallback: string) =>
  platformEntries.find((p) => p.name === id || p.stem === id)?.color ?? fallback;

const NEUTRAL = 'var(--ink-dim)';
const gbNodes = [
  { id: 'spec', kind: 'chip', x: 6, y: 32, label: 'spec', harness: '', color: NEUTRAL, flash: 0.50 },
  { id: 'p1', kind: 'agent', x: 17, y: 12, label: 'propose', harness: 'codex', color: hue('codex', '#57c7c3'), flash: 0.57 },
  { id: 'p2', kind: 'agent', x: 17, y: 32, label: 'propose', harness: 'gemini', color: hue('gemini', '#c09ee4'), flash: 0.56 },
  { id: 'p3', kind: 'agent', x: 17, y: 52, label: 'propose', harness: 'copilot', color: hue('copilot', '#aa00aa'), flash: 0.58 },
  { id: 'quorum', kind: 'gate', x: 28, y: 32, label: 'quorum', harness: '', color: NEUTRAL, flash: 0.655 },
  { id: 'implement', kind: 'agent', x: 43, y: 32, label: 'implement', harness: 'claude', color: hue('claude', '#d97757'), flash: 0.07 },
  { id: 'gates', kind: 'check', x: 57, y: 12, label: 'gates', harness: 'sh', color: NEUTRAL, flash: 0.20 },
  { id: 'resilience', kind: 'agent', x: 57, y: 52, label: 'resilience', harness: 'mimo', color: hue('mimo', '#fb8147'), flash: 0.80 },
  { id: 'review', kind: 'agent', x: 72, y: 32, label: 'review', harness: 'opencode', color: hue('opencode', '#5c9cf5'), flash: 0.47 },
  { id: 'commit', kind: 'commit', x: 89, y: 32, label: '', harness: '', color: NEUTRAL, flash: 0.87 },
];
const gbEdges = [
  { from: 'spec', to: 'implement', cond: 'pass' },
  { from: 'implement', to: 'gates', cond: 'pass' },
  { from: 'gates', to: 'implement', cond: 'fail' },
  { from: 'gates', to: 'review', cond: 'pass' },
  { from: 'review', to: 'implement', cond: 'fail' },
  { from: 'implement', to: 'resilience', cond: 'fail' },
  { from: 'resilience', to: 'implement', cond: 'pass' },
  { from: 'spec', to: 'p1', cond: 'pass' },
  { from: 'spec', to: 'p2', cond: 'pass' },
  { from: 'spec', to: 'p3', cond: 'pass' },
  { from: 'p1', to: 'quorum', cond: 'pass' },
  { from: 'p2', to: 'quorum', cond: 'pass' },
  { from: 'p3', to: 'quorum', cond: 'pass' },
  { from: 'quorum', to: 'implement', cond: 'pass' },
  { from: 'review', to: 'commit', cond: 'pass' },
];
const gbNode = (id: string) => gbNodes.find((n) => n.id === id)!;
// Loop schedule (fractions of the 18s cycle; arrive = depart + 0.06). Red legs:
// the gates bounce-back and the implement → resilience quota death.
const gbPulses = [
  { from: 'spec', to: 'implement', t0: 0.01, red: false },
  { from: 'implement', to: 'gates', t0: 0.14, red: false },
  { from: 'gates', to: 'implement', t0: 0.21, red: true },
  { from: 'implement', to: 'gates', t0: 0.31, red: false },
  { from: 'gates', to: 'review', t0: 0.41, red: false },
  { from: 'spec', to: 'p2', t0: 0.50, red: false },
  { from: 'spec', to: 'p1', t0: 0.51, red: false },
  { from: 'spec', to: 'p3', t0: 0.52, red: false },
  { from: 'p1', to: 'quorum', t0: 0.59, red: false },
  { from: 'p2', to: 'quorum', t0: 0.595, red: false },
  { from: 'p3', to: 'quorum', t0: 0.60, red: false },
  { from: 'quorum', to: 'implement', t0: 0.67, red: false },
  { from: 'implement', to: 'resilience', t0: 0.74, red: true },
  { from: 'resilience', to: 'implement', t0: 0.775, red: false },
  { from: 'review', to: 'commit', t0: 0.84, red: false },
];
// Hero morph accents: harness colours from the registry, plus model families
// that ride on a harness (deepseek, muse, mimo, qwen) with fixed fallbacks.
const morphColors: Record<string, string> = {
  claude: hue('claude', '#d97757'),
  opencode: hue('opencode', '#5c9cf5'),
  codex: hue('codex', '#57c7c3'),
  gemini: hue('gemini', '#c09ee4'),
  copilot: hue('copilot', '#aa00aa'),
  kiro: hue('kiro', '#9d7cf5'),
  mimo: hue('mimocode', '#fb8147'),
  qwen: hue('qwen', '#615ced'),
  deepseek: '#4d6bfe',
  muse: '#e7b04b',
};
---
<ExperimentLayout id="canopy">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">{exp.motif}</p>
  <div slot="hero-visual" class="morph-stage">
    <GraphMorph colors={morphColors} captions={e.morph} />
  </div>
  <Fragment slot="before-genesis">
    <div class="wrap section">
      <p class="mono-kicker">
        <span class="kicker-badge">daemon</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">tui</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">graph engine</span>
        <span class="kicker-sep" aria-hidden="true">·</span>
        <span class="kicker-badge">mcp</span>
      </p>

      <section class="platforms-section">
        <span class="label">{e.platforms.kicker}</span>
        <ul class="platforms">
          {platformEntries.map(({ name, color }) => (
            <li style={`--pcolor: ${color}`}>{name}</li>
          ))}
        </ul>
      </section>
    </div>
  </Fragment>

  <section class="wrap section">
    <span class="label">{e.layer.kicker}</span>
    <div class="cols">
      {e.layer.cols.map(([h, b]) => (
        <div class="col"><h3>{h}</h3><p>{b}</p></div>
      ))}
    </div>
  </section>

  <!-- One spec survives the graph — a single spec runs the whole engine on a
       pure CSS 18s loop, red legs included, ending on the commit. Nothing
       here waits for scroll. Each agent node sits on a different harness
       color from the registry. -->
  <section class="wrap section auto-graph">
    <span class="label">{e.builder.kicker}</span>
    <div class="ag-stage">
      <svg class="ag-svg" viewBox="0 0 100 64" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="ag-aurora" x1="0" x2="1">
            <stop offset="0" stop-color="rgb(203,255,252)" />
            <stop offset=".2625" stop-color="rgb(237,255,254)" />
            <stop offset=".4757" stop-color="rgb(255,253,250)" />
            <stop offset=".8896" stop-color="rgb(250,209,255)" />
          </linearGradient>
        </defs>
        {gbEdges.map((edge) => {
          const a = gbNode(edge.from);
          const b = gbNode(edge.to);
          return edge.cond === 'fail' ? (
            <line
              class="ag-edge ag-edge-fail"
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            />
          ) : (
            <line
              class="ag-edge ag-edge-pass"
              x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            />
          );
        })}
        {gbPulses.map((p) => {
          const a = gbNode(p.from);
          const b = gbNode(p.to);
          return (
            <circle
              class={p.red ? 'ag-pulse ag-pulse-red' : 'ag-pulse'}
              r="0.9"
              style={`--x1:${a.x}px; --y1:${a.y}px; --x2:${b.x}px; --y2:${b.y}px; --t0:${p.t0}`}
            />
          );
        })}
        {gbNodes.map((n) => (
          <g
            class={`ag-node ag-${n.kind}`}
            style={`--nc:${n.color}`}
            transform={`translate(${n.x}, ${n.y})`}
          >
            {n.kind === 'chip' && <rect x="-4.5" y="-2.6" width="9" height="5.2" rx="1" class="ag-shape" />}
            {n.kind === 'agent' && <circle r="3" class="ag-shape" />}
            {n.kind === 'check' && <rect x="-2.7" y="-2.7" width="5.4" height="5.4" rx="0.6" class="ag-shape ag-gateshape" />}
            {n.kind === 'check' && <path class="ag-gatecheck" d="M-1.3 0 L-0.3 1.1 L1.5 -1.2" />}
            {n.kind === 'gate' && <rect x="-2.5" y="-2.5" width="5" height="5" rx="0.5" class="ag-shape ag-diamond" />}
            {n.kind === 'commit' && <circle r="3" class="ag-shape ag-commitshape" />}
            {n.kind === 'commit' && <path class="ag-check" d="M-1.3 0 L-0.3 1.1 L1.5 -1.2" />}
            {n.kind === 'commit' && (
              <g class="ag-badge">
                <rect x="-8" y="6.6" width="16" height="4.4" rx="1" />
                <text dy="9.7" text-anchor="middle">⇡ pushed</text>
              </g>
            )}
            {n.kind !== 'commit' && <text class="ag-label" dy={n.kind === 'chip' ? 1 : 5.8} text-anchor="middle">{n.label}</text>}
            {n.harness && <text class="ag-harness" dy="8.4" text-anchor="middle">{n.harness}</text>}
            <circle class="ag-hit" r="4.4" style={`--t0:${n.flash}`} />
          </g>
        ))}
        <g class="ag-redmark">
          <text x="57" y="5.5" text-anchor="middle">✕ cargo test</text>
        </g>
        <g class="ag-clock">
          <circle cx="63" cy="47" r="1.6" class="ag-clockface" />
          <line x1="63" y1="47" x2="63" y2="45.8" class="ag-hand" />
          <line x1="63" y1="47" x2="63.9" y2="47.4" class="ag-hand" />
          <text x="60" y="55.8" text-anchor="middle" class="ag-quota">✕</text>
        </g>
      </svg>
      <div class="ag-caption">
        <p class="ag-stat mono"><span>{e.builder.stat[0]}</span> {e.builder.stat[1]}</p>
        <h2>{e.builder.title}</h2>
        <ol class="ag-steps">
          {e.builder.steps.map(([h, b], i) => (
            <li class={`ag-step ag-beat ag-beat-${i + 1}`}>
              <span class="ag-step-num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{h}</h3>
              <p>{b}</p>
            </li>
          ))}
        </ol>
        <p class="ag-outro">{e.builder.outro}</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <span class="label">{e.graphs.kicker}</span>
    <div class="cols">
      {e.graphs.cols.map(([h, b]) => (
        <div class="col"><h3>{h}</h3><p>{b}</p></div>
      ))}
    </div>
  </section>
</ExperimentLayout>

<style>
  .section { padding-block: 2rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.2rem; margin-top: 1.4rem; }
  .col { background: var(--bg-raise); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 1.5rem 1.5rem 1.4rem; }
  .col h3 { color: var(--ink-hi, #ffffff); font-size: 1.05rem; margin-bottom: 0.5rem; }
  .col p { margin: 0; color: var(--ink-dim); font-size: 0.95rem; }

  /* The recorded-demo frame in the genesis row is a card here too, but
     DemoFigure ships it at 12px with a 22/60px drop shadow — 12px is outside
     auros.md's complete shape vocabulary (cards 16, small 6) and elevation
     comes from the teal stack, never from box-shadow. Re-state both from this
     view: the hairline border the component already draws stays. (Same move
     surfaces.css makes for the paper surface.) */
  :global(html[data-surface='tui'] .exp .demo-frame) {
    border-radius: var(--radius-card);
    box-shadow: none;
  }

  /* ── Primary CTA ────────────────────────────────────────────────────────
     global.css declares this surface's Aurora gradient (--cta-gradient: cyan →
     white → pink) as the install/primary CTA's fill, but the preserved POC
     block in surfaces.css paints the hero button from `:root` (0,4,0) with the
     older teal→aqua sweep — a bare `.btn` rule here can't outrank it. Name the
     surface and the wrapper: this beats (0,4,0) on specificity and matches
     auros.md's Gradient Pill Button (aurora fill, 6px, dark label). The Docs
     button keeps its outline — `.btn.ghost` in surfaces.css is more specific
     still and still sets background: transparent. The hover sets only `filter`
     (no competing rule sets one), because ExperimentLayout's `.btn:hover`
     background loses to this rule and would otherwise leave the CTA with no
     hover feedback. */
  :global(html[data-surface='tui'] .exp .actions .btn:not(.ghost)) {
    background: var(--cta-gradient);
    color: #222222;
    border: 0;
    border-radius: var(--radius-ctl);
  }
  :global(html[data-surface='tui'] .exp .actions .btn:not(.ghost):hover) {
    filter: brightness(1.05);
  }

  /* The install bar is a control, so it takes the 6px control radius —
     neither layout nor surfaces.css gives the tui install bar any radius
     (square corners by default). The POC block also paints its border with
     the drifted pre-Auros teal hairline as a literal (rgba(203,255,252,.16)),
     bypassing the --line token this surface re-states to the Auros white
     hairline — so re-point the color through the token too.
     0-3-1 beats surfaces.css's 0-3-0. */
  :global(html[data-surface='tui'] .exp .cmd) {
    border-radius: var(--radius-ctl);
    border-color: var(--line);
  }

  /* ── Hero extras ──────────────────────────────────────────────────────
     A fragment of the field the TUI actually draws, and a mono kicker row.
     The machine's own vocabulary, on hairlines. (The empty 16:9 placeholder
     that used to live here is gone: the layout renders the real recorded
     demo, and a second empty frame would say the same thing twice.) */

  .ascii-motif {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--canopy);
    opacity: 0.5;
    margin: 0 0 0.5rem;
  }

  /* The hero column is narrow (it centres the lede); the graph breaks out of
     it to a readable width and recentres on the page. */
  .morph-stage {
    width: min(94vw, 56rem);
    margin: 0.5rem 0 0.75rem 50%;
    transform: translateX(-50%);
    padding: 1rem 0.5rem 0.25rem;
    background: radial-gradient(ellipse at 50% 45%, rgba(0,130,124,.18), transparent 70%);
  }

  .mono-kicker {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem;
    margin: 0 0 1.6rem;
    font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .kicker-badge {
    border: 1px solid var(--line);
    border-radius: var(--radius-ctl);
    padding: 0.2rem 0.55rem;
    color: var(--ink-dim);
  }
  .kicker-sep { color: var(--ink-faint); }

  /* Platforms — colored badges from registry */
  .platforms-section { padding-block: 0.5rem 1rem; }
  .platforms { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .platforms li {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;
    color: var(--pcolor); padding: 0.3rem 0.65rem;
    background: var(--bg-deep, #011d1c);
    border: 1px solid var(--pcolor);
    border-radius: var(--radius-ctl);
    white-space: nowrap;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .platforms li:hover {
    background: color-mix(in srgb, var(--pcolor) 15%, #011d1c);
  }

  /* ── One spec survives the graph ────────────────────────────────────
     Single 18s master loop, phase-locked with zero/negative delays only.
     Base styles ARE the END frame (committed graph, green checks, caption 5)
     so prefers-reduced-motion renders a finished run with no animation
     declared. Only opacity/transform/stroke animate — no layout shift. */
  .auto-graph { --loop: 18s; padding-block: 2rem 3rem; }
  .ag-stage {
    display: flex; align-items: flex-start; justify-content: center; gap: 4rem;
    margin-top: 1.6rem;
  }
  .ag-svg { width: min(38rem, 54vw); height: auto; flex-shrink: 0; }
  .ag-caption { max-width: 24rem; }
  .ag-stat { margin: 0 0 0.6rem; color: var(--ink-dim); font-size: 0.85rem; letter-spacing: 0.04em; }
  .ag-stat span { color: var(--phosphor); font-size: 2.1rem; line-height: 1; margin-right: 0.4rem; }
  .ag-caption h2 { font-size: 1.7rem; margin: 0 0 1.4rem; }

  /* The quietest *text* on this page is the AA-lifted helper grey the tui
     substrate declares in global.css (6.54:1 on the Abyss canvas). Slate Deep
     #707777 stays a decorative fill — as text it is 3.52:1,
     which is why global.css re-states --ink-faint above surfaces.css's pin. */
  .ag-steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .ag-step { grid-area: 1 / 1; }
  .ag-step-num { display: block; color: var(--ink-faint); font-size: 0.72rem; letter-spacing: 0.1em; margin-bottom: 0.4rem; }
  .ag-step h3 { color: var(--ink-hi, #ffffff); font-size: 1.05rem; margin: 0 0 0.5rem; }
  .ag-step p { margin: 0; color: var(--ink-dim); font-size: 0.95rem; line-height: 1.65; }
  .ag-outro { margin: 1.4rem 0 0; color: var(--ink-faint); font-size: 0.88rem; line-height: 1.6; }

  /* Nodes */
  .ag-shape {
    fill: color-mix(in srgb, var(--nc) 12%, var(--bg));
    stroke: var(--nc); stroke-width: 0.4;
  }
  .ag-diamond { rotate: 45deg; }
  .ag-label { font-family: var(--font-mono); font-size: 2.7px; fill: var(--ink); }
  .ag-chip .ag-label { fill: var(--ink-dim); }
  .ag-harness { font-family: var(--font-mono); font-size: 2.2px; fill: var(--nc); letter-spacing: 0.02em; }

  /* Edges — pass routes in essence, failures in red dashes, both always lit */
  .ag-edge { stroke-width: 0.35; }
  .ag-edge-pass { stroke: color-mix(in srgb, var(--canopy) 65%, var(--line)); }
  .ag-edge-fail {
    stroke: color-mix(in srgb, #e0605a 55%, var(--line));
    stroke-dasharray: 1.3 1; opacity: 0.55;
  }

  /* Arrival flashes (base: hidden) */
  .ag-hit { fill: none; stroke: var(--canopy); stroke-width: 0.4; opacity: 0; }

  /* Travelling tokens (base: hidden) */
  .ag-pulse { fill: var(--canopy); opacity: 0; }
  .ag-pulse-red { fill: #e0605a; }

  /* Latched END states (base = committed graph) */
  .ag-gateshape { stroke: var(--canopy); fill: color-mix(in srgb, var(--canopy) 12%, var(--bg)); }
  .ag-gatecheck { fill: none; stroke: var(--canopy); stroke-width: 0.5; opacity: 1; }
  .ag-commitshape { stroke: var(--canopy); fill: color-mix(in srgb, var(--canopy) 12%, var(--bg)); }
  .ag-check { fill: none; stroke: var(--canopy); stroke-width: 0.5; opacity: 1; }
  .ag-badge rect { fill: url(#ag-aurora); }
  .ag-badge text { font-family: var(--font-mono); font-size: 2.2px; fill: #222222; }
  .ag-badge { opacity: 1; }
  .ag-redmark { opacity: 0; }
  .ag-redmark text { font-family: var(--font-mono); font-size: 2.2px; fill: color-mix(in srgb, #e0605a 75%, var(--ink)); }
  .ag-clock { opacity: 0; }
  .ag-clockface { fill: color-mix(in srgb, var(--nc, var(--ink-dim)) 12%, var(--bg)); stroke: var(--ink-dim); stroke-width: 0.3; }
  .ag-hand { stroke: var(--ink-dim); stroke-width: 0.3; }
  .ag-quota { font-family: var(--font-mono); font-size: 3px; fill: color-mix(in srgb, #e0605a 75%, var(--ink)); }

  /* Beat captions: base = END frame (beat 5 visible, rest hidden) */
  .ag-beat { opacity: 0; }
  .ag-beat-5 { opacity: 1; }

  @keyframes ag-leg {
    0%   { transform: translate(var(--x1), var(--y1)); opacity: 0; }
    0.8% { opacity: 0.95; }
    5.2% { transform: translate(var(--x2), var(--y2)); opacity: 0.95; }
    6%   { transform: translate(var(--x2), var(--y2)); opacity: 0; }
    100% { transform: translate(var(--x2), var(--y2)); opacity: 0; }
  }
  @keyframes ag-flash {
    0%   { opacity: 0.9; }
    6%   { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes ag-latch-red {
    0% { opacity: 0; } 19.5% { opacity: 0; } 20% { opacity: 1; }
    27.5% { opacity: 1; } 28% { opacity: 0; } 100% { opacity: 0; }
  }
  @keyframes ag-latch-gates {
    0% { stroke: var(--ink-dim); } 36% { stroke: var(--ink-dim); }
    37% { stroke: var(--canopy); } 100% { stroke: var(--canopy); }
  }
  @keyframes ag-latch-gatecheck {
    0% { opacity: 0; } 36% { opacity: 0; } 37% { opacity: 1; } 100% { opacity: 1; }
  }
