---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments.cadspec;
---
<ExperimentLayout id="cadspec">
  <p slot="hero-mark" class="ascii-motif" aria-hidden="true">{e.hero.motif}</p>
  <!-- Product artifacts are anchored to the hero, not inserted into the CTA row. -->
  <Fragment slot="hero-visual">
    <div class="art art-coords">
      <p class="label">{e.hero.artifacts.coords.label}</p>
      <pre class="mono art-code"><code>{e.hero.artifacts.coords.code}</code></pre>
    </div>
    <div class="art art-dim">
      <p class="label">{e.hero.artifacts.dim.label}</p>
      <svg viewBox="0 0 160 34" aria-hidden="true">
        <!-- the same dimension the plan draws: extension lines, the measure
             line with its 45° ticks, and the value it reports -->
        <g stroke="var(--essence)" stroke-width="1" fill="none">
          <line x1="14" y1="6" x2="14" y2="28" />
          <line x1="146" y1="6" x2="146" y2="28" />
          <line x1="14" y1="24" x2="146" y2="24" />
          <line x1="9" y1="29" x2="19" y2="19" />
          <line x1="141" y1="29" x2="151" y2="19" />
        </g>
        <text class="art-val" x="80" y="17" text-anchor="middle">8.50</text>
      </svg>
    </div>
    <div class="art art-chip"><!-- the ONE blush-peach card on the page -->
      <span class="chip-dot" aria-hidden="true"></span>
      <span class="chip-label">{e.hero.artifacts.compile.label}</span>
      <span class="chip-status">{e.hero.artifacts.compile.status}</span>
    </div>
  </Fragment>

  <section class="wrap section">
    <div class="sheet">
      <div class="drawing">
        <svg viewBox="0 0 320 200" id="cs-plan" aria-hidden="true">
          <!-- room walls — the right wall slides as the width spec changes; a
               window gap on top and a door gap on the bottom stay put -->
          <path class="walls" d="M50 146 V34 H70 M110 34 H280 V146 H145 M110 146 H50"
            stroke="var(--ink)" stroke-width="3" fill="none" stroke-linecap="square" />
          <g class="window" stroke="var(--essence)" stroke-width="1.3">
            <line x1="70" y1="32" x2="110" y2="32" />
            <line x1="70" y1="36" x2="110" y2="36" />
          </g>
          <path class="swing" d="M145 146 A 35 35 0 0 0 110 111" stroke="var(--essence)" stroke-width="1.2" stroke-dasharray="4 4" fill="none" />
          <line x1="110" y1="146" x2="110" y2="111" stroke="var(--essence)" stroke-width="2" />
          <!-- width dimension: line, end ticks and value, all driven by the spec -->
          <g class="dims" stroke="var(--essence)" stroke-width="1" opacity="0.85">
            <line class="dim-line" x1="50" y1="168" x2="280" y2="168" />
            <line x1="50" y1="164" x2="50" y2="174" />
            <line class="dim-tick-r" x1="280" y1="164" x2="280" y2="174" />
            <line x1="30" y1="34" x2="30" y2="146" />
            <line x1="26" y1="34" x2="34" y2="34" />
            <line x1="26" y1="146" x2="34" y2="146" />
          </g>
          <text class="dim-label mono dim-t" x="165" y="184" text-anchor="middle" font-size="9">8.50</text>
          <text class="mono dim-t" x="20" y="90" text-anchor="middle" font-size="9" transform="rotate(-90 20 90)">4.20</text>
        </svg>
      </div>
      <pre class="mono code"><code id="cs-toml">[[line]]
id = "ln-001"
from = [0.0, 0.0]
to = [8.50, 0.0]
weight = 0.50

[[dim]]
id = "dm-001"
from = [0, 0]
to = [8.50, 0]
offset = 0.5</code></pre>
    </div>

    <ul class="notes">
      {e.notes.items.map((n, i) => (
        <li><span class="mono note-num">N{i + 1}</span><span set:html={n} /></li>
      ))}
    </ul>
  </section>
</ExperimentLayout>

<script>
  // cadspec is declarative: the spec drives the drawing. So the width in the
  // .toml steps between a few values and the plan redraws in lock-step — the
  // right wall slides, the dimension follows, the measured value counts. The
  // number you'd edit and the geometry it produces move together.
  (function () {
    const svg = document.getElementById('cs-plan');
    const toml = document.getElementById('cs-toml');
    if (!svg || !toml) return;
    const walls = svg.querySelector('.walls');
    const dimLine = svg.querySelector('.dim-line');
    const dimTick = svg.querySelector('.dim-tick-r');
    const dimLabel = svg.querySelector('.dim-label');
    if (!walls || !dimLine || !dimTick || !dimLabel) return;

    const LEFT = 50;
    const SCALE = 27; // px per metre
    const fmt = (w) => w.toFixed(2);
    const tomlText = (w) =>
      '[[line]]\nid = "ln-001"\nfrom = [0.0, 0.0]\nto = [' + fmt(w) +
      ', 0.0]\nweight = 0.50\n\n[[dim]]\nid = "dm-001"\nfrom = [0, 0]\nto = [' +
      fmt(w) + ', 0]\noffset = 0.5';

    function apply(w) {
      const R = Math.round(LEFT + SCALE * w);
      walls.setAttribute('d', 'M50 146 V34 H70 M110 34 H' + R + ' V146 H145 M110 146 H50');
      dimLine.setAttribute('x2', String(R));
      dimTick.setAttribute('x1', String(R));
      dimTick.setAttribute('x2', String(R));
      dimLabel.setAttribute('x', String((LEFT + R) / 2));
      dimLabel.textContent = fmt(w);
      toml.textContent = tomlText(w);
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const targets = [8.5, 6.4, 5.2, 7.3]; // metres — the values that get "edited"
    const TWEEN = 850; // ms to redraw to the next value
    const HOLD = 2200; // ms resting on a clean value
    const ease = (k) => (k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);

    let i = 0;
    let from = targets[0];
    let to = targets[1];
    let phase = null;
    let raf = null;
    function frame(ts) {
      if (phase === null) phase = ts;
      const e2 = ts - phase;
      if (e2 < TWEEN) apply(from + (to - from) * ease(e2 / TWEEN));
      else if (e2 < TWEEN + HOLD) apply(to);
      else {
        phase = ts;
        i = (i + 1) % targets.length;
        from = targets[i];
        to = targets[(i + 1) % targets.length];
        apply(from);
      }
      raf = requestAnimationFrame(frame);
    }
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting && raf === null) { phase = null; raf = requestAnimationFrame(frame); }
        else if (!en.isIntersecting && raf !== null) { cancelAnimationFrame(raf); raf = null; }
      }
    });
    io.observe(svg);
  })();

  // The drafting grid is quiet and cursor-stirred: a faint teal bloom follows
  // the pointer and the grid drifts a few pixels behind it (lerped, so it
  // reads as paper being nudged, not as a cursor effect). blueprint is a
  // stillSurface — no canvas runs here — so the grid is pure CSS and these
  // are its only variables. Reduced motion never registers the listener or
  // the loop: the grid renders static. Touch never moves it either (the
  // pointer is the finger, which would shake the page while scrolling).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement;
    let tx = 0, ty = 0, gx = 0, gy = 0, seen = false;
    addEventListener('pointermove', (ev) => {
      if (ev.pointerType === 'touch') return;
      if (!seen) { gx = tx; gy = ty; seen = true; } // no jump from off-screen origin
      tx = (ev.clientX / innerWidth - 0.5) * -14;   // ±7px grid parallax
      ty = (ev.clientY / innerHeight - 0.5) * -14;
      root.style.setProperty('--stir-x', ev.clientX + 'px');
      root.style.setProperty('--stir-y', ev.clientY + 'px');
    }, { passive: true });
    (function ease() {                              // one loop; rAF pauses with the tab
      gx += (tx - gx) * 0.06; gy += (ty - gy) * 0.06;
      root.style.setProperty('--stir-gx', gx.toFixed(2) + 'px');
      root.style.setProperty('--stir-gy', gy.toFixed(2) + 'px');
      requestAnimationFrame(ease);
    })();
  }
</script>

<style>
  /* ── The Steep direction: serif analytics on warm paper, floating product
     artifacts. This block is the whole skin for `data-surface='blueprint'`.

     Every rule that re-dresses markup owned by surfaces.css / global.css /
     ExperimentLayout is written `:global(:root[data-surface='blueprint'] X)`:
     the `:root` prefix (a pseudo-class) out-specifies their
     `html[data-surface='blueprint'] X` and the layout's cid-scoped rules, so
     nothing here needs `!important` or a source-order bet. Rules without
     :global() are view-local (the cards, the sheet, the notes) and stay
     scoped. ────────────────────────────────────────────────────────────── */

  /* (a) Tokens — warm paper, mist cards, one blush reserved for the chip. */
  :global(:root[data-surface='blueprint']) {
    --bg: #ffffff;
    --bg-raise: #f2f2f3;
    --ink: #17191c;
    --ink-dim: #777b86;
    --ink-faint: #979799;
    --line: #ececec;
    --blush: #fbe1d1;
    --font-serif: 'Source Serif 4', 'Iowan Old Style', Palatino, Georgia, serif;
    --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  /* (b) Type — serif display at 400 only. global.css forces 500 on
     h1/h2/h3 and strong; surfaces.css forces 600 on the blueprint genesis
     h2 (handled by its own rule below). Sans body stays sans. */
  :global(:root[data-surface='blueprint'] h1),
  :global(:root[data-surface='blueprint'] h2),
  :global(:root[data-surface='blueprint'] h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0;
  }
  :global(:root[data-surface='blueprint'] strong) { font-weight: 400; }
  /* The layout pins its own 500 on lede/genesis emphasis (cid-scoped, so it
     outranks a bare `strong` rule) — beat it with the descendants. */
  :global(:root[data-surface='blueprint'] .exp .lede strong),
  :global(:root[data-surface='blueprint'] .exp .genesis .prose strong) {
    font-weight: 400;
    color: var(--ink);
  }

  /* (c) Hero — editorial title with a contained artifact collage. */
  :global(:root[data-surface='blueprint'] .hero) {
    align-items: center;
    text-align: center;
    gap: 1rem;
    background: none;
    border: 0;
    padding: 2rem 1rem 11rem;
  }
  :global(:root[data-surface='blueprint'] .hero::after) { content: none; }
  :global(:root[data-surface='blueprint'] .hero::before) {
    /* registration tick stays; its fill goes (there is no plate anymore) */
    border-color: var(--essence);
    background: transparent;
  }
  /* The one product name: surfaces.css hides .exp-name by default. */
  :global(:root[data-surface='blueprint'] .exp-name) {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    overflow: visible;
    white-space: normal;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.25vw, 5.625rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  :global(:root[data-surface='blueprint'] .koan) {
    /* serif epigraph under the masthead (surfaces.css wants it mono) */
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    letter-spacing: 0;
    color: var(--essence);
    opacity: 1;
  }
  :global(:root[data-surface='blueprint'] .lede) {
    margin-inline: auto;
    max-width: 54ch;
    text-align: center;
  }
  :global(:root[data-surface='blueprint'] .num) { color: var(--ink-faint); }
  :global(:root[data-surface='blueprint'] .actions) { justify-content: center; }
  .ascii-motif {
    margin: 0;
    color: var(--ink-faint);
    font: 400 0.72rem/1.5 var(--font-mono);
    letter-spacing: 0.08em;
  }

  /* (d) Pill button pair — filled (repo) + ghost (docs). The layout already
     renders exactly this pair; only the dress changes. */
  :global(:root[data-surface='blueprint'] .actions .btn),
  :global(:root[data-surface='blueprint'] .actions .btn.ghost) {
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.6rem 1.35rem;
  }
  :global(:root[data-surface='blueprint'] .actions .btn) {
    background: #17191c;
    border-color: #17191c;
    color: #fff;
  }
  :global(:root[data-surface='blueprint'] .actions .btn:hover) { filter: brightness(1.1); }
  :global(:root[data-surface='blueprint'] .actions .btn.ghost) {
    background: transparent;
    border-color: #17191c;
    color: #17191c;
  }
  :global(:root[data-surface='blueprint'] .actions .btn.ghost:hover) {
    border-color: #17191c;
    color: #17191c;
    background: transparent;
  }

  /* (e) Install bar — already in the hero; centered, mist plate, no frame. */
  :global(:root[data-surface='blueprint'] .install) { margin-inline: auto; }
  :global(:root[data-surface='blueprint'] .install-head) {
    justify-content: center;
    gap: 1.2rem;
  }
  :global(:root[data-surface='blueprint'] .install-head .label) {
    color: var(--ink-faint);
  }
  :global(:root[data-surface='blueprint'] .cmd) {
    background: var(--bg-raise);
    border: 0;
    border-radius: 18px;
    box-shadow: 0 1px 2px rgba(22, 32, 42, 0.05);
  }
  :global(:root[data-surface='blueprint'] .copy) { border-left: 1px solid var(--line); }
  :global(:root[data-surface='blueprint'] .os-tab[aria-selected='true']) {
    color: var(--essence);
  }

  /* (f) The floating product artifacts — view-local, so they stay scoped.
     24px radius (the spec), barely-there shadows, a 7s drift that reads as
     paper stirring, disabled under reduced motion and on narrow screens.
     `translate` (not `transform`) animates alongside each card's rotation. */
  .art {
    position: absolute;      /* anchored to .hero, never to .actions */
    background: #ffffff;
    border: 0;
    border-radius: 20px;
    padding: 0.9rem 1.05rem;
    box-shadow: 0 0 0 1px rgba(4,23,43,0.05), 0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
    text-align: left;
    overflow: hidden;        /* nothing spills past the hero — no h-scroll */
    z-index: 1;
    animation: art-float 7s ease-in-out infinite;
  }
  .art .label { margin: 0 0 0.45rem; }
  .art-coords { left: 1rem; top: 7.4rem; width: 14.5rem; transform: rotate(-1deg); }
  .art-dim    { right: 1rem; top: 8rem; width: 13rem; transform: rotate(1deg); }
  .art-dim svg { display: block; width: 100%; height: auto; }
  .art-val {
    fill: var(--essence);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .art-code {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--essence);
    white-space: pre;
  }
  /* The one blush-peach card on the page (the compile status chip). */
  .art-chip {
    right: 3%;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--blush);
    border: 0;
    box-shadow: none;
  }
  .chip-dot {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--essence);
  }
  .chip-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5d2a1a;
  }
  .chip-status { font-size: 0.78rem; color: #5d2a1a; }
  .ascii-motif {
    margin: 0;
    max-width: 42rem;
    text-align: center;
    white-space: normal;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  @keyframes art-float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .art { animation: none; }
  }

  /* Responsive guard — mandatory: below 64rem the absolute cards would sit
     on the centered headline and can force a horizontal scrollbar. They go
     static and flow into the flexing, wrapping `.actions` row (after the
     docs button, because they come from the cta slot).

     The threshold is 64rem (1024px), not 60rem: the hero has to fit the
     banner art (~416px, centred) *between* the two side cards, and it only
     clears it above ~1024px. Between 961px and 1020px the coords card's box
     already overlaps the banner's (15px at 961px, leaving a 2px gap to its
     glyphs and its shadow across the art), so the guard has to bite before
     that band opens. */
  @media (max-width: 64rem) {
    :global(:root[data-surface='blueprint'] .hero) { padding-bottom: 2rem; }
    .art-coords,
    .art-dim,
    .art-chip {
      position: static;
      width: min(100%, 24rem);
      transform: none;
      animation: none;
      margin: 0.5rem auto 0;
    }
    .ascii-motif {
      position: static;
      transform: none;
      width: 100%;
      max-width: none;
      margin: 0.8rem auto 0;
      text-align: center;
      white-space: normal;
    }
  }

  /* (g) Below the hero — the plan sheet and its notes. The old cyan hairline
     plate goes; the drawing and the code become two mist cards. Every
     var(--cadspec) (#6ec6e6, ~1.9:1 on paper) in this file is replaced by
     var(--essence) (#156c80, 5.3:1 on mist). */
  .section { padding-block: 1.5rem 2rem; }
  .sheet {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1rem;
    background: none;
    border: 0;
    max-width: 46rem;
    margin-inline: auto;
  }
  @media (max-width: 44rem) { .sheet { grid-template-columns: 1fr; } }
  /* centre the plan in its cell, beside the (taller) code block */
  .drawing {
    background: var(--bg-raise);
    border: 0;
    border-radius: 24px;
    box-shadow: 0 1px 2px rgba(22, 32, 42, 0.05), 0 12px 30px rgba(22, 32, 42, 0.05);
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .drawing svg { display: block; width: 100%; }
  .dim-t { fill: var(--essence); }
  .code {
    margin: 0;
    background: var(--bg-raise);
    border: 0;
    border-radius: 24px;
    box-shadow: 0 1px 2px rgba(22, 32, 42, 0.05), 0 12px 30px rgba(22, 32, 42, 0.05);
    padding: 1.2rem;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--essence);
  }
  .notes { list-style: none; padding: 0; margin: 2rem auto 0; max-width: 46rem; }
  .notes li {
    display: flex;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 0.97rem;
  }
  .note-num { color: var(--essence); font-size: 0.8rem; padding-top: 0.15rem; }
  .notes :global(code) { color: var(--essence); font-size: 0.88em; }
  .notes :global(em) { color: var(--essence); font-style: italic; }

  /* (h) Layout-owned sections, re-dressed for this surface. */
  :global(:root[data-surface='blueprint'] .genesis h2),
  :global(:root[data-surface='blueprint'] .faq-section h2) {
    font-family: var(--font-serif);
    font-weight: 400;
  }
  :global(:root[data-surface='blueprint'] .genesis .prose) { color: var(--ink-dim); }
  :global(:root[data-surface='blueprint'] .genesis-row .genesis) {
    background: var(--bg-raise);
    border-radius: 24px;
    padding: 1.8rem 2rem;
  }
  :global(:root[data-surface='blueprint'] .faq-item),
  :global(:root[data-surface='blueprint'] .faq-item:first-child) {
    border-color: var(--line);
  }
  :global(:root[data-surface='blueprint'] .exp-nav-link:hover),
  :global(:root[data-surface='blueprint'] .exp-nav-link:hover .n),
  :global(:root[data-surface='blueprint'] .exp-nav-link:hover .arrow) {
    color: var(--essence);
  }

  /* (i) Background — a quiet drafting grid, cursor-stirred. blueprint is a
     stillSurface (no canvas ever runs), so this replaces surfaces.css's two
     centre-line axes from the view: two grid pitches (140px / 28px) in warm
     ink, a teal bloom under the cursor, and a few pixels of parallax the
     script feeds through --stir-*. Under reduced motion the variables stay
     unset and the grid renders static. body::before's position/inset/
     z-index come from surfaces.css. */
  :global(:root[data-surface='blueprint'] body::before) {
    background-image:
      radial-gradient(420px circle at var(--stir-x, 50%) var(--stir-y, 40%),
        color-mix(in srgb, var(--essence, #156c80) 7%, transparent), transparent 72%),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 7%, transparent) 1px, transparent 1px),
      linear-gradient(0deg,  color-mix(in srgb, var(--ink) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px),
      linear-gradient(0deg,  color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px);
    background-size: auto, 140px 140px, 140px 140px, 28px 28px, 28px 28px;
    background-position: 0 0,
      var(--stir-gx, 0px) var(--stir-gy, 0px), var(--stir-gx, 0px) var(--stir-gy, 0px),
      var(--stir-gx, 0px) var(--stir-gy, 0px), var(--stir-gx, 0px) var(--stir-gy, 0px);
    background-repeat: no-repeat, repeat, repeat, repeat, repeat;
  }
</style>
