---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getLang, useTranslations } from '../../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments['demostage'];

// Exactly two demo slots, both empty: the frames the score will fill.
const slots = [
  { fig: 'Fig. 1', caption: e.demos.first },
  { fig: 'Fig. 2', caption: e.demos.second },
];
const spectrumBars = [42, 62, 88, 122, 154, 178, 158, 128, 96, 68, 44];
---
<ExperimentLayout id="demostage">
  <a slot="cta" class="btn ghost" href="#demo-player">{t.common.demo}</a>
  <p slot="hero-mark" class="ascii-motif mono" aria-hidden="true">▶──●────●───□</p>

  <!-- The real terminal/export sequence is the Altius thermal-spectrum hero. -->
  <Fragment slot="hero-visual">
    <div class="stage">
      <figure class="player" id="demo-player">
        <div class="bar mono">
          <span class="d r"></span><span class="d y"></span><span class="d g"></span>
          <span class="name">demo.cast</span>
        </div>
        <pre class="mono body" translate="no"><code>$ demo capture
  → demo.toml (8 steps) + demo.rec
$ demo focus main docs --scroll
  → terminal | docs — browser source composited in
$ demo record
  → demo.rec (clean humanized take)
$ demo export gif,mp4
  → dist/demo.gif  dist/demo.mp4</code></pre>
        <div class="scrubber mono">
          <span class="play" aria-hidden="true">▶</span>
          <div class="track">
            <span class="fill"></span>
            <span class="tick" style="left:20%"></span>
            <span class="tick" style="left:55%"></span>
            <span class="tick" style="left:82%"></span>
            <span class="head"></span>
          </div>
          <span class="tc">0:06</span>
        </div>
      </figure>
      <div class="spectrum" aria-hidden="true">
        {spectrumBars.map((height) => <span style={`--bar-height:${height}px; --bar-opacity:${(height / 228).toFixed(2)}`} />)}
      </div>
    </div>
  </Fragment>

  <!-- The confident light section: the two 16:9 slots the capture and the
       export will land in, with the koan as a signature line at its foot. -->
  <section class="band-light">
    <div class="wrap slots-wrap">
      <div class="slots">
        {slots.map((s) => (
          <figure class="demo-slot">
            <!-- The frame is empty on purpose, so it has nothing to name: it is
                 hidden from assistive tech and the figcaption is the slot's
                 description. Labelling it too would read the caption twice. -->
            <div class="ds-frame" aria-hidden="true">
              <span class="rec mono">REC</span>
            </div>
            <figcaption class="ds-cap"><span class="label mono">{s.fig}</span>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="sig mono" aria-hidden="true">{e.koan}</p>
    </div>
  </section>

  <!-- Obsidian band — the five commands, inverted. The page's single dark
       counterweight: light everywhere else. -->
  <section class="band-dark">
    <div class="wrap band-wrap">
      <div class="features">
        <span class="label">{e.pipeline.kicker}</span>
        <ul>
          {e.pipeline.items.map((f, i) => <li><span class="step">{String(i + 1).padStart(2, '0')}</span><span set:html={f} /></li>)}
        </ul>
      </div>
    </div>
  </section>
</ExperimentLayout>

<style>
  /* The hero figure: a black monitor on the bright set, coral as its phosphor.
     The dark/light contrast of the page lives here and in the obsidian band. */
  .stage { width: 100%; display: grid; justify-items: center; padding-block: .5rem 1rem; }
  .player {
    margin: 0;
    max-width: 56rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-ctl);
    overflow: hidden;
    background: var(--bg-raise); /* Dark Cocoa — flat, no drop shadow */
  }
  .bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--line); font-size: 0.75rem; }
  .bar .d { width: 0.6rem; height: 0.6rem; border-radius: 50%; }
  .bar .d.r { background: var(--flare); } .bar .d.y { background: #e0c34a; } .bar .d.g { background: #5dd39e; }
  .bar .name { margin-left: 0.5rem; color: #8a8175; }
  /* min-height reserves the full session so the typewriter doesn't shift layout. */
  .body { margin: 0; padding: 1.2rem; font-size: 0.85rem; line-height: 1.8; color: color-mix(in srgb, #f7f6ff 85%, transparent); min-height: 8rem; }
  .scrubber { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.9rem 0.7rem; border-top: 1px solid var(--line); font-size: 0.72rem; }
  .scrubber .play { color: var(--flare); font-size: 0.7rem; }
  .scrubber .track { position: relative; flex: 1; height: 3px; border-radius: 2px; background: #322b22; }
  .scrubber .fill { position: absolute; inset: 0 38% 0 0; background: var(--flare); border-radius: 2px; }
  .scrubber .head { position: absolute; left: 62%; top: 50%; width: 0.62rem; height: 0.62rem; border-radius: 50%; background: var(--flare); transform: translate(-50%, -50%); box-shadow: 0 0 9px color-mix(in srgb, var(--flare) 70%, transparent); }
  .scrubber .tick { position: absolute; top: -2px; width: 1px; height: 7px; background: #4a4339; transform: translateX(-50%); transition: background .2s, box-shadow .2s; }
  .scrubber .tick.on { background: var(--flare); box-shadow: 0 0 6px color-mix(in srgb, var(--flare) 70%, transparent); }
  .scrubber .tc { color: var(--ink-mute); }

  /* The spectrum is solid-color bars with an opacity fade (peak-to-zero) —
     that fade is the motif, not a color gradient. Nothing else carries one. */
  .spectrum {
    width: min(100%, 56rem);
    height: 11.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.25rem, 1vw, .75rem);
    overflow: hidden;
    margin-top: 1.5rem;
  }
  .spectrum span {
    flex: 1 1 0;
    max-width: 4.5rem;
    height: var(--bar-height);
    opacity: var(--bar-opacity);
    background: var(--flare);
    border-radius: 2px;
  }
  .ascii-motif { color: #fcac9c; font-size: .72rem; letter-spacing: .16em; }

  /* Two empty 16:9 slots, side by side, stacking below 52rem. Flat frames: no
     grid texture, no glow, no video, no lens, no dialog. */
  .slots { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  @media (max-width: 52rem) { .slots { grid-template-columns: 1fr; } }
  .demo-slot { margin: 0; }
  .ds-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    /* Warm Ash hairline reads on the peach band; Linen card per altius.md. */
    border: 1px solid var(--ink-mute);
    border-radius: var(--radius-card);
    background: #f7f6ff;
    box-shadow: none;
  }
  .rec {
    position: absolute;
    top: 0.7rem;
    right: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #190501;
  }
  .rec::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--flare); /* graphics only — never text on the light band */
  }
  .ds-cap {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.88rem;
    color: var(--ink-dim);
  }
  .ds-cap .label { font-style: normal; margin-right: 0.6rem; }
  /* The peach band inverts its inks: Warm Ash (the dark-side tertiary) would
     sit at 1.9:1 here, so captions and the signature line take Obsidian Ember
     (17.0:1) — the light-section body ink. Flare stays on the REC dot. */
  .band-light .ds-cap,
  .band-light .sig { color: #190501; }

  /* The signature line at the foot of the light section — the koan reused
     verbatim, small and quiet, hidden from assistive tech (it repeats the
     hero's). Obsidian on the peach band, like every other line of body copy
     there: the coral is spent on the REC dots and the step numerals, and
     orange text on peach has nowhere near AA. */
  .sig {
    margin: 2.2rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .features ul { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .features li { display: flex; gap: 0.9rem; align-items: baseline; padding-block: 0.7rem; border-bottom: 1px solid var(--line); color: var(--ink-dim); font-size: 0.97rem; }
  .step { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500; color: var(--flare); flex: none; min-width: 1.5rem; }
  .features :global(code) { color: #f7f6ff; font-size: 0.88em; }

  /* Band labels and list rows are the last things the pre-Altius surface block
     in surfaces.css still reaches: it dresses them in cool greys (#a39c8e,
     #2a241d) that belong to no Altius value. Component CSS is bundled *before*
     the surface stylesheet, so these rules name the surface key to earn the
     weight they need to win — the bands then speak Flare on obsidian, Signal
     Red on peach, and the row rules keep the hairline warm. */
  :global(html[data-surface='studio']) .band-dark .label { color: var(--flare); }
  :global(html[data-surface='studio']) .band-light .label { color: #951c04; }
  :global(html[data-surface='studio']) .features li { color: var(--ink-dim); border-bottom-color: var(--line); }
  :global(html[data-surface='studio']) .features :global(code) { color: #f7f6ff; }

  /* The origin story is layout-owned, but it is painted the same vapor-peach as
     the slots below it (surfaces.css washes .genesis-row), so it has to invert
     with them. Left alone it inherits Linen from the obsidian canvas: a white
     heading and 1.9:1 body copy on peach. The light half of the thermal rhythm
     is Obsidian body, Signal Red labels. */
  :global(html[data-surface='studio'] .exp .genesis-row) { color: #190501; background: var(--peach); }
  :global(html[data-surface='studio'] .genesis-row .genesis .label) { color: #951c04; }
  :global(html[data-surface='studio'] .genesis-row .genesis .prose) { color: #190501; }
</style>

<script>
  // The landing of a demo tool should itself be a demo: the player types the
  // session, advances the scrubber, lights the step ticks, and loops. Honours
  // reduced-motion (leaves the static, fully-typed state) and only runs on screen.
  (function () {
    // Hero REC — a live session clock (mm:ss): the time you've been on the page.
    // Independent of the player, so it never freezes.
    const hero = document.querySelector('.exp .hero');
    if (hero) {
      hero.classList.add('js-rec');
      const rec = document.createElement('span');
      rec.className = 'rec';
      hero.appendChild(rec);
      const t0 = Date.now();
      const clock = () => {
        const s = Math.floor((Date.now() - t0) / 1000);
        rec.textContent = '● REC  ' + Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      };
      clock();
      setInterval(clock, 1000);
    }

    // The player plays itself: typewriter + scrubber + lit step ticks, looping.
    const fig = document.getElementById('demo-player');
    if (!fig) return;
    const code = fig.querySelector('.body code');
    const fill = fig.querySelector('.fill');
    const head = fig.querySelector('.head');
    const tc = fig.querySelector('.tc');
    const ticks = Array.from(fig.querySelectorAll('.tick'));
    if (!code || !fill || !head || !tc) return;

    const full = code.textContent;
    const total = full.length || 1;
    const PLAY = 5000; // ms to play through
    const HOLD = 1600; // ms to rest at the end before replaying
    const pad = (n) => (n < 10 ? '0' + n : '' + n);

    function set(p) {
      const n = Math.round(total * p);
      code.textContent = full.slice(0, n) + (p < 1 ? '▍' : '');
      fill.style.right = (100 - p * 100).toFixed(2) + '%';
      head.style.left = (p * 100).toFixed(2) + '%';
      tc.textContent = '0:' + pad(Math.min(8, Math.round(p * 8)));
      for (const t of ticks) {
        const tp = parseFloat(t.style.left) / 100;
        t.classList.toggle('on', p >= tp);
      }
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let start = null;
    let raf = null;
    function frame(ts) {
      if (start === null) start = ts;
      const e = ts - start;
      if (e <= PLAY) set(e / PLAY);
      else if (e <= PLAY + HOLD) set(1);
      else { start = ts; set(0); }
      raf = requestAnimationFrame(frame);
    }
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting && raf === null) { start = null; raf = requestAnimationFrame(frame); }
        else if (!en.isIntersecting && raf !== null) { cancelAnimationFrame(raf); raf = null; }
      }
    });
    io.observe(fig);
  })();
</script>
