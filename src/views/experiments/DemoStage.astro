---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import DemoFigure from '../../components/DemoFigure.astro';
import { byId } from '../../lib/experiments';
import { getLang, useTranslations } from '../../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const e = t.experiments['demostage'];
const exp = byId('demostage');
const spectrumBars = [21, 31, 44, 61, 77, 89, 79, 64, 48, 34, 22];
---
<ExperimentLayout id="demostage" hideDemo>
  <a slot="cta" class="btn ghost" href="#demo-player">{t.common.demo}</a>
  <p slot="hero-mark" class="ascii-motif mono" aria-hidden="true">{exp.motif}</p>

  <!-- Below the hero (before genesis) is the Altius thermal-spectrum figure:
       the text hero with CTAs, install bar and banner reads first; the fake
       player + thermal bars close the stage. -->
  <Fragment slot="before-genesis">
    <div class="stage">
      <figure class="player" id="demo-player">
        <div class="bar mono">
          <span class="d r"></span><span class="d y"></span><span class="d g"></span>
          <span class="name">demo.cast</span>
        </div>
        <pre class="mono body" translate="no"><code>$ demo capture
  → demo.toml (8 steps) + demo.rec
$ demo focus main docs --scroll
  → terminal | docs — browser source composited in
$ demo record
  → demo.rec (clean humanized take)
$ demo export gif,mp4
  → dist/demo.gif  dist/demo.mp4</code></pre>
        <div class="scrubber mono">
          <span class="play" aria-hidden="true">▶</span>
          <div class="track">
            <span class="fill"></span>
            <span class="tick" style="left:20%"></span>
            <span class="tick" style="left:55%"></span>
            <span class="tick" style="left:82%"></span>
            <span class="head"></span>
          </div>
          <span class="tc">0:06</span>
        </div>
      </figure>
      <div class="spectrum" aria-hidden="true">
        {spectrumBars.map((height) => <span style={`--bar-height:${height}px; --bar-opacity:${(height / 114).toFixed(2)}`} />)}
      </div>
    </div>
  </Fragment>

  <!-- The confident light section: the single genuine capture, with the
       koan as a signature line at its foot. No second figure exists —
       one honest figure beats two props. -->
  <section class="band-light">
    <div class="wrap slots-wrap">
      <div class="slots single">
        <DemoFigure src="/demos/demostage.mp4" essence={exp.essenceHex} label="Fig. 1" caption={e.demos.first} />
      </div>
      <p class="sig mono" aria-hidden="true">{e.koan}</p>
    </div>
  </section>

  <!-- Obsidian band — the five commands, inverted. The page's single dark
       counterweight: light everywhere else. -->
  <section class="band-dark">
    <div class="wrap band-wrap">
      <div class="features">
        <span class="label">{e.pipeline.kicker}</span>
        <ul>
          {e.pipeline.items.map((f, i) => <li><span class="step">{String(i + 1).padStart(2, '0')}</span><span set:html={f} /></li>)}
        </ul>
      </div>
    </div>
  </section>
</ExperimentLayout>

<style>
  /* The hero figure: a black monitor on the bright set, coral as its phosphor.
     The dark/light contrast of the page lives here and in the obsidian band. */
  .stage { width: 100%; display: grid; justify-items: center; padding-block: .5rem 1rem; }
  .player {
    margin: 0;
    max-width: 56rem;
    border: 1px solid var(--line);
    /* Dark Cocoa panel + hairline coral edge = a card by altius.md, so the
       card radius (8px), not the control radius (4px). */
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-raise); /* Dark Cocoa — flat, no drop shadow */
  }
  .bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--line); font-size: 0.75rem; }
  .bar .d { width: 0.6rem; height: 0.6rem; border-radius: 50%; }
  .bar .d.r { background: var(--flare); } .bar .d.y { background: #fcac9c; } .bar .d.g { background: #baadab; }
  .bar .name { margin-left: 0.5rem; color: var(--ink-mute); }
  /* min-height reserves the full session so the typewriter doesn't shift layout. */
  .body { margin: 0; padding: 1.2rem; font-size: 0.85rem; line-height: 1.8; color: color-mix(in srgb, #f7f6ff 85%, transparent); min-height: 8rem; }
  .scrubber { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.9rem 0.7rem; border-top: 1px solid var(--line); font-size: 0.72rem; }
  .scrubber .play { color: var(--flare); font-size: 0.7rem; }
  .scrubber .track { position: relative; flex: 1; height: 3px; border-radius: 2px; background: var(--bg); }
  .scrubber .fill { position: absolute; inset: 0 38% 0 0; background: var(--flare); border-radius: 2px; }
  .scrubber .head { position: absolute; left: 62%; top: 50%; width: 0.62rem; height: 0.62rem; border-radius: 50%; background: var(--flare); transform: translate(-50%, -50%); box-shadow: 0 0 9px color-mix(in srgb, var(--flare) 70%, transparent); }
  .scrubber .tick { position: absolute; top: -2px; width: 1px; height: 7px; background: var(--molten); transform: translateX(-50%); transition: background .2s, box-shadow .2s; }
  .scrubber .tick.on { background: var(--flare); box-shadow: 0 0 6px color-mix(in srgb, var(--flare) 70%, transparent); }
  .scrubber .tc { color: var(--ink-mute); }

  /* The spectrum is solid-color bars with an opacity fade (peak-to-zero) —
     that fade is the motif, not a color gradient. Nothing else carries one. */
  .spectrum {
    width: min(100%, 56rem);
    height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.25rem, 1vw, .75rem);
    overflow: hidden;
    margin-top: 1.5rem;
  }
  .spectrum span {
    flex: 1 1 0;
    max-width: 4.5rem;
    height: var(--bar-height);
    opacity: var(--bar-opacity);
    background: var(--flare);
    /* Bare rectangles per altius.md — 2px sits outside the 4/8 vocabulary. */
  }
  .ascii-motif { color: #fcac9c; font-size: .72rem; letter-spacing: .16em; }

  /* One genuine capture, centred on the hero measure. DemoFigure brings
     its own frame, lens and caption — no flat empty frames here. */
  .slots.single { max-width: 56rem; margin-inline: auto; }
  /* The peach band inverts its inks: the signature line takes Obsidian Ember
     (17.0:1) — the light-section body ink. */
  .band-light .sig { color: #190501; }
  :global(html[data-surface='studio'] .band-light .demo-cap) { color: #190501; }
  /* …but the caption's own "Fig. 1" tag escaped both rules above: it renders in
     DemoFigure's cid, so the cid-scoped `.band-light .label` (Signal Red) never
     matches it, and it inherits nothing because it sets its own colour — the
     registry coral (#ef8354) on Vapor Peach, 1.7:1. altius.md puts labels in
     Signal Red on light and Flare on dark; this is the same #951c04 every other
     label on this band wears (5.7:1 even with the takes trail at its brightest
     behind the 88% veil — FR3). */
  :global(html[data-surface='studio'] .band-light .demo-cap .label) { color: #951c04; }

  /* The signature line at the foot of the light section — the koan reused
     verbatim, small and quiet, hidden from assistive tech (it repeats the
     hero's). Obsidian on the peach band, like every other line of body copy
     there: the coral is spent on the step numerals, and orange text on peach
     has nowhere near AA. */
  .sig {
    margin: 2.2rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .features ul { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .features li { display: flex; gap: 0.9rem; align-items: baseline; padding-block: 0.7rem; border-bottom: 1px solid var(--line); color: var(--ink-dim); font-size: 0.97rem; }
  .step { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500; color: var(--flare); flex: none; min-width: 1.5rem; }
  .features :global(code) { color: #f7f6ff; font-size: 0.88em; }

  /* Band labels and list rows are the last things the pre-Altius surface block
     in surfaces.css still reaches: it dresses them in cool greys (#a39c8e,
     #2a241d, and #ece7dd for inline code) that belong to no Altius value.
     Component CSS is bundled *before* the surface stylesheet, so these rules
     name the surface key and the `.exp` wrapper to out-rank that block
     (extra compound ⇒ higher specificity, and no cid-scoping, since the
     wrapper belongs to ExperimentLayout). The bands then speak Flare on
     obsidian, Signal Red on peach, and the row rules keep the hairline warm.
     `.features code` must stay fully :global: the <code> arrives through
     set:html, so it never carries this component's cid. */
  :global(html[data-surface='studio']) .band-dark .label { color: var(--flare); }
  :global(html[data-surface='studio']) .band-light .label { color: #951c04; }
  :global(html[data-surface='studio'] .exp .band-dark .features li) { color: var(--ink-dim); border-bottom-color: var(--line); }
  :global(html[data-surface='studio'] .exp .band-dark .features code) { color: #f7f6ff; }

  /* The origin story is layout-owned and sits between the hero figure and the
     peach slots band. surfaces.css (preserved block) washes it peach, which
     collapses altius.md's section rhythm — dark hero → dark band → light peach
     → dark solutions — into dark → peach → peach, and leaves the page with no
     dark/dark/peach beat anywhere. Put the row back on the obsidian canvas:
     two dark bands now precede the first Vapor Peach break, and its inks
     invert back with the background (Flare eyebrow, Linen body — the row's
     previous obsidian-on-peach values would sit at 1:1 on this canvas).
     The 82% veil lets the takes trail show through. */
  :global(html[data-surface='studio'] .exp .genesis-row) { color: var(--ink); background: color-mix(in srgb, var(--bg) 82%, transparent); }
  :global(html[data-surface='studio'] .genesis-row .genesis .label) { color: var(--flare); }
  :global(html[data-surface='studio'] .genesis-row .genesis .prose) { color: var(--ink-dim); }

  /* Vapor Peach break before the dark tail. Without it the page runs commands
     → FAQ → prev/next → footer all dark (altius.md: never more than 2-3 dark
     blocks in a row). The FAQ is layout-owned → whole selector :global;
     `max-width: none` makes it full-bleed like .band-light/.band-dark while
     the inner cap keeps the 52rem measure. Local token inversion re-dresses
     the whole section: Obsidian body, Warm Ash hairlines, Signal Red emphasis
     (7.41:1 on peach). The 88% veil lets the takes trail show through.
     Resulting rhythm:
     hero(D) · stage · origin(D) · slots(P) · commands(D) · faq(P) · prev/next+footer(D) */
  :global(html[data-surface='studio'] .exp .faq-section) {
    max-width: none;
    background: color-mix(in srgb, var(--peach) 88%, transparent);
    color: #190501;
    padding-block: 3.5rem;
    padding-inline: max(var(--space), calc(50% - 26rem));
    --ink: #190501;
    --ink-dim: #190501;
    --ink-faint: #190501;
    --line: #baadab;
    --essence: #951c04;
  }
  :global(html[data-surface='studio'] .exp .faq-section > *) { max-width: 52rem; margin-inline: auto; }
  :global(html[data-surface='studio'] .exp .faq-section .label) { color: #951c04; }

  /* The install bar is a control: the 4px radius from the substrate (the
     shared .cmd is square and the POC block only re-points its fill and
     coral border). Mirrors the 6px control fix on the canopy surface. */
  :global(html[data-surface='studio'] .exp .cmd) { border-radius: var(--radius-ctl); }

  /* altius.md Eyebrow Tag Label: Flare Orange on dark. The bands are done
     above; the hero install label is the remaining dark eyebrow (layout-owned
     → full :global). The origin label is already Flare two rules up. */
  :global(html[data-surface='studio'] .exp .install-head .label) { color: var(--flare); }

  /* FR3 — AA with the takes trail at its brightest behind the hero: the studio
     lede runs at opacity .75, and that drags its Flare inline code
     (`demo.toml`) down to 3.6:1 over the 82% veil. Band opacity cannot rescue
     it (an opaque hero still only reaches 3.9:1), so the code takes Warm
     Blush — this surface's warm tint on dark (koan, motif) — which clears
     5.9:1 at its worst. */
  :global(html[data-surface='studio'] .exp .lede code) { color: #fcac9c; }
</style>

<script>
  // The landing of a demo tool should itself be a demo: the player types the
  // session, advances the scrubber, lights the step ticks, and loops. Honours
  // reduced-motion (leaves the static, fully-typed state) and only runs on screen.
  (function () {
    // Hero REC — a live session clock (mm:ss): the time you've been on the page.
    // Independent of the player, so it never freezes.
    const hero = document.querySelector('.exp .hero');
    if (hero) {
      hero.classList.add('js-rec');
      const rec = document.createElement('span');
      rec.className = 'rec';
      hero.appendChild(rec);
      const t0 = Date.now();
      const clock = () => {
        const s = Math.floor((Date.now() - t0) / 1000);
        rec.textContent = '● REC  ' + Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      };
      clock();
      setInterval(clock, 1000);
    }

    // The player plays itself: typewriter + scrubber + lit step ticks, looping.
    const fig = document.getElementById('demo-player');
    if (!fig) return;
    const code = fig.querySelector('.body code');
    const fill = fig.querySelector('.fill');
    const head = fig.querySelector('.head');
    const tc = fig.querySelector('.tc');
    const ticks = Array.from(fig.querySelectorAll('.tick'));
    if (!code || !fill || !head || !tc) return;

    const full = code.textContent;
    const total = full.length || 1;
    const PLAY = 5000; // ms to play through
    const HOLD = 1600; // ms to rest at the end before replaying
    const pad = (n) => (n < 10 ? '0' + n : '' + n);

    function set(p) {
      const n = Math.round(total * p);
      code.textContent = full.slice(0, n) + (p < 1 ? '▍' : '');
      fill.style.right = (100 - p * 100).toFixed(2) + '%';
      head.style.left = (p * 100).toFixed(2) + '%';
      tc.textContent = '0:' + pad(Math.min(8, Math.round(p * 8)));
      for (const t of ticks) {
        const tp = parseFloat(t.style.left) / 100;
        t.classList.toggle('on', p >= tp);
      }
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let start = null;
    let raf = null;
    function frame(ts) {
      if (start === null) start = ts;
      const e = ts - start;
      if (e <= PLAY) set(e / PLAY);
      else if (e <= PLAY + HOLD) set(1);
      else { start = ts; set(0); }
      raf = requestAnimationFrame(frame);
    }
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting && raf === null) { start = null; raf = requestAnimationFrame(frame); }
        else if (!en.isIntersecting && raf !== null) { cancelAnimationFrame(raf); raf = null; }
      }
    });
    io.observe(fig);
  })();
</script>
