---
import BaseLayout from '../layouts/BaseLayout.astro';
import Watermark from '../components/Watermark.astro';
import Machine from '../components/Machine.astro';
import { getLang, localizePath, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const w = t.workbench;
const a = w.audits;
const WHATSAPP = 'https://wa.me/573053892323';
const waHref = `${WHATSAPP}?text=${encodeURIComponent(w.ctaMessage)}`;
---
<BaseLayout title={a.title} description={a.description} circadian>
  <Watermark kind="blueprint" />
  <section class="wrap workbench">
    <header class="wba-hero">
      <div class="wba-hero-text">
        <span class="label">{w.label}</span>
        <div class="wba-thumb"><Machine id="workbench" ink="theme" height="112px" /></div>
        <h1>{a.head}</h1>
        <p class="wba-lede">{a.lede}</p>
        <p class="wba-ctas">
          <a class="wba-btn" href={waHref} target="_blank" rel="noopener"><span class="wba-long">{w.cta}</span><span class="wba-short">{w.ctaShort}</span></a>
          <small>{w.ctaNote}</small>
        </p>
      </div>
      <figure class="wba-figure">
        <Machine id="workbench" ink="theme" height="260px" class="wba-machine" />
      </figure>
    </header>
    <section class="wba-block">
      <span class="label">{a.scope.kicker}</span>
      <ol class="wba-scope">
        {a.scope.items.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wba-block">
      <span class="label">{a.how.kicker}</span>
      <ol class="wba-steps">
        {a.how.steps.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wba-block">
      <span class="label">{a.deliver.kicker}</span>
      <ol class="wba-deliver">
        {a.deliver.items.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wba-block">
      <span class="label">{a.impl.kicker}</span>
      {a.impl.paras.map((para) => (
        <p class="wba-para">{para}</p>
      ))}
    </section>
    <section class="wba-block wba-privacy">
      <span class="label">{a.privacy.kicker}</span>
      <p>{a.privacy.text}</p>
      <p><a href={localizePath('/privacy', lang)}>{a.privacy.link}</a></p>
    </section>
    <section class="wba-block wba-price">
      <span class="label">{a.price.kicker}</span>
      <p>{a.price.text}</p>
      {lang === 'es' && <p class="wba-price-cop">{a.price.cop}</p>}
    </section>
    <section class="wba-block wba-offers">
      <span class="label">{a.offers.kicker}</span>
      <ol class="wba-deliver">
        {a.offers.founding.spots > 0 && (
          <li><b>{a.offers.founding.title}</b><span>{a.offers.founding.text}</span></li>
        )}
        <li><b>{a.offers.public.title}</b><span>{a.offers.public.text}</span></li>
        <li><b>{a.offers.reaudit.title}</b><span>{a.offers.reaudit.text}</span></li>
      </ol>
      {a.offers.rules.map((rule) => (
        <p class="wba-para">{rule}</p>
      ))}
      <p class="wba-para">{a.offers.zenodoNote}</p>
    </section>
    <section class="wba-close">
      <h2>{w.close.head}</h2>
      <p><a class="wba-btn" href={waHref} target="_blank" rel="noopener">{w.close.cta}</a></p>
      <small>{w.close.phone}</small>
    </section>
  </section>
  <div class="wba-sticky"><a class="wba-btn" href={waHref} target="_blank" rel="noopener">{w.ctaShort}</a><span>{w.ctaNote}</span></div>
</BaseLayout>

{/* Inlined so the page ships no CSS chunk: every chunk is linked site-wide
    and counted on the budgeted pages, and this design must not move them. */}
<style is:inline>
  .wba-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; }
  .wba-hero h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; margin: 0.6rem 0 1rem; text-wrap: balance; }
  .wba-lede { max-width: 40rem; color: var(--ink-dim); font-size: 1.1rem; line-height: 1.7; margin: 0 0 1.4rem; }
  .wba-ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; margin: 0; }
  .wba-ctas small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wba-btn { text-decoration: none; border: 1px solid var(--accent);
         color: var(--accent); padding: 0.55rem 1.1rem;
         font-family: var(--font-mono); font-size: 0.85rem;
         transition: background 0.15s ease, color 0.15s ease; }
  .wba-btn:hover { background: var(--accent); color: var(--bg); }
  .wba-ctas .wba-short { display: none; }
  .wba-thumb { display: none; }
  .wba-figure { margin: 0; }
  .wba-machine { justify-self: center; width: min(22rem, 100%); }
  .wba-block { margin-top: 3rem; }
  .wba-para { max-width: 46rem; color: var(--ink-dim); line-height: 1.7; }
  .wba-scope { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; counter-reset: scope; }
  .wba-scope li { counter-increment: scope; padding-left: 2.6rem; position: relative; }
  .wba-scope li::before { content: counter(scope, decimal-leading-zero); position: absolute; left: 0; font-family: var(--font-serif); color: var(--accent); font-size: 1.4rem; }
  .wba-scope li b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem; margin: 0.1rem 0 0.25rem; }
  .wba-scope li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wba-steps { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; counter-reset: step; }
  .wba-steps li { counter-increment: step; padding-left: 2.6rem; position: relative; }
  .wba-steps li::before { content: counter(step, upper-roman) '.'; position: absolute; left: 0; font-family: var(--font-serif); color: var(--accent); font-size: 1.4rem; }
  .wba-steps li b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem; margin: 0.1rem 0 0.25rem; }
  .wba-steps li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wba-deliver { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; }
  .wba-deliver li { border: 1px solid var(--line); background: var(--bg-raise); padding: 1.2rem 1.2rem 1rem; }
  .wba-deliver li b { display: block; font-family: var(--font-mono); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.4rem; color: var(--accent); }
  .wba-deliver li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wba-privacy p { max-width: 46rem; color: var(--ink-dim); line-height: 1.7; }
  .wba-privacy a { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); }
  .wba-price p { max-width: 46rem; font-family: var(--font-serif); font-size: 1.4rem; line-height: 1.5; }
  .wba-price-cop { font-family: var(--font-mono); font-size: .75rem; color: var(--ink-dim); margin: .15rem 0 .25rem; }
  .wba-close { background: var(--bg-raise); border-block: 1px solid var(--line); margin-top: 3rem; padding: 2.5rem 1.5rem; text-align: center; display: grid; gap: 1rem; justify-items: center; }
  .wba-close h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0; text-wrap: balance; max-width: 44rem; }
  .wba-close p { margin: 0; }
  .wba-close small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wba-sticky { display: none; }
  @media (max-width: 47.99rem) {
    .wba-hero { grid-template-columns: minmax(0, 1fr); }
    .wba-figure { display: none; }
    .wba-thumb { display: block; float: right; --machine-h-phone: 112px; margin: -0.4rem -0.25rem 0.25rem 0.65rem; }
    .wba-lede { clear: both; }
    .wba-hero h1 { font-size: 1.95rem; }
    .wba-ctas .wba-btn { width: 100%; display: flex; justify-content: center; }
    .wba-ctas .wba-long { display: none; }
    .wba-ctas .wba-short { display: inline; }
    .wba-price p { font-size: 1.2rem; }
    .wba-sticky { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 5; align-items: center; gap: 0.65rem; padding: 0.65rem var(--space) calc(0.65rem + env(safe-area-inset-bottom, 0px)); background: color-mix(in srgb, var(--bg) 92%, transparent); border-top: 1px solid var(--line); backdrop-filter: blur(6px); }
    .wba-sticky .wba-btn { flex: 1; display: flex; justify-content: center; }
    .wba-sticky span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-dim); letter-spacing: 0.06em; }
  }
</style>
