---
import BaseLayout from '../layouts/BaseLayout.astro';
import Watermark from '../components/Watermark.astro';
import Machine from '../components/Machine.astro';
import { getLang, useTranslations } from '../i18n';
import { bookTarget } from '../lib/book-target';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const w = t.workbench;
const s = w.solutions;
const WHATSAPP = 'https://wa.me/573053892323';
const waHref = `${WHATSAPP}?text=${encodeURIComponent(w.ctaMessage)}`;
const bookHref = bookTarget(lang);
---
<BaseLayout title={s.title} description={s.description} circadian>
{/* Inlined so the page ships no CSS chunk: every chunk is linked site-wide
    and counted on the budgeted pages, and this design must not move them. */}
<style is:inline>
  .wbs-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; }
  .wbs-hero h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; margin: 0.6rem 0 1rem; text-wrap: balance; }
  .wbs-lede { max-width: 40rem; color: var(--ink-dim); font-size: 1.1rem; line-height: 1.7; margin: 0 0 1.4rem; }
  .wbs-ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; margin: 0; }
  .wbs-ctas small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wbs-alt { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); }
  .wbs-btn { text-decoration: none; border: 1px solid var(--accent);
         color: var(--accent); padding: 0.55rem 1.1rem;
         font-family: var(--font-mono); font-size: 0.85rem;
         transition: background 0.15s ease, color 0.15s ease; }
  .wbs-btn:hover { background: var(--accent); color: var(--bg); }
  .wbs-ctas .wbs-short { display: none; }
  .wbs-thumb { display: none; }
  .wbs-figure { margin: 0; }
  .wbs-machine { justify-self: center; width: min(22rem, 100%); }
  .wbs-block { margin-top: 3rem; }
  .wbs-scope { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; counter-reset: scope; }
  .wbs-scope li { counter-increment: scope; padding-left: 2.6rem; position: relative; }
  .wbs-scope li::before { content: counter(scope, decimal-leading-zero); position: absolute; left: 0; font-family: var(--font-serif); color: var(--accent); font-size: 1.4rem; }
  .wbs-scope li b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem; margin: 0.1rem 0 0.25rem; }
  .wbs-scope li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wbs-steps { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; counter-reset: step; }
  .wbs-steps li { counter-increment: step; padding-left: 2.6rem; position: relative; }
  .wbs-steps li::before { content: counter(step, upper-roman) '.'; position: absolute; left: 0; font-family: var(--font-serif); color: var(--accent); font-size: 1.4rem; }
  .wbs-steps li b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem; margin: 0.1rem 0 0.25rem; }
  .wbs-steps li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wbs-deliver { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1.4rem; }
  .wbs-deliver li { border: 1px solid var(--line); background: var(--bg-raise); padding: 1.2rem 1.2rem 1rem; }
  .wbs-deliver li b { display: block; font-family: var(--font-mono); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.4rem; color: var(--accent); }
  .wbs-deliver li span { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; }
  .wbs-price p { max-width: 46rem; font-family: var(--font-serif); font-size: 1.4rem; line-height: 1.5; }
  .wbs-price-cop { font-family: var(--font-mono); font-size: .75rem; color: var(--ink-dim); margin: .15rem 0 .25rem; }
  .wbs-close { background: var(--bg-raise); border-block: 1px solid var(--line); margin-top: 3rem; padding: 2.5rem 1.5rem; text-align: center; display: grid; gap: 1rem; justify-items: center; }
  .wbs-close h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0; text-wrap: balance; max-width: 44rem; }
  .wbs-close p { margin: 0; }
  .wbs-close small { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-dim); }
  .wbs-sticky { display: none; }
  @media (max-width: 47.99rem) {
    .wbs-hero { grid-template-columns: minmax(0, 1fr); }
    .wbs-figure { display: none; }
    .wbs-thumb { display: block; float: right; --machine-h-phone: 112px; margin: -0.4rem -0.25rem 0.25rem 0.65rem; }
    .wbs-lede { clear: both; }
    .wbs-hero h1 { font-size: 1.95rem; }
    .wbs-ctas .wbs-btn { width: 100%; display: flex; justify-content: center; }
    .wbs-ctas .wbs-long { display: none; }
    .wbs-ctas .wbs-short { display: inline; }
    .wbs-price p { font-size: 1.2rem; }
    .wbs-sticky { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 5; align-items: center; gap: 0.65rem; padding: 0.65rem var(--space) calc(0.65rem + env(safe-area-inset-bottom, 0px)); background: color-mix(in srgb, var(--bg) 92%, transparent); border-top: 1px solid var(--line); backdrop-filter: blur(6px); }
    .wbs-sticky .wbs-btn { flex: 1; display: flex; justify-content: center; }
    .wbs-sticky .wbs-alt { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent); letter-spacing: 0.06em; white-space: nowrap; }
  }
</style>
  <Watermark kind="blueprint" />
  <section class="wrap workbench">
    <header class="wbs-hero">
      <div class="wbs-hero-text">
        <span class="label">{w.label}</span>
        <div class="wbs-thumb"><Machine id="workbench" ink="theme" height="112px" /></div>
        <h1>{s.head}</h1>
        <p class="wbs-lede">{s.lede}</p>
        <p class="wbs-ctas">
          <a class="wbs-btn" href={bookHref}><span class="wbs-long">{w.cta}</span><span class="wbs-short">{w.ctaShort}</span></a>
          <a class="wbs-alt" href={waHref} target="_blank" rel="noopener">{w.altCta}</a>
          <small>{w.ctaNote}</small>
        </p>
      </div>
      <figure class="wbs-figure">
        <Machine id="workbench" ink="theme" height="260px" class="wbs-machine" />
      </figure>
    </header>
    <section class="wbs-block">
      <span class="label">{s.kinds.kicker}</span>
      <ol class="wbs-scope">
        {s.kinds.items.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wbs-block">
      <span class="label">{s.how.kicker}</span>
      <ol class="wbs-steps">
        {s.how.steps.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wbs-block">
      <span class="label">{s.deliver.kicker}</span>
      <ol class="wbs-deliver">
        {s.deliver.items.map(([title, body]) => (
          <li><b>{title}</b><span>{body}</span></li>
        ))}
      </ol>
    </section>
    <section class="wbs-block wbs-price">
      <span class="label">{s.price.kicker}</span>
      <p>{s.price.text}</p>
      {lang === 'es' && <p class="wbs-price-cop">{s.price.cop}</p>}
    </section>
    <section class="wbs-close">
      <h2>{w.close.head}</h2>
      <p><a class="wbs-btn" href={waHref} target="_blank" rel="noopener">{w.close.cta}</a></p>
      <small>{w.close.phone}</small>
    </section>
  </section>
  <div class="wbs-sticky"><a class="wbs-btn" href={bookHref}>{w.ctaShort}</a><a class="wbs-alt" href={waHref} target="_blank" rel="noopener">{w.altCta}</a></div>
</BaseLayout>
