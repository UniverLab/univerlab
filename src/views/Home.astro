---
import BaseLayout from '../layouts/BaseLayout.astro';
import { liveExperiments } from '../lib/experiments';
import { getLang, useTranslations, localizePath } from '../i18n';
import { formatSolLabel } from '../lib/mission-time';
// The engraved mark is inlined so it takes `currentColor` (and therefore the
// ground's ink) instead of shipping a second request.
import logo from '../../public/bench/identidad/logo-grabado.svg?raw';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://univerlab.org');
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UniverLab',
  url: site.href,
  description: t.meta.description,
  inLanguage: lang === 'es' ? 'es' : 'en',
  publisher: { '@type': 'Organization', name: 'UniverLab', url: site.href },
};

// The imprint is engraved at build time and refreshed on load by lantern.ts.
const builtAt = new Date();
const imprint = `${builtAt.getFullYear()} · ${formatSolLabel(builtAt.toISOString())} · univerlab.org`;

// Intrinsic widths of the 450 px day plates (public/bench/manifest.json) — the
// row gives every machine the same HEIGHT, so only the ratio needs reserving.
const plateWidths: Record<string, number> = {
  canopy: 306,
  texforge: 421,
  gitkit: 453,
  ghscaff: 353,
  'astro-denoise': 344,
  demostage: 476,
  quorum: 392,
};

// Engraved sea lines for the horizon separator (drawHorizon in the mockup):
// sixteen closing in on the waterline, five fading above it.
const seaLines = Array.from({ length: 16 }, (_, i) => ({
  y: (46 + Math.pow(i / 15, 1.6) * 44).toFixed(1),
  w: (0.5 + i * 0.04).toFixed(2),
}));
const skyLines = Array.from({ length: 5 }, (_, i) => ({
  y: (46 - (i + 1) * (i + 1) * 1.6).toFixed(1),
  o: (0.5 - (i + 1) * 0.07).toFixed(2),
}));
---

<BaseLayout title={t.meta.title} bg="cosmic" circadian structuredData={webSite}>
  <div class="crt-view" id="home-view">
    <section class="wrap hall" aria-labelledby="frontis-title">
      <!-- Frontispiece: the title page of an old encyclopedia. -->
      <header class="frontis">
        <span class="fr-rule" aria-hidden="true"></span>
        <h1 id="frontis-title">UniverLab</h1>
        <p class="fr-sub">{t.home.frontis.sub}</p>
        <span class="fr-mark" aria-hidden="true" set:html={logo} />
        <p class="fr-motto">{t.home.hero.subtitle}</p>
        <span class="fr-rule thin" aria-hidden="true"></span>
        <p class="fr-imprint" id="imprint">{imprint}</p>
      </header>

      <p class="plate-label">{t.home.plate.lead} · <i>{t.home.plate.title}</i></p>

      <!-- Plate I: the magic lantern and its screen. -->
      <div class="lantern">
        <div
          class="screen"
          id="screen"
          data-viewer-day="0.135 0.078 0.8 0.694"
          data-viewer-night="0.16 0.068 0.69 0.70"
          style="left: 13.5%; top: 7.8%; width: 80%; height: 69.4%"
          aria-hidden="true"
        >
          <div class="slide title-slide is-on">
            <span class="title-mark" set:html={logo} />
            <span class="title-name">UniverLab</span>
            <p class="title-sub">{t.home.hero.subtitle}</p>
          </div>
          {liveExperiments.map((exp) => {
            const e = t.experiments[exp.id];
            const bench =
              'bench' in e && typeof (e as { bench?: unknown }).bench === 'string'
                ? (e as unknown as { bench: string }).bench
                : '';
            return (
              <div
                class="slide"
                data-exp={exp.id}
                data-tagline={e.tagline}
                data-bench={bench}
                data-surface={exp.surface}
                data-world-hint={t.home.lantern.worldHint[exp.id]}
              >
                <video
                  src={`/bench/clips/${exp.id}.mp4`}
                  poster={`/bench/clips/${exp.id}.webp`}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"></video>
                <p class="caption"><b>{exp.name}</b> — {e.tagline}</p>
              </div>
            );
          })}
          <div class="world-host" id="world-host" aria-hidden="true"></div>
          <canvas class="film" id="film" aria-hidden="true"></canvas>
          <div class="typed" id="typed" aria-hidden="true"><span class="k" data-typed="k"></span><span class="cmd" data-typed="cmd"></span><span class="line" data-typed="line"></span></div>
          <div class="catch" id="catch" aria-hidden="true"></div>
        </div>

        <picture class="lantern-pic">
          <source
            data-phase="day"
            type="image/avif"
            srcset="/bench/live/lantern-day-450.avif 450w, /bench/live/lantern-day-900.avif 900w"
            sizes="(min-width: 50rem) 760px, 100vw"
          />
          <source
            data-phase="day"
            type="image/webp"
            srcset="/bench/live/lantern-day-450.webp 450w, /bench/live/lantern-day-900.webp 900w"
            sizes="(min-width: 50rem) 760px, 100vw"
          />
          <source
            data-phase="night"
            type="image/avif"
            media="not all"
            srcset="/bench/live/lantern-night-450.avif 450w, /bench/live/lantern-night-900.avif 900w"
            sizes="(min-width: 50rem) 760px, 100vw"
          />
          <source
            data-phase="night"
            type="image/webp"
            media="not all"
            srcset="/bench/live/lantern-night-450.webp 450w, /bench/live/lantern-night-900.webp 900w"
            sizes="(min-width: 50rem) 760px, 100vw"
          />
          <img
            id="lantern-img"
            src="/bench/live/lantern-day-900.webp"
            width="1068"
            height="900"
            alt={t.home.lantern.alt}
            fetchpriority="high"
            data-day-src="/bench/live/lantern-day-900.webp"
            data-night-src="/bench/live/lantern-night-900.webp"
          />
        </picture>
      </div>

      <!-- The bench: the seven machines, all the same height. -->
      <div class="row-wrap">
        <div class="row" role="group" aria-label={t.home.lantern.benchLabel}>
          {liveExperiments.map((exp) => {
            const e = t.experiments[exp.id];
            return (
              <button
                type="button"
                class="plate"
                data-exp={exp.id}
                data-href={localizePath(`/${exp.id}`, lang)}
                aria-current="false"
              >
                <picture>
                  <source data-phase="day" type="image/avif" srcset={`/bench/machines/${exp.id}-day-450.avif`} />
                  <source data-phase="day" type="image/webp" srcset={`/bench/machines/${exp.id}-day-450.webp`} />
                  <source data-phase="night" type="image/avif" media="not all" srcset={`/bench/machines/${exp.id}-night-450.avif`} />
                  <source data-phase="night" type="image/webp" media="not all" srcset={`/bench/machines/${exp.id}-night-450.webp`} />
                  <img
                    src={`/bench/machines/${exp.id}-day-450.webp`}
                    width={plateWidths[exp.id] ?? 450}
                    height="450"
                    alt=""
                    fetchpriority="low"
                    data-day-src={`/bench/machines/${exp.id}-day-450.webp`}
                    data-night-src={`/bench/machines/${exp.id}-night-450.webp`}
                  />
                </picture>
                <span>{exp.name}</span>
              </button>
            );
          })}
        </div>
      </div>

      <div class="bench-foot">
        <p class="hint">{t.home.lantern.benchLabel}</p>
        <button
          type="button"
          class="lantern-pause"
          id="lantern-pause"
          aria-pressed="false"
          data-pause-label={t.home.lantern.pause}
          data-resume-label={t.home.lantern.resume}
        >
          {t.home.lantern.pause}
        </button>
      </div>
    </section>

    <!-- About the lab: the former hero, now below the plate. -->
    <section class="wrap section two-col about">
      <div>
        <span class="label">{t.home.about.kicker}</span>
        <h2>{t.home.hero.title}</h2>
      </div>
      <div>
        <p class="prose lede" set:html={t.home.hero.lede} />
        <div class="pitch">
          <p class="pitch-domains">{t.home.hero.pitch}</p>
          <p class="pitch-sub">{t.home.hero.pitchSub}</p>
        </div>
        <div class="hero-cta">
          <a class="btn" href={localizePath('/experiments', lang)}>{t.home.hero.ctaExperiments}</a>
          <a class="btn ghost" href={localizePath('/manifesto', lang)}>{t.home.hero.ctaManifesto}</a>
        </div>
      </div>
    </section>

    <!-- The horizon appears once, after the lab's paragraph. -->
    <div class="wrap sep horizon" aria-hidden="true">
      <svg viewBox="0 0 1000 92" id="horizon-svg">
        <defs>
          <mask id="horizon-mask">
            <rect width="1000" height="92" fill="white" />
            <rect id="horizon-gap" x="318" y="24" width="364" height="44" fill="black" />
          </mask>
        </defs>
        <g mask="url(#horizon-mask)">
          {seaLines.map((l) => (
            <line x1="0" y1={l.y} x2="1000" y2={l.y} stroke="currentColor" stroke-width={l.w} />
          ))}
          {skyLines.map((l) => (
            <line x1="0" y1={l.y} x2="1000" y2={l.y} stroke="currentColor" stroke-width="0.4" opacity={l.o} />
          ))}
          <line x1="0" y1="46" x2="1000" y2="46" stroke="currentColor" stroke-width="1.8" />
        </g>
        <text
          id="horizon-text"
          x="500"
          y="57"
          text-anchor="middle"
          font-family="Sometype Mono, monospace"
          font-size="30"
          letter-spacing="10"
          fill="currentColor">SCI · CLI · BIO</text>
      </svg>
    </div>

    <!-- Lineage / origin: the genesis story, now after the experiments it produced -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.lineage.kicker}</span><h2>{t.home.lineage.title}</h2></div>
      <div class="prose"><p set:html={t.home.lineage.body} /></div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Philosophy -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.philosophy.kicker}</span><h2>{t.home.philosophy.title}</h2></div>
      <div class="prose">
        <p set:html={t.home.philosophy.body} />
        <ul class="values label">
          {t.home.philosophy.values.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Research directions -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.directions.kicker}</span><h2>{t.home.directions.title}</h2></div>
      <div>
        <p class="axis">{t.home.directions.axis}</p>
        <div class="directions">
          <div class="dir-now">
            <span class="label">{t.home.directions.now}</span>
            <ul>{t.home.directions.nowItems.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="dir-next">
            <span class="label">{t.home.directions.next}</span>
            <ul>{t.home.directions.nextItems.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Closing -->
    <section class="wrap section closing">
      <span class="label">{t.home.closing.kicker}</span>
      <h2>{t.home.closing.title}</h2>
      <p class="prose" set:html={t.home.closing.body} />
      <div class="closing-cta">
        <a class="btn" href={localizePath('/manifesto', lang)}>{t.home.closing.manifesto}</a>
        <a class="btn ghost" href="https://github.com/UniverLab" target="_blank" rel="noopener noreferrer">{t.home.closing.contribute}</a>
      </div>
    </section>
  </div>

  <div class="crt-dot" id="crt-dot" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* ── Frontispiece ─────────────────────────────────────────────────────── */
  .hall { display: grid; justify-items: center; gap: 0.75rem;
          padding-block: clamp(1.5rem, 4vh, 2.5rem) 2rem; }
  .frontis { display: grid; justify-items: center; text-align: center; gap: 10px;
             padding-block: 8px 4px; max-width: 40rem; margin-inline: auto; }
  .frontis h1 {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(44px, 9vw, 84px); letter-spacing: 0.14em;
    text-transform: uppercase; line-height: 1; margin: 6px 0 0;
    padding-left: 0.14em;
  }
  .fr-rule { display: block; width: min(100%, 26rem); height: 7px;
             border-top: 1.5px solid var(--bench-line);
             border-bottom: 0.75px solid var(--bench-line); }
  .fr-rule.thin { width: min(60%, 14rem); height: 0; border-bottom: 0;
                  border-top: 0.75px solid var(--bench-line-soft); }
  .fr-sub { margin: 0; font-family: var(--font-serif); font-variant: small-caps;
            letter-spacing: 0.12em; font-size: clamp(17px, 2.6vw, 22px);
            color: var(--bench-line); }
  /* Inlined SVG: it inherits the ground's ink through currentColor, so the
     night inversion happens in the token, not in a filter. */
  .fr-mark { display: block; width: 58px; height: 58px; margin-block: 6px 2px;
             color: var(--bench-line); }
  .fr-mark :global(svg) { display: block; width: 100%; height: 100%; }
  .fr-motto { margin: 0; font-family: var(--font-serif); font-style: italic;
              font-size: clamp(17px, 2.4vw, 21px); color: var(--bench-line-soft); }
  .fr-imprint { margin: 0; font-family: var(--font-mono); font-size: 12px;
                letter-spacing: 0.18em; text-transform: uppercase;
                color: var(--bench-line-soft); }

  .plate-label { margin: 18px 0 0; text-align: center; font-family: var(--font-mono);
                 font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
                 color: var(--bench-line-soft); }
  .plate-label i { font-family: var(--font-serif); font-style: italic;
                   text-transform: none; letter-spacing: 0; font-size: 15px;
                   color: var(--bench-line); }

  /* ── The lantern and its screen ───────────────────────────────────────── */
  .lantern { position: relative; width: min(100%, 780px); }
  .lantern-pic { position: relative; z-index: 2; display: block; pointer-events: none; }
  .lantern-pic img { display: block; width: 100%; height: auto; pointer-events: none; }
  .screen { position: absolute; z-index: 1; overflow: hidden;
            background: var(--bench-c-parchment); }
  :global(html[data-bench-theme='night']) .screen { background: #15110c; }

  /* Each slide fills the screen; the clip is letterboxed inside it (`contain`)
     and the caption rides along the bottom edge, over the clip, as in the
     mockup — never a band that shrinks the projection. */
  .slide { position: absolute; inset: 0; z-index: 2; opacity: 0;
           transition: opacity 0.25s ease, transform 0.6s ease; }
  .slide.is-on { opacity: 1; }
  .slide video { position: absolute; inset: 0; display: block;
                 width: 100%; height: 100%;
                 object-fit: contain; filter: var(--bench-clip-filter); }

  /* World mode: the screen becomes the experiment's live background. The
     world host paints under the clip (z 1); the clip shrinks, paperless, to
     the lower right under a soft mask; the film grain stays over it (z 3);
     the freed corner types the experiment out (z 4); the catcher takes
     the pointer on top (z 5). */
  /* The world keeps the experiment's own ground (`data-surface` carries its
     `--surface-bg`): its modules draw their marks over the page's surface,
     so a parchment lantern behind them would wash them out. */
  .world-host { position: absolute; inset: 0; z-index: 1; overflow: hidden;
                background: var(--surface-bg, var(--bench-c-parchment)); }
  .world-host:empty { display: none; }
  .screen.is-world .slide.is-on { transform: translate(27%, 20%) scale(.48);
    -webkit-mask-image: radial-gradient(ellipse 46% 46% at 50% 50%, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 46% 46% at 50% 50%, #000 70%, transparent 100%);
    transition: opacity 0.25s ease, transform 0.6s ease; }
  .screen.is-world .slide.is-on video { filter: none; }
  .screen.is-world.on-light .slide.is-on { mix-blend-mode: multiply; }
  .screen.is-world.on-dark .slide.is-on { filter: invert(1) hue-rotate(180deg); mix-blend-mode: screen; }
  .typed { position: absolute; left: 4%; top: 6%; z-index: 4; max-width: 74%;
           display: grid; gap: 6px; margin: 0;
           font-family: var(--font-mono); opacity: 0; pointer-events: none;
           transition: opacity 0.4s ease; }
  .screen.is-world .typed { opacity: 1; }
  .typed .k { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .typed .cmd { font-size: 14px; line-height: 1.4; white-space: pre-wrap; overflow-wrap: anywhere; }
  .typed .cmd::after { content: "▌"; animation: typed-blink 1s steps(1) infinite; }
  .typed .line { font-family: var(--font-serif); font-style: italic;
                 font-size: 16px; line-height: 1.3; text-wrap: balance;
                 opacity: 0; transition: opacity 0.6s ease; }
  .typed .line.is-on { opacity: 1; }
  @keyframes typed-blink { 50% { opacity: 0; } }
  .screen.on-light .typed { color: #2a2118;
    background: radial-gradient(ellipse at 35% 45%, rgba(244, 240, 234, .92) 45%, rgba(244, 240, 234, 0) 78%); }
  .screen.on-dark .typed { color: #ece4d4;
    background: radial-gradient(ellipse at 35% 45%, rgba(10, 10, 14, .78) 45%, rgba(10, 10, 14, 0) 78%); }
  .catch { position: absolute; inset: 0; z-index: 5; cursor: crosshair; touch-action: manipulation; }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
    .typed .cmd::after { animation: none; }
  }

  /* The title slide is a group, centred as a whole: the mark above the name,
     the motto under it. (`place-content` alone would keep .slide's row
     template and scatter the three children over the full height.) */
  .title-slide { display: grid; align-content: center; justify-items: center;
                 text-align: center; gap: 6px; padding: 6%; }
  .title-mark { display: block; width: 44px; height: 44px; margin: 0 auto 4px;
                color: var(--bench-line); }
  .title-mark :global(svg) { display: block; width: 100%; height: 100%; }
  .title-name { font-family: var(--font-serif); font-size: clamp(22px, 4.5vw, 44px);
                letter-spacing: 0.12em; line-height: 1; color: var(--bench-line); }
  .title-sub { margin: 0; font-family: var(--font-serif); font-style: italic;
               font-size: clamp(11px, 1.8vw, 16px); color: var(--bench-line-soft); }

  /* Absolute and above the film layer, so it stays crisp and centred: `main p`
     caps paragraphs at 65ch, which would otherwise push it off the screen. */
  .caption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4;
             max-width: none; margin: 0; padding: 0 6% 3.2%;
             font-family: var(--font-serif); font-style: italic;
             font-size: clamp(11px, 1.7vw, 17px); line-height: 1.3;
             color: var(--bench-line); text-align: center;
             text-wrap: balance;
             text-shadow: 0 0 6px rgba(244, 240, 234, 0.85); }
  :global(html[data-bench-theme='night']) .caption {
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.75); }
  .caption b { font-style: normal; font-weight: 400; letter-spacing: 0.05em; }

  .film { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%;
          pointer-events: none; }

  /* ── The bench ────────────────────────────────────────────────────────── */
  .row-wrap { overflow-x: auto; width: 100%; margin-top: 0.5rem;
              -webkit-overflow-scrolling: touch; }
  .row { display: flex; align-items: flex-end; justify-content: center;
         gap: clamp(0.75rem, 2vw, 1.5rem); min-width: max-content;
         padding: 6px 4px; margin-inline: auto; }
  .plate { background: none; border: 0; padding: 0; cursor: pointer;
           display: grid; justify-items: center; gap: 6px; font: inherit;
           color: var(--bench-line); opacity: 0.55;
           transition: opacity 0.3s ease; }
  .plate picture { display: block; height: 120px; }
  .plate img { display: block; height: 100%; width: auto; }
  .plate span { font-family: var(--font-serif); font-style: italic; font-size: 13px; }
  .plate[aria-current='true'] { opacity: 1; }
  .plate:focus-visible { outline: 2px solid var(--bench-line); outline-offset: 3px; }
  @media (max-width: 47.999rem) { .plate picture { height: 84px; } }

  .bench-foot { display: flex; flex-wrap: wrap; align-items: center;
                justify-content: center; gap: 0.5rem 1.25rem; margin-top: 0.25rem; }
  .hint { margin: 0; font-size: 0.85rem; color: var(--bench-line-soft);
          text-align: center; max-width: none; }
  .lantern-pause { font-family: var(--font-mono); font-size: 0.72rem;
                   letter-spacing: 0.08em; text-transform: uppercase;
                   color: var(--bench-line); background: transparent;
                   border: 1px solid var(--bench-line-soft);
                   padding: 0.35rem 0.7rem; cursor: pointer; }
  .lantern-pause:hover { border-color: var(--bench-line); }
  .lantern-pause[aria-pressed='true'] { background: var(--bench-line);
                                        color: var(--bench-ground); }
  .lantern-pause:focus-visible { outline: 2px solid var(--bench-line); outline-offset: 3px; }

  /* ── Separators ───────────────────────────────────────────────────────── */
  .sep { color: var(--bench-line); margin-block: 2.25rem; }
  .horizon svg { display: block; width: 100%; height: auto; overflow: visible; }
  .dinkus { display: grid; grid-template-columns: 1fr auto 1fr;
            align-items: center; gap: 1.125rem; color: var(--bench-line-soft);
            margin-block: 2rem; }
  .dinkus::before, .dinkus::after { content: ''; height: 1px;
    background: linear-gradient(90deg, transparent, currentColor 30%, currentColor 70%, transparent);
    opacity: 0.7; }
  .dinkus > span { font-family: var(--font-serif); font-size: 22px;
                   line-height: 1; color: var(--bench-line); }

  /* ── About the lab and the lower sections ─────────────────────────────── */
  .section { padding-block: clamp(2.75rem, 6vw, 4rem); }
  .lede { font-size: 1.12rem; color: var(--ink-dim); margin: 0; }
  :global(.lede strong) { color: var(--accent); font-weight: 500; }

  .pitch { margin-top: 0.9rem; }
  .pitch-domains { font-family: var(--font-mono); font-size: 0.88rem;
                   letter-spacing: 0.06em; color: var(--ink); margin: 0; }
  .pitch-sub { font-size: 0.85rem; color: var(--ink-faint); margin: 0.3rem 0 0; }

  .hero-cta { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap;
              margin-top: 1.2rem; }
  .btn { text-decoration: none; border: 1px solid var(--accent);
         color: var(--accent); padding: 0.55rem 1.1rem;
         font-family: var(--font-mono); font-size: 0.85rem;
         transition: background 0.15s ease, color 0.15s ease; }
  .btn:hover { background: var(--accent); color: var(--bg); }
  .btn.ghost { border-color: var(--line); color: var(--ink-dim); }
  .btn.ghost:hover { border-color: var(--ink); color: var(--ink); background: transparent; }

  .two-col { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: 2.5rem; }
  .two-col h2 { font-size: 1.7rem; margin-top: 0.7rem; max-width: 16ch; }
  @media (max-width: 47.999rem) { .two-col { grid-template-columns: 1fr; } }
  :global(.section .prose a) { color: var(--ink); }

  .two-col .label:not(.values) { display: block; margin-bottom: 0.35rem; }
  .closing .label { display: block; }

  .values { list-style: none; padding: 0; margin: 1.4rem 0 0;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
            gap: 0.6rem 1.5rem; }
  .values li::before { content: '— '; color: var(--ink-faint); }

  .directions { display: grid; grid-template-columns: 1fr 1fr;
                gap: clamp(1.5rem, 3vw, 2.5rem); }
  .directions ul { list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .directions li { padding-block: 0.35rem; border-bottom: 1px solid var(--line); }
  .dir-now .label { color: var(--ink); }
  .dir-now li { color: var(--ink-dim); }
  .dir-next .label { color: var(--ink-faint); }
  .dir-next li { color: var(--ink-faint);
                 border-bottom-color: color-mix(in srgb, var(--line) 60%, transparent); }
  @media (max-width: 40rem) { .directions { grid-template-columns: 1fr; } }

  .axis { color: var(--ink-dim); margin: 0 0 1rem; max-width: 60ch; }

  .closing { padding-block: clamp(2.75rem, 6vw, 4rem) 5rem; }
  .closing h2 { font-size: 1.8rem; margin-block: 0.7rem 1rem; max-width: 22ch; }
  .closing .prose { color: var(--ink-dim); }
  .closing-cta { display: flex; gap: 1.2rem; align-items: center;
                 flex-wrap: wrap; margin-top: 1.4rem; }
</style>

<script>
  import { startLantern } from '../scripts/lantern';
  import { crtNavigate } from '../scripts/crt';

  startLantern();

  // A machine opens its experiment page through the CRT power-off. The key
  // `sessionStorage['univerlab-crt']` tells BaseLayout to play crt-on once the
  // destination has loaded; crt.ts owns that handshake.
  const view = document.getElementById('home-view');
  const dot = document.getElementById('crt-dot');
  document.querySelectorAll<HTMLButtonElement>('.plate[data-exp]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const href = btn.dataset.href;
      if (!href) return;
      if (view && dot) crtNavigate(href, view, dot);
      else window.location.assign(href);
    });
  });
</script>
