---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabLantern from '../components/LabLantern.astro';
import { getLang, useTranslations, localizePath } from '../i18n';
import { formatSolLabel } from '../lib/mission-time';
// The engraved mark is inlined so it takes `currentColor` (and therefore the
// ground's ink) instead of shipping a second request.
import logo from '../../public/bench/identidad/logo-grabado.svg?raw';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://univerlab.org');
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UniverLab',
  url: site.href,
  description: t.meta.description,
  inLanguage: lang === 'es' ? 'es' : 'en',
  publisher: { '@type': 'Organization', name: 'UniverLab', url: site.href },
};

// The imprint is engraved at build time and refreshed on load by lantern.ts.
const builtAt = new Date();
const imprint = `${builtAt.getFullYear()} · ${formatSolLabel(builtAt.toISOString())} · univerlab.org`;

// Engraved sea lines for the horizon separator (drawHorizon in the mockup):
// sixteen closing in on the waterline, five fading above it.
const seaLines = Array.from({ length: 16 }, (_, i) => ({
  y: (46 + Math.pow(i / 15, 1.6) * 44).toFixed(1),
  w: (0.5 + i * 0.04).toFixed(2),
}));
const skyLines = Array.from({ length: 5 }, (_, i) => ({
  y: (46 - (i + 1) * (i + 1) * 1.6).toFixed(1),
  o: (0.5 - (i + 1) * 0.07).toFixed(2),
}));
---

<BaseLayout title={t.meta.title} circadian structuredData={webSite}>
  <div id="home-view">
    <section class="wrap hall" aria-labelledby="frontis-title">
      <!-- Frontispiece: the title page of an old encyclopedia. -->
      <header class="frontis">
        <span class="fr-rule" aria-hidden="true"></span>
        <h1 id="frontis-title">UniverLab</h1>
        <p class="fr-sub">{t.home.frontis.sub}</p>
        <span class="fr-mark" aria-hidden="true" set:html={logo} />
        <p class="fr-motto">{t.home.hero.subtitle}</p>
        <span class="fr-rule thin" aria-hidden="true"></span>
        <p class="fr-imprint" id="imprint">{imprint}</p>
      </header>

      <p class="plate-label">{t.home.plate.lead} · <i>{t.home.plate.title}</i></p>

      <LabLantern />
    </section>

    <!-- About the lab: the former hero, now below the plate. -->
    <section class="wrap section two-col about">
      <div>
        <span class="label">{t.home.about.kicker}</span>
        <h2>{t.home.hero.title}</h2>
      </div>
      <div>
        <p class="prose lede" set:html={t.home.hero.lede} />
        <div class="pitch">
          <p class="pitch-domains">{t.home.hero.pitch}</p>
          <p class="pitch-sub">{t.home.hero.pitchSub}</p>
        </div>
        <div class="hero-cta">
          <a class="btn" href={localizePath('/experiments', lang)}>{t.home.hero.ctaExperiments}</a>
          <a class="btn ghost" href={localizePath('/manifesto', lang)}>{t.home.hero.ctaManifesto}</a>
        </div>
      </div>
    </section>

    <!-- The horizon appears once, after the lab's paragraph. -->
    <div class="wrap sep horizon" aria-hidden="true">
      <svg viewBox="0 0 1000 92" id="horizon-svg">
        <defs>
          <mask id="horizon-mask">
            <rect width="1000" height="92" fill="white" />
            <rect id="horizon-gap" x="318" y="24" width="364" height="44" fill="black" />
          </mask>
        </defs>
        <g mask="url(#horizon-mask)">
          {seaLines.map((l) => (
            <line x1="0" y1={l.y} x2="1000" y2={l.y} stroke="currentColor" stroke-width={l.w} />
          ))}
          {skyLines.map((l) => (
            <line x1="0" y1={l.y} x2="1000" y2={l.y} stroke="currentColor" stroke-width="0.4" opacity={l.o} />
          ))}
          <line x1="0" y1="46" x2="1000" y2="46" stroke="currentColor" stroke-width="1.8" />
        </g>
        <text
          id="horizon-text"
          x="500"
          y="57"
          text-anchor="middle"
          font-family="Sometype Mono, monospace"
          font-size="30"
          letter-spacing="10"
          fill="currentColor">SCI · CLI · BIO</text>
      </svg>
    </div>

    <!-- Lineage / origin: the genesis story, now after the experiments it produced -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.lineage.kicker}</span><h2>{t.home.lineage.title}</h2></div>
      <div class="prose"><p set:html={t.home.lineage.body} /></div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Philosophy -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.philosophy.kicker}</span><h2>{t.home.philosophy.title}</h2></div>
      <div class="prose">
        <p set:html={t.home.philosophy.body} />
        <ul class="values label">
          {t.home.philosophy.values.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Research directions -->
    <section class="wrap section two-col">
      <div><span class="label">{t.home.directions.kicker}</span><h2>{t.home.directions.title}</h2></div>
      <div>
        <p class="axis">{t.home.directions.axis}</p>
        <div class="directions">
          <div class="dir-now">
            <span class="label">{t.home.directions.now}</span>
            <ul>{t.home.directions.nowItems.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="dir-next">
            <span class="label">{t.home.directions.next}</span>
            <ul>{t.home.directions.nextItems.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
        <a class="btn dir-roadmap" href="/roadmap/">{t.home.directions.roadmap}</a>
      </div>
    </section>

    <div class="wrap sep dinkus" aria-hidden="true"><span>⁂</span></div>

    <!-- Closing -->
    <section class="wrap section closing">
      <span class="label">{t.home.closing.kicker}</span>
      <h2>{t.home.closing.title}</h2>
      <p class="prose" set:html={t.home.closing.body} />
      <div class="closing-cta">
        <a class="btn" href={localizePath('/manifesto', lang)}>{t.home.closing.manifesto}</a>
        <a class="btn ghost" href="https://github.com/UniverLab" target="_blank" rel="noopener noreferrer">{t.home.closing.contribute}</a>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  /* ── Frontispiece ─────────────────────────────────────────────────────── */
  .hall { display: grid; justify-items: center; gap: 0.75rem;
          padding-block: clamp(1.5rem, 4vh, 2.5rem) 2rem; }
  .frontis { display: grid; justify-items: center; text-align: center; gap: 10px;
             padding-block: 8px 4px; max-width: 40rem; margin-inline: auto; }
  .frontis h1 {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(44px, 9vw, 84px); letter-spacing: 0.14em;
    text-transform: uppercase; line-height: 1; margin: 6px 0 0;
    padding-left: 0.14em;
  }
  .fr-rule { display: block; width: min(100%, 26rem); height: 7px;
             border-top: 1.5px solid var(--bench-line);
             border-bottom: 0.75px solid var(--bench-line); }
  .fr-rule.thin { width: min(60%, 14rem); height: 0; border-bottom: 0;
                  border-top: 0.75px solid var(--bench-line-soft); }
  .fr-sub { margin: 0; font-family: var(--font-serif); font-variant: small-caps;
            letter-spacing: 0.12em; font-size: clamp(17px, 2.6vw, 22px);
            color: var(--bench-line); }
  /* Inlined SVG: it inherits the ground's ink through currentColor, so the
     night inversion happens in the token, not in a filter. */
  .fr-mark { display: block; width: 58px; height: 58px; margin-block: 6px 2px;
             color: var(--bench-line); }
  .fr-mark :global(svg) { display: block; width: 100%; height: 100%; }
  .fr-motto { margin: 0; font-family: var(--font-serif); font-style: italic;
              font-size: clamp(17px, 2.4vw, 21px); color: var(--bench-line-soft); }
  .fr-imprint { margin: 0; font-family: var(--font-mono); font-size: 12px;
                letter-spacing: 0.18em; text-transform: uppercase;
                color: var(--bench-line-soft); }

  .plate-label { margin: 18px 0 0; text-align: center; font-family: var(--font-mono);
                 font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
                 color: var(--bench-line-soft); }
  .plate-label i { font-family: var(--font-serif); font-style: italic;
                   text-transform: none; letter-spacing: 0; font-size: 15px;
                   color: var(--bench-line); }

  /* ── Separators ───────────────────────────────────────────────────────── */
  .sep { color: var(--bench-line); margin-block: 2.25rem; }
  .horizon svg { display: block; width: 100%; height: auto; overflow: visible; }
  .dinkus { display: grid; grid-template-columns: 1fr auto 1fr;
            align-items: center; gap: 1.125rem; color: var(--bench-line-soft);
            margin-block: 2rem; }
  .dinkus::before, .dinkus::after { content: ''; height: 1px;
    background: linear-gradient(90deg, transparent, currentColor 30%, currentColor 70%, transparent);
    opacity: 0.7; }
  .dinkus > span { font-family: var(--font-serif); font-size: 22px;
                   line-height: 1; color: var(--bench-line); }

  /* ── About the lab and the lower sections ─────────────────────────────── */
  .section { padding-block: clamp(2.75rem, 6vw, 4rem); }
  .lede { font-size: 1.12rem; color: var(--ink-dim); margin: 0; }
  :global(.lede strong) { color: var(--accent); font-weight: 500; }

  .pitch { margin-top: 0.9rem; }
  .pitch-domains { font-family: var(--font-mono); font-size: 0.88rem;
                   letter-spacing: 0.06em; color: var(--ink); margin: 0; }
  .pitch-sub { font-size: 0.85rem; color: var(--ink-faint); margin: 0.3rem 0 0; }

  .hero-cta { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap;
              margin-top: 1.2rem; }
  .btn { text-decoration: none; border: 1px solid var(--accent);
         color: var(--accent); padding: 0.55rem 1.1rem;
         font-family: var(--font-mono); font-size: 0.85rem;
         transition: background 0.15s ease, color 0.15s ease; }
  .btn:hover { background: var(--accent); color: var(--bg); }
  .btn.ghost { border-color: var(--line); color: var(--ink-dim); }
  .btn.ghost:hover { border-color: var(--ink); color: var(--ink); background: transparent; }

  .two-col { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: 2.5rem; }
  .two-col h2 { font-size: 1.7rem; margin-top: 0.7rem; max-width: 16ch; }
  @media (max-width: 47.999rem) { .two-col { grid-template-columns: 1fr; } }
  :global(.section .prose a) { color: var(--ink); }

  .two-col .label:not(.values) { display: block; margin-bottom: 0.35rem; }
  .closing .label { display: block; }

  .values { list-style: none; padding: 0; margin: 1.4rem 0 0;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
            gap: 0.6rem 1.5rem; }
  .values li::before { content: '— '; color: var(--ink-faint); }

  .directions { display: grid; grid-template-columns: 1fr 1fr;
                gap: clamp(1.5rem, 3vw, 2.5rem); }
  .directions ul { list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .directions li { padding-block: 0.35rem; border-bottom: 1px solid var(--line); }
  .dir-now .label { color: var(--ink); }
  .dir-now li { color: var(--ink-dim); }
  .dir-next .label { color: var(--ink-faint); }
  .dir-next li { color: var(--ink-faint);
                 border-bottom-color: color-mix(in srgb, var(--line) 60%, transparent); }
  @media (max-width: 40rem) { .directions { grid-template-columns: 1fr; } }

  .dir-roadmap { display: inline-block; margin-top: 1.2rem; }

  .axis { color: var(--ink-dim); margin: 0 0 1rem; max-width: 60ch; }

  .closing { padding-block: clamp(2.75rem, 6vw, 4rem) 5rem; }
  .closing h2 { font-size: 1.8rem; margin-block: 0.7rem 1rem; max-width: 22ch; }
  .closing .prose { color: var(--ink-dim); }
  .closing-cta { display: flex; gap: 1.2rem; align-items: center;
                 flex-wrap: wrap; margin-top: 1.4rem; }
</style>

