---
// Renders an experiment's README ASCII banner. The art is each project's own
// signature — representative, and on-brand for the lab. Most surfaces print it
// in ink (dark on light, light on dark). Canopy is the exception: it uses the
// same green gradient the CLI wizard prints line by line.
//
// Metrics: banners are drawn for DejaVu Sans Mono (same font embedded in the
// CLIs). IBM Plex Mono — the site mono — has different block-glyph widths, so
// descenders (g, p, y, t, f) look shifted if we reuse --font-mono here.
import { banners } from '../lib/banners';
interface Props { id: string; color: string; }
const { id, color } = Astro.props;
const art = banners[id]?.replace(/^\r?\n/, '');

// Canopy's wizard gradient — 8 greens from light to dark, matching the CLI.
const canopyGradient = [
  '#9dcfa1', '#84be89', '#6cae71', '#559d5a',
  '#3f8d44', '#2b7a30', '#1a6620', '#0c5212',
];
const useGradient = id === 'canopy';
const lines = art?.split('\n') ?? [];
const gradColor = (i: number) => {
  const idx = Math.round((i / Math.max(1, lines.length - 1)) * (canopyGradient.length - 1));
  return canopyGradient[Math.min(idx, canopyGradient.length - 1)];
};
---
{art && (
  useGradient ? (
    <pre class="banner gradient" aria-hidden="true" translate="no"><code>{lines.map((line, i) => (
        <span class="gline" style={`color: ${gradColor(i)}`}>{line}</span>
      ))}</code></pre>
  ) : (
    <pre class="banner" style={`--c: ${color}`} aria-hidden="true" translate="no"><code>{art}</code></pre>
  )
)}

<style>
  @font-face {
    font-family: 'DejaVu Sans Mono';
    src: url('/fonts/DejaVuSansMono.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* The banner is the ONLY visible product name, so it has to behave like
     body text: it never exceeds the content measure, and it lines up with
     whatever the hero's own alignment already is.

     `width: auto` is the load-bearing choice, not an omission. As a flex item
     the banner is shrink-to-fit, so the box takes the art's own width and the
     hero's `align-items` decides the rest for free: left-flow heroes (texforge,
     astro-denoise) get it flush with the lede, centred heroes (canopy,
     cadspec, demostage, gitkit, ghscaff, quorum) get it centred, and the one
     grid hero (paper) stretches it across both columns via `justify-self`. No
     per-surface rule is needed, and none is wanted.

     Two independent guards, because one is not enough:
       · `max-width:100%` + `min-width:0` + `overflow:hidden` make it
         structurally incapable of forcing a horizontal scrollbar — the grid
         and flex parents both size to it, never the other way round.
       · the font-size clamp is tuned so the WIDEST art (demostage, 94 columns,
         0.6023em advance in DejaVu Sans Mono) still fits the narrowest content
         column at 320px, so it shrinks to fit rather than being clipped.
     `text-align:left` is load-bearing too: several hero surfaces centre their
     text, and centring each line of block art would shear the letters apart. */
  .banner {
    margin: 0;
    padding: 0;
    width: auto;
    max-width: 100%;
    min-width: 0;
    text-align: left;
    overflow: hidden;
    color: var(--c);
    font-family: 'DejaVu Sans Mono', ui-monospace, monospace;
    font-size: clamp(5px, 1.15vw, 10px);
    line-height: 1;
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "clig" 0;
    letter-spacing: 0;
    word-spacing: 0;
    text-rendering: geometricPrecision;
    opacity: 0.92;
    text-shadow: 0 0 18px color-mix(in srgb, var(--c) 30%, transparent);
    scrollbar-width: none;
  }
  /* Below 40rem the base clamp bottoms out on its 5px floor, which leaves the
     widest art 60px short of the column on a 375px screen. This range trades
     the old floor for a slightly larger glyph (5.44px at 375px), which still
     fits — 94 columns × 5.44px × 0.6023em ≈ 308px inside 343px. Legibility,
     not overflow: the guards above are what make clipping impossible. */
  @media (max-width: 40rem) {
    .banner { font-size: clamp(3px, 1.45vw, 6px); }
  }
  .banner::-webkit-scrollbar { display: none; }
  .banner code {
    display: block;
    max-width: 100%;
    overflow: hidden;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-variant-numeric: normal;
  }
  .banner.gradient { color: var(--canopy); text-shadow: none; opacity: 1; }
  .banner.gradient .gline { display: block; text-shadow: 0 0 14px color-mix(in srgb, currentColor 20%, transparent); }
</style>
