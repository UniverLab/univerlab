---
import { plate, srcsetFor, plateSizes, type MachineTheme } from '../lib/machines';
import { getLang, useTranslations } from '../i18n';

interface Props {
  id: string;
  ink?: MachineTheme;
  height?: string;
  class?: string;
  eager?: boolean;
}
const { id, ink = 'night', height = '240px', class: className, eager = false } = Astro.props;
const inks: ReadonlyArray<'day' | 'night'> = ink === 'theme' ? ['day', 'night'] : [ink];
const lang = getLang(Astro.url);
const t = useTranslations(lang);
// The engraving's description, written once per machine: the workbench keeps
// its own key, every experiment keeps one under experiments[id].
const alt = id === 'workbench' ? t.workbench.machineAlt : t.experiments[id as keyof typeof t.experiments].machineAlt;
// A lone plate is the page's hero art: its URLs ship inline and eager. A theme
// pair ships every URL in data-* and the swap script below populates only the
// live phase at parse time (the other phase loads if the theme changes), so
// one variant — never both — downloads. The visible plate of a lazy pair also
// carries its day URL as src (a no-JS fallback the alt contract reads): lazy
// loading means the parse-time script still swaps in the live phase before
// anything fetches, while eager pairs stay data-only so the script alone picks
// the live phase. Below-fold pairs stay lazy through the native loading
// attribute; eager pairs (the workbench thumb) take the high-priority eager
// path instead.
const single = inks.length === 1;
const pairEager = eager && !single;
---
<span class:list={['machine', className]} data-machine={ink} style={`--machine-h:${height}`}>
  {inks.map((which) => {
    const p = plate(id, which);
    const sizes = plateSizes(p);
    // Only the visible plate exposes the description: a lone plate always
    // does, a theme pair ships it on the day plate with the night plate empty
    // and hidden, and the swap script moves the pair with the eager/lazy one
    // so a screen reader hears it once.
    const exposed = single || which === 'day';
    const avif = srcsetFor(id, which, 'avif');
    const webp = srcsetFor(id, which, 'webp');
    const fallback = `/bench/machines/${id}-${which}-450.webp`;
    return single ? (
      <picture class:list={['machine-pic', `machine-${which}`]}>
        <source srcset={avif} sizes={sizes} type="image/avif" />
        <source srcset={webp} sizes={sizes} type="image/webp" />
        <img
          src={fallback}
          width={p.w}
          height={p.h}
          alt={alt}
          data-alt={alt}
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    ) : (
      <picture class:list={['machine-pic', `machine-${which}`]}>
        <source data-srcset={avif} sizes={sizes} type="image/avif" />
        <source data-srcset={webp} sizes={sizes} type="image/webp" />
        <img
          src={exposed && !pairEager ? fallback : undefined}
          data-src={fallback}
          width={p.w}
          height={p.h}
          alt={exposed ? alt : ''}
          aria-hidden={exposed ? undefined : 'true'}
          data-alt={alt}
          decoding="async"
          fetchpriority={pairEager ? 'high' : undefined}
          loading={pairEager ? undefined : 'lazy'}
        />
      </picture>
    );
  })}
</span>

<!-- Only the picture matching the live phase gets real URLs: this parser-run
     script copies the active phase's data-* into src/srcset (eager at high
     priority, otherwise lazily through the native loading attribute), and the
     themechange listener populates the newly shown phase on a flip. A
     single-ink machine has no pair, so the sync below finds nothing and does
     nothing. -->
<script is:inline data-machine-swap>
  (function () {
    function populate(pic) {
      if (!pic) return;
      var sources = pic.querySelectorAll('source[data-srcset]');
      for (var i = 0; i < sources.length; i++) {
        if (!sources[i].hasAttribute('srcset')) {
          sources[i].setAttribute('srcset', sources[i].getAttribute('data-srcset'));
        }
      }
      var img = pic.querySelector('img[data-src]');
      if (img && !img.hasAttribute('src')) {
        img.setAttribute('src', img.getAttribute('data-src'));
      }
    }
    // Only the visible plate exposes the description: the live plate carries
    // its data-alt, the parked one carries an empty alt and stays hidden.
    function expose(img, hide) {
      img.setAttribute('alt', img.getAttribute('data-alt') || '');
      img.removeAttribute('aria-hidden');
      hide.setAttribute('alt', '');
      hide.setAttribute('aria-hidden', 'true');
    }
    function sync() {
      var night = document.documentElement.dataset.benchTheme === 'night';
      var roots = document.querySelectorAll('span[data-machine="theme"]');
      for (var i = 0; i < roots.length; i++) {
        var day = roots[i].querySelector('picture.machine-day');
        var dark = roots[i].querySelector('picture.machine-night');
        if (day && dark) {
          var show = night ? dark : day;
          var hide = night ? day : dark;
          populate(show);
          var simg = show.querySelector('img');
          var himg = hide.querySelector('img');
          if (simg && himg && simg.hasAttribute('src')) expose(simg, himg);
        }
      }
    }
    sync();
    window.addEventListener('univerlab:themechange', sync);
  })();
</script>

<style>
  /* Static (phone) the plate centres itself under the hero; absolutely
     placed in a hero corner it shrinks to the plate either way. */
  .machine { display: block; width: fit-content; margin-inline: auto; }
  .machine-pic { display: block; margin: 0; }
  .machine img { height: var(--machine-h); width: auto; display: block; }
  @media (max-width: 39.999rem) {
    .machine img { height: var(--machine-h-phone, 150px); }
  }
  /* The ink swap applies only to theme machines: a single-ink plate is the
     page's only machine and stays visible in either phase. */
  html[data-bench-theme='night'] .machine[data-machine='theme'] .machine-day { display: none; }
  html:not([data-bench-theme='night']) .machine[data-machine='theme'] .machine-night { display: none; }
</style>
