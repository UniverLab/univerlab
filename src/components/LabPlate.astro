---
import { byId, type ExperimentId } from '../lib/experiments';
import { getLang, useTranslations, localizePath } from '../i18n';
import { startSolLabel } from '../lib/mission-time';
import { latestRelease, releaseAgeLabel } from '../lib/releases';

interface Props { id: ExperimentId; }
const { id } = Astro.props;
const exp = byId(id);
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const statusLabel = t.status[exp.status];
const solLabel = exp.startDate ? startSolLabel(exp.startDate) : null;
const release = await latestRelease(exp.github);
const releaseAge = release ? releaseAgeLabel(release.publishedAt, lang) : '';
---
<p class="lab-plate" translate="no"
   data-exp-id={exp.id} data-exp-name={exp.name}
   data-roadmap-label={t.plate.roadmap} data-lastlog-label={t.plate.lastLog}
   data-lanes={JSON.stringify(t.roadmap.lanes)}
   data-status-label={statusLabel} data-start-sol={solLabel ?? ''}
   data-release={release?.version}
   data-release-date={release ? release.publishedAt.slice(0, 10) : undefined}>
  <span class="lp-num">{exp.number}</span>
  <span class="lp-sep"> · </span><span class="lp-status">{statusLabel}</span>
  {solLabel && (<><span class="lp-sep"> · </span><time class="lp-sol" datetime={exp.startDate} data-mission>{solLabel}</time></>)}
  {release && (
    <><span class="lp-sep"> · </span><a class="lp-release" href={release.url} target="_blank" rel="noopener noreferrer">{t.plate.release} {release.version}{releaseAge && <> · {releaseAge}</>}</a></>
  )}
  {exp.citation && (
    <><span class="lp-sep"> · </span><a class="lp-doi" href={`https://doi.org/${exp.citation.doi}`} target="_blank" rel="noopener noreferrer">DOI {exp.citation.doi}</a></>
  )}
  <span data-plate-seg="roadmap" hidden><span class="lp-sep"> · </span><span class="lp-roadmap">{t.plate.roadmap}: <span data-plate-roadmap></span></span></span>
  <span data-plate-seg="lastlog" hidden><span class="lp-sep"> · </span><span class="lp-lastlog" data-plate-lastlog></span></span>
  {exp.builtWith.map((tool) => (
    <>
      <span class="lp-sep"> · </span><span class="lp-built">{t.builtWithSegments[tool]}{' '}<a href={localizePath(`/${tool}`, lang)} translate="no">{byId(tool).name}</a></span>
    </>
  ))}
</p>

<style>
  .lab-plate {
    /* Quiet colophon row below the hero: mono, faint ink, flush left like
       the genesis section beneath it, wrapping on one line. */
    display: block; text-align: left;
    max-width: var(--max-w, 70rem); margin: 0 auto;
    padding: 0 var(--page-gutter);
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
  /* Segments with no data behind them stay hidden (no em-dash filler). */
  .lab-plate [hidden] { display: none; }
  .lab-plate .lp-num, .lab-plate .lp-status { color: var(--essence); }
  .lab-plate .lp-sep { color: var(--ink-faint); white-space: pre; }
  /* One link now lives in the caption (the release segment, spec
     lexp-release-signal supersedes R7's "no links"): underline off so it keeps
     the caption's mono register, essence on hover. */
  .lab-plate .lp-release, .lab-plate .lp-doi { text-decoration: none; }
  .lab-plate .lp-release:hover, .lab-plate .lp-doi:hover, .lab-plate .lp-built a:hover { color: var(--essence); }
  .lab-plate .lp-built a { color: var(--ink-faint); text-decoration-color: var(--line); }
</style>

<script>
  import { loadBoardData } from '../lib/announcements-client';
  import { selectEntries, firstNonDone, normalizeTopic } from '../lib/field-notes';
  import { formatSolLabel } from '../lib/mission-time';

  (async () => {
    const el = document.querySelector<HTMLElement>('.lab-plate[data-exp-id]');
    if (!el) return;
    let data: Awaited<ReturnType<typeof loadBoardData>>;
    try {
      data = await loadBoardData();
    } catch {
      return;
    }
    if (!data) return;
    const id = el.dataset.expId ?? '';
    const name = el.dataset.expName ?? '';
    const exp = { id, name };
    const mine = data.roadmap.filter((i) => normalizeTopic(i.topic) === id);
    const state = firstNonDone(mine, id);
    const rmSpan = el.querySelector('[data-plate-roadmap]');
    if (state && rmSpan) {
      let label = state;
      try {
        const lanes = el.dataset.lanes ? JSON.parse(el.dataset.lanes) : null;
        if (lanes && typeof lanes[state] === 'string') label = lanes[state];
      } catch {
        // Keep the raw state.
      }
      rmSpan.textContent = label;
      el.querySelector<HTMLElement>('[data-plate-seg="roadmap"]')?.removeAttribute('hidden');
    }
    const newest = selectEntries(data.entries, exp, 1)[0];
    const ll = el.querySelector('[data-plate-lastlog]');
    if (newest && ll) {
      const lastLogLabel = el.dataset.lastlogLabel ?? 'last log';
      const time = document.createElement('time');
      time.setAttribute('datetime', newest.date);
      time.setAttribute('data-mission', '');
      time.textContent = formatSolLabel(newest.date);
      ll.textContent = `${lastLogLabel}: `;
      ll.appendChild(time);
      ll.appendChild(document.createTextNode(` \u201c${newest.title}\u201d`));
      el.querySelector<HTMLElement>('[data-plate-seg="lastlog"]')?.removeAttribute('hidden');
    }
  })();
</script>
