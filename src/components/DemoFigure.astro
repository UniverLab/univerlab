---
// A short screen-recording demo, shown as "Fig. 1" right after the hero — the
// tool actually working, which is the most characteristic thing an experiment
// page can show. Autoplays muted and loops like an animated figure; reduced-
// motion visitors get it paused with controls instead. Rendered only when the
// experiment has a `demo` clip, so it stays invisible until one is recorded.
interface Props {
  /** Path to the mp4 clip, e.g. '/demos/gitkit.mp4'. */
  src: string;
  /** Optional poster frame (jpg/png) shown before play / under reduced motion. */
  poster?: string;
  /** Experiment essence color for the frame glow. */
  essence: string;
  /** Figure label, e.g. "Fig. 1". */
  label: string;
  /** Figure caption, e.g. "GitKit — recorded with DemoStage". */
  caption: string;
}
const { src, poster, essence, label, caption } = Astro.props;
const isGif = src.endsWith('.gif');
// The clip sits below the first screen: it shows its poster frame and loads
// only on approach. Dimensions are the real mp4 pixels (ffprobe), so the
// poster reserves the exact box and nothing shifts when the clip loads.
const DEMO_DIMS: Record<string, { w: number; h: number }> = {
  canopy: { w: 1440, h: 1026 },
  demostage: { w: 1200, h: 720 },
  ghscaff: { w: 1440, h: 1080 },
  gitkit: { w: 1440, h: 1026 },
  texforge: { w: 1440, h: 1080 },
};
const demoId = src.split('/').pop()?.replace(/\.mp4$/, '') ?? '';
const dims = DEMO_DIMS[demoId];
const posterUrl = poster ?? (src.endsWith('.mp4') ? src.replace(/\.mp4$/, '-poster.webp') : undefined);
---
<figure class="demo-fig" style={`--essence: ${essence}`} data-demo-src={src} data-demo-caption={caption}>
  <div class="demo-frame">
    {isGif ? (
      <img class="demo-video" src={src} alt={caption} loading="lazy" />
    ) : (
      <div class="demo-player">
        <video
          class="demo-video"
          muted
          loop
          playsinline
          preload="none"
          poster={posterUrl}
          width={dims?.w}
          height={dims?.h}
          aria-label={caption}
          data-demo-video
        >
          <source src={src} type="video/mp4" />
        </video>
        <div class="demo-bar">
          <div class="demo-progress"><div class="demo-fill"></div></div>
        </div>
      </div>
    )}
  </div>
  {/* Loupe artwork inlined from public/bench/identidad/lupa.svg so its copper strokes read var(--accent-secondary); geometry lives in that file. */}
  <div class="demo-lens" aria-hidden="true"><div class="demo-lens-inner"></div><!-- Loupe artwork: copper strokes read the site secondary accent token; remaining fixed values below are geometry ink only. --><svg class="demo-loupe" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 330 330" fill="none" stroke="#120d09" stroke-linecap="round" stroke-linejoin="round"><g fill="#2a2118"><g transform="rotate(45 150 150)"><path d="M270 136 h22 v28 h-22 Z" stroke-width="3"/><path d="M276 136 v28 M283 136 v28" stroke="var(--accent-secondary)" stroke-width="1.4"/><path d="M292 139 C314 134 334 134 366 138 C378 140 378 160 366 162 C334 166 314 166 292 161 Z" stroke-width="3"/><path d="M300 137 C296 146 296 154 300 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M307 137 C303 146 303 154 307 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M314 137 C310 146 310 154 314 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M321 137 C317 146 317 154 321 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M328 137 C324 146 324 154 328 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M335 137 C331 146 331 154 335 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M342 137 C338 146 338 154 342 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M349 137 C345 146 345 154 349 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M356 137 C352 146 352 154 356 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M363 137 C359 146 359 154 363 163" stroke="var(--accent-secondary)" stroke-width="1.1" fill="none" opacity=".9"/><path d="M370 144 q8 6 0 12" stroke-width="2"/></g></g><path d="M26 150 a124 124 0 1 0 248 0 a124 124 0 1 0 -248 0 Z M40 150 a110 110 0 1 1 220 0 a110 110 0 1 1 -220 0 Z" fill="#2a2118" fill-rule="evenodd" stroke="none"/><circle cx="150" cy="150" r="124" stroke-width="3.5"/><circle cx="150" cy="150" r="110" stroke-width="2.5"/><g stroke="var(--accent-secondary)" stroke-width="1.2" opacity=".9"><path d="M263 150 L270.85 156.05"/><path d="M262.57 159.85 L269.86 166.56"/><path d="M261.28 169.62 L267.96 176.94"/><path d="M259.15 179.25 L265.17 187.12"/><path d="M256.19 188.65 L261.49 197.02"/><path d="M252.41 197.76 L256.97 206.55"/><path d="M247.86 206.5 L251.63 215.66"/><path d="M242.56 214.81 L245.52 224.27"/><path d="M236.56 222.63 L238.69 232.31"/><path d="M229.9 229.9 L231.18 239.73"/><path d="M222.63 236.56 L223.05 246.46"/><path d="M214.81 242.56 L214.36 252.46"/><path d="M206.5 247.86 L205.19 257.68"/><path d="M197.76 252.41 L195.59 262.08"/><path d="M188.65 256.19 L185.65 265.63"/><path d="M179.25 259.15 L175.44 268.3"/><path d="M169.62 261.28 L165.03 270.06"/><path d="M159.85 262.57 L154.51 270.92"/><path d="M150 263 L143.95 270.85"/><path d="M140.15 262.57 L133.44 269.86"/><path d="M130.38 261.28 L123.06 267.96"/><path d="M120.75 259.15 L112.88 265.17"/><path d="M111.35 256.19 L102.98 261.49"/><path d="M102.24 252.41 L93.45 256.97"/><path d="M93.5 247.86 L84.34 251.63"/><path d="M85.19 242.56 L75.73 245.52"/><path d="M77.37 236.56 L67.69 238.69"/><path d="M70.1 229.9 L60.27 231.18"/><path d="M63.44 222.63 L53.54 223.05"/><path d="M57.44 214.81 L47.54 214.36"/><path d="M52.14 206.5 L42.32 205.19"/><path d="M47.59 197.76 L37.92 195.59"/><path d="M43.81 188.65 L34.37 185.65"/><path d="M40.85 179.25 L31.7 175.44"/><path d="M38.72 169.62 L29.94 165.03"/><path d="M37.43 159.85 L29.08 154.51"/><path d="M37 150 L29.15 143.95"/><path d="M37.43 140.15 L30.14 133.44"/><path d="M38.72 130.38 L32.04 123.06"/><path d="M40.85 120.75 L34.83 112.88"/><path d="M43.81 111.35 L38.51 102.98"/><path d="M47.59 102.24 L43.03 93.45"/><path d="M52.14 93.5 L48.37 84.34"/><path d="M57.44 85.19 L54.48 75.73"/><path d="M63.44 77.37 L61.31 67.69"/><path d="M70.1 70.1 L68.82 60.27"/><path d="M77.37 63.44 L76.95 53.54"/><path d="M85.19 57.44 L85.64 47.54"/><path d="M93.5 52.14 L94.81 42.32"/><path d="M102.24 47.59 L104.41 37.92"/><path d="M111.35 43.81 L114.35 34.37"/><path d="M120.75 40.85 L124.56 31.7"/><path d="M130.38 38.72 L134.97 29.94"/><path d="M140.15 37.43 L145.49 29.08"/><path d="M150 37 L156.05 29.15"/><path d="M159.85 37.43 L166.56 30.14"/><path d="M169.62 38.72 L176.94 32.04"/><path d="M179.25 40.85 L187.12 34.83"/><path d="M188.65 43.81 L197.02 38.51"/><path d="M197.76 47.59 L206.55 43.03"/><path d="M206.5 52.14 L215.66 48.37"/><path d="M214.81 57.44 L224.27 54.48"/><path d="M222.63 63.44 L232.31 61.31"/><path d="M229.9 70.1 L239.73 68.82"/><path d="M236.56 77.37 L246.46 76.95"/><path d="M242.56 85.19 L252.46 85.64"/><path d="M247.86 93.5 L257.68 94.81"/><path d="M252.41 102.24 L262.08 104.41"/><path d="M256.19 111.35 L265.63 114.35"/><path d="M259.15 120.75 L268.3 124.56"/><path d="M261.28 130.38 L270.06 134.97"/><path d="M262.57 140.15 L270.92 145.49"/></g><g stroke="#d6b26a"><path d="M80 98 A88 88 0 0 1 130 64" stroke-width="3" opacity=".35"/></g></svg></div>
  <figcaption class="demo-cap"><span class="label mono">{label}</span>{caption}</figcaption>
</figure>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var LENS_SIZE = 220;
  var ZOOM = 2.2;

  document.querySelectorAll('.demo-player').forEach(function (box) {
    var video = box.querySelector('video');
    var fill = box.querySelector('.demo-fill');
    if (!video || !fill) return;
    var fig = box.closest('.demo-fig');

    if (reduced) {
      video.pause();
      video.controls = true;
      var b = box.querySelector('.demo-bar');
      if (b) b.style.display = 'none';
      return;
    }

    // The clip sits below the first screen: it plays only when the visitor
    // approaches (200px out), so no demo bytes load with the page.
    if ('IntersectionObserver' in window) {
      var seen = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          seen.disconnect();
          video.play().catch(function () {});
        }
      }, { rootMargin: '200px' });
      seen.observe(box);
    } else {
      video.play().catch(function () {});
    }

    // Hold-to-pause: press and hold over the demo (with the lens) to freeze the
    // clip; release to continue. A short click still opens the full-screen view,
    // so we flag a long press and skip the dialog open below.
    var pressStart = 0;

    box.addEventListener('mousedown', function (e) {
      if (e.target.closest('.demo-bar')) return;
      pressStart = Date.now();
      video.pause();
    });
    box.addEventListener('mouseup', function (e) {
      if (e.target.closest('.demo-bar')) return;
      video.play();
      if (fig && Date.now() - pressStart > 180) fig._held = true;
    });
    box.addEventListener('mouseleave', function () {
      if (!video.paused) return;
      video.play();
    });

    video.addEventListener('timeupdate', function () {
      if (video.duration) {
        fill.style.width = (video.currentTime / video.duration * 100).toFixed(2) + '%';
      }
    });

    // Seek: click or drag on the progress bar.
    var bar = box.querySelector('.demo-bar');
    if (!bar) return;

    function seekFromEvent(e) {
      var rect = bar.getBoundingClientRect();
      var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      if (video.duration) {
        video.currentTime = pct * video.duration;
        fill.style.width = (pct * 100).toFixed(2) + '%';
      }
    }

    var dragging = false;

    bar.addEventListener('mousedown', function (e) {
      dragging = true;
      seekFromEvent(e);
      e.preventDefault();
    });

    document.addEventListener('mousemove', function (e) {
      if (dragging) seekFromEvent(e);
    });

    document.addEventListener('mouseup', function () {
      dragging = false;
    });

    // Touch support
    bar.addEventListener('touchstart', function (e) {
      dragging = true;
      seekFromEvent(e.touches[0]);
    }, { passive: true });

    bar.addEventListener('touchmove', function (e) {
      seekFromEvent(e.touches[0]);
    }, { passive: true });

    bar.addEventListener('touchend', function () {
      dragging = false;
    });
  });

  /* ---- Magnifying glass lens on hover ---- */
  document.querySelectorAll('.demo-fig').forEach(function (fig) {
    var lens = fig.querySelector('.demo-lens');
    var lensInner = fig.querySelector('.demo-lens-inner');
    var frame = fig.querySelector('.demo-frame');
    var media = fig.querySelector('.demo-video');
    if (!lens || !frame || !media) return;

    var isImg = media.tagName === 'IMG';
    var lensVideo = null;

    // For video: create a cloned video inside the lens
    if (!isImg) {
      lensVideo = document.createElement('video');
      lensVideo.muted = true;
      lensVideo.loop = true;
      lensVideo.playsInline = true;
      // The loupe only exists on hover: it must never fetch the clip on its
      // own, or the page would load the whole video beside its poster.
      lensVideo.preload = 'none';
      lensVideo.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;pointer-events:none;';
      var srcEl = media.querySelector('source');
      if (srcEl) {
        var s = document.createElement('source');
        s.src = srcEl.src;
        s.type = srcEl.type;
        lensVideo.appendChild(s);
      }
      lensInner.appendChild(lensVideo);
      // The clone starts loading only when the lens is first approached (a
      // hover, i.e. an interaction), then follows the main clip.
      var lensReady = false;
      var startLens = function () {
        if (lensReady) return;
        lensReady = true;
        lensVideo.preload = 'auto';
        if (media.currentTime) lensVideo.currentTime = media.currentTime;
        if (!media.paused) lensVideo.play().catch(function () {});
      };
      frame.addEventListener('mouseenter', startLens);
      // Keep lens video in sync
      media.addEventListener('play', function () { if (lensReady) lensVideo.play().catch(function(){}); });
      media.addEventListener('pause', function () { lensVideo.pause(); });
      media.addEventListener('timeupdate', function () {
        if (lensVideo.duration && Math.abs(lensVideo.currentTime - media.currentTime) > 0.3) {
          lensVideo.currentTime = media.currentTime;
        }
      });
    }

    frame.addEventListener('mousemove', function (e) {
      var rect = frame.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;

      lens.style.opacity = '1';
      lens.style.left = (e.clientX - LENS_SIZE / 2) + 'px';
      lens.style.top = (e.clientY - LENS_SIZE / 2) + 'px';

      var px = x / rect.width * 100;
      var py = y / rect.height * 100;

      if (isImg) {
        lensInner.style.backgroundImage = 'url(' + media.src + ')';
        lensInner.style.backgroundSize = (rect.width * ZOOM) + 'px ' + (rect.height * ZOOM) + 'px';
        lensInner.style.backgroundPosition = (px * ZOOM - 50) + '% ' + (py * ZOOM - 50) + '%';
      } else {
        // Position the cloned video so the cursor area is centered and zoomed
        var vw = rect.width * ZOOM;
        var vh = rect.height * ZOOM;
        lensVideo.style.width = vw + 'px';
        lensVideo.style.height = vh + 'px';
        lensVideo.style.left = -(x * ZOOM - LENS_SIZE / 2) + 'px';
        lensVideo.style.top = -(y * ZOOM - LENS_SIZE / 2) + 'px';
      }
    });

    frame.addEventListener('mouseleave', function () {
      lens.style.opacity = '0';
      if (lensVideo) lensVideo.pause();
    });
  });

  /* ---- Click-to-expand: opens the demo in a full-screen dialog ---- */
  function openDemoDialog(src, caption) {
    var existing = document.getElementById('demo-dialog');
    if (existing) existing.remove();

    var isGif = /\.gif$/i.test(src);
    var media;
    if (isGif) {
      media = '<img src="' + src + '" alt="' + caption + '" style="width:100%;height:auto;display:block;" />';
    } else {
      media = '<video autoplay muted loop playsinline controls style="width:100%;height:auto;display:block;border-radius:8px;">' +
        '<source src="' + src + '" type="video/mp4" /></video>';
    }

    var dialog = document.createElement('dialog');
    dialog.id = 'demo-dialog';
    dialog.innerHTML =
      '<div class="demo-dialog-inner">' +
        '<button class="demo-dialog-close" aria-label="Close">&times;</button>' +
        media +
        '<p class="demo-dialog-caption">' + caption + '</p>' +
      '</div>';

    document.body.appendChild(dialog);
    dialog.showModal();

    dialog.querySelector('.demo-dialog-close').addEventListener('click', function () { dialog.close(); dialog.remove(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) { dialog.close(); dialog.remove(); } });
    dialog.addEventListener('keydown', function (e) { if (e.key === 'Escape') { dialog.close(); dialog.remove(); } });
  }

  document.querySelectorAll('.demo-fig').forEach(function (fig) {
    fig.addEventListener('click', function (e) {
      if (e.target.closest('.demo-bar')) return;
      // A long press (hold-to-pause) should not also open the full-screen view.
      if (fig._held) { fig._held = false; return; }
      var src = fig.getAttribute('data-demo-src');
      var cap = fig.getAttribute('data-demo-caption') || '';
      if (src) openDemoDialog(src, cap);
    });
  });

  // Expose for /demo command
  window.__openDemoDialog = function () {
    var fig = document.querySelector('.demo-fig');
    if (!fig) return false;
    var src = fig.getAttribute('data-demo-src');
    var cap = fig.getAttribute('data-demo-caption') || '';
    if (src) { openDemoDialog(src, cap); return true; }
    return false;
  };
})();
</script>

<style>
  .demo-fig {
    margin: 0;
    padding-block: 0.4rem 0.6rem;
    position: relative;
    cursor: none;
  }
  .demo-frame {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-raise);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--essence) 18%, transparent),
      0 22px 60px rgba(0, 0, 0, 0.3);
  }
  .demo-video { display: block; width: 100%; height: auto; }

  /* Magnifying glass lens — engraved brass loupe overlay */
  .demo-lens {
    position: fixed;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: none;
    box-shadow: none;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    z-index: 100;
    transition: opacity 0.15s ease;
  }
  .demo-lens-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
  }
  .demo-loupe {
    position: absolute;
    width: 330px;
    height: 330px;
    left: -40px;
    top: -40px;
    max-width: none;
    pointer-events: none;
    filter: none !important;
  }

  /* Custom player wrapper */
  .demo-player { position: relative; }
  .demo-player video { display: block; width: 100%; height: auto; }

  /* Progress bar — always visible, thin visual but tall hit area */
  .demo-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 14px;
    cursor: pointer;
    z-index: 2;
  }
  .demo-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.2);
  }
  .demo-fill {
    height: 100%;
    width: 0%;
    background: var(--essence);
    border-radius: 0 2px 2px 0;
    transition: none;
  }

  .demo-cap {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .demo-cap .label {
    font-style: normal;
    color: var(--essence);
    margin-right: 0.6rem;
  }
</style>
