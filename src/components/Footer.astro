---
import Mark from './Mark.astro';
import { getLang, useTranslations, localizePath } from '../i18n';
import { byId, type ExperimentId } from '../lib/experiments';
import { BRAILLE_SENTENCE, toBraille } from '../lib/braille';
import { legalNav } from '../data/legal-nav';
import { iconSvg } from '../lib/icon-svg';
import { codeXml, github, heart } from '../lib/icons';

interface Props {
  /** Experiment pages: the id whose name opens the forged colophon line. */
  expId?: ExperimentId;
}
const { expId } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
// The forged line only exists on experiment pages — other routes render the
// footer without it.
const forged = expId ? byId(expId) : null;
// One faint line of braille under the UNIVERLAB word, the same sentence in
// both languages.
const brailleCells = toBraille(BRAILLE_SENTENCE);

const isManifesto = Astro.url.pathname.endsWith('/manifesto') || Astro.url.pathname.endsWith('/manifesto/');
// The legal labels come from the legal module with the rest of that copy; both
// dictionaries already sit at the 1 200-line cap (see src/data/legal-nav.ts).
const legal = legalNav[lang];
const footGroups = [
  {
    head: t.footer.groups.work,
    links: [
      { href: localizePath('/experiments', lang), label: t.nav.experiments },
      { href: localizePath('/archive', lang), label: t.nav.archive },
      { href: '/roadmap/', label: t.nav.roadmap },
    ],
  },
  {
    head: t.footer.groups.lab,
    links: [
      { href: localizePath('/manifesto', lang), label: t.nav.manifesto },
      { href: localizePath('/contributors', lang), label: t.nav.people },
      { href: localizePath('/workbench', lang), label: t.nav.workbench },
      { href: localizePath('/newspaper', lang), label: t.nav.observable },
    ],
  },
];
// The social and API links read faster as icons: the lab's repo, X and Bluesky,
// the API as code, and the sponsor heart — each keeping its name for assistive
// tech and hover. Brands Lucide lacks (X, Bluesky) use their official marks
// (Simple Icons paths on the 24×24 grid, drawn as fill, not stroke).
const X_PATH =
  'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z';
const BLUESKY_PATH =
  'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z';
const brandSvg = (path: string, size = 20) =>
  `<svg xmlns="http://www.w3.org/2000/svg" class="icon" width="${size}" height="${size}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${path}"/></svg>`;
const openIcons = [
  { href: 'https://github.com/UniverLab', label: t.nav.github, ext: true, svg: iconSvg(github, { size: 20 }) },
  { href: 'https://x.com/UniverLab', label: 'X', ext: true, svg: brandSvg(X_PATH) },
  {
    href: 'https://bsky.app/profile/univerlab.bsky.social',
    label: 'Bluesky',
    ext: true,
    svg: brandSvg(BLUESKY_PATH),
  },
  { href: localizePath('/api', lang), label: t.nav.api, ext: false, svg: iconSvg(codeXml, { size: 20 }) },
];
const sponsorIcon = iconSvg(heart, { size: 20 });
const legalLinks = [{ href: localizePath('/privacy', lang), label: legal.privacy }, { href: localizePath('/terms', lang), label: legal.terms }];
---
<footer>
  <!-- The engraved frieze: gear band full width, sinking into the ink, with
       the lab's seal (the real Mark) riding its lower edge. -->
  <div class="frieze">
    <picture class="colophon-band" aria-hidden="true">
      <source type="image/avif" srcset="/bench/colophon/frieze-960.avif 960w, /bench/colophon/frieze-1920.avif 1920w" sizes="100vw">
      <img src="/bench/colophon/frieze-1920.webp" srcset="/bench/colophon/frieze-960.webp 960w, /bench/colophon/frieze-1920.webp 1920w" sizes="100vw" width="1920" height="608" alt="" loading="lazy" decoding="async">
    </picture>
    <!-- Quiet click target: the seal links to this site's own repository. No
         hover affordance — you only find it if you try it. -->
    <a
      class="seal"
      href="https://github.com/UniverLab/univerlab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="UniverLab website repository"
    ><Mark size={24} /></a>
  </div>
  <div class="wrap colophon">
    {!isManifesto && <p class="quote">{t.footer.quote}</p>}
    <nav class="foot-nav" aria-label={t.nav.experiments}>
      {footGroups.map((group) => (
        <div class="foot-group"><span class="foot-head">{group.head}</span>{group.links.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}</div>
      ))}
    </nav>
    <a class="cta" href={localizePath('/workbench', lang)}>{t.footer.cta}</a>
    <p class="word-rule"><span class="word" translate="no">UNIVERLAB</span></p>
    <!-- Braille easter egg (user, 2026-10-21): one faint line of real grade-1
         cells, the same sentence in every language, never translated and
         never reacting. The element carries role="img" + aria-label so a
         screen reader speaks the sentence; the glyph text itself is hidden
         so it isn't read letter by letter. -->
    <span class="braille" role="img" aria-label={BRAILLE_SENTENCE}>
      <span aria-hidden="true">{brailleCells}</span>
    </span>
    <span class="icon-row">
      {openIcons.map((item) => (
        <a
          class="icon-link"
          href={item.href}
          target={item.ext ? '_blank' : undefined}
          rel={item.ext ? 'noopener noreferrer' : undefined}
          aria-label={item.label}
          title={item.label}
          set:html={item.svg}
        />
      ))}
      <a
        class="icon-link sponsor"
        href="https://github.com/sponsors/JheisonMB"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.sponsors}
        title={t.nav.sponsors}
        set:html={sponsorIcon}
      />
    </span>
  </div>
  <div class="wrap base">
    <div class="small">
      {forged && (<p><span class="forged"><span class="forged-name" translate="no">{forged.name}</span>{' · '}{t.footer.forged}</span></p>)}
      <p><span class="operator">{t.footer.operator}</span><span class="sep"> · </span>{legalLinks.map((l, i) => (<Fragment>{i > 0 && <span class="sep"> · </span>}<a href={l.href}>{l.label}</a></Fragment>))}</p>
      <p><span class="copyright">{t.footer.copyright} · <a href="https://github.com/UniverLab/univerlab/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">{t.footer.licenseName}</a></span></p>
      <p><span class="built">{t.footer.built.label} {t.footer.built.canopy} <a href={localizePath('/canopy', lang)} translate="no">{byId('canopy').name}</a><span class="sep"> · </span>{t.footer.built.ghscaff} <a href={localizePath('/ghscaff', lang)} translate="no">{byId('ghscaff').name}</a><span class="sep"> · </span>{t.footer.built.gitkit} <a href={localizePath('/gitkit', lang)} translate="no">{byId('gitkit').name}</a></span><span class="sep"> · </span><button
        type="button"
        class="branch mono"
        translate="no"
        title={t.cosmos.branchTooltip}
        aria-expanded="false"
        aria-controls="cosmic-commit"
      >{t.cosmos.branch}</button></p>
    </div>
    <!-- Easter egg: the universe's latest commit. Terminal output stays English
         in every locale (git always is), toggled by the branch button. -->
    <div id="cosmic-commit" class="commit-panel" hidden translate="no">
      <pre>commit HEAD (you)
Author: the universe
Date:   now

    observing itself</pre>
    </div>
  </div>
</footer>

<style>
  /* The footer is the lab's signature — always dark, regardless of the page's
     circadian phase or experiment surface. It anchors the brand at the bottom
     of every page: a dark footer on a light page gives contrast and identity;
     on a dark page it stays coherent. */
  footer {
    --f-bg: #000000;
    --f-bg-raise: #0a0a0a;
    --f-ink: #e3e6e8;
    --f-ink-dim: #8a8d93;
    --f-ink-faint: #4a4d53;
    --f-line: #1a1a1a;
    position: relative;
    background: var(--f-bg);
    color: var(--f-ink);
    margin-top: 2rem;
  }
  footer :global(svg) { color: var(--f-ink-faint); }
  footer :focus-visible { outline-color: var(--f-ink); }

  /* The engraved machinery frieze (Quorum's colophon band): full width at the
     very top of the footer, sinking into the ink through a mask. Aria-hidden
     and lazy — the fixed width/height keep it from shifting layout. */
  .frieze {
    position: relative;
  }
  .colophon-band {
    display: block;
    width: 100%;
    height: clamp(6rem, 14vw, 11.875rem);
    opacity: 0.8;
    -webkit-mask-image: linear-gradient(#000 35%, transparent 96%);
    mask-image: linear-gradient(#000 35%, transparent 96%);
  }
  .colophon-band img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* The lab's seal on the frieze's lower edge: a small round seal (48px)
     with the real Mark (24px) inside. A quiet, discoverable click target. */
  .seal {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--f-bg);
    border: 1px solid var(--f-line);
    display: grid;
    place-items: center;
    color: var(--f-ink);
    line-height: 0;
  }
  .seal :global(svg) { color: var(--f-ink); }

  /* The centred book colophon below the frieze. */
  .colophon {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.125rem;
    padding-block: 2.5rem 1.5rem;
  }
  .quote { margin: 0; font-family: var(--font-serif); font-style: italic; color: var(--f-ink-dim); font-size: clamp(0.95rem, 1.4vw, 1.1rem); line-height: 1.55; max-width: 46ch; }
  /* Nav links in the colophon face (Quorum's rule: serif links, mono labels);
     every target keeps a 32px tap reach on touch screens. */
  .foot-nav { display: grid; gap: 0.875rem; justify-items: center; width: 100%; }
  .foot-group { display: grid; gap: 0.375rem; justify-items: center; }
  .foot-head { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.55; margin-bottom: 0.35rem; }
  .foot-nav a {
    text-decoration: none; color: var(--f-ink-dim);
    font-family: var(--font-serif); font-size: 0.85rem;
    display: inline-flex; align-items: center; min-height: 32px;
    transition: color 0.15s ease;
  }
  .foot-nav a:hover { color: var(--f-ink); }
  /* The social and API links read as icons: one quiet row of 20px marks next
     to the sponsor heart, dim ink at rest, full ink on hover. The fixed box
     keeps the row from shifting; the svg inherits the anchor's colour (the
     footer paints every svg faint by default, which would freeze the hover). */
  .icon-row { display: flex; gap: 1rem; align-items: center; justify-content: center; min-height: 32px; }
  .icon-link {
    display: inline-flex; align-items: center; min-height: 32px; min-width: 32px; justify-content: center;
    color: var(--f-ink-dim);
    transition: color 0.15s ease;
  }
  .icon-link:hover { color: var(--f-ink); }
  .icon-link svg { display: block; color: inherit; }
  .icon-link.sponsor {
    color: var(--accent, #c9a227);
    animation: heartbeat 2s ease-in-out infinite;
  }
  .icon-link.sponsor:hover { color: #f0d060; animation-play-state: paused; }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.15); }
    28% { transform: scale(1); }
    42% { transform: scale(1.1); }
    56% { transform: scale(1); }
  }
  .cta {
    display: inline-block;
    border: 1px solid var(--f-line);
    padding: 0.625rem 1rem;
    font-family: var(--font-mono); font-size: 0.8125rem;
    color: var(--accent, #c9a227);
    text-decoration: none;
  }
  .cta:hover { color: var(--f-ink); }
  .word-rule {
    width: min(32.5rem, 100%);
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-block: 0;
    color: var(--f-ink-dim);
  }
  .word-rule::before, .word-rule::after {
    content: "";
    height: 1px;
    background: var(--f-line);
    flex: 1;
  }
  .word { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.32em; color: var(--f-ink-dim); }
  /* The braille easter egg sits quietly under the word: no hover, no
     translation, just plain grade-1 cells at a faint opacity. The font stack
     is chosen only for having braille glyphs. */
  .braille {
    opacity: 0.45;
    font-family: "DejaVu Sans Mono", "Segoe UI Symbol", "Noto Sans Symbols 2", monospace;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--f-ink-dim);
    line-height: 1;
  }

  .base {
    position: relative;
    padding-block: 1.2rem 1.6rem;
  }
  .small {
    margin-block: 0;
    text-align: center;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.02em;
    line-height: 2;
    color: var(--f-ink-dim);
    overflow-wrap: anywhere;
  }
  .small p { margin-block: 0; }
  .small .sep { color: var(--f-ink-faint); }
  .small a { color: inherit; }
  .built a { text-decoration-color: var(--f-line); }
  .built a:hover { color: var(--f-ink); }
  /* The forged colophon line — experiment pages only: the artifact's name in
     the mono face, then the dictionary line. */
  .forged {
    margin-block: 0;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.02em;
    color: var(--f-ink-dim);
  }
  .forged-name { font-family: var(--font-mono); }
  .forged .sep { color: var(--f-ink-faint); }
  /* A quiet easter egg: the lab's one software-as-cosmos metaphor. Dimmer than
     everything around it; hover reveals its meaning, click reveals the commit. */
  .branch {
    font-family: var(--font-mono);
    font-size: 0.6rem; letter-spacing: 0.08em; color: var(--f-ink-faint);
    background: none; border: 0; padding: 0; cursor: pointer;
    transition: color 0.15s ease;
  }
  .branch:hover, .branch[aria-expanded='true'] { color: var(--f-ink-dim); }

  /* The universe's latest commit — a small terminal card above the branch. */
  .commit-panel {
    position: absolute;
    right: 0; bottom: calc(100% + 0.6rem);
    z-index: 20;
    background: var(--f-bg-raise);
    border: 1px solid var(--f-line);
    border-left: 2px solid var(--accent, #c9a227);
    padding: 0.9rem 1.1rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
    animation: commit-in 0.16s ease;
  }
  .commit-panel[hidden] { display: none; }
  .commit-panel pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem; line-height: 1.7; color: var(--f-ink-dim);
    white-space: pre;
  }
  @keyframes commit-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  @media (min-width: 40rem) {
    .foot-nav { grid-template-columns: repeat(2, auto); justify-content: center; column-gap: clamp(1.75rem, 5vw, 4.5rem); }
  }
  @media (max-width: 40rem) {
    .colophon { padding-block-start: 2.25rem; }
    footer { padding-bottom: 4.5rem; }
  }
  /* The page-corner language switch sits at the bottom right at every width; the
     branch button shares that line, so the base keeps it clear of the fold. */
  .base { padding-bottom: 4.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .icon-link.sponsor { animation: none !important; }
  }
</style>

<script>
  // Branch easter egg — toggle the universe's latest commit; close on outside
  // click or Escape.
  const branch = document.querySelector<HTMLButtonElement>('.branch');
  const panel = document.getElementById('cosmic-commit');
  if (branch && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      branch.setAttribute('aria-expanded', String(open));
    };
    branch.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(branch.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== branch) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
