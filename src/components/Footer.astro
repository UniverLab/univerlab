---
import Mark from './Mark.astro';
import { getLang, useTranslations, localizePath } from '../i18n';
import { byId, type ExperimentId } from '../lib/experiments';
import { BRAILLE_SENTENCE, toBraille } from '../lib/braille';

interface Props {
  /** Experiment pages: the id whose name opens the forged colophon line. */
  expId?: ExperimentId;
}
const { expId } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
// The forged line only exists on experiment pages — other routes render the
// footer without it.
const forged = expId ? byId(expId) : null;
// One faint line of braille under the UNIVERLAB word, the same sentence in
// both languages.
const brailleCells = toBraille(BRAILLE_SENTENCE);

const isManifesto = Astro.url.pathname.endsWith('/manifesto') || Astro.url.pathname.endsWith('/manifesto/');
const footNav = [
  { href: localizePath('/experiments', lang), label: t.nav.experiments },
  { href: localizePath('/archive', lang), label: t.nav.archive },
  { href: localizePath('/manifesto', lang), label: t.nav.manifesto },
  { href: '/roadmap/', label: t.nav.roadmap },
  { href: localizePath('/contributors', lang), label: t.nav.people },
  { href: localizePath('/api', lang), label: t.nav.api },
  { href: 'https://github.com/UniverLab', label: t.nav.github, ext: true },
  { href: 'https://github.com/sponsors/JheisonMB', label: 'heart', ext: true, sponsor: true },
];
---
<footer>
  <!-- The engraved frieze: decorative band across the top of the footer,
       sinking into the ink before the text (Quorum's colophon band). -->
  <picture class="colophon-band" aria-hidden="true">
    <source type="image/avif" srcset="/bench/colophon/frieze-960.avif 960w, /bench/colophon/frieze-1920.avif 1920w" sizes="100vw">
    <img src="/bench/colophon/frieze-1920.webp" srcset="/bench/colophon/frieze-960.webp 960w, /bench/colophon/frieze-1920.webp 1920w" sizes="100vw" width="1920" height="608" alt="" loading="lazy" decoding="async">
  </picture>
  <div class="wrap inner">
    <div class="left">
      <!-- Quiet click target: the mark links to this site's own repository. No
           hover affordance — you only find it if you try it. -->
      <a
        class="mark-link"
        href="https://github.com/UniverLab/univerlab"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="UniverLab website repository"
      ><Mark size={32} /></a>
      {!isManifesto && <p class="quote">{t.footer.quote}</p>}
    </div>
    <nav class="foot-nav" aria-label={t.nav.experiments}>
      {footNav.map((item) => (
        <a
          href={item.href}
          target={item.ext ? '_blank' : undefined}
          rel={item.ext ? 'noopener noreferrer' : undefined}
          class:list={{ sponsor: item.sponsor }}
        >{item.sponsor ? <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> : item.label}</a>
      ))}
    </nav>
  </div>
  <p class="wrap lab-built">
    {t.footer.built.label} {t.footer.built.canopy} <a href={localizePath('/canopy', lang)} translate="no">{byId('canopy').name}</a><span class="sep"> · </span>{t.footer.built.ghscaff} <a href={localizePath('/ghscaff', lang)} translate="no">{byId('ghscaff').name}</a><span class="sep"> · </span>{t.footer.built.gitkit} <a href={localizePath('/gitkit', lang)} translate="no">{byId('gitkit').name}</a>
  </p>
  <div class="wrap base">
    <div class="word-block">
      <span class="word" translate="no">UNIVERLAB</span>
      <!-- Braille easter egg (user, 2026-10-21): one faint line of real grade-1
           cells, the same sentence in every language, never translated and
           never reacting. The element carries role="img" + aria-label so a
           screen reader speaks the sentence; the glyph text itself is hidden
           so it isn't read letter by letter. -->
      <span class="braille" role="img" aria-label={BRAILLE_SENTENCE}>
        <span aria-hidden="true">{brailleCells}</span>
      </span>
    </div>
    <span class="meta">
      <button
        type="button"
        class="branch mono"
        translate="no"
        title={t.cosmos.branchTooltip}
        aria-expanded="false"
        aria-controls="cosmic-commit"
      >{t.cosmos.branch}</button>
      <span class="tag">SCI · CLI · BIO</span>
    </span>
    <!-- Easter egg: the universe's latest commit. Terminal output stays English
         in every locale (git always is), toggled by the branch button. -->
    <div id="cosmic-commit" class="commit-panel" hidden translate="no">
      <pre>commit HEAD (you)
Author: the universe
Date:   now

    observing itself</pre>
    </div>
  </div>
  {forged && (
    <p class="wrap forged">
      <span class="forged-name" translate="no">{forged.name}</span>
      <span class="sep">{' · '}</span>{t.footer.forged}
    </p>
  )}
  <div class="wrap colophon-credits">
    <img src="/bench/colophon/sello-lacre.svg" width="28" height="28" alt="" aria-hidden="true">
    <p class="privacy">{t.footer.privacy}</p>
  </div>
</footer>

<style>
  /* The footer is the lab's signature — always dark, regardless of the page's
     circadian phase or experiment surface. It anchors the brand at the bottom
     of every page: a dark footer on a light page gives contrast and identity;
     on a dark page it stays coherent. */
  footer {
    --f-bg: #000000;
    --f-bg-raise: #0a0a0a;
    --f-ink: #e3e6e8;
    --f-ink-dim: #8a8d93;
    --f-ink-faint: #4a4d53;
    --f-line: #1a1a1a;
    position: relative;
    background: var(--f-bg);
    color: var(--f-ink);
    margin-top: 2rem;
  }
  footer :global(svg) { color: var(--f-ink-faint); }
  footer :focus-visible { outline-color: var(--f-ink); }

  /* The engraved machinery frieze (Quorum's colophon band): absolutely over
     the dark ink at the very top of the footer, sinking into it through a
     mask so the text below never competes with it. Aria-hidden and lazy —
     the fixed width/height keep it from shifting layout. */
  .colophon-band {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 16rem;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 90%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 90%);
  }
  .colophon-band img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    flex-wrap: wrap;
    /* 12rem of headroom clear the 16rem band's densest third; the mask starts
       fading before the first line of content. */
    padding-block: 12rem 2rem;
  }
  .left { display: flex; gap: 1rem; align-items: flex-start; max-width: 34rem; }
  /* No hover, no underline — a quiet, discoverable click target. */
  .mark-link { display: inline-flex; line-height: 0; flex: none; }
  .quote { margin: 0; font-family: var(--font-serif); font-style: italic; color: var(--f-ink-dim); font-size: 0.95rem; line-height: 1.55; }
  /* Nav links in the colophon face (Quorum's rule: serif links, mono labels);
     every target keeps a 32px tap reach on touch screens. */
  .foot-nav { display: flex; gap: 1.6rem; flex-wrap: wrap; align-items: center; }
  .foot-nav a {
    text-decoration: none; color: var(--f-ink-dim);
    font-family: var(--font-serif); font-size: 1.05rem;
    display: inline-flex; align-items: center; min-height: 32px;
    transition: color 0.15s ease;
  }
  .foot-nav a:hover { color: var(--f-ink); }
  .foot-nav a.sponsor {
    color: var(--accent, #c9a227);
    letter-spacing: 0; text-transform: none;
    animation: heartbeat 2s ease-in-out infinite;
    display: inline-flex; align-items: center;
  }
  .foot-nav a.sponsor svg { display: block; stroke: var(--accent, #c9a227); }
  .foot-nav a.sponsor:hover { color: #f0d060; stroke: #f0d060; animation-play-state: paused; }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.15); }
    28% { transform: scale(1); }
    42% { transform: scale(1.1); }
    56% { transform: scale(1); }
  }

  .base {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.2rem 1.6rem;
    border-top: 1px solid var(--f-line);
  }
  .word { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.32em; color: var(--f-ink-dim); }
  /* The braille easter egg sits quietly under the word: no hover, no
     translation, just plain grade-1 cells at a faint opacity. The font stack
     is chosen only for having braille glyphs. */
  .word-block { display: flex; flex-direction: column; gap: 0.45rem; }
  .braille {
    opacity: 0.45;
    font-family: "DejaVu Sans Mono", "Segoe UI Symbol", "Noto Sans Symbols 2", monospace;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--f-ink-dim);
    line-height: 1;
  }
  /* The site's own built-with — one line above the base rule, footer's dark palette. */
  .lab-built {
    margin-block: 0; padding-block: 0 1.6rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.02em;
    color: var(--f-ink-dim);
  }
  .lab-built .sep { color: var(--f-ink-faint); }
  .lab-built a { color: var(--f-ink-dim); text-decoration-color: var(--f-line); }
  .lab-built a:hover { color: var(--f-ink); }
  .meta { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .tag { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; color: var(--f-ink-dim); }
  /* A quiet easter egg: the lab's one software-as-cosmos metaphor. Dimmer than
     everything around it; hover reveals its meaning, click reveals the commit. */
  .branch {
    font-family: var(--font-mono);
    font-size: 0.7rem; letter-spacing: 0.08em; color: var(--f-ink-faint);
    background: none; border: 0; padding: 0; cursor: pointer;
    transition: color 0.15s ease;
  }
  .branch:hover, .branch[aria-expanded='true'] { color: var(--f-ink-dim); }

  /* The universe's latest commit — a small terminal card above the branch. */
  .commit-panel {
    position: absolute;
    right: 0; bottom: calc(100% + 0.6rem);
    z-index: 20;
    background: var(--f-bg-raise);
    border: 1px solid var(--f-line);
    border-left: 2px solid var(--accent, #c9a227);
    padding: 0.9rem 1.1rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
    animation: commit-in 0.16s ease;
  }
  .commit-panel[hidden] { display: none; }
  .commit-panel pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem; line-height: 1.7; color: var(--f-ink-dim);
    white-space: pre;
  }
  @keyframes commit-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 40rem) {
    .inner { flex-direction: column; gap: 1.6rem; padding-top: 9rem; }
    .foot-nav { gap: 1.2rem; }
    footer { padding-bottom: 4.5rem; }
  }
  /* The page-corner language switch sits at the bottom right at every width; the
     branch button shares that line, so the base keeps it clear of the fold. */
  .base { padding-bottom: 4.5rem; }
  /* The forged colophon line — experiment pages only: the artifact's name in
     the mono face, then the dictionary line. One line above the credits rule. */
  .forged {
    margin-block: 0; padding-bottom: 0.9rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.02em;
    color: var(--f-ink-dim); text-align: center;
  }
  .forged-name { font-family: var(--font-mono); }
  .forged .sep { color: var(--f-ink-faint); }

  /* Quorum's colophon credits: the garnet seal ahead of the privacy line,
     below a 25% currentColor rule. */
  .colophon-credits {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.2rem 0 1.4rem;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .colophon-credits img { flex: none; }
  .privacy {
    margin: 0;
    font-family: var(--font-mono); font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--f-ink-faint); text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .foot-nav a.sponsor { animation: none !important; }
  }
</style>

<script>
  // Branch easter egg — toggle the universe's latest commit; close on outside
  // click or Escape.
  const branch = document.querySelector<HTMLButtonElement>('.branch');
  const panel = document.getElementById('cosmic-commit');
  if (branch && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      branch.setAttribute('aria-expanded', String(open));
    };
    branch.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(branch.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== branch) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
