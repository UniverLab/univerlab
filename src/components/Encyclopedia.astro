---
import Machine from './Machine.astro';
import { byId } from '../lib/experiments';
import { entryModels } from '../lib/experiment-entries';
import { getLang, useTranslations, localizePath } from '../i18n';
import { iconSvg } from '../lib/icon-svg';
import { copy } from '../lib/icons';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const enc = t.encyclopedia;

const statusMark: Record<string, string> = {
  active: '§',
  beta: '‡',
  research: '¶',
  archived: '†',
};

const entries = entryModels((path) => localizePath(path, lang));
const expCopy = (id: string) => t.experiments[id as keyof typeof t.experiments];
---
<nav class="thumbs" aria-label={enc.tabs.aria}>
  <button type="button" data-f="all" aria-pressed="true">{enc.tabs.all}</button>
  <button type="button" data-f="active" aria-pressed="false">{enc.tabs.active}</button>
  <button type="button" data-f="research" aria-pressed="false">{enc.tabs.research}</button>
  <button type="button" data-f="archived" aria-pressed="false">{enc.tabs.archived}</button>
</nav>

<div class="entries">
  {entries.map((entry) => {
    const exp = byId(entry.id);
    const ec = expCopy(entry.id);
    const status = entry.status;
    const mark = statusMark[status] ?? '';
    const statusName = enc.titleStatus[status as keyof typeof enc.titleStatus] ?? status;
    const installCmd = entry.install;
    const linkLabel = entry.archived ? enc.use.archive : enc.use.plate;
    const repo = exp.github;
    return (
      <article class="entry" id={entry.anchor} data-status={status}>
        <div class="plate">
          <a class="plate-link" href={entry.href} aria-label={enc.use.open.replace('{name}', exp.name)}>
            {/* An archived experiment keeps a plate too: cadSpec's is its
                drafting table put away under a dust cloth. */}
            <Machine id={entry.id} ink="theme" height="var(--plate-h)" />
          </a>
        </div>
        <div class="entry-body">
          <h2 class="hw"><a class="hw-link" href={entry.href}><b>{exp.name}</b><span class="ipa" lang="und-fonipa">{exp.ipa}</span><span class="mark" title={statusName}>{mark}</span></a></h2>
          <p class="meta">{enc.meta.replace('{n}', exp.number.replace('EXP-', '')).replace('{status}', enc.statuses[status as keyof typeof enc.statuses] ?? status)}</p>
          <p class="def">
            <span class="ety" set:html={ec.etymology} />
            {' '}
            <span class="n">{enc.definitionNumber}</span>
            {' '}
            {ec.tagline}
          </p>
          <p class="def fig"><span class="n">{enc.definitionNumber2}</span>{' '}<i>{enc.figLabel}</i>{' '}{ec.figure}</p>
          <div class="use">
            {installCmd && (
              <span class="chip-wrap">
                <code class="chip" title={installCmd}>{installCmd}</code>
                <button
                  type="button"
                  class="copy-btn"
                  data-cmd={installCmd}
                  data-copy={enc.use.copy}
                  data-copied={enc.use.copied}
                  aria-label={enc.use.copy}
                  title={enc.use.copy}
                ><span class="copy-icon" set:html={iconSvg(copy, { size: 16 })} /></button>
              </span>
            )}
            {entry.id === 'quorum' && !installCmd && (
              <span>{enc.use.quorum}</span>
            )}
            {entry.id === 'astro-denoise' && (
              <span>{enc.use.research}</span>
            )}
          </div>
          <p class="links">
            <a href={entry.href}>{linkLabel}</a>
            {repo && (
              <>
                <span class="links-sep" aria-hidden="true">{' · '}</span>
                <a href={repo} target="_blank" rel="noopener noreferrer">{enc.use.repo}</a>
              </>
            )}
          </p>
        </div>
      </article>
    );
  })}
</div>

<p class="enc-key" set:html={enc.key.replace(/§/g, '<span>§</span>').replace(/‡/g, '<span>‡</span>').replace(/¶/g, '<span>¶</span>').replace(/†/g, '<span>†</span>')} />

<script>
  import { COPY_DONE_MS, setCopyState } from '../lib/copy-morph';
  (function () {
    // Tabs filter entries by status via the `hidden` attribute.
    var tabs = document.querySelectorAll('.thumbs button');
    var entries = document.querySelectorAll('.entry');
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var f = btn.getAttribute('data-f');
        tabs.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
        entries.forEach(function (e) {
          var show = f === 'all' || e.getAttribute('data-status') === f || (f === 'active' && e.getAttribute('data-status') === 'beta');
          if (show) e.removeAttribute('hidden');
          else e.setAttribute('hidden', '');
        });
      });
    });

    // Copy install command. On success the icon morphs to a check and the
    // accessible name reads "Copied"; the static icon stays for no-JS.
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
      var label = btn.getAttribute('aria-label') || '';
      btn.addEventListener('click', async function () {
        var cmd = btn.getAttribute('data-cmd') || '';
        try { await navigator.clipboard.writeText(cmd); } catch { return; }
        var copied = btn.getAttribute('data-copied') || '';
        setCopyState(btn, true);
        if (copied) btn.setAttribute('aria-label', copied);
        setTimeout(function () {
          setCopyState(btn, false);
          if (label) btn.setAttribute('aria-label', label);
        }, COPY_DONE_MS);
      });
    });
  })();
</script>

<style>
  .thumbs { display: flex; justify-content: center; gap: 0; flex-wrap: wrap; }
  .thumbs button { font-family: 'Old Standard TT', serif; font-size: 15px; letter-spacing: 0.04em; color: var(--bench-line); background: color-mix(in srgb, var(--bench-line) 6%, transparent); border: 1px solid var(--bench-line-soft); border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 16px 5px; margin: 0 2px; cursor: pointer; }
  .thumbs button[aria-pressed="true"] { background: var(--bench-line); color: var(--bench-ground); }

  .entries { display: grid; border-top: 3px double var(--bench-line); padding-top: 18px; }
  /* status.astro also ships *global* board styles for `.entry` — a border-bottom rule
     and `grid-template-rows: auto auto` — which would keep drawing a line between these
     entries and leave an empty second row (its row-gap) under every body. The scoped
     selector outranks it (the attribute raises the specificity). */
  .entry { display: grid; grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr); gap: 2rem; align-items: start; padding-block: 1.25rem; margin: 0; border: 0; grid-template-rows: none; }
  .entry[hidden] { display: none; }
  .entry[data-status="archived"] { opacity: 0.7; }

  .plate { --machine-h-phone: 200px; --plate-h: clamp(150px, 13vw, 190px); }
  /* The whole plate is the entry link; block keeps the machine's size unchanged.
     No text decoration: the link wraps art, and the default underline would draw
     a line under the archived entry's EXP number. */
  .plate-link { display: block; text-decoration: none; }
  .plate :global(.machine img) { height: auto; max-height: var(--plate-h); max-width: 100%; }

  .hw { margin: 0; font-family: 'Old Standard TT', serif; font-weight: 400; font-size: 22px; line-height: 1.15; }
  /* The name reads as plain headword until it is hovered or focused, then takes
     the entry's link style (same colour + underline offset as .links a). */
  .hw-link { color: inherit; text-decoration: none; }
  .hw-link:hover, .hw-link:focus-visible { color: var(--bench-copper); text-decoration: underline; text-underline-offset: 3px; }
  .hw b { font-weight: 700; font-variant: small-caps; letter-spacing: 0.06em; }
  .hw .mark { color: #87222c; margin-left: 4px; font-size: 18px; }
  .ipa { font-size: 0.8em; color: var(--bench-line-soft); margin-left: 6px; }
  :global(html[data-bench-theme='night']) .hw .mark { color: #e0a2a6; }

  .meta { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; color: var(--bench-line-soft); text-transform: uppercase; margin: 2px 0 0; }

  .def { margin: 4px 0 0; font-size: 18px; line-height: 1.55; max-width: 60ch; }
  .def .ety { color: var(--bench-line-soft); }
  .def .n { font-family: var(--font-mono); font-size: 12px; }
  .def.fig { font-size: 0.92em; color: var(--bench-line-soft); margin-top: 0.15rem; }

  .entry-body { min-width: 0; }
  /* status.astro builds its board markup by script, so its board styles are
     global and linked on every page: its `.entry .entry-body` would pin this
     body to a full-width second row. This scoped rule outranks it (the
     attribute raises the specificity) and touches only this view's markup. */
  .entry .entry-body { grid-column: auto; grid-row: auto; }
  .use { min-width: 0; max-width: 100%; margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; font-family: var(--font-mono); font-size: 12.5px; }
  .use code { background: color-mix(in srgb, var(--bench-line) 7%, transparent); padding: 2px 6px; overflow-wrap: anywhere; }
  .use a { color: var(--bench-copper); text-underline-offset: 3px; }
  .links { margin: 4px 0 0; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5; max-width: 100%; overflow-wrap: anywhere; }
  .links a { color: var(--bench-copper); text-underline-offset: 3px; }
  .links-sep { color: var(--bench-line-soft); }
  .chip-wrap { display: flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; }
  /* Wide enough for the whole command once the entry body has room; the chip scrolls only
     under 520 px, where one line is the only way to keep the row intact. */
  .chip { flex: 0 1 auto; min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; display: block; }
  .copy-btn { flex: none; }
  .copy-btn { font-family: var(--font-mono); font-size: 11px; background: none; border: 1px solid var(--bench-line-soft); color: var(--bench-line); padding: 2px 6px; cursor: pointer; border-radius: 4px; display: inline-flex; align-items: center; }
  /* The icon slot keeps a fixed 16px box so the morph never shifts layout. */
  .copy-btn .copy-icon { display: inline-flex; width: 16px; height: 16px; line-height: 0; }
  .copy-btn .copy-icon > svg, .copy-btn .copy-icon morph-icon { width: 16px; height: 16px; display: block; }
  .copy-btn .copy-icon[data-icon='check'] { color: var(--bench-copper); }

  .enc-key { margin: 0; text-align: center; font-family: var(--font-mono); font-size: 12px; color: var(--bench-line-soft); }
  /* The key marks come from set:html, so they carry no scope attribute: target them globally. */
  .enc-key :global(span) { color: #87222c; font-family: 'Old Standard TT', serif; font-size: 15px; }
  :global(html[data-bench-theme='night']) .enc-key :global(span) { color: #e0a2a6; }

  @media (max-width: 56.25rem) {
    .plate { --plate-h: 170px; }
  }

  @media (max-width: 40rem) {
    .entry { grid-template-columns: 1fr; gap: 14px; }
  }

  @media (max-width: 520px) {
    .thumbs button { font-size: 13px; padding: 5px 9px 4px; margin: 0 1px; }
    .chip { white-space: nowrap; overflow-x: auto; overflow-wrap: normal; }
  }

  @media (min-width: 900px) {
    .entry { grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr); align-items: center; }
  }
</style>
