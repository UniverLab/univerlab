---
import { getLang, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---
<!-- The newspaper: the masthead is static, #edition is set at the edge by
  functions/_middleware.ts (HTMLRewriter) or, on failure, by the client script
  in pages/today.astro with the same renderer. The page-open above keeps the
  only h1, so the masthead name is a paragraph set like one. -->
<div class="paper">
  <header class="masthead">
    <div class="ear"><span>{t.today.path}</span><span>{t.today.edition}</span></div>
    <p class="masthead-name">{t.today.name}</p>
    <p class="motto">{t.today.motto}</p>
  </header>
  <div id="edition"></div>
  <div id="today-loading" class="today-loading" role="status" aria-label={t.today.loading}>
    <div class="skeleton-line" style="width:60%"></div>
    <div class="skeleton-line" style="width:80%"></div>
    <div class="skeleton-line" style="width:45%"></div>
  </div>
  <div id="today-error" class="today-error" style="display:none" role="alert" data-msg={t.today.error}></div>
</div>

<style is:global>
  /* Global (the edition is injected at the edge and by script, so scoped
     styles would miss it), but every rule hangs off .paper: generic names like
     .lead or .col must never style another page. */
  .paper { display: grid; gap: 18px; margin-top: 2.5rem; }
  .paper .masthead { text-align: center; display: grid; gap: 6px; padding-bottom: 10px; border-bottom: 3px double var(--bench-line); }
  .paper .masthead .ear { display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bench-line-soft); flex-wrap: wrap; }
  .paper .masthead-name { font-family: var(--font-serif); font-weight: 700; font-size: clamp(38px, 8.4vw, 86px); line-height: 0.95; margin: 4px 0 0; letter-spacing: -0.01em; text-wrap: balance; color: var(--bench-line); }
  .paper .masthead .motto { font-family: var(--font-serif); font-style: italic; font-size: clamp(15px, 2.2vw, 19px); margin: 0; color: var(--bench-line-soft); }
  .paper #edition { display: grid; gap: 18px; }
  /* The edge-filled edition hides the skeletons without waiting for JS. */
  .paper #edition:not(:empty) + #today-loading { display: none; }
  .paper .dateline { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-block: 1px solid var(--bench-line); padding-block: 5px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--bench-line); }
  .paper .lead { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; border-bottom: 1px solid var(--bench-rule); padding-bottom: 20px; }
  .paper .lead .kicker, .paper .col h3 { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bench-line-soft); margin: 0; font-weight: 400; }
  .paper .lead h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(30px, 5.2vw, 54px); line-height: 1.02; margin: 6px 0 10px; text-wrap: balance; color: var(--bench-line); }
  .paper .lead p { margin: 0 0 10px; font-family: var(--font-body); font-size: 18px; line-height: 1.6; color: var(--bench-line); }
  .paper .lead .story .dropcap::first-letter { font-family: var(--font-serif); float: left; font-size: 3.4em; line-height: 0.82; padding: 4px 8px 0 0; }
  .paper .lead a, .paper .item a { font-family: var(--font-mono); font-size: 12px; color: var(--bench-emphasis); text-underline-offset: 3px; }
  .paper .lead aside { border-left: 1px solid var(--bench-rule); padding-left: 22px; display: grid; align-content: start; gap: 10px; font-family: var(--font-body); font-size: 16px; color: var(--bench-line-soft); }
  .paper .lead aside b { font-family: var(--font-serif); font-weight: 400; font-size: 26px; color: var(--bench-line); display: block; line-height: 1.1; }
  .paper .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .paper .col { padding-inline: 18px; display: grid; align-content: start; gap: 14px; min-width: 0; }
  .paper .col + .col { border-left: 1px solid var(--bench-rule); }
  .paper .col:first-child { padding-left: 0; } .paper .col:last-child { padding-right: 0; }
  .paper .col h3 { border-bottom: 1px solid var(--bench-line); padding-bottom: 4px; }
  .paper .item { display: grid; gap: 2px; padding-bottom: 12px; border-bottom: 1px dotted var(--bench-rule); }
  .paper .item:last-child { border-bottom: 0; }
  .paper .item .yr { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .paper .item .yr b { font-family: var(--font-serif); font-weight: 400; font-size: 26px; line-height: 1; font-variant-numeric: tabular-nums; color: var(--bench-line); }
  .paper .item .yr span { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.05em; color: var(--bench-line-soft); white-space: nowrap; }
  .paper .item p { margin: 0; font-family: var(--font-body); font-size: 16.5px; line-height: 1.45; color: var(--bench-line); }
  .paper .item a { justify-self: start; }
  .paper .labmail { border: 1px solid var(--bench-line); outline: 1px solid var(--bench-line); outline-offset: 3px; padding: 12px 16px; display: grid; gap: 6px; margin: 4px; }
  .paper .labmail .kicker { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bench-line-soft); margin: 0; }
  .paper .labmail h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(22px, 3.2vw, 30px); line-height: 1.1; margin: 0; text-wrap: balance; color: var(--bench-line); }
  .paper .labmail p { margin: 0; font-family: var(--font-body); font-size: 17px; color: var(--bench-line); }
  .paper .labmail a { font-family: var(--font-mono); font-size: 12px; color: var(--bench-emphasis); text-underline-offset: 3px; justify-self: start; }
  /* Newspaper photos: printed halftone, sepia-tinted, framed like a press
    print. The mat keeps its paper tone in both phases. */
  .paper .photo { position: relative; margin: 0; display: grid; gap: 4px; }
  .paper .photo .print { position: relative; overflow: hidden; background: var(--bench-c-parchment-deep); padding: 4px; box-shadow: 0 1px 0 var(--bench-rule); }
  .paper .photo img { display: block; width: 100%; height: auto; filter: grayscale(1) sepia(0.3) contrast(1.35) brightness(1.04); }
  .paper .photo .print::after { content: ""; position: absolute; inset: 4px; pointer-events: none; mix-blend-mode: multiply; opacity: 0.28;
    background: radial-gradient(circle, #2a2118 30%, transparent 33%) 0 0 / 2.5px 2.5px; }
  .paper .photo figcaption { font-family: var(--font-mono); font-size: 10.5px; color: var(--bench-line-soft); letter-spacing: 0.03em; }
  .paper .lead .story .photo { float: right; width: min(42%, 220px); margin: 4px 0 10px 18px; }
  .paper .item.has-photo { grid-template-columns: 64px minmax(0, 1fr); column-gap: 12px; }
  .paper .item.has-photo .photo { grid-row: span 3; }
  .paper .item.has-photo .yr, .paper .item.has-photo p, .paper .item.has-photo a { grid-column: 2; }
  .paper .colophon-note { font-family: var(--font-mono); font-size: 11.5px; color: var(--bench-line-soft); text-align: center; border-top: 3px double var(--bench-line); padding-top: 8px; margin: 0; }
  .paper .today-loading { display: flex; flex-direction: column; gap: 0.8rem; padding-block: 1rem; }
  .paper .skeleton-line { height: 1rem; border-radius: 4px; background: linear-gradient(90deg, var(--bench-rule) 25%, transparent 50%, var(--bench-rule) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  .paper .today-error { font-family: var(--font-mono); font-size: 0.8rem; color: var(--bench-line-soft); padding-block: 2rem; text-align: center; }
  @media (max-width: 47.99rem) {
    .paper .lead { grid-template-columns: 1fr; }
    .paper .lead aside { border-left: 0; padding-left: 0; border-top: 1px solid var(--bench-rule); padding-top: 12px; }
    .paper .cols { grid-template-columns: 1fr; }
    .paper .col, .paper .col:first-child, .paper .col:last-child { padding-inline: 0; }
    .paper .col + .col { border-left: 0; border-top: 1px solid var(--bench-line); padding-top: 14px; margin-top: 8px; }
  }
</style>
