---
import { getLang, useTranslations } from '../i18n';
import { iconSvg } from '../lib/icon-svg';
import { chevronLeft, chevronRight, printer } from '../lib/icons';
import { SHEET_WIDTH_REM, SHEET_HEIGHT_REM } from '../lib/paper-sheet-size';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---
<!-- The newspaper: the masthead is static, #edition is set at the edge by
  functions/_middleware.ts (HTMLRewriter) or, on failure, by the client script
  in pages/newspaper.astro with the same renderer. The masthead name is the
  page's h1; the sundial plate is an engraving inside the paper's grid, not a
  band above it. The ear's date controls are set by the script below: the
  built page cannot know ?d=. The paper is always light: sepia by day, a
  cooler grey under the moon — never dark. -->
<div class="paper-viewport" data-paper-viewport>
  <div class="paper-sheet" data-paper-sheet style={`--paper-sheet-w:${SHEET_WIDTH_REM}rem;--paper-sheet-h:${SHEET_HEIGHT_REM}rem`}>
<div class="paper">
  <header class="masthead">
    <div class="ear ear--left"><span>{t.today.path}</span><span class="edition-label" data-today={t.today.edition} data-past={t.today.editionPast}>{t.today.edition}</span><span data-sol data-sol-label={t.today.sol}></span></div>
    <h1 class="masthead-name">{t.today.name}</h1>
    <div class="ear ear--right"><span>{t.today.price}</span></div>
    <p class="motto">{t.today.motto}</p>
    <form class="edition-pick" method="get" aria-label={t.today.pick.label}><a class="step prev" data-prev href="./" aria-label={t.today.pick.prev} title={t.today.pick.prev} set:html={iconSvg(chevronLeft, { size: 15 })} /><label class="words"><span data-words></span><input type="date" name="d" required /></label><a class="step next" data-next href="./" aria-label={t.today.pick.next} title={t.today.pick.next} set:html={iconSvg(chevronRight, { size: 15 })} /><button type="submit" aria-label={t.today.pick.go} title={t.today.pick.go} set:html={iconSvg(printer, { size: 15 })} /></form>
    <nav class="paper-tabs">
      <a class="paper-tab is-active" data-page="page-1" href="#page-1">{t.today.tabs.p1}</a>
      <a class="paper-tab" data-page="lab" href="#lab">{t.today.tabs.p2}</a>
      <a class="paper-tab" data-page="lab2" href="#lab2">{t.today.tabs.p3}</a>
    </nav>
  </header>
  <section id="page-1" class="paper-page" aria-label={t.today.tabs.p1}>
    <div id="edition"></div>
    <div id="today-loading" class="today-loading" role="status" aria-label={t.today.loading}>
      <div class="skeleton-line" style="width:60%"></div>
      <div class="skeleton-line" style="width:80%"></div>
      <div class="skeleton-line" style="width:45%"></div>
    </div>
    <div id="today-error" class="today-error" style="display:none" role="alert" data-msg={t.today.error}></div>
  </section>
  <section id="lab" class="paper-page" aria-label={t.today.tabs.p2}>
    <div id="lab-body"></div>
  </section>
  <section id="lab2" class="paper-page" aria-label={t.today.tabs.p3}>
    <div id="lab2-body"></div>
  </section>
</div>
  </div>
</div>
<div class="paper-bar" data-paper-bar>
  <nav class="paper-bar-tabs" aria-label={t.today.controls}>
    <a class="paper-tab is-active" data-page="page-1" href="#page-1">{t.today.tabs.p1}</a>
    <a class="paper-tab" data-page="lab" href="#lab">{t.today.tabs.p2}</a>
    <a class="paper-tab" data-page="lab2" href="#lab2">{t.today.tabs.p3}</a>
  </nav>
  <form class="edition-pick edition-pick--bar" method="get" aria-label={t.today.pick.label}><a class="step prev" data-prev href="./" aria-label={t.today.pick.prev} title={t.today.pick.prev} set:html={iconSvg(chevronLeft, { size: 15 })} /><label class="words"><span data-words></span><input type="date" name="d" required /></label><a class="step next" data-next href="./" aria-label={t.today.pick.next} title={t.today.pick.next} set:html={iconSvg(chevronRight, { size: 15 })} /></form>
  <button class="paper-fit" data-paper-fit type="button" hidden>{t.today.fit}</button>
</div>

<script>
  // The masthead date controls: the built page cannot know ?d=, so the
  // edition's words, the prev/next steps and the today/past label are set
  // here, from the same day key the edition renderer uses.
  import { editionYmd, editionDateFor, solOf } from '../lib/today-edition';

  (function () {
    var d = editionDateFor(window.location.search);
    var sol = document.querySelector('[data-sol]');
    if (sol) sol.textContent = (sol.getAttribute('data-sol-label') || 'Sol') + ' ' + solOf(d);
    var forms = document.querySelectorAll('.edition-pick');
    if (!forms.length) return;
    var today = editionYmd();
    var ymd = editionYmd(d);
    var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
    forms.forEach(function (form) {
      var input = form.querySelector('input[name="d"]');
      if (input) {
        input.setAttribute('max', today);
        input.setAttribute('value', ymd);
        // Touch: tapping the words label only focuses the 1px input, which
        // does not reliably open the picker, so open it explicitly.
        var wordsLabel = form.querySelector('label.words');
        if (wordsLabel) {
          wordsLabel.addEventListener('click', function () {
            try {
              if (input.showPicker) input.showPicker();
            } catch (_) {
              /* the forwarded label click still focuses the input */
            }
          });
        }
      }
      var words = form.querySelector('[data-words]');
      if (words) {
        words.textContent = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }).format(d);
      }
      var prev = form.querySelector('[data-prev]');
      if (prev) prev.setAttribute('href', '?d=' + editionYmd(new Date(d.getTime() - 86400000)));
      var next = form.querySelector('[data-next]');
      if (next) {
        if (ymd === today) next.style.display = 'none';
        else next.setAttribute('href', '?d=' + editionYmd(new Date(d.getTime() + 86400000)));
      }
    });
    var label = document.querySelector('.edition-label');
    if (label) {
      if (ymd === today) {
        label.textContent = label.getAttribute('data-today') || '';
      } else {
        // The short date reads day-first in both languages (en-GB).
        var short = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
          day: 'numeric',
          month: 'long',
        }).format(d);
        label.textContent = (label.getAttribute('data-past') || '').replace('{date}', short);
      }
    }
  })();
</script>

<style is:global>
  /* Global (the edition is injected at the edge and by script, so scoped
     styles would miss it), but every rule hangs off .paper: generic names like
     .lead or .col must never style another page. The paper is always light:
     sepia by day, a cooler grey under the moon — never dark. */
  .paper {
    --p-ground: var(--bench-c-parchment);
    --p-deep: var(--bench-c-parchment-deep);
    --p-ink: var(--bench-c-ink);
    --p-soft: var(--bench-c-sepia);
    --p-rule: var(--bench-c-graphite);
    --p-emphasis: var(--bench-c-garnet);
    display: flex; flex-direction: column; gap: 18px;
    background: var(--p-ground);
    padding: clamp(16px, 3vw, 28px);
    min-height: var(--paper-sheet-h);
  }
  [data-bench-theme='night'] .paper {
    --p-ground: #e3e5e2;
    --p-deep: #d7dad6;
    --p-ink: #16191c;
    --p-soft: #454e54;
    --p-rule: #6d787e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-bench-theme='day']) .paper {
      --p-ground: #e3e5e2;
      --p-deep: #d7dad6;
      --p-ink: #16191c;
      --p-soft: #454e54;
      --p-rule: #6d787e;
    }
  }
  .paper .masthead { text-align: center; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; align-items: center; padding-bottom: 10px; border-bottom: 3px double var(--p-ink); }
  .paper .masthead .ear { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--p-soft); flex-wrap: wrap; min-width: 0; }
  .paper .masthead .ear--left { grid-column: 1; grid-row: 1; justify-self: start; }
  .paper .masthead .ear--right { grid-column: 2; grid-row: 1; justify-self: end; }
  .paper .masthead-name { grid-column: 1 / -1; }
  .paper .masthead .motto, .paper .edition-pick, .paper .paper-tabs { grid-column: 1 / -1; }
  @media (min-width: 48rem) {
    .paper .masthead { grid-template-columns: 1fr auto 1fr; }
    .paper .masthead .ear--left { grid-column: 1; grid-row: 1; }
    .paper .masthead-name { grid-column: 2; grid-row: 1; }
    .paper .masthead .ear--right { grid-column: 3; grid-row: 1; }
  }
  .paper .edition-pick { display: inline-flex; gap: 8px; align-items: center; justify-content: center; justify-self: center; }
  .paper .edition-pick .step, .paper .edition-pick button { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; padding: 0; color: var(--p-ink); background: transparent; border: 1px solid var(--p-rule); border-radius: 0; cursor: pointer; }
  .paper .edition-pick .step { text-decoration: none; }
  .paper .edition-pick .icon { display: block; }
  .paper .edition-pick .words { position: relative; cursor: pointer; border-bottom: 1px dotted var(--p-soft); text-align: center; }
  .paper .edition-pick .words input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .paper .edition-pick .words:focus-within { outline: 1px solid var(--p-emphasis); outline-offset: 3px; }
  .paper .edition-pick .step:focus-visible, .paper .edition-pick button:focus-visible { outline: 1px solid var(--p-emphasis); outline-offset: 2px; }
  .paper .masthead-name { font-family: var(--font-serif); font-weight: 700; font-size: clamp(38px, 8.4vw, 86px); line-height: 0.95; margin: 4px 0 0; letter-spacing: -0.01em; text-wrap: balance; color: var(--p-ink); }
  .paper .masthead .motto { font-family: var(--font-serif); font-style: italic; font-size: clamp(15px, 2.2vw, 19px); margin: 0; text-align: center; justify-self: center; color: var(--p-soft); }
  .paper #edition { display: grid; gap: 18px; flex: 1 1 auto; min-height: 0; }
  .paper #lab-body, .paper #lab2-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 18px; }
  /* The two pages: tabs in the masthead switch them when JS runs. Without
     JS both read one after the other — hidden only ever applies under .js. */
  .paper .paper-tabs { display: flex; justify-content: center; gap: 4px; margin-top: 10px; border-top: 1px solid var(--p-ink); padding-top: 8px; }
  .paper .paper-tab { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--p-soft); text-decoration: none; padding: 4px 14px; border: 1px solid transparent; }
  .paper .paper-tab.is-active { color: var(--p-ink); border-color: var(--p-rule); }
  .paper .paper-page { display: flex; flex-direction: column; gap: 18px; flex: 1 1 auto; min-height: 0; }
  .paper.js .paper-page[hidden] { display: none; }
  /* Pages 2 and 3: the announcements as a classifieds section — a composed
     grid of display, boxed and small ads with runs of one-line notices, set
     in the paper's own type. Filtered rows hide only when JS manages them,
     so no-JS readers get every entry. */
  .paper .lab-heading { font-family: var(--font-serif); font-weight: 400; font-size: clamp(26px, 3.4vw, 38px); line-height: 1.1; margin: 0; text-wrap: balance; color: var(--p-ink); border-bottom: 1px solid var(--p-ink); padding-bottom: 8px; }
  .paper .lab-heading--cont { border-bottom: 1px solid var(--p-rule); }
  /* The classifieds section head: the engraved head ornament with the words
     set in type beside it. Every ornament is printed like the paper's own
     halftones — sepia, multiplied into the sheet — so it reads in both
     themes and stays decorative to assistive technology (alt=""). */
  .paper .lab-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; border-bottom: 1px solid var(--p-ink); padding-bottom: 8px; }
  .paper .lab-head .lab-heading { border-bottom: 0; padding-bottom: 0; min-width: 0; }
  .paper .lab-head-ornament { width: min(16rem, 100%); height: auto; flex: 0 1 auto; }
  .paper .ad-cut { display: block; width: 2.4rem; }
  .paper .ad-cut img { width: 100%; height: auto; }
  .paper .notice-fleuron { grid-column: 1 / -1; text-align: center; }
  .paper .notice-fleuron img { width: 4.5rem; height: auto; }
  .paper .manicule { display: inline-block; width: 1.7rem; height: auto; margin-right: 4px; vertical-align: -.18em; }
  .paper .lab-head-ornament, .paper .ad-cut img, .paper .notice-fleuron img, .paper .manicule {
    filter: grayscale(1) sepia(.22) contrast(1.12); mix-blend-mode: multiply; opacity: .9;
  }
  .paper .lab-empty { margin: 0; font-family: var(--font-body); font-size: 16px; line-height: 1.55; color: var(--p-soft); }
  .paper .lab-filters { display: grid; gap: 6px; }
  .paper .lab-filter-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .paper .lab-filter-row { border-top: 1px solid var(--p-ink); padding-top: 6px; }
  .paper .lab-filter { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--p-soft); background: transparent; border: 1px solid var(--p-rule); border-radius: 0; padding: 3px 10px; cursor: pointer; }
  .paper .lab-filter.is-active { color: var(--p-ink); border-color: var(--p-ink); }
  .paper .lab-filter-count { opacity: 0.7; margin-left: 6px; font-size: 10.5px; }
  /* The classifieds: one composed grid per page. Display ads read across
     the full measure with their engraving; boxed ads take half, small ads a
     third, and one-line notices run in dense ruled columns. Dense flow packs
     the small ads instead of leaving a shelf of blank paper under short ones. */
  .paper .classifieds { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); grid-auto-flow: dense; flex: 1 1 auto; min-height: 0; }
  .paper .classifieds > * { min-width: 0; }
  @media (min-width: 48rem) {
    .paper .classifieds { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .paper .ad-display { grid-column: 1 / -1; }
    .paper .ad-boxed, .paper .classifieds > .coupon { grid-column: span 3; }
    .paper .ad-small { grid-column: span 2; }
    .paper .notice-run { grid-column: 1 / -1; }
  }
  .paper .ad-display { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 48rem) {
    .paper .ad-display { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  }
  .paper .ad-art { margin: 0; }
  .paper .notice-run { column-count: 2; column-gap: 24px; column-rule: 1px solid var(--p-rule); }
  @media (min-width: 48rem) {
    .paper .notice-run { column-count: 3; }
  }
  .paper .notice-run .notice { break-inside: avoid; }
  .paper .notice-line { margin: 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .paper .notice-title { color: var(--p-soft); }
  .paper .lab-more { margin: 0; border-top: 3px double var(--p-ink); padding-top: 8px; text-align: center; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; }
  .paper .lab-more a { color: var(--p-emphasis); text-underline-offset: 3px; }
  .paper .log-entry { display: block; min-width: 0; break-inside: avoid; padding-block: 14px; border-bottom: 1px dotted var(--p-rule); }
  .paper .log-entry time { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; color: var(--p-soft); }
  .paper .log-entry .type-badge { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--p-emphasis); border: 1px solid var(--p-emphasis); padding: 2px 8px; border-radius: 0; }
  .paper .log-entry .entry-body { display: grid; gap: 6px; }
  .paper .log-entry h3 { font-family: var(--font-serif); line-height: 1.25; margin: 0; text-wrap: balance; color: var(--p-ink); }
  .paper .log-entry h3.sz-lg { font-weight: 700; font-size: 24px; text-transform: uppercase; letter-spacing: 0.02em; }
  .paper .log-entry h3.sz-md { font-weight: 700; font-size: 20px; }
  .paper .log-entry h3.sz-sm { font-weight: 400; font-size: 18px; font-style: italic; }
  .paper .log-entry p { margin: 0; font-family: var(--font-body); font-size: 15.5px; line-height: 1.55; color: var(--p-ink); white-space: pre-line; }
  .paper .log-entry .entry-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; border-top: 1px solid var(--p-rule); padding-top: 6px; }
  .paper .log-entry p a, .paper .log-entry .log-link { font-family: var(--font-mono); font-size: 12px; color: var(--p-emphasis); text-underline-offset: 3px; }
  .paper.js .log-entry.is-hidden { display: none; }
  .paper.js .notice-run[hidden] { display: none; }
  /* The edge-filled edition hides the skeletons without waiting for JS. */
  .paper #edition:not(:empty) + #today-loading { display: none; }
  .paper .dateline { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-block: 1px solid var(--p-ink); padding-block: 5px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--p-ink); }
  .paper .banner { text-align: center; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--p-ink); border-bottom: 1px solid var(--p-ink); padding-bottom: 6px; margin: 0; }
  .paper .front { display: grid; gap: 18px; grid-template-columns: minmax(0, 1fr); }
  .paper .front > * { min-width: 0; }
  .paper .lead { border-bottom: 1px solid var(--p-rule); padding-bottom: 20px; }
  .paper .lead .story { display: flex; flex-direction: column; height: 100%; }
  .paper .lead .kicker, .paper .col h3 { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--p-soft); margin: 0; font-weight: 400; }
  .paper .lead h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(30px, 4.4vw, 46px); line-height: 1.05; margin: 6px 0 10px; text-wrap: balance; color: var(--p-ink); }
  .paper .lead p { margin: 0 0 10px; font-family: var(--font-body); font-size: 18px; line-height: 1.6; color: var(--p-ink); text-align: justify; hyphens: auto; }
  .paper .lead .story .dropcap::first-letter { font-family: var(--font-serif); float: left; font-size: 3.4em; line-height: 0.82; padding: 4px 8px 0 0; }
  .paper .lead a, .paper .item a { font-family: var(--font-mono); font-size: 12px; color: var(--p-emphasis); text-underline-offset: 3px; }
  .paper .rail { display: flex; flex-direction: column; gap: 18px; height: 100%; min-width: 0; }
  .paper .rail > * { min-width: 0; }
  .paper .rail .also { border: 1px solid var(--p-rule); padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; font-family: var(--font-body); font-size: 16px; color: var(--p-soft); flex: 1 0 auto; }
  .paper .rail .also .aside-item { display: flex; flex-direction: column; gap: 8px; min-height: 0; }
  .paper .rail .also .aside-item.has-photo { flex: 1 1 auto; }
  .paper .rail .also b { font-family: var(--font-serif); font-weight: 400; font-size: 26px; color: var(--p-ink); display: block; line-height: 1.1; }
  .paper .rail .also .aside-body { font-size: 14.5px; line-height: 1.5; text-align: justify; hyphens: auto; }
  .paper .cols { display: grid; gap: 0 16px; grid-template-columns: minmax(0, 1fr); }
  .paper .more { display: grid; gap: 14px; }
  .paper .more summary { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; color: var(--p-emphasis); cursor: pointer; }
  .paper .col { padding-inline: 18px; display: grid; align-content: start; gap: 14px; min-width: 0; }
  .paper .col .ad { margin-top: 16px; align-self: end; }
  .paper .col + .col { border-left: 1px solid var(--p-rule); }
  .paper .col:first-child { padding-left: 0; } .paper .col:last-child { padding-right: 0; }
  .paper .col h3 { border-bottom: 1px solid var(--p-ink); padding-bottom: 4px; }
  .paper .col h3 .cont { text-transform: none; letter-spacing: 0.02em; }
  .paper .item { display: grid; gap: 2px; padding-bottom: 12px; border-bottom: 1px dotted var(--p-rule); }
  .paper .item:last-child { border-bottom: 0; }
  .paper .item .yr { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .paper .item .yr b { font-family: var(--font-serif); font-weight: 400; font-size: 26px; line-height: 1; font-variant-numeric: tabular-nums; color: var(--p-ink); }
  .paper .item .yr span { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: lowercase; font-variant: small-caps; color: var(--p-soft); white-space: nowrap; }
  .paper .item p { margin: 0; font-family: var(--font-serif); font-size: 17px; line-height: 1.4; color: var(--p-ink); text-align: left; hyphens: auto; }
  .paper .item .body { font-family: var(--font-body); font-style: normal; font-size: 15px; line-height: 1.55; text-align: left; hyphens: auto; }
  .paper .item a { justify-self: start; }
  .paper .labmail { border: 1px solid var(--p-ink); outline: 1px solid var(--p-ink); outline-offset: 3px; padding: 12px 16px; display: grid; gap: 6px; margin: 4px; }
  .paper .labmail .kicker { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--p-soft); margin: 0; }
  .paper .labmail h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(22px, 3.2vw, 30px); line-height: 1.1; margin: 0; text-wrap: balance; color: var(--p-ink); }
  .paper .labmail p { margin: 0; font-family: var(--font-body); font-size: 17px; color: var(--p-ink); }
  .paper .labmail a { font-family: var(--font-mono); font-size: 12px; color: var(--p-emphasis); text-underline-offset: 3px; justify-self: start; }
  /* Newspaper photos: printed halftone, sepia-tinted, framed like a press
    print. The mat keeps the paper's own tone in both phases. */
  .paper .photo { position: relative; margin: 0; display: grid; gap: 4px; }
