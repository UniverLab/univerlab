---
import Mark from './Mark.astro';
import { buildLabBodies, labRings, labVarStyle, LAB, LABEL, SAT } from '../lib/lab-system';
import { getLang, useTranslations, localizePath, motifOf } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const bodies = buildLabBodies();
const rings = labRings(bodies);
---
<figure class="lab-system">
  <div class="lab-canvas">
    <svg class="lab-svg" viewBox={`0 0 ${LAB.vbW} ${LAB.vbH}`} data-orbit-well
         role="group" aria-label={t.home.hero.systemCaption}
         xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="lab-term" x1="0.15" y1="0" x2="0.85" y2="1">
          <stop class="term-a" offset="0" />
          <stop class="term-b" offset="0.72" />
        </linearGradient>
      </defs>
      <g class="lab-rings" aria-hidden="true">
        {rings.map((r, i) => (
          <ellipse class="lab-orbit" data-orbit={i} cx={LAB.cx} cy={LAB.cy} rx={r.rx} ry={r.ry} />
        ))}
      </g>
      <g class="lab-planet" aria-hidden="true">
        <circle class="lab-planet-disc" cx={LAB.cx} cy={LAB.cy} r={LAB.planetR} />
        <circle class="lab-planet-term" cx={LAB.cx} cy={LAB.cy} r={LAB.planetR} />
        <g class="lab-mark" transform={`translate(${LAB.cx - 13} ${LAB.cy - 13})`}>
          <Mark size={26} />
        </g>
      </g>
      <g class="lab-sats">
        {bodies.map((b) => (
          <a class="lab-sat" href={localizePath(`/${b.id}`, lang)} tabindex="0"
             data-body={b.number} data-status={b.status} data-ring={b.ring}
             data-preview={b.id} data-flip-surface={b.surface}
             aria-label={`${b.name} — ${t.experiments[b.id].tagline}`}
             style={`--essence: ${b.essenceHex}; ${labVarStyle(b)}`}>
            <g class="lab-body">
              <g class="lab-scale">
                <circle class="lab-hit" r={SAT.hit} />
                <circle class="lab-dot" r={b.radius} />
                <circle class="lab-focus" r={b.radius + 4} />
                {b.side === 'right' && <text class="lab-tag" x={b.radius + LABEL.gap} y="0" dominant-baseline="middle">{b.number}</text>}
                {b.side === 'left' && <text class="lab-tag" x={-(b.radius + LABEL.gap)} y="0" text-anchor="end" dominant-baseline="middle">{b.number}</text>}
                {b.side === 'above' && <text class="lab-tag" x="0" y={-(b.radius + LABEL.gap)} text-anchor="middle">{b.number}</text>}
                {b.side === 'below' && <text class="lab-tag" x="0" y={b.radius + LABEL.gap + 10} text-anchor="middle">{b.number}</text>}
              </g>
            </g>
          </a>
        ))}
      </g>
    </svg>
    <div class="lab-previews" aria-hidden="true">
      {bodies.map((b) => (
        <div class="lab-preview" data-preview={b.id} data-flip-surface={b.surface}>
          <div class="lab-preview-top">
            <span class="lab-preview-num">{b.number}</span>
            <span class="lab-preview-status" data-status={b.status}>{t.status[b.status]}</span>
          </div>
          <p class="lab-preview-name">{b.name}</p>
          <p class="lab-preview-motif">{motifOf({ motif: b.motif }, t)}</p>
          <p class="lab-preview-tag">{t.experiments[b.id].tagline}</p>
        </div>
      ))}
    </div>
  </div>
  <figcaption class="lab-cap">{t.home.hero.systemCaption}</figcaption>
</figure>
<style>
  .lab-system { margin: 0; display: flex; flex-direction: column; gap: 0.55rem;
                width: 100%; max-width: 420px; align-items: stretch; }
  .lab-canvas { position: relative; }
  .lab-svg { display: block; width: 100%; height: auto; }
  .lab-orbit { fill: none; stroke: var(--ink); stroke-width: 1;
               stroke-dasharray: 1 5; stroke-linecap: round; opacity: 0.2; }
  .lab-planet-disc { fill: color-mix(in srgb, var(--accent) 12%, var(--bg)); }
  .lab-planet-term { fill: url(#lab-term); }
  .term-a { stop-color: var(--accent); stop-opacity: 0.34; }
  .term-b { stop-color: var(--accent); stop-opacity: 0; }
  /* Mark is a child component: its svg carries no LabSystem scope attribute,
     so the descendant must be :global() or the accent fill never applies. */
  .lab-mark :global(svg) { fill: var(--accent); opacity: 0.92; }
  .lab-dot { fill: var(--surface-essence, var(--essence, var(--accent))); }
  .lab-hit { fill: transparent; pointer-events: all; cursor: pointer; }
  .lab-focus { fill: none; stroke: transparent; stroke-width: 1.5; }
  .lab-sat:focus-visible { outline: none; }
  .lab-sat:focus-visible .lab-focus { stroke: var(--accent); }
  .lab-tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em;
             fill: var(--ink-dim); pointer-events: none; }
  .lab-scale { transform-box: fill-box; transform-origin: center;
               transition: transform 0.18s ease; }
  .lab-body { transform: translate(var(--k0x), var(--k0y)); }
  .lab-system.is-hovering .lab-body { animation-play-state: paused; opacity: 0.4; }
  .lab-system.is-hovering .lab-body.is-lit { opacity: 1; }
  .lab-system.is-hovering .lab-body.is-lit .lab-scale { transform: scale(1.6); }
  .lab-system.is-hovering .lab-orbit.is-lit { opacity: 0.45; }
  @media (prefers-reduced-motion: no-preference) {
    .lab-body { animation: lab-orbit var(--period, 120s) linear infinite; }
  }
  @keyframes lab-orbit {
    0% { transform: translate(var(--k0x), var(--k0y)); }
    6.25% { transform: translate(var(--k1x), var(--k1y)); }
    12.5% { transform: translate(var(--k2x), var(--k2y)); }
    18.75% { transform: translate(var(--k3x), var(--k3y)); }
    25% { transform: translate(var(--k4x), var(--k4y)); }
    31.25% { transform: translate(var(--k5x), var(--k5y)); }
    37.5% { transform: translate(var(--k6x), var(--k6y)); }
    43.75% { transform: translate(var(--k7x), var(--k7y)); }
    50% { transform: translate(var(--k8x), var(--k8y)); }
    56.25% { transform: translate(var(--k9x), var(--k9y)); }
    62.5% { transform: translate(var(--k10x), var(--k10y)); }
    68.75% { transform: translate(var(--k11x), var(--k11y)); }
    75% { transform: translate(var(--k12x), var(--k12y)); }
    81.25% { transform: translate(var(--k13x), var(--k13y)); }
    87.5% { transform: translate(var(--k14x), var(--k14y)); }
    93.75% { transform: translate(var(--k15x), var(--k15y)); }
    100% { transform: translate(var(--k0x), var(--k0y)); }
  }
  .lab-preview { position: absolute; width: 220px; height: 120px; display: none;
    background: var(--surface-bg); color: var(--surface-ink);
    border: 1px solid var(--surface-line);
    border-left: 2px solid var(--surface-essence, var(--essence, var(--accent)));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--surface-ink) 7%, transparent);
    padding: 0.55rem 0.7rem; font-family: var(--font-mono); z-index: 2; }
  .lab-preview.is-open { display: block; }
  .lab-preview-top { display: flex; justify-content: space-between; font-size: 0.62rem;
    letter-spacing: 0.12em; color: var(--surface-essence, var(--essence)); }
  .lab-preview-status { color: var(--surface-ink-dim); text-transform: uppercase; }
  .lab-preview-name { font-family: var(--font-body); font-size: 0.82rem; margin: 0.3rem 0;
    color: var(--surface-ink); }
  .lab-preview-motif { font-size: 0.58rem; letter-spacing: 0.06em; margin: 0 0 0.25rem;
    color: var(--surface-essence, var(--essence)); white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; }
  .lab-preview-tag { font-family: var(--font-body); font-size: 0.7rem; margin: 0;
    color: var(--surface-ink-dim); display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .lab-system.is-hovering .lab-body.is-lit .lab-scale { transform: none; }
  }
  @media (max-height: 48rem) and (min-width: 1100px) { .lab-system { max-width: 340px; } }
</style>
<script>
  const fig = document.querySelector<HTMLElement>('.lab-system')!;
  const canvas = fig.querySelector<HTMLElement>('.lab-canvas')!;
  const rings = [...fig.querySelectorAll<SVGEllipseElement>('.lab-orbit')];
  const sats = [...fig.querySelectorAll<SVGElement>('.lab-sat')];
  const previews = new Map(
    [...fig.querySelectorAll<HTMLElement>('.lab-preview')].map((p) => [p.dataset.preview!, p]),
  );
  const previewFor = (sat: Element): string => sat.getAttribute('data-preview') ?? '';
  let tappedId: string | null = null;

  const open = (sat: Element) => {
    fig.classList.add('is-hovering');
    sats.forEach((s) => s.querySelector('.lab-body')!.classList.toggle('is-lit', s === sat));
    rings.forEach((r, i) => r.classList.toggle('is-lit', i === Number((sat as HTMLElement).dataset.ring)));
    const cr = canvas.getBoundingClientRect();
    const sr = sat.querySelector('.lab-dot')!.getBoundingClientRect();
    const card = previews.get(previewFor(sat));
    if (!card) return;
    const w = 220, h = 120, pad = 12;
    let x = sr.right - cr.left + pad;
    let y = sr.top - cr.top + sr.height / 2 - h / 2;
    if (x + w > cr.width) x = sr.left - cr.left - pad - w;
    x = Math.max(0, Math.min(x, cr.width - w));
    y = Math.max(0, Math.min(y, cr.height - h));
    card.style.left = `${x}px`;
    card.style.top = `${y}px`;
    previews.forEach((p) => p.classList.toggle('is-open', p === card));
  };
  const close = () => {
    fig.classList.remove('is-hovering');
    sats.forEach((s) => s.querySelector('.lab-body')!.classList.remove('is-lit'));
    rings.forEach((r) => r.classList.remove('is-lit'));
    previews.forEach((p) => p.classList.remove('is-open'));
  };

  sats.forEach((sat) => {
    sat.addEventListener('mouseenter', () => open(sat));
    sat.addEventListener('mouseleave', close);
    sat.addEventListener('focus', () => open(sat));
    sat.addEventListener('blur', close);
  });

  if ('ontouchstart' in window) {
    const SLOP = 12, TAP_MS = 600;
    let x = 0, y = 0, t0 = 0, moved = false;
    sats.forEach((sat) => {
      sat.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        x = e.touches[0].clientX; y = e.touches[0].clientY;
        t0 = performance.now(); moved = false;
        if (tappedId === (sat as HTMLElement).dataset.body) return;
        e.preventDefault(); open(sat); tappedId = (sat as HTMLElement).dataset.body ?? null;
      }, { passive: false });
      sat.addEventListener('touchmove', (e) => {
        const t = e.touches[0];
        if (t && (Math.abs(t.clientX - x) > SLOP || Math.abs(t.clientY - y) > SLOP)) { moved = true; tappedId = null; }
      }, { passive: true });
      sat.addEventListener('touchend', (e) => {
        if (moved || performance.now() - t0 > TAP_MS) return;
        if (tappedId !== (sat as HTMLElement).dataset.body) e.preventDefault();
      });
    });
  }
  window.addEventListener('pageshow', () => { tappedId = null; close(); });
</script>
