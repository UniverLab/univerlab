---
import type { ExperimentId } from '../lib/experiments';

interface Props {
  id: ExperimentId;
}
const { id } = Astro.props;
---
<div class="fondo" data-fondo={id} aria-hidden="true"></div>
{id !== 'astro-denoise' && <div class="fondo-veil" aria-hidden="true"></div>}

<script>
  // Astro compiles this block as its own module, so the shared map has to be
  // imported here; a frontmatter import never reaches this scope.
  import { fondoLoaders } from '../scripts/fondos/index';

  const run = async () => {
    const host = document.querySelector<HTMLElement>('.fondo[data-fondo]');
    if (!host) return;
    const id = host.dataset.fondo;
    if (!id) return;
    const loaders: Record<string, () => Promise<any>> = fondoLoaders;
    const load = loaders[id];
    if (!load) return;
    const mod = await load();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isNight = () =>
      document.documentElement.dataset.benchTheme === 'night' ||
      document.documentElement.dataset.celestial === 'moon';
    const fondo = mod.mount(host, { night: isNight(), reduced, base: `/bench/fondos/${id}/` });
    const onTheme = () => fondo.setNight(isNight());
    window.addEventListener('univerlab:themechange', onTheme);

    if (id === 'quorum') {
      const observer = new MutationObserver(onTheme);
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-bench-theme'],
      });
      const onPageHide = () => {
        observer.disconnect();
        fondo.destroy();
        window.removeEventListener('pagehide', onPageHide);
      };
      window.addEventListener('pagehide', onPageHide);
    }
  };
  // The fondo's script work and its data/images stay off the critical path:
  // after the load event, an idle slot (or 5 s) before the module that
  // animates the background even starts, so first paint is never blocked.
  const later = () => {
    if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 5000 });
    else setTimeout(run, 5000);
  };
  if (document.readyState === 'complete') later();
  else window.addEventListener('load', later, { once: true });
</script>

<style>
  .fondo {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .fondo-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 60% 80% at 50% 50%,
      color-mix(in srgb, var(--bg) 90%, transparent) 0%,
      transparent 75%
    );
  }
</style>
