---
// The canopy hero: one SVG that morphs between graph shapes the engine really
// runs — gated implement, ensemble quorum, cascade fallback, router, and the
// full rq pipeline with its resilience branch. Nodes keep their identity
// (slot) across shapes and glide to their new position and form; edges cross-
// fade; a token walks each shape's path (red legs = a failure routed back).
// prefers-reduced-motion renders the first shape, still.
interface Props {
  /** Harness accent colours keyed by platform stem (from canopy-registry). */
  colors: Record<string, string>;
  /** Shape captions, in the order of SHAPES below: [name, line]. */
  captions: [string, string][];
}
const { colors, captions } = Astro.props;
const SLOTS = 9;
---
<figure class="gm" data-colors={JSON.stringify(colors)} data-captions={JSON.stringify(captions)}>
  <svg class="gm-svg" viewBox="0 0 100 62" role="img" aria-label={captions.map((c) => c[0]).join(', ')}>
    <g class="gm-edges">
      {Array.from({ length: 12 }, () => <path class="gm-edge" d="M50 31 L50 31" />)}
    </g>
    <g class="gm-group">
      <rect class="gm-group-box" x="0" y="0" width="0" height="0" rx="2" />
      <text class="gm-group-label" text-anchor="start"></text>
      <text class="gm-mark" text-anchor="start">✕ quota</text>
      {Array.from({ length: 3 }, () => <text class="gm-ord" text-anchor="middle"></text>)}
    </g>
    <circle class="gm-token" r="1.1" cx="-10" cy="-10" />
    <g class="gm-nodes">
      {Array.from({ length: SLOTS }, (_, i) => (
        <g class="gm-node" data-slot={i} transform="translate(50 31)">
          <rect class="gm-shape" x="-3" y="-3" width="6" height="6" rx="3" />
          <text class="gm-label" dy="6.4" text-anchor="middle"></text>
          <text class="gm-harness" dy="8.9" text-anchor="middle"></text>
        </g>
      ))}
    </g>
  </svg>
  <figcaption class="gm-caption mono">
    <span class="gm-name">{captions[0][0]}</span>
    <span class="gm-line">{captions[0][1]}</span>
  </figcaption>
</figure>

<script>
  import { GEOM, edgePath, type Kind } from '../lib/canopy-graph';

  type N = { s: number; x: number; y: number; k: Kind; l: string; h?: string };
  // 'order' = the try-next-member sequence inside an ensemble group (not a route).
  type E = [number, number, 'pass' | 'fail' | 'order'];
  // An ensemble group: a labelled outline around its members, tried in `members` order.
  type Group = { x: number; y: number; w: number; h: number; label: string; members: number[] };
  type Leg = [number, number, boolean, ('red' | 'ok' | 'none')?];
  // Edge/leg endpoints >= 100 are the shape's free points (`pts`), e.g. a group's exit.
  type Shape = { nodes: N[]; edges: E[]; walk: Leg[]; group?: Group; pts?: { x: number; y: number }[] };

  // Slots: 0 spec · 1 main agent · 2 gate/check · 3 reviewer/third · 4 commit ·
  // 5,6 extra members · 7 designer · 8 resilience.
  const SHAPES: Shape[] = [
    { // gated implement
      nodes: [
        { s: 0, x: 7, y: 31, k: 'chip', l: 'spec' },
        { s: 1, x: 28, y: 31, k: 'agent', l: 'implement', h: 'claude' },
        { s: 2, x: 49, y: 31, k: 'check', l: 'gates' },
        { s: 3, x: 70, y: 31, k: 'agent', l: 'review', h: 'opencode' },
        { s: 4, x: 91, y: 31, k: 'commit', l: 'commit' },
      ],
      edges: [[0, 1, 'pass'], [1, 2, 'pass'], [2, 1, 'fail'], [2, 3, 'pass'], [3, 1, 'fail'], [3, 4, 'pass']],
      walk: [[0, 1, false], [1, 2, false], [2, 1, true], [1, 2, false], [2, 3, false], [3, 4, false]],
    },
    { // ensemble quorum
      nodes: [
        { s: 0, x: 7, y: 31, k: 'chip', l: 'spec' },
        { s: 5, x: 34, y: 11, k: 'agent', l: 'propose', h: 'codex' },
        { s: 1, x: 34, y: 31, k: 'agent', l: 'propose', h: 'gemini' },
        { s: 6, x: 34, y: 51, k: 'agent', l: 'propose', h: 'copilot' },
        { s: 2, x: 62, y: 31, k: 'gate', l: 'quorum 2/3' },
        { s: 4, x: 91, y: 31, k: 'commit', l: 'commit' },
      ],
      edges: [[0, 5, 'pass'], [0, 1, 'pass'], [0, 6, 'pass'], [5, 2, 'pass'], [1, 2, 'pass'], [6, 2, 'pass'], [2, 4, 'pass']],
      walk: [[0, 5, false], [5, 2, false], [0, 1, false], [1, 2, false], [0, 6, false], [6, 2, true], [2, 4, false]],
    },
    { // cascade: standby alternatives — #1 runs; on failure #2 takes the spec cold; #3 never runs
      nodes: [
        { s: 0, x: 7, y: 31, k: 'chip', l: 'spec' },
        { s: 1, x: 47, y: 13, k: 'agent', l: 'first', h: 'kiro' },
        { s: 2, x: 47, y: 31, k: 'agent', l: 'fallback', h: 'mimo' },
        { s: 3, x: 47, y: 49, k: 'agent', l: 'last resort', h: 'qwen' },
        { s: 4, x: 91, y: 31, k: 'commit', l: 'commit' },
      ],
      // Entry only to #1; a single exit leaves the group (point 100, its right edge).
      edges: [[0, 1, 'pass'], [1, 2, 'order'], [2, 3, 'order'], [100, 4, 'pass']],
      // [from, to, red token, impact on arrival]
      walk: [[0, 1, false, 'red'], [1, 2, false, 'ok'], [2, 100, false, 'none'], [100, 4, false, 'ok']],
      group: { x: 31, y: 2, w: 32, h: 58, label: 'cascade', members: [1, 2, 3] },
      pts: [{ x: 63, y: 31 }],
    },
    { // router
      nodes: [
        { s: 0, x: 7, y: 31, k: 'chip', l: 'spec' },
        { s: 2, x: 27, y: 31, k: 'gate', l: 'router' },
        { s: 5, x: 52, y: 11, k: 'agent', l: 'bugfix', h: 'claude' },
        { s: 1, x: 52, y: 31, k: 'agent', l: 'feature', h: 'codex' },
        { s: 6, x: 52, y: 51, k: 'agent', l: 'docs', h: 'gemini' },
        { s: 4, x: 88, y: 31, k: 'commit', l: 'commit' },
      ],
      edges: [[0, 2, 'pass'], [2, 5, 'pass'], [2, 1, 'pass'], [2, 6, 'pass'], [5, 4, 'pass'], [1, 4, 'pass'], [6, 4, 'pass']],
      walk: [[0, 2, false], [2, 5, false], [5, 4, false]],
    },
    { // rq pipeline + resilience
      nodes: [
        { s: 0, x: 6, y: 24, k: 'chip', l: 'spec' },
        { s: 7, x: 21, y: 24, k: 'agent', l: 'design', h: 'claude' },
        { s: 1, x: 37, y: 24, k: 'agent', l: 'implement', h: 'deepseek' },
        { s: 2, x: 53, y: 24, k: 'check', l: 'gates' },
        { s: 3, x: 69, y: 24, k: 'agent', l: 'review ×2', h: 'kiro' },
        { s: 4, x: 90, y: 24, k: 'commit', l: 'commit' },
        { s: 8, x: 47, y: 52, k: 'agent', l: 'resilience', h: 'muse' },
      ],
      edges: [[0, 7, 'pass'], [7, 1, 'pass'], [1, 2, 'pass'], [2, 1, 'fail'], [2, 3, 'pass'], [3, 4, 'pass'], [1, 8, 'fail'], [8, 7, 'pass']],
      walk: [[0, 7, false], [7, 1, false], [1, 8, true], [8, 7, false], [7, 1, false], [1, 2, false], [2, 3, false], [3, 4, false]],
    },
  ];

  const HOLD = 5200;
  const MORPH = 1100;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function mount(fig: HTMLElement) {
    const colors: Record<string, string> = JSON.parse(fig.dataset.colors || '{}');
    const captions: [string, string][] = JSON.parse(fig.dataset.captions || '[]');
    const nodes = Array.from(fig.querySelectorAll<SVGGElement>('.gm-node'));
    const edges = Array.from(fig.querySelectorAll<SVGPathElement>('.gm-edge'));
    const token = fig.querySelector<SVGCircleElement>('.gm-token')!;
    const name = fig.querySelector<HTMLElement>('.gm-name')!;
    const line = fig.querySelector<HTMLElement>('.gm-line')!;
    const groupEl = fig.querySelector<SVGGElement>('.gm-group')!;
    const box = groupEl.querySelector<SVGRectElement>('.gm-group-box')!;
    const glabel = groupEl.querySelector<SVGTextElement>('.gm-group-label')!;
    const mark = groupEl.querySelector<SVGTextElement>('.gm-mark')!;
    const ords = Array.from(groupEl.querySelectorAll<SVGTextElement>('.gm-ord'));

    // Per-slot animated state.
    const st = nodes.map(() => ({ x: 50, y: 31, w: 0, h: 0, rx: 0, rot: 0, o: 0 }));

    const pos = (shape: Shape, i: number) => (i >= 100 ? shape.pts![i - 100] : st[i]);

    const target = (shape: Shape) =>
      nodes.map((_, slot) => {
        const n = shape.nodes.find((m) => m.s === slot);
        if (!n) return null;
        return { ...GEOM[n.k], x: n.x, y: n.y, o: 1, n };
      });

    function paint() {
      nodes.forEach((g, i) => {
        const s = st[i];
        g.setAttribute('transform', `translate(${s.x.toFixed(2)} ${s.y.toFixed(2)})`);
        g.style.opacity = s.o.toFixed(3);
        const r = g.querySelector<SVGRectElement>('.gm-shape')!;
        r.setAttribute('x', (-s.w / 2).toFixed(2));
        r.setAttribute('y', (-s.h / 2).toFixed(2));
        r.setAttribute('width', s.w.toFixed(2));
        r.setAttribute('height', s.h.toFixed(2));
        r.setAttribute('rx', s.rx.toFixed(2));
        r.setAttribute('transform', `rotate(${s.rot.toFixed(1)})`);
      });
    }

    function dress(shape: Shape) {
      nodes.forEach((g, slot) => {
        const n = shape.nodes.find((m) => m.s === slot);
        const label = g.querySelector('.gm-label')!;
        const harness = g.querySelector('.gm-harness')!;
        label.textContent = n ? n.l : '';
        harness.textContent = n?.h ?? '';
        // A chip carries its label inside; every other kind labels below.
        label.setAttribute('dy', n?.k === 'chip' ? '0.8' : '6.4');
        g.dataset.kind = n ? n.k : '';
        // Group members after the first wait on standby: dimmed, never run.
        g.classList.toggle('standby', !!n && !!shape.group && shape.group.members.indexOf(slot) > 0 && !shape.walk.some((w) => w[1] === slot));
        g.style.setProperty('--nc', n?.h ? colors[n.h] ?? 'var(--canopy)' : 'var(--ink-dim)');
      });
    }

    function drawEdges(shape: Shape) {
      edges.forEach((p, i) => {
        const e = shape.edges[i];
        if (!e) { p.classList.remove('on'); return; }
        const a = pos(shape, e[0]);
        const b = pos(shape, e[1]);
        p.setAttribute('d', edgePath(a, b, e[2] === 'fail'));
        p.classList.toggle('fail', e[2] === 'fail');
        p.classList.toggle('order', e[2] === 'order');
        p.classList.add('on');
      });
    }

    function showMark(shape: Shape, slot: number) {
      const m = shape.nodes.find((n) => n.s === slot)!;
      mark.setAttribute('x', String(m.x + 4.6));
      mark.setAttribute('y', String(m.y + 0.7));
      mark.classList.add('on');
    }

    function hideEdges() {
      mark.classList.remove('on');
      edges.forEach((p) => p.classList.remove('on'));
      groupEl.classList.remove('on');
    }

    // The ensemble outline, its label and the 1→2→3 ordinals over the members.
    function drawGroup(shape: Shape) {
      const g = shape.group;
      if (!g) { groupEl.classList.remove('on'); return; }
      box.setAttribute('x', String(g.x));
      box.setAttribute('y', String(g.y));
      box.setAttribute('width', String(g.w));
      box.setAttribute('height', String(g.h));
      glabel.setAttribute('x', String(g.x + 2));
      glabel.setAttribute('y', String(g.y + 3.6));
      glabel.textContent = g.label;
      ords.forEach((t, k) => {
        const m = g.members[k] === undefined ? undefined : shape.nodes.find((n) => n.s === g.members[k]);
        t.textContent = m ? String(k + 1) : '';
        if (m) { t.setAttribute('x', String(m.x - 9)); t.setAttribute('y', String(m.y + 0.8)); }
      });
      groupEl.classList.add('on');
    }

    function morph(to: Shape, done: () => void) {
      const from = st.map((s) => ({ ...s }));
      const tgt = target(to);
      const t0 = performance.now();
      const step = (now: number) => {
        const t = ease(Math.min(1, (now - t0) / MORPH));
        st.forEach((s, i) => {
          const a = from[i];
          const b = tgt[i];
          // Arriving slots grow from their target; leaving slots shrink in place.
          const bx = b ? b.x : a.x;
          const by = b ? b.y : a.y;
          const ax = a.o > 0 ? a.x : bx;
          const ay = a.o > 0 ? a.y : by;
          s.x = lerp(ax, bx, t);
          s.y = lerp(ay, by, t);
          s.w = lerp(a.w, b ? b.w : 0, t);
          s.h = lerp(a.h, b ? b.h : 0, t);
          s.rx = lerp(a.rx, b ? b.rx : 0, t);
          s.rot = lerp(a.rot, b ? b.rot : a.rot, t);
          s.o = lerp(a.o, b ? 1 : 0, t);
        });
        paint();
        if (t < 1) requestAnimationFrame(step);
        else done();
      };
      requestAnimationFrame(step);
    }

    function walk(shape: Shape, done: () => void) {
      const legs = shape.walk;
      const per = Math.min(620, (HOLD - 600) / legs.length);
      let k = 0;
      const next = () => {
        if (k >= legs.length) { token.style.opacity = '0'; done(); return; }
        const [a, b, red, impact] = legs[k++];
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', edgePath(pos(shape, a), pos(shape, b), red && shape.edges.some((e) => e[0] === a && e[1] === b && e[2] === 'fail')));
        const len = path.getTotalLength();
        token.classList.toggle('red', red);
        token.style.opacity = '1';
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / per);
          const p = path.getPointAtLength(len * ease(t));
          token.setAttribute('cx', p.x.toFixed(2));
          token.setAttribute('cy', p.y.toFixed(2));
          if (t < 1) requestAnimationFrame(step);
          else {
            const hit = nodes[b];
            const kind = impact ?? (red ? 'red' : 'ok');
            if (hit && kind !== 'none') {
              hit.classList.remove('hit', 'hit-red');
              void hit.getBoundingClientRect();
              hit.classList.add(kind === 'red' ? 'hit-red' : 'hit');
              // A member that fails on quota says so, briefly.
              if (kind === 'red' && shape.group?.members.includes(b)) showMark(shape, b);
            }
            next();
          }
        };
        requestAnimationFrame(step);
      };
      next();
    }

    let i = 0;
    const show = (idx: number) => {
      const shape = SHAPES[idx];
      name.textContent = captions[idx]?.[0] ?? '';
      line.textContent = captions[idx]?.[1] ?? '';
      fig.classList.remove('caption-in');
      void fig.offsetWidth;
      fig.classList.add('caption-in');
      dress(shape);
      hideEdges();
      morph(shape, () => {
        drawEdges(shape);
        drawGroup(shape);
        setTimeout(() => walk(shape, () => setTimeout(() => show((i = (i + 1) % SHAPES.length)), 500)), 350);
      });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      const tgt = target(SHAPES[0]);
      st.forEach((s, k) => Object.assign(s, tgt[k] ?? { o: 0, w: 0, h: 0 }));
      dress(SHAPES[0]);
      paint();
      drawEdges(SHAPES[0]);
      return;
    }
    // Start only when visible; pause work entirely while off-screen.
    let started = false;
    new IntersectionObserver((entries) => {
      if (!started && entries.some((en) => en.isIntersecting)) { started = true; show(0); }
    }).observe(fig);
  }

  document.querySelectorAll<HTMLElement>('figure.gm').forEach(mount);
</script>

<style>
  .gm { margin: 0.25rem auto 0.5rem; width: 100%; }
  .gm-svg { width: 100%; height: auto; overflow: visible; display: block; }
  .gm-edge {
    fill: none; stroke: color-mix(in srgb, var(--canopy) 70%, transparent);
    stroke-width: 0.45; opacity: 0; transition: opacity 0.35s ease;
  }
  .gm-edge.on { opacity: 0.85; }
  .gm-edge.fail { stroke: #ff6b6b; stroke-dasharray: 1.4 1.1; }
  .gm-edge.fail.on { opacity: 0.7; }
  .gm-edge.order { stroke: var(--ink-dim); stroke-dasharray: 0.5 1.1; stroke-linecap: round; }
  .gm-edge.order.on { opacity: 0.9; }
  .gm-group { opacity: 0; transition: opacity 0.35s ease; }
  .gm-group.on { opacity: 1; }
  .gm-group-box {
    fill: color-mix(in srgb, var(--canopy) 5%, transparent);
    stroke: var(--canopy); stroke-width: 0.3; stroke-dasharray: 1.2 0.9; opacity: 0.75;
  }
  .gm-group-label { font: 1.9px var(--font-mono, monospace); fill: var(--canopy); letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.9; }
  .gm-mark { font: 1.9px var(--font-mono, monospace); fill: #ff6b6b; opacity: 0; transition: opacity 0.2s; }
  .gm-mark.on { opacity: 1; }
  .gm-node.standby > * { opacity: 0.38; }
  .gm-ord { font: 2.1px var(--font-mono, monospace); fill: var(--ink-dim); }
  .gm-node .gm-shape {
    fill: color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);
    stroke: var(--nc, var(--canopy)); stroke-width: 0.45;
  }
  .gm-node[data-kind='chip'] .gm-shape { fill: #0c1416; stroke: var(--ink-dim); }
  .gm-node[data-kind='check'] .gm-shape,
  .gm-node[data-kind='gate'] .gm-shape { fill: #0c1416; stroke: #e8f6f1; }
  .gm-node[data-kind='commit'] .gm-shape { fill: color-mix(in srgb, var(--canopy) 35%, #04110f); stroke: var(--canopy); }
  .gm-label { font: 2.3px var(--font-mono, monospace); fill: #e8f6f1; letter-spacing: 0.02em; }
  .gm-harness { font: 1.9px var(--font-mono, monospace); fill: var(--nc); opacity: 0.9; }
  .gm-token { fill: #cbfffc; filter: drop-shadow(0 0 1.2px #cbfffc); opacity: 0; transition: opacity 0.2s; }
  .gm-token.red { fill: #ff6b6b; filter: drop-shadow(0 0 1.2px #ff6b6b); }
  .gm-node.hit .gm-shape { animation: gm-hit 0.6s ease-out; }
  .gm-node.hit-red .gm-shape { animation: gm-hit-red 0.6s ease-out; }
  @keyframes gm-hit { 0% { stroke-width: 1.4; filter: drop-shadow(0 0 2px var(--nc, var(--canopy))); } 100% { stroke-width: 0.45; } }
  @keyframes gm-hit-red { 0% { stroke: #ff6b6b; stroke-width: 1.4; } 100% { stroke-width: 0.45; } }
  .gm-caption {
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    margin-top: 0.8rem; font-size: 0.82rem; letter-spacing: 0.06em; text-align: center;
  }
  .gm-name { color: var(--canopy); text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.86rem; }
  .gm-line { color: var(--ink-dim); letter-spacing: 0.02em; }
  .gm.caption-in .gm-caption { animation: gm-cap 0.6s ease-out; }
  @keyframes gm-cap { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
</style>
