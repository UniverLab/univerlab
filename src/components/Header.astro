---
import Mark from './Mark.astro';
import NameGloss from './NameGloss.astro';
import {
  getLang,
  hasCounterpart,
  useTranslations,
  localizePath,
  switchLangPath,
  languages,
} from '../i18n';
import { experiments } from '../lib/experiments';
import Mailbox from './Mailbox.astro';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

// Experiments now live at the root (/canopy, /canopy/docs, …). Detect when the
// current page is one so the "Experiments" nav item still lights up.
const seg = path.replace(/^\/es(?=\/|$)/, '').split('/').filter(Boolean)[0] ?? '';
const onExperiment = experiments.some((e) => e.id === seg);

// On docs pages the header points GitHub at the project's own repo (not the org).
// Docs are circadian like the rest of the site — no manual theme toggle.
const docsMatch = path.match(/^\/([^/]+)\/docs/);
const docExp = docsMatch ? experiments.find((e) => e.id === docsMatch[1]) : undefined;
const isDocs = !!docExp;
const githubHref = docExp ? docExp.github : 'https://github.com/UniverLab';

const nav = [
  { href: localizePath('/experiments', lang), label: t.nav.experiments, exp: true },
  { href: localizePath('/manifesto', lang), label: t.nav.manifesto },
  { href: '/status/', label: t.nav.log }, // English-only page, no /es twin
  { href: localizePath('/contributors', lang), label: t.nav.people },
  { href: githubHref, label: t.nav.github, ext: true },
  { href: 'https://github.com/sponsors/JheisonMB', label: t.nav.sponsors, ext: true, sponsor: true },
];
const other = lang === 'en' ? 'es' : 'en';
const toggleHref = hasCounterpart(path, other) ? switchLangPath(Astro.url, other) : localizePath('/', other);

function isActive(href: string, current: string): boolean {
  if (href === '/' || href === '/es/') return current === href || current === href.replace(/\/$/, '');
  return current === href || current.startsWith(href);
}

// The Experiments entry is a plain link to the encyclopedia; it lights up on
// the encyclopedia itself, on any experiment page and on experiment docs.
const navActive = (item: any) => !item.ext && (isActive(item.href, path) || (item.exp && (onExperiment || isDocs)));

// Wave strip along the bottom of the collapsed menu — several short signals
// drifting at different speeds and phases, like overlapping traffic. Each is a
// sine path that loops by translating exactly one wavelength.
const WAVE_W = 780;
function sineWave(amp: number, wl: number, phase: number, mid = 14) {
  const step = wl / 10;
  let d = `M0,${(mid + amp * Math.sin(phase)).toFixed(2)}`;
  for (let x = step; x <= WAVE_W; x += step) {
    d += ` L${x.toFixed(1)},${(mid + amp * Math.sin((x / wl) * Math.PI * 2 + phase)).toFixed(2)}`;
  }
  return d;
}
// amplitude, wavelength (= translate px), phase, opacity, stroke width, seconds
// Synced with the banner-profile.svg wave pattern — shorter, thinner
const signals = [
  { amp: 1.5, wl: 32, phase: 0, op: 0.4, w: 1.2, dur: 9 },
  { amp: 1, wl: 21, phase: 1.2, op: 0.28, w: 0.9, dur: 6.5 },
  { amp: 1.8, wl: 46, phase: 2.5, op: 0.18, w: 0.7, dur: 13 },
];
---
<header>
  <div class="wrap bar">
    <a href={localizePath('/', lang)} class="home" aria-label="UniverLab">
      <Mark size={42} />
      <NameGloss senses={t.home.hero.senses} tagline={t.home.hero.tagline} />
    </a>
    <button
      type="button"
      class="burger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="bars"></span>
    </button>
    <nav id="site-nav">
      {nav.map((item) => (
        <a
          href={(item as any).href}
          target={(item as any).ext ? '_blank' : undefined}
          rel={(item as any).ext ? 'noopener noreferrer' : undefined}
          class:list={['label', { active: navActive(item as any), sponsor: (item as any).sponsor }]}
          aria-current={navActive(item as any) ? 'page' : undefined}
        >{(item as any).sponsor ? <><svg class="heart-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span class="heart-text">{(item as any).label}</span></> : (item as any).label}</a>
      ))}
      <span class="nav-waves" aria-hidden="true">
        <svg viewBox={`0 0 ${WAVE_W} 28`}>
          {signals.map((s) => (
            <g style={`--tx:${s.wl}px;--dur:${s.dur}s`}>
              <path d={sineWave(s.amp, s.wl, s.phase)} fill="none" stroke="var(--accent)" stroke-width={s.w} stroke-opacity={s.op} stroke-linecap="round"/>
            </g>
          ))}
        </svg>
      </span>
    </nav>
  </div>
  <span class="sky-ruler" aria-hidden="true"><svg preserveAspectRatio="none"></svg></span>
  <button class="celestial-btn" type="button" aria-label={t.header.skyToNight} title={t.header.skyToNight} data-sky-to-night={t.header.skyToNight} data-sky-to-day={t.header.skyToDay}>
    <span class="celestial" aria-hidden="true"></span>
  </button>
  <Mailbox />
  <a
    class="peel"
    href={toggleHref}
    data-set-lang={other}
    hreflang={other}
    aria-label={`${t.header.switchTo} ${t.header.langLabel[other]}`}
    id="lang-corner"
  ><span class="under"><span class="label"><span class="short">{languages[other]}</span><span class="long">{t.header.langLabel[other]}</span></span></span><span class="flap"></span></a>
</header>

<script>
  import { moonSVG } from '../lib/moon-svg';
  // Engraved sky body — the sepia sun by day, the chalk moon at tonight's real
  // phase by night, riding the hour ruler like the horizon. The circadian
  // script already sets data-celestial; re-render on load and on every flip.
  (function () {
    var SYNODIC = 29.530588853;
    var EPOCH = Date.UTC(2000, 0, 6, 18, 14);
    var btn = document.querySelector('.celestial-btn');
    var mount = btn ? btn.querySelector('.celestial') : null;
    var rulerSvg = document.querySelector('.sky-ruler svg');
    if (!btn || !mount) return;

    function synodicPhase() {
      var ph = (((Date.now() - EPOCH) / 86400000) % SYNODIC) / SYNODIC;
      if (ph < 0) ph += 1;
      return ph;
    }

    // Hour ruler: the 12 hours of the current phase (06-18 by day, 18-06 by
    // night) engraved along the rule — hourly ticks 5px, quarters 2.5px at
    // half opacity, the 06/12/18 (or 18/00/06) marks 9px.
    function drawRuler() {
      if (!rulerSvg) return;
      var W = 1000;
      var ticks = '<line x1="0" y1="12" x2="' + W + '" y2="12" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"/>';
      for (var m = 0; m <= 48; m++) {
        var x = ((m / 48) * W).toFixed(1);
        var hour = m % 4 === 0;
        var six = m % 24 === 0;
        var len = six ? 9 : hour ? 5 : 2.5;
        ticks += '<line x1="' + x + '" y1="12" x2="' + x + '" y2="' + (12 - len) + '" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" opacity="' + (hour ? 0.9 : 0.5) + '"/>';
      }
      rulerSvg.setAttribute('viewBox', '0 0 ' + W + ' 16');
      rulerSvg.innerHTML = ticks;
    }

    function renderCelestial() {
      var isMoon = document.documentElement.dataset.celestial === 'moon';
      if (isMoon) {
        mount.innerHTML = moonSVG(synodicPhase(), 'hdr');
        // The moon is showing: the click will switch to the day theme.
        btn.setAttribute('aria-label', btn.dataset.skyToDay || 'day');
        btn.setAttribute('title', btn.dataset.skyToDay || 'day');
      } else {
        mount.innerHTML = '<img src="/bench/identidad/sol.svg" alt="" width="34" height="34">';
        // The sun is showing: the click will switch to the night theme.
        btn.setAttribute('aria-label', btn.dataset.skyToNight || 'night');
        btn.setAttribute('title', btn.dataset.skyToNight || 'night');
      }
      drawRuler();
    }

    // A click switches the theme — letters live in the mailbox now. The sun
    // switches to slate (night) and the moon to papyrus (day); the choice
    // rides the palette's own key and function, so the two stay in sync.
    // Choosing what the circadian clock shows right now drops the key and
    // returns to circadian, so two clicks come back to the clock.
    function toggleTheme() {
      var root = document.documentElement;
      var target = root.dataset.celestial === 'moon' ? 'day' : 'night';
      try { localStorage.removeItem('univerlab-theme'); } catch (e) {}
      if (window.calc) window.calc();
      var clock = root.dataset.celestial === 'moon' ? 'night' : 'day';
      if (clock === target) {
        if (window.applyTheme) window.applyTheme('circadian');
      } else {
        try { localStorage.setItem('univerlab-theme', target); } catch (e) {}
        if (window.applyTheme) window.applyTheme(target);
      }
      renderCelestial();
    }

    renderCelestial();
    new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        if (mutations[i].attributeName === 'data-celestial') {
          renderCelestial();
          break;
        }
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-celestial'] });

    // Drag-to-scrub: hold and drag the celestial icon to preview time.
    // Only active in circadian mode. A short click still switches the theme.
    var dragging = false;
    var startX = 0;
    var moved = false;
    var DRAG_THRESHOLD = 6;

    // Create scrub tooltip.
    var scrubTip = document.createElement('div');
    scrubTip.className = 'scrub-tip';
    scrubTip.style.cssText = 'position:fixed;top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.85);color:#e0e0e0;padding:6px 14px;border-radius:6px;font:12px/1.4 monospace;pointer-events:none;z-index:999;display:none;white-space:pre;text-align:center;';
    document.body.appendChild(scrubTip);

    function showTip(info) {
      if (!info) return;
      var lines = [info.hour + 'h'];
      info.palettes.forEach(function(p) { lines.push(p.name + ' ' + p.pct + '%'); });
      scrubTip.textContent = lines.join('  ');
      scrubTip.style.display = 'block';
    }
    function hideTip() { scrubTip.style.display = 'none'; }

    function onPointerDown(e) {
      dragging = true;
      moved = false;
      if (localStorage.getItem('univerlab-theme') || !window.scrubTime) return;
      startX = e.clientX || (e.touches && e.touches[0].clientX) || 0;
      btn.classList.add('scrubbing');
      e.preventDefault();
    }

    function onPointerMove(e) {
      if (!dragging) return;
      var x = e.clientX || (e.touches && e.touches[0].clientX) || 0;
      var dx = x - startX;
      if (Math.abs(dx) > DRAG_THRESHOLD) moved = true;
      if (!moved) return;
      var header = btn.closest('header');
      var rect = header ? header.getBoundingClientRect() : btn.getBoundingClientRect();
      var fraction = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
      var hour = fraction * 24;
      window.scrubTime(hour);
      showTip(window.__scrubInfo);
    }

    function onPointerUp() {
      if (!dragging) return;
      dragging = false;
      btn.classList.remove('scrubbing');
      if (moved) {
        moved = false;
        hideTip();
        if (window.resetScrub) window.resetScrub();
        return;
      }
      hideTip();
      toggleTheme();
    }

    btn.addEventListener('mousedown', onPointerDown);
    btn.addEventListener('touchstart', onPointerDown, { passive: false });
    document.addEventListener('mousemove', onPointerMove);
    document.addEventListener('touchmove', onPointerMove, { passive: false });
    document.addEventListener('mouseup', onPointerUp);
    document.addEventListener('touchend', onPointerUp);
    // Keyboard: Enter/Space on the focused body fires a click with detail 0.
    btn.addEventListener('click', function (e) { if (!e.detail) toggleTheme(); });
  })();
</script>

<script>
  // Persist an explicit language choice so the pre-paint detector honours it,
  // and turn the page: the corner sweeps across the screen and the switch lands
  // when the turn covers it. Reduced motion navigates at once.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLAnchorElement>('a[data-set-lang]').forEach((a) => {
    a.addEventListener('click', (event) => {
      try {
        localStorage.setItem('univerlab-lang', a.dataset.setLang!);
      } catch (e) {}
      if (reduceMotion) return; // plain navigation
      event.preventDefault();
      if (a.dataset.turning) return; // a second Enter must not restart the turn
      a.dataset.turning = 'true';
      a.classList.add('turning');
      setTimeout(() => location.assign(a.href), 550);
    });
  });

  // Coming back from the other language (the browser's Back button) can restore
  // this page from the bfcache with the turn still on: a sheet of paper across
  // the whole screen and a link locked by data-turning. Put the corner back.
  addEventListener('pageshow', () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-set-lang]').forEach((a) => {
      a.classList.remove('turning');
      delete a.dataset.turning;
    });
  });

  // Mobile nav: the burger toggles the collapsed menu open/closed.
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const siteNav = document.getElementById('site-nav');
  if (burger && siteNav) {
    const setOpen = (open: boolean) => {
      siteNav.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
    };
    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true'),
    );
    // Close burger after following any link.
    siteNav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );

    // Escape closes the menu.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  /* The header owns the page-corner switch, which is fixed at the viewport's bottom
     right: a stacking context of its own keeps it painted above the footer's ground
     (a later sibling) while the footer's own popups still layer above it. */
  header { position: relative; z-index: 1; }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* No more hr.rule at the foot: the bar's own padding-bottom
       carries the 1px so the header keeps the total height it had. */
    padding-top: 1.1rem;
    padding-bottom: calc(1.1rem + 1px);
  }
  /* The living wordmark — a compact NameGloss lockup, sized down for the bar. */
  .home {
    display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none;
    --ng-word: 1rem; --ng-line: 1rem; --ng-slogan: 0.66rem; --ng-gloss: 0.86rem; --ng-gap: 0.02rem;
    /* The cycled suffix in a true gold (not the lemony circadian accent), so it
       reads on both light and dark headers. */
    --ng-suffix: #c9a227;
  }
  nav { display: flex; gap: 1.6rem; flex-wrap: wrap; align-items: center; }
  nav a { text-decoration: none; color: #8a8d93; }
  nav a:hover, nav a.active { color: var(--ink); }
  nav a.sponsor { color: var(--bench-emphasis); display: inline-flex; align-items: center; animation: heartbeat 2s ease-in-out infinite; margin-right: 0.5rem; }
  nav a.sponsor svg { display: block; }
  nav a.sponsor .heart-text { display: none; }
  nav a.sponsor:hover { color: color-mix(in srgb, var(--bench-emphasis) 75%, var(--bench-line)); animation-play-state: paused; }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.15); }
    28% { transform: scale(1); }
    42% { transform: scale(1.1); }
    56% { transform: scale(1); }
  }
  .lang { color: var(--ink-faint); }
  .lang:hover { color: var(--ink); }

  /* Language corner — the bottom-right corner of the page is turned up, showing the
     page underneath in the other language; it lifts when approached and a click
     turns the page across the screen before switching. */
  .peel {
    --s: 58px;
    --next-paper: #e9e1d0;
    --flap-a: #d6c8ad;
    --flap-b: #f2eadb;
    --flap-c: #c4b28d;
    position: fixed;
    z-index: 45;
    right: 0;
    bottom: 0;
    width: var(--s);
    height: var(--s);
    display: block;
    text-decoration: none;
    margin: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) 0;
    transition: width 0.28s cubic-bezier(0.3, 0.7, 0.3, 1), height 0.28s cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .peel:hover,
  .peel:focus-visible { --s: 86px; }
  .peel.turning {
    --s: 160vmax;
    transition-duration: 0.55s;
    transition-timing-function: cubic-bezier(0.5, 0, 0.8, 0.4);
  }
  .peel .under {
    position: absolute;
    inset: 0;
    background: var(--next-paper);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    box-shadow: inset 8px 8px 14px rgb(0 0 0 / 0.18);
  }
  .peel .label {
    position: absolute;
    right: 7px;
    bottom: 6px;
    font-family: var(--font-serif);
    font-variant: small-caps;
    text-transform: none; /* the site's .label uppercases; small caps need the real case */
    letter-spacing: 0.1em;
    font-size: 13px;
    color: var(--bench-line);
    white-space: nowrap;
  }
  .peel .long { display: none; }
  .peel:hover .short,
  .peel:focus-visible .short,
  .peel.turning .short { display: none; }
  .peel:hover .long,
  .peel:focus-visible .long,
  .peel.turning .long { display: inline; }
  .peel .flap {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 0 100%);
    background: linear-gradient(135deg, var(--flap-c) 0%, var(--flap-a) 18%, var(--flap-b) 48%, var(--flap-a) 72%, var(--flap-c) 100%);
    filter: drop-shadow(-3px -3px 4px rgb(0 0 0 / 0.22));
  }
  .peel .flap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 46%, rgb(255 255 255 / 0.35) 50%, transparent 54%);
  }
  .peel:focus-visible { outline: 2px solid var(--bench-line); outline-offset: -4px; }

  /* Night: the page underneath is slate, the folded back a lighter sheet. */
  :global([data-bench-theme='night']) .peel {
    --next-paper: #2c3432;
    --flap-a: #3a4441;
    --flap-b: #4b5753;
    --flap-c: #2e3634;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-bench-theme='day'])) .peel {
      --next-paper: #2c3432;
      --flap-a: #3a4441;
      --flap-b: #4b5753;
      --flap-c: #2e3634;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .peel { transition: none; }
  }

  /* Engraved sun by day, engraved moon at tonight's phase by night — the body
     rides the hour ruler (the header's only line) like the horizon, centred
     on its baseline. The button keeps a 44px hit area for touch while the
     body is 34px; the track ends before the mailbox at the ruler's right
     end, so the position is clamped off it. Fixed colours, never themed:
     sepia sun, chalk moon. */
  .celestial-btn {
    position: absolute;
    bottom: 4px;
    left: clamp(22px, var(--sun-pos, 50%), calc(100% - 71px));
    transform: translate(-50%, 50%);
    width: 44px;
    height: 44px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 1;
    transition: left 60s linear, opacity 0.4s ease, transform 0.2s ease;
    opacity: 1;
    pointer-events: auto;
  }
  .celestial-btn.scrubbing {
    transition: none;
    cursor: grabbing;
  }
  .celestial-btn:hover {
    transform: translate(-50%, 50%) scale(1.12);
  }
  .celestial {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    pointer-events: none;
  }
  /* The sun img and the moon svg are injected by the bundled script at
     runtime (innerHTML), so they never carry the Astro scope attribute —
     the descendant must be :global() or width/height and the fixed
     drop-shadows silently never apply (same trap as LabSystem's accent). */
  .celestial :global(img),
  .celestial :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  html[data-celestial='sun'] .celestial :global(img) {
    filter: drop-shadow(0 1px 1px rgb(32 22 12 / .18));
  }
  html[data-celestial='moon'] .celestial :global(svg) {
    filter: drop-shadow(0 0 6px #ecebe455);
  }
  /* Hour ruler the sky body rides — the header's only line, spanning to the
     mailbox at its right end. The 12 hours of the current phase are engraved
     along it. It lives only here, never repeated in the page. */
  .sky-ruler {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 16px;
    color: var(--line);
    pointer-events: none;
  }
  .sky-ruler svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Hamburger button — hidden until the nav no longer fits comfortably. */
  .burger {
    display: none;
    position: relative;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    margin-right: 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink-dim);
  }
  .burger:hover { color: var(--ink); }
  .burger .bars,
  .burger .bars::before,
  .burger .bars::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 1.5px;
    background: currentColor;
    transform: translateX(-50%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger .bars { top: 50%; transform: translate(-50%, -50%); }
  .burger .bars::before { top: -6px; }
  .burger .bars::after { top: 6px; }
  /* Morph into an X when open. */
  .burger[aria-expanded='true'] .bars { background: transparent; }
  .burger[aria-expanded='true'] .bars::before { top: 0; transform: translateX(-50%) rotate(45deg); }
  .burger[aria-expanded='true'] .bars::after { top: 0; transform: translateX(-50%) rotate(-45deg); }

  @media (max-width: 1024px) {
    /* The mailbox stands at the rule's right end and rises into the bar:
       keep the burger and menu clear of it. */
    .bar { padding-right: 56px; }
    .burger { display: inline-flex; }
    nav a.sponsor .heart-icon { display: none; }
    nav a.sponsor .heart-text { display: inline; }
    nav {
      display: none;
      position: absolute;
      top: calc(100% + 0.6rem);    /* float a little below the bar */
      right: 0;                    /* anchored under the burger; .wrap padding keeps it off the page edge */
      z-index: 30;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 1.1rem;
      min-width: 11rem;
      padding: 1.1rem 1.3rem 1.6rem; /* extra bottom room for the wave strip */
