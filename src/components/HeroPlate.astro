---
import { plate, plateMask, plateLarge, srcsetFor, type MachineInk, type MachineTheme } from '../lib/machines';

interface Props {
  id: string;
  ink: MachineTheme;
  offset?: string;
  alpha?: string;
}
const { id, ink, offset = '0px', alpha } = Astro.props;
const rootStyle = `--hp-offset:${offset};${alpha ? ` --hp-base-a:${alpha};` : ''}`;
const inks: MachineInk[] = ink === 'theme' ? ['day', 'night'] : [ink];
const single = inks.length === 1;
---
<div class:list={['hero-plate', id === 'gitkit' && 'gitkit']} data-hero-plate data-pair={inks.length === 2 ? '' : undefined} aria-hidden="true" style={rootStyle}>
  {inks.map((which) => {
    const p = plate(id, which);
    const avif = srcsetFor(id, which, 'avif');
    const fallback = plateLarge(id, which);
    // The hero plate is the experiment page's largest element: its active
    // phase is discovered with the document (avif srcset at high priority)
    // and the parked phase ships in data-* until a theme flip needs it.
    return single ? (
      <div class:list={['hp', `hp-${which}`]} style={`--hp-mask: url(${plateMask(id, which)}); --hp-ink: url(${fallback}); aspect-ratio: ${p.w} / ${p.h}; --hp-inv: ${(p.h / p.w).toFixed(4)};`}>
        <span class="hp-ground"></span>
        <img class="hp-plate" src={fallback} srcset={avif} sizes="(min-width: 40rem) 560px, 300px" width={p.w} height={p.h} alt="" decoding="async" fetchpriority="high" />
        <span class="hp-light"></span>
      </div>
    ) : (
      <div class:list={['hp', `hp-${which}`]} style={`--hp-mask: url(${plateMask(id, which)}); --hp-ink: url(${fallback}); aspect-ratio: ${p.w} / ${p.h}; --hp-inv: ${(p.h / p.w).toFixed(4)};`}>
        <span class="hp-ground"></span>
        <img class="hp-plate" data-src={fallback} data-srcset={avif} sizes="(min-width: 40rem) 560px, 300px" width={p.w} height={p.h} alt="" decoding="async" fetchpriority="high" />
        <span class="hp-light"></span>
      </div>
    );
  })}
  {id === 'gitkit' && <span class="hp-veil"></span>}
</div>

<!-- The live phase's plate populates at parse time (high priority, with the
     document); a theme flip populates the newly shown phase. -->
<script is:inline data-hero-swap>
  (function () {
    function populate(hp) {
      if (!hp) return;
      var img = hp.querySelector('img.hp-plate[data-src]');
      if (img && !img.hasAttribute('src')) {
        var avif = img.getAttribute('data-srcset');
        if (avif) img.setAttribute('srcset', avif);
        img.setAttribute('src', img.getAttribute('data-src'));
      }
    }
    function sync() {
      var night = document.documentElement.dataset.benchTheme === 'night';
      var roots = document.querySelectorAll('[data-hero-plate][data-pair]');
      for (var i = 0; i < roots.length; i++) {
        populate(roots[i].querySelector(night ? '.hp-night' : '.hp-day'));
      }
    }
    sync();
    window.addEventListener('univerlab:themechange', sync);
  })();
</script>

<style>
  .hero-plate { position: absolute; inset-block: 1rem; left: 0; right: 0; margin-inline: auto; max-width: 72rem; z-index: -1; pointer-events: none; --hp-base-a: 0.38; container-type: inline-size; --hp-wcap: 58cqw; }
  .hp { position: absolute; top: var(--hp-offset, 0px); right: var(--space); left: auto; height: min(100%, 560px, calc(var(--hp-wcap) * var(--hp-inv))); }
  .hp > * { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The page ground painted through the machine's filled silhouette: the live background never shows inside the machine. */
  .hp-ground { background: var(--bg); -webkit-mask: var(--hp-mask) center / contain no-repeat; mask: var(--hp-mask) center / contain no-repeat; }
  .hp-plate { -webkit-mask-image: radial-gradient(ellipse 150px 120px at var(--mx, -9999px) var(--my, -9999px), #000 0%, rgba(0, 0, 0, 0.82) 30%, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, var(--hp-base-a)) 100%); mask-image: radial-gradient(ellipse 150px 120px at var(--mx, -9999px) var(--my, -9999px), #000 0%, rgba(0, 0, 0, 0.82) 30%, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, var(--hp-base-a)) 100%); }
  .hp-light { background: radial-gradient(ellipse 90px 70px at var(--mx, -9999px) var(--my, -9999px), color-mix(in srgb, var(--essence) 70%, transparent) 0%, color-mix(in srgb, var(--essence) 25%, transparent) 55%, transparent 100%); opacity: 0.35; -webkit-mask: var(--hp-ink) center / contain no-repeat; mask: var(--hp-ink) center / contain no-repeat; }
  .hp-veil { position: absolute; inset: 0; background: radial-gradient(ellipse 50% 85% at 36% 45%, color-mix(in srgb, var(--bg) 94%, transparent) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 45%, transparent 75%); }
  @media (min-width: 40rem) { .hero-plate.gitkit { --hp-wcap: 46cqw; } }
  :global(html[data-bench-theme='night']) .hero-plate[data-pair] .hp-day { display: none; }
  :global(html:not([data-bench-theme='night'])) .hero-plate[data-pair] .hp-night { display: none; }
  @media (max-width: 39.999rem) {
    .hero-plate { inset-block: 0.5rem auto; height: 320px; left: 30%; right: 0; --hp-wcap: 88vw; --hp-base-a: 0.28; }
    .hp { right: 0; }
    .hp-veil { background: radial-gradient(ellipse 85% 90% at 50% 35%, color-mix(in srgb, var(--bg) 94%, transparent) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 45%, transparent 75%); }
  }
</style>

<script type="module">
  import { pointerIn } from '../scripts/fondos/runtime';
  const root = document.querySelector<HTMLElement>('[data-hero-plate]');
  const frame = root?.parentElement;
  if (root && frame) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.style.setProperty('--hp-base-a', '0.5');
    } else {
      const layers = () => Array.from(root.querySelectorAll<HTMLElement>('.hp'));
      pointerIn(
        frame,
        (x, y) => {
          const f = frame.getBoundingClientRect();
          for (const hp of layers()) {
            const r = hp.getBoundingClientRect();
            hp.style.setProperty('--mx', `${x + f.left - r.left}px`);
            hp.style.setProperty('--my', `${y + f.top - r.top}px`);
          }
        },
        () => {
          for (const hp of layers()) {
            hp.style.removeProperty('--mx');
            hp.style.removeProperty('--my');
          }
        },
      );
    }
  }
</script>
