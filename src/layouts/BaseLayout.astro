      <script is:inline>
        (function () {
          function syncMoonGeometry() {
            var root = document.documentElement;
            var epoch = Date.UTC(2000, 0, 6, 18, 14);
            var cycle = 29.530588853;
            var phase = ((Date.now() - epoch) / 86400000 % cycle) / cycle;
            if (phase < 0) phase += 1;
            root.style.setProperty('--moon-offset', window.__moonOffsetFor(phase).toFixed(2) + 'px');
            root.style.setProperty('--moon-geometry-offset', window.__moonOffsetFor(phase).toFixed(2) + 'px');
            root.style.setProperty('--moon-glow', Math.round((1 - Math.cos(2 * Math.PI * phase)) / 2 * 35) + '%');
