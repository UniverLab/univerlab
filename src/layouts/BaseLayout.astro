t(new CustomEvent('univerlab:themechange',{detail:{mode:mode}}))}catch(_){}}};dropStale();var sv=localStorage.getItem('univerlab-theme');if(sv==='day'||sv==='night')applyTheme(sv);else calc();var tm=setInterval(function(){updateMoon();dropStale();if(!localStorage.getItem('univerlab-theme'))calc()},6e4);document.addEventListener('visibilitychange',function(){if(!document.hidden){updateMoon();dropStale();if(!localStorage.getItem('univerlab-theme')){calc();clearInterval(tm);tm=setInterval(function(){updateMoon();dropStale();if(!localStorage.getItem('univerlab-theme'))calc()},6e4)}}})}catch(e){}})()
