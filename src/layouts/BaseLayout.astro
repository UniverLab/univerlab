---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EssenceTokens from '../components/EssenceTokens.astro';
import LiveBackground from '../components/LiveBackground.astro';
import GhostHint from '../components/GhostHint.astro';
import type { ExperimentId } from '../lib/experiments';
import { buildSiteAbout } from '../lib/site-about';
import { WEBMCP_ORIGIN_TRIAL_TOKEN } from '../lib/origin-trial';
import { getLang, hasCounterpart, localizePath, useTranslations } from '../i18n';
import { organizationNode } from '../lib/structured-data';
import '../styles/global.css';
import '../styles/surfaces.css';
import '../styles/bench-tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Per-page Open Graph image URL (e.g. '/og/texforge.png').  Falls back to
   *  '/og.png' when omitted — the site-wide default for home, docs, and
   *  experiment pages that don't supply their own card. */
  ogImage?: string;
  /** Core pages: shift the palette progressively with the time of day. */
  circadian?: boolean;
  /** Experiment pages: a fixed visual surface (paper, tui, blueprint, …). */
  surface?: string;
  /** Extra JSON-LD for this page (e.g. SoftwareApplication, WebSite), emitted
   *  alongside the site-wide Organization graph. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** A ready-made `@graph` that *replaces* the standalone Organization
   *  script. Docs pages use it: their graph already defines Organization (plus
   *  the founder and the experiment app), and emitting the site-wide script
   *  too would make the page carry two definitions of the same node. */
  jsonLdGraph?: Record<string, unknown>[];
  /** Open Graph content type. Pages that read as a document — the docs — ask
   *  for `article`; everything else keeps the default `website`. */
  ogType?: 'website' | 'article';
  /** `article:modified_time`, emitted only when the page has a real date
   *  (the source file's last commit, never the build time). */
  articleModifiedTime?: string;
  /** Hidden pages: prevent indexing by search engines. */
  noindex?: boolean;
  /** The page builds an `index.html` and therefore has a markdown twin.
   *  `false` only for pages whose output is not `index.html` (404). */
  markdownTwin?: boolean;
  /** Experiment pages: the footer opens its forged colophon line with this
   *  experiment's name. Omitted everywhere else. */
  expId?: ExperimentId;
  /** Opt into the cursor-driven engraved background runtime. */
  fondo?: ExperimentId;
  /** Surface-specific circadian palette endpoints (day/night), serialized as
   *  a JSON data attribute so the circadian script can pick them up. */
  circadianPalette?: { day: Record<string, string>; night: Record<string, string> };
}
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const {
  title,
  description = t.meta.description,
  ogImage: ogImageProp,
  circadian = false,
  surface,
  structuredData,
  jsonLdGraph,
  ogType = 'website',
  articleModifiedTime,
  circadianPalette,
  noindex = false,
  markdownTwin = true,
  expId,
  fondo,
} = Astro.props;
const colorScheme = ['paper', 'blueprint', 'studio', 'pastel'].includes(surface ?? '') ? 'light' : 'dark';

// The three lab typefaces, on every page: Old Standard TT (titles), EB Garamond
// (long text), Sometype Mono (wordmark, commands, code, EXP numbers, dates).
const fontFamilies = [
  'Old+Standard+TT:ital,wght@0,400;0,700;1,400',
  'EB+Garamond:ital,wght@0,400;0,500;1,400',
  'Sometype+Mono:wght@400;500',
];
const fontHref =
  'https://fonts.googleapis.com/css2?' +
  fontFamilies.map((f) => 'family=' + f).join('&') +
  '&display=swap';

const site = Astro.site ?? new URL('https://univerlab.org');
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const ogImage = ogImageProp ? new URL(ogImageProp, site).href : new URL('/og.png', site).href;
// hreflang alternates — only for localized pages (docs are English-only).
const isDocs = path.includes('/docs');
const other = lang === 'en' ? 'es' : 'en';
const enHref = new URL(localizePath(path, 'en'), site).href;
const esHref = new URL(localizePath(path, 'es'), site).href;
const showAlts = !isDocs && hasCounterpart(path, other);
// Whether the pre-paint language script may switch this page at all: only
// when the other language actually has it. English-only routes (docs, status,
// roadmap, the 404) answer false — sending them to their /es spelling is a
// round trip with that path's _redirects rule, a loop that never lands.
const autoLang = hasCounterpart(path, other);

const orgJsonLd = organizationNode(site, t.meta.description);

// WebMCP (AGR2): the text an in-page agent gets from `about_univerlab`,
// composed at build time from llms.txt, the registry and the dictionary and
// inlined as JSON, so the module script needs no second request and no i18n in
// the browser bundle.
const aboutMarkdown = buildSiteAbout(site);

// JSON-LD lives in `<script>`, where a literal `<` followed by `/script>`
// inside any string would end the tag early and leave the rest of the payload
// as page markup. Replacing every `<` with its JSON escape sequence is still
// valid JSON — `JSON.parse` reads the original character back — so the emitted
// block is both safe and parseable.
const serialize = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang} data-surface={surface} data-lang-auto={autoLang ? 'on' : 'off'} data-circadian-palette={circadianPalette ? JSON.stringify(circadianPalette) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="origin-trial" content={WEBMCP_ORIGIN_TRIAL_TOKEN} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content={colorScheme} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1115" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {!noindex && markdownTwin && (
      <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} />
    )}
    <link rel="alternate" type="application/atom+xml" title="UniverLab Logbook" href="https://announcements.univerlab.org/feed.atom" />
    {/* ARD / AI Catalog (specVersion 1.0) — advertised three ways: this head link, robots.txt's Agentmap, llms.txt's head. */}
    <link rel="ai-catalog" href={new URL('/.well-known/ai-catalog.json', site).href} />
    <!-- Type. Old Standard TT for titles, EB Garamond for long text, Sometype
         Mono for the wordmark and code. Surfaces keep their palette and layout
         and use the same tokens (--font-serif, --font-body, --font-mono). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-render-blocking: fetch as `print`, promote to `all` once loaded;
         `display=swap` shows fallback text immediately. -->
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>
    <EssenceTokens />
    {/* Experiment banners are block ASCII tuned to DejaVu Sans Mono (see Banner.astro). */}
    {surface && (
      <link rel="preload" href="/fonts/DejaVuSansMono.ttf" as="font" type="font/ttf" crossorigin />
    )}
    {showAlts && (
      <>
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="es" href={esHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}
    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:site_name" content="UniverLab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <!-- Arriving from the home's lantern (tune.ts): the view transition gets
         the `tune` type, and global.css zooms the old page into the screen.
         It must be a blocking head script: pagereveal fires before the first
         render. Engines without the API ignore it. -->
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        var from = window.navigation && navigation.activation && navigation.activation.from;
        if (!e.viewTransition || !from) return;
        var path = new URL(from.url).pathname;
        if (path === '/' || path === '/es/' || path === '/es') e.viewTransition.types.add('tune');
      });
    </script>
    <script is:inline>window.scrubTime = null; window.resetScrub = null; window.calc = null;</script>
    {/* A caller-supplied `@graph` already defines the Organization node, so it
        replaces the site-wide script rather than sitting beside it — otherwise
        the page would define the same node twice. */}
    {jsonLdGraph ? (
      <script type="application/ld+json" set:html={serialize({ '@context': 'https://schema.org', '@graph': jsonLdGraph })} />
    ) : (
      <script type="application/ld+json" set:html={serialize(orgJsonLd)} />
    )}
    {structuredData &&
      (Array.isArray(structuredData) ? structuredData : [structuredData]).map((d) => (
        <script type="application/ld+json" set:html={serialize(d)} />
      ))}
    {/* The pre-built `about_univerlab` text. Read by src/lib/webmcp.ts when (and
        only when) a browser agent asks for it — no request is made at load. */}
    <script type="application/json" id="webmcp-about" set:html={serialize({ about: aboutMarkdown })} />
    <!-- Pre-paint language detection: first-time visitors whose system is in
         Spanish are sent to /es once; an explicit choice is always respected. -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          // Derived on the server from the page tree and stamped on <html>
          // before paint: 'off' for English-only routes, whose /es spelling
          // only 301s back here. Hardcoding the exemptions is what let the
          // roadmap loop when it joined them.
          if (document.documentElement.dataset.langAuto !== 'on') return;
          var stored = localStorage.getItem('univerlab-lang');
          var onEs = /^\/es(\/|$)/.test(path);
          if (!stored) {
            var sys = (navigator.language || 'en').toLowerCase().slice(0, 2);
            if (sys === 'es' && !onEs) {
              localStorage.setItem('univerlab-lang', 'es');
              location.replace('/es' + (path === '/' ? '' : path));
              return;
            }
          } else if (stored === 'es' && !onEs) {
            location.replace('/es' + (path === '/' ? '' : path));
          } else if (stored === 'en' && onEs) {
            location.replace(path.replace(/^\/es/, '') || '/');
          }
        } catch (e) {}
      })();
    </script>
    <script>
      // Console Easter egg — a diving helmet: opening the developer tools
      // goes below the page's surface. Art: lgbeard's "Scuba" (asciiart.eu),
      // cut down to the helmet; his initials LGB stay, as the artist asks.
      // Printed with console.info — a greeting for whoever opens the devtools,
      // not a log line.
      (function () {
        function print() {
          var art = `                           o    .
                      .      O
                         o       .
               _..--==--.._    o      (/)
            .-\`   ______   \`-.        (/)
           / _   .--==--.  .' \\       (\\)
          /    /.-=____=-.\\ .\` \\      (/)
         | '. // ||    || \\\\    |     (\\)
         |   ||==||====||==||   |     (/)
         |   ||' ||    ||  || \` |     (\\)
         | \`.\\\\==||====||==//   |     (/)
          \\   \\\`.||____||.'/   /      (\\)
           \\   \`-.______.-' . /      (/)
           /'-._          _.-'\\      (\\)
      _...-| .  \`-......-'  . |-..._ (/)
  .-'   '.  '.__.   ::  ' __.'  .' _.'\\)
.'        '.|\`._''------''_.\`|.'_][\\).' '.
                                       LGB`;
          var S = {};
          try { S = JSON.parse(document.getElementById('console-strings').textContent); } catch (e) {}
          console.info(art + '\n\n' + S.belowSurface + '\n' + S.pullRequest + '\nhttps://github.com/UniverLab');
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', print);
        else print();
      })();
    </script>
    <script is:inline>
      // Celestial position — always runs so the sun/moon dot moves along the
      // header rule on every page. Circadian pages add palette + color on top.
      (function () {
        // A manual theme (the sky body or /theme) holds only until the
        // clock's own next turn — sunrise or sunset — then the key drops and
        // the page is circadian again. 'univerlab-theme-until' stores that
        // turn; a key without it (an old choice) has already expired.
        function halfDay(d) {
          var y = d.getFullYear();
          var kJan = new Date(y, 0, 1).getTimezoneOffset();
          var kJul = new Date(y, 6, 1).getTimezoneOffset();
          if (kJan === kJul) return 6;
          var doy = Math.floor((d - new Date(y, 0, 0)) / 86400000);
          var s = Math.cos((2 * Math.PI * (doy - 172)) / 365.25);
          if (kJan < kJul) s = -s;
          return 6 + 2.5 * s;
        }
        function nextTurn(now) {
          var midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
          var half = halfDay(now);
          var hour = (now.getTime() - midnight) / 3600000;
          if (hour < 12 - half) return midnight + (12 - half) * 3600000;
          if (hour < 12 + half) return midnight + (12 + half) * 3600000;
          var tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
          return tomorrow.getTime() + (12 - halfDay(tomorrow)) * 3600000;
        }
        window.univerlabTheme = {
          set: function (mode) {
            try {
              localStorage.setItem('univerlab-theme', mode);
              localStorage.setItem('univerlab-theme-until', String(nextTurn(new Date())));
            } catch (e) {}
          },
          clear: function () {
            try {
              localStorage.removeItem('univerlab-theme');
              localStorage.removeItem('univerlab-theme-until');
            } catch (e) {}
          },
          read: function () {
            var mode = null;
            var until = 0;
            try {
              mode = localStorage.getItem('univerlab-theme');
              until = Number(localStorage.getItem('univerlab-theme-until')) || 0;
            } catch (e) {}
            if (mode && until <= Date.now()) {
              window.univerlabTheme.clear();
              return null;
            }
            return mode;
          },
        };
        function calc() {
          var d = new Date();
          var hour = d.getHours() + d.getMinutes() / 60;
          var y = d.getFullYear();
          var kJan = new Date(y, 0, 1).getTimezoneOffset();
          var kJul = new Date(y, 6, 1).getTimezoneOffset();
          var half = 6;
          if (kJan !== kJul) {
            var southern = kJan < kJul;
            var doy = Math.floor((d - new Date(y, 0, 0)) / 86400000);
            var s = Math.cos((2 * Math.PI * (doy - 172)) / 365.25);
            if (southern) s = -s;
            half = 6 + 2.5 * s;
          }
          var sunrise = 12 - half;
          var sunset = 12 + half;
          var actualDay = hour >= sunrise && hour < sunset;
          var forcedTheme = window.univerlabTheme.read();
          var isDay = forcedTheme === 'night' || forcedTheme === 'slate' ? false : forcedTheme === 'day' || forcedTheme === 'papyrus' ? true : actualDay;
          var pos;
          if (actualDay) {
            pos = ((hour - sunrise) / (sunset - sunrise)) * 100;
          } else {
            var ss = hour >= sunset ? hour - sunset : hour + (24 - sunset);
            var nl = 24 - (sunset - sunrise);
            pos = (ss / nl) * 100;
          }
          var root = document.documentElement;
          root.style.setProperty('--sun-pos', pos.toFixed(2) + '%');
          root.dataset.celestial = isDay ? 'sun' : 'moon';
          root.dataset.benchTheme = isDay ? 'day' : 'night';
          // Moon phase must be set every time the moon is shown — on plain
          // (non-circadian) pages this is the only script, and on circadian
          // pages this runs on nav + the 60s tick too. Without it the crescent
          // shadow defaults to offset 0 (new moon) and the disc reads as black.
          function moonOffsetFor(phase) {
            var target = (1 - Math.cos(2 * Math.PI * phase)) / 2;
            var low = 0;
            var high = 8;
            // Equal-circle overlap is nonlinear, so invert it to preserve the
            // actual illuminated fraction instead of using a linear offset.
            for (var i = 0; i < 14; i++) {
              var distance = (low + high) / 2;
              var overlap = 32 * Math.acos(distance / 8) -
                0.5 * distance * Math.sqrt(64 - distance * distance);
              var visible = 1 - overlap / (Math.PI * 16);
              if (visible < target) low = distance;
              else high = distance;
            }
            var offset = (low + high) / 2;
            return (phase < 0.5 ? -offset : offset);
          }
          window.__moonOffsetFor = moonOffsetFor;
          if (!isDay) {
            var MOON_EPOCH = Date.UTC(2000, 0, 6, 18, 14);
            var SYNODIC = 29.530588853;
            var dn = (d.getTime() - MOON_EPOCH) / 86400000;
            var phase = (dn % SYNODIC) / SYNODIC;
            if (phase < 0) phase += 1;
            var illum = (1 - Math.cos(2 * Math.PI * phase)) / 2;
            var moonOff = 8 * (1 - 2 * Math.abs(phase - 0.5));
            var sign = phase < 0.5 ? -1 : 1;
            root.style.setProperty('--moon-offset', (sign * moonOff).toFixed(2) + 'px');
            root.style.setProperty('--moon-glow', Math.round(illum * 70) + '%');
            root.style.setProperty('--moon-geometry-offset', moonOffsetFor(phase).toFixed(2) + 'px');
          }
        }
        calc();
        // Publish it: on pages without the circadian script (which defines no
        // window.applyTheme) this plain calc is what re-reads
        // localStorage['univerlab-theme'] and flips data-celestial and
        // data-bench-theme, so a header theme click lands at once. The
        // circadian script below overwrites window.calc with its palette calc
        // exactly as before, so circadian pages behave as they always did.
        window.calc = calc;
        setInterval(calc, 60000);
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) calc();
        });
      })();
    </script>
    {circadian && (
      <script is:inline>
        (function(){try{var DG={'--bg':'#f4f0ea','--bg-raise':'#eee7dc','--ink':'#1d1510','--ink-dim':'#6b5a43','--ink-faint':'#8a7a63','--line':'#d9cfbf','--accent':'#8a6a2c','--canvas-color':'#6b5a43','--canvas-mute':'#b3a892'};var DW={'--bg':'#f1e9dc','--bg-raise':'#e9dfcf','--ink':'#241a12','--ink-dim':'#6e5a40','--ink-faint':'#8f7b5e','--line':'#d6c8b2','--accent':'#9a5530','--canvas-color':'#9a5530','--canvas-mute':'#b3a089'};var NB={'--bg':'#1d2322','--bg-raise':'#171c1b','--ink':'#e4e3dc','--ink-dim':'#aeb3ab','--ink-faint':'#7b817b','--line':'#343c3a','--accent':'#d6955b','--canvas-color':'#aeb3ab','--canvas-mute':'#545e59'};var NS={'--bg':'#222928','--bg-raise':'#1a201f','--ink':'#ecebe4','--ink-dim':'#b9bdb5','--ink-faint':'#848a84','--line':'#3a4240','--accent':'#d9b878','--canvas-color':'#b9bdb5','--canvas-mute':'#5b6560'};try{var pa=document.documentElement.getAttribute('data-circadian-palette');if(pa){var sp=JSON.parse(pa);if(sp.day){DG=sp.day;DW=sp.day}if(sp.night){NS=sp.night;NB=sp.night}}}catch(_){}function hx(c){return[parseInt(c.slice(1,3),16),parseInt(c.slice(3,5),16),parseInt(c.slice(5,7),16)]}function lerp(a,b,t){var x=hx(a),y=hx(b);function h(n){return('0'+Math.round(n).toString(16)).slice(-2)}return'#'+h(x[0]+(y[0]-x[0])*t)+h(x[1]+(y[1]-x[1])*t)+h(x[2]+(y[2]-x[2])*t)}function mix(a,b,f){var o={};for(var k in a)o[k]=lerp(a[k],b[k],f);return o}function ap(p){var r=document.documentElement;for(var k in p)r.style.setProperty(k,p[k])}function updateMoon(){var d=new Date(),E=Date.UTC(2000,0,6,18,14),S=29.530588853,dn=(d.getTime()-E)/864e4,ph=(dn%S)/S;if(ph<0)ph+=1;var il=(1-Math.cos(2*Math.PI*ph))/2,mo=8*(1-2*Math.abs(ph-.5)),sg=ph<.5?-1:1,r=document.documentElement;r.style.setProperty('--moon-offset',(sg*mo).toFixed(2)+'px');r.style.setProperty('--moon-glow',Math.round(il*70)+'%')}function nat(){var d=new Date(),h=d.getHours()+d.getMinutes()/60,y=d.getFullYear(),kJ=new Date(y,0,1).getTimezoneOffset(),kL=new Date(y,6,1).getTimezoneOffset(),hf=6;if(kJ!==kL){var so=kJ<kL,doy=Math.floor((d-new Date(y,0,0))/864e4),s=Math.cos(2*Math.PI*(doy-172)/365.25);if(so)s=-s;hf=6+2.5*s}return{h:h,sr:12-hf,ss:12+hf,day:h>=12-hf&&h<12+hf}}
function dropStale(){var T=window.univerlabTheme,s=T.read();if((s==='day'||s==='night')&&s===(nat().day?'day':'night'))T.clear()}
