    )}
   </head>
  <body>
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    {fondo && <LiveBackground id={fondo} />}
    <Header circadian={circadian} />
    <main id="main">
      <slot />
    </main>
    <Footer expId={expId} />
    <GhostHint hints={[
      { id: 'cmd-palette', msg: 'Press <kbd>/</kbd> for commands', first: true },
      { id: 'today-science', msg: 'The celestial marker hides a fact from today in science', prob: 0.16 },
      { id: 'footer-commit', msg: 'The branch label opens a small terminal trace', prob: 0.1 },
    ]} />
    {/* The palette reads its strings (drawer labels, foot line, theme names,
        the 42 answer) from this JSON at runtime: one source, the i18n
        dictionary, no literals in the script. */}
    <script is:inline type="application/json" id="console-strings" set:html={serialize(t.console)}></script>
    <script>
      import { openDateTranslator } from '../lib/mission-date-ui';
      // Command palette — the library catalog card: type `/` and the card
      // slides up from the foot of the page, typed on a typewriter. Commands
      // are derived from experiment IDs + static routes.
      // To add a new experiment: add its ID to the experiments array in
      // experiments.ts — the palette picks it up automatically.
      (function () {
        var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
        var base = lang === 'es' ? '/es' : '';
        var path = window.location.pathname;

        // One-time cleanup of the retired console state: the two forced
        // warm/blue palette keys and the flight log's storage entries.
        try {
          localStorage.removeItem('univerlab-day-palette');
          localStorage.removeItem('univerlab-night-palette');
          localStorage.removeItem('univerlab-flight-log');
        } catch (e) {}

        // The palette's own strings, inlined at build time from the i18n
        // dictionary (see the console-strings script in the head of <body>).
        var S = {};
        try { S = JSON.parse(document.getElementById('console-strings').textContent); } catch (e) {}

        // A slip of old paper taped to the screen — every notice that is not
        // mail: tips, feedback, the 42 answer. One slip per kind; a click or
        // the timeout takes it back off.
        function slip(cls, html, ms) {
          ms = ms || 5000;
          var old = document.querySelectorAll('.slip.' + cls);
          for (var i = 0; i < old.length; i++) old[i].remove();
          var el = document.createElement('div');
          el.className = 'slip ' + cls;
          el.setAttribute('role', 'status');
          el.innerHTML = html;
          document.body.appendChild(el);
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && el.animate) {
            el.animate(
              [{ opacity: 0, translate: '0 14px' }, { opacity: 1, translate: '0 0' }],
              { duration: 260, easing: 'cubic-bezier(.2,.8,.3,1)' }
            );
          }
          var bye = function () {
            if (!el.isConnected) return;
            if (reduce || !el.animate) { el.remove(); return; }
            el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, fill: 'forwards' })
              .finished.then(function () { el.remove(); });
          };
          el.addEventListener('click', bye);
          setTimeout(bye, ms);
        }

        // /find — open a search overlay for the current page / docs.
        function openFind() {
          var existing = document.querySelector('.find-overlay');
          if (existing) { existing.remove(); return; }
          var overlay = document.createElement('div');
          overlay.className = 'find-overlay';
          overlay.innerHTML = '<div class="find-bar">' +
            '<input type="text" class="find-input" placeholder="Find..." autofocus />' +
            '<span class="find-count"></span>' +
            '<button class="find-prev" type="button" aria-label="Previous">&#9650;</button>' +
            '<button class="find-next" type="button" aria-label="Next">&#9660;</button>' +
            '<button class="find-close" type="button" aria-label="Close">&times;</button>' +
            '</div>';
          document.body.appendChild(overlay);
          var input = overlay.querySelector('.find-input');
          var count = overlay.querySelector('.find-count');
          var highlights = [];
          var current = -1;

          function clearHighlights() {
            highlights.forEach(function (h) {
              var parent = h.parentNode;
              if (parent) { parent.replaceChild(document.createTextNode(h.textContent), h); parent.normalize(); }
            });
            highlights = [];
            current = -1;
          }

          function highlightAll(query) {
            clearHighlights();
            if (!query) { count.textContent = ''; return; }
            var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
              acceptNode: function (n) {
                if (n.parentElement && (n.parentElement.closest('.find-overlay') || n.parentElement.closest('script') || n.parentElement.closest('style'))) return NodeFilter.FILTER_REJECT;
                return NodeFilter.FILTER_ACCEPT;
              }
            });
            var nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            var lower = query.toLowerCase();
            nodes.forEach(function (node) {
              var text = node.textContent;
              var lowerText = text.toLowerCase();
              var idx = lowerText.indexOf(lower);
              if (idx === -1) return;
              var frag = document.createDocumentFragment();
              var last = 0;
              while (idx !== -1) {
                frag.appendChild(document.createTextNode(text.slice(last, idx)));
                var span = document.createElement('mark');
                span.className = 'find-hl';
                span.textContent = text.slice(idx, idx + query.length);
                frag.appendChild(span);
                highlights.push(span);
                last = idx + query.length;
                idx = lowerText.indexOf(lower, last);
              }
              frag.appendChild(document.createTextNode(text.slice(last)));
              node.parentNode.replaceChild(frag, node);
            });
            count.textContent = highlights.length ? '1/' + highlights.length : '0 results';
            if (highlights.length) scrollToHighlight(0);
          }

          function scrollToHighlight(idx) {
            if (!highlights.length) return;
            highlights.forEach(function (h) { h.classList.remove('find-active'); });
            current = ((idx % highlights.length) + highlights.length) % highlights.length;
            highlights[current].classList.add('find-active');
            highlights[current].scrollIntoView({ block: 'center' });
            count.textContent = (current + 1) + '/' + highlights.length;
          }

          var debounce = null;
          input.addEventListener('input', function () {
            clearTimeout(debounce);
            debounce = setTimeout(function () { highlightAll(input.value); }, 200);
          });
          overlay.querySelector('.find-next').addEventListener('click', function () { scrollToHighlight(current + 1); });
          overlay.querySelector('.find-prev').addEventListener('click', function () { scrollToHighlight(current - 1); });
          overlay.querySelector('.find-close').addEventListener('click', function () { clearHighlights(); overlay.remove(); });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { clearHighlights(); overlay.remove(); }
            if (e.key === 'Enter') { e.preventDefault(); scrollToHighlight(e.shiftKey ? current - 1 : current + 1); }
          });
          setTimeout(function () { input.focus(); }, 50);
        }

        // /theme — the second catalog card: the three grounds, in order.
        function showThemeMenu() {
          if (!overlay) create();
          overlay.classList.remove('closing');
          overlay.classList.add('open');
          inSubmenu = true;
          input.value = '';
          setHeader(true);
          selected = 0;
          filter('');
          setTimeout(function () { input.focus(); }, 50);
        }

        function getThemeCmds() {
          var t = window.univerlabTheme.read();
          // A stored 'day'/'night' from the old themes keeps working as
          // Papyrus/Slate.
          var active = !t ? 'circadian' : t === 'day' ? 'papyrus' : 'slate';
          var check = ' \u2713';
          var names = S.theme || {};
          return [
            { cmd: 'circadian', label: (names.circadian || 'Circadian') + (active === 'circadian' ? check : ''), action: function () { window.univerlabTheme.clear(); if (window.applyTheme) applyTheme('circadian'); else if (window.calc) calc(); } },
            { cmd: 'papyrus', label: (names.papyrus || 'Papyrus') + (active === 'papyrus' ? check : ''), action: function () { window.univerlabTheme.set('day'); if (window.applyTheme) applyTheme('day'); else if (window.calc) calc(); } },
            { cmd: 'slate', label: (names.slate || 'Slate') + (active === 'slate' ? check : ''), action: function () { window.univerlabTheme.set('night'); if (window.applyTheme) applyTheme('night'); else if (window.calc) calc(); } },
          ];
        }

        // Static commands — always available.
        var staticCmds = [
          { cmd: '/home', label: 'Home', href: base + '/' },
          { cmd: '/experiments', label: 'Experiments', href: base + '/experiments/' },
          { cmd: '/manifesto', label: 'Manifesto', href: base + '/manifesto/' },
          { cmd: '/contributors', label: 'Contributors', href: base + '/contributors/' },
          { cmd: '/random', label: 'Surprise me', action: function () {
            var ids = ['canopy', 'texforge', 'gitkit', 'ghscaff', 'astro-denoise', 'demostage', 'quorum'];
            var pages = ['/', '/manifesto/', '/contributors/', '/archive/'];
            var all = ids.map(function (id) { return base + '/' + id; }).concat(pages.map(function (p) { return base + p; }));
            var history = [];
            try { history = JSON.parse(localStorage.getItem('univerlab-random') || '[]'); } catch (e) {}
            var fresh = all.filter(function (p) { return history.indexOf(p) === -1; });
            if (!fresh.length) { fresh = all; history = []; }
            var pick = fresh[Math.floor(Math.random() * fresh.length)];
            history.push(pick);
            if (history.length > 5) history = history.slice(-5);
            try { localStorage.setItem('univerlab-random', JSON.stringify(history)); } catch (e) {}
            window.location.href = pick;
          }},
          { cmd: '/fact', label: 'Today in science', action: function () {
            // The letter of the day belongs to the mailbox now — the sky body
            // switched to the theme — so /fact asks the mailbox for it,
            // anchored at the mailbox, the same open the box's own click does.
            function openTodayLetter() {
              if (window.univerlabOpenMail) { window.univerlabOpenMail(); return; }
              var box = document.querySelector('.mailbox');
              if (box) box.click();
            }
            if (window.scrollY < 10) {
              openTodayLetter();
            } else {
              window.scrollTo({ top: 0, behavior: 'smooth' });
              var checkScroll = function() {
                setTimeout(function() {
                  if (window.scrollY < 10) {
                    openTodayLetter();
                  } else {
                    checkScroll();
                  }
                }, 50);
              };
              checkScroll();
            }
          }},
          { cmd: '/today', label: 'Today in science (full page)', href: base + '/today/' },
          { cmd: '/tip', label: 'Tip', action: function () {
            var tips = {
              en: [
                'Drag the sun/moon to scrub through time.',
                'Type <kbd>/random</kbd> to visit a random page.',
                'Press <kbd>Esc</kbd> to close any popup.',
                'The celestial body traces the horizon — it\'s your clock.',
                'Type <kbd>/lang</kbd> to switch between English and Spanish.',
                'Type <kbd>/theme</kbd> to pick Circadian, Papyrus or Slate.',
                'The Logbook tracks every experiment in real time.',
                'Click the sun or moon to switch the theme.',
                'Type <kbd>/find</kbd> to search within the current page.',
                'Every page has a keyboard shortcut — type <kbd>/</kbd> to discover them.',
                'The Archive holds experiments that didn\'t make it to production.',
                'Contributors are the people who make UniverLab possible.',
              ],
              es: [
                'Arrastra el sol/luna para recorrer el tiempo.',
                'Escribe <kbd>/random</kbd> para visitar una página al azar.',
                'Presiona <kbd>Esc</kbd> para cerrar cualquier popup.',
                'El cuerpo celeste recorre el horizonte — es tu reloj.',
                'Escribe <kbd>/lang</kbd> para cambiar entre inglés y español.',
                'Escribe <kbd>/theme</kbd> para elegir Circadian, Papyrus o Slate.',
                'El Cuaderno de bitácora registra cada experimento en tiempo real.',
                'Haz clic en el sol o la luna para cambiar el tema.',
                'Escribe <kbd>/find</kbd> para buscar en la página actual.',
                'Cada página tiene un atajo de teclado — escribe <kbd>/</kbd> para descubrirlos.',
                'El Archivo contiene experimentos que no llegaron a producción.',
                'Los colaboradores son quienes hacen posible UniverLab.',
              ],
            };
            var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
            var pool = tips[lang] || tips.en;
            var msg = pool[Math.floor(Math.random() * pool.length)];
            slip('tip', msg, 5000);
          }},
          { cmd: '/up', label: 'Scroll to top', action: function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }},
          { cmd: '/down', label: 'Scroll to bottom', action: function () {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
          }},
          { cmd: '/lang', label: 'Switch language', action: function () {
            var onEs = window.location.pathname.indexOf('/es') === 0;
            var other = onEs ? 'en' : 'es';
            try { localStorage.setItem('univerlab-lang', other); } catch (e) {}
            var path = window.location.pathname;
            if (onEs) {
              window.location.href = path.replace(/^\/es/, '') || '/';
            } else {
              window.location.href = '/es' + (path === '/' ? '' : path);
            }
          }},
          { cmd: '/github', label: 'GitHub', action: function () { window.open(githubUrl(), '_blank', 'noopener'); } },
          { cmd: '/find', label: 'Find on page', action: function () { openFind(); } },
          { cmd: '/theme', label: 'Theme…', action: function () { showThemeMenu(); } },
          { cmd: '/archive', label: 'The Archive', href: base + '/archive/' },
          { cmd: '/status', label: lang === 'es' ? 'Cuaderno de bitácora' : 'Logbook', href: '/status/' },
          { cmd: '/date', label: lang === 'es' ? 'Traducir una fecha de misión' : 'Translate a mission date', action: function () { openDateTranslator(close, lang); } },
        ];

        // Experiment IDs — auto-generated from the registry.
        // Keep this list in sync with experiments.ts (add new IDs here).
        var experimentIds = ['canopy', 'texforge', 'gitkit', 'ghscaff', 'astro-denoise', 'demostage', 'quorum'];
        var experimentGithub = {
          canopy: 'https://github.com/UniverLab/harness-canopy',
          texforge: 'https://github.com/UniverLab/texforge',
          gitkit: 'https://github.com/UniverLab/gitkit',
          ghscaff: 'https://github.com/UniverLab/ghscaff',
          'astro-denoise': 'https://github.com/UniverLab',
          demostage: 'https://github.com/UniverLab/demostage',
          quorum: 'https://github.com/UniverLab/quorum',
        };
        function currentExpId() {
          var m = window.location.pathname.match(/\/(?:es\/)?(\w[\w-]*)\/?$/);
          return m && experimentIds.indexOf(m[1]) !== -1 ? m[1] : null;
        }
        function githubUrl() {
          var id = currentExpId();
          return id && experimentGithub[id] ? experimentGithub[id] : 'https://github.com/UniverLab';
        }
        var experimentCmds = experimentIds.map(function (id) {
          return { cmd: '/' + id, label: id, href: base + '/' + id };
        });

        // /docs — only on experiment pages.
        var docMatch = path.match(/\/(?:es\/)?(\w[\w-]*)\/?$/);
        var currentExp = docMatch && experimentIds.indexOf(docMatch[1]) !== -1 ? docMatch[1] : null;
        var allCmds = staticCmds.concat(experimentCmds);
        if (currentExp) {
          allCmds.unshift({ cmd: '/docs', label: 'Docs (' + currentExp + ')', href: '/' + currentExp + '/docs' });
          allCmds.unshift({ cmd: '/demo', label: 'Demo (' + currentExp + ')', action: function () { if (window.__openDemoDialog) window.__openDemoDialog(); } });
        }
        if (document.getElementById('faq')) {
          allCmds.push({ cmd: '/faq', label: 'FAQ', action: function () {
            var el = document.getElementById('faq');
            if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
          }});
        }

        var overlay = null;
        var input = null;
        var list = null;
        var slash = null;
        var drawer = null;
        var selected = 0;
        var filtered = [];
        var inSubmenu = false;

        function create() {
          overlay = document.createElement('div');
          overlay.id = 'cmd-palette';
          overlay.className = 'palette';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-label', 'Command palette');
          overlay.innerHTML =
            '<div class="head">' +
              '<span class="slash">/</span>' +
              '<input type="text" spellcheck="false" autocomplete="off" />' +
              '<span class="drawer"></span>' +
            '</div>' +
            '<ul class="cmd-list" role="listbox"></ul>' +
            '<div class="foot"><span class="keys"></span><span class="esc"></span></div>';
          document.body.appendChild(overlay);
          input = overlay.querySelector('input');
          list = overlay.querySelector('.cmd-list');
          slash = overlay.querySelector('.slash');
          drawer = overlay.querySelector('.drawer');
          overlay.querySelector('.keys').textContent = S.keys || '';
          overlay.querySelector('.esc').textContent = S.esc || '';
          input.addEventListener('input', onInput);
          input.addEventListener('keydown', onKey);
          list.addEventListener('click', function (e) {
            var li = e.target.closest ? e.target.closest('li[data-i]') : null;
            if (li) execute(filtered[Number(li.getAttribute('data-i'))]);
          });
          filter('');
        }

        // The header line: the red slash reads `/` for commands, `/theme`
        // inside the theme card; the drawer label at the right follows it.
        function setHeader(sub) {
          slash.textContent = sub ? '/theme' : '/';
          input.placeholder = sub ? (S.themePlaceholder || '') : (S.placeholder || '');
          drawer.textContent = sub ? (S.themeDrawer || '') : (S.drawer || '');
        }

        function open() {
          if (!overlay) create();
          overlay.classList.remove('closing');
          overlay.classList.add('open');
          inSubmenu = false;
          input.value = '';
          setHeader(false);
          selected = 0;
          filter('');
          setTimeout(function () { input.focus(); }, 50);
        }

        function close() {
          if (!overlay) return;
          inSubmenu = false;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            overlay.classList.remove('open');
            return;
          }
          // Slide the card back down into its drawer. If a new card was
          // opened meanwhile (/theme re-opens at once), leave it alone.
          overlay.classList.add('closing');
          setTimeout(function () {
            if (!overlay.classList.contains('closing')) return;
            overlay.classList.remove('open');
            overlay.classList.remove('closing');
          }, 220);
        }

        function isOpen() { return !!(overlay && overlay.classList.contains('open') && !overlay.classList.contains('closing')); }

        function filter(q) {
          q = (q || '').toLowerCase().replace(/^\//, '');
          var source = inSubmenu ? getThemeCmds() : allCmds;
          filtered = q
            ? source.filter(function (c) { return c.cmd.toLowerCase().indexOf(q) !== -1 || c.label.toLowerCase().indexOf(q) !== -1; })
            : source.slice();
          selected = 0;
          render();
        }

        function render() {
          list.innerHTML = filtered.map(function (c, i) {
            return '<li class="cmd-item" role="option" aria-selected="' + (i === selected) + '" data-i="' + i + '">' +
              '<span class="cmd-hand">☞</span>' +
              '<span class="cmd-cmd">' + c.cmd + '</span>' +
              '<span class="cmd-label">' + c.label + '</span>' +
            '</li>';
          }).join('');
          // Scroll selected into view.
          var sel = list.querySelector('[aria-selected="true"]');
          if (sel) sel.scrollIntoView({ block: 'nearest' });
        }

        function execute(cmd) {
          close();
          if (cmd.action) {
            cmd.action();
          } else if (cmd.href.startsWith('http')) {
            window.open(cmd.href, '_blank', 'noopener');
          } else {
            window.location.href = cmd.href;
          }
        }

        function onInput() {
          // The red slash sits in the header line; the field holds the bare
          // command, so any typed `/` is dropped.
          var v = input.value.replace(/^\//, '');
          if (input.value !== v) input.value = v;
          filter(v);
        }

        function onKey(e) {
          if (e.key === 'Escape') { e.preventDefault(); close(); return; }
          if (e.key === 'ArrowDown') { e.preventDefault(); selected = Math.min(selected + 1, filtered.length - 1); render(); return; }
          if (e.key === 'ArrowUp') { e.preventDefault(); selected = Math.max(selected - 1, 0); render(); return; }
          if (e.key === 'Tab') {
            e.preventDefault();
            if (filtered[selected]) {
              input.value = filtered[selected].cmd.replace(/^\//, '');
              filter(input.value);
            }
            return;
          }
          if (e.key === 'Enter') {
            e.preventDefault();
            if (filtered[selected]) execute(filtered[selected]);
            return;
          }
        }

        // Global keyboard shortcuts.
        var expFocusIndex = -1;
        var keySeq = '';
        document.addEventListener('keydown', function (e) {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

          // Easter egg: typing "42" tapes the Answer up as a centred slip.
          keySeq += e.key;
          if (keySeq.length > 10) keySeq = keySeq.slice(-10);
          if (keySeq.indexOf('42') !== -1) {
            keySeq = '';
            slip('answer', '<b>42</b>' + S.answer + '<i>' + S.guide + '</i>', 6000);
            return;
          }

          // / → open command palette
          if (e.key === '/') {
            e.preventDefault();
            if (isOpen()) close(); else open();
            return;
          }

          // ? → open help / command list
          if (e.key === '?') {
            e.preventDefault();
            if (isOpen()) { close(); return; }
            open();
            return;
          }

          // Esc → close palette or go back
          if (e.key === 'Escape') {
            if (isOpen()) { e.preventDefault(); close(); return; }
            return;
          }

          // Don't handle navigation shortcuts when palette is open.
          if (isOpen()) return;

          // Shift+Left → go back, Shift+Right → go forward (browser history)
          if (e.shiftKey && e.key === 'ArrowLeft') {
            e.preventDefault();
            history.back();
            return;
          }
          if (e.shiftKey && e.key === 'ArrowRight') {
            e.preventDefault();
            history.forward();
            return;
          }

          // Shift+ArrowUp / Shift+ArrowDown → prev / next experiment, doc, or card focus
          if (e.shiftKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
            // Experiment detail pages: use exp-nav-link
            var expNavLinks = document.querySelectorAll('a.exp-nav-link');
            if (expNavLinks.length) {
              e.preventDefault();
              var idx = e.key === 'ArrowDown' ? 1 : 0;
              if (expNavLinks[idx]) window.location.href = expNavLinks[idx].getAttribute('href') || '/';
              return;
            }
            // Docs pages: use sidebar nav
            var docItems = document.querySelectorAll('.docs nav .item');
            if (docItems.length > 1) {
              e.preventDefault();
              var curDoc = -1;
              for (var d = 0; d < docItems.length; d++) {
                if (docItems[d].classList.contains('active')) { curDoc = d; break; }
              }
              var nextDoc = e.key === 'ArrowDown'
                ? (curDoc < docItems.length - 1 ? curDoc + 1 : 0)
                : (curDoc > 0 ? curDoc - 1 : docItems.length - 1);
              window.location.href = docItems[nextDoc].getAttribute('href') || '/';
              return;
            }
            // Listing pages (home, experiments): focus cards
            var cards = document.querySelectorAll('a.card, a.row');
            if (cards.length > 1) {
              e.preventDefault();
              if (expFocusIndex === -1) expFocusIndex = e.key === 'ArrowDown' ? 0 : cards.length - 1;
              else expFocusIndex = e.key === 'ArrowDown'
                ? (expFocusIndex + 1) % cards.length
                : (expFocusIndex - 1 + cards.length) % cards.length;
              var card = cards[expFocusIndex];
              card.focus({ preventScroll: true });
              card.scrollIntoView({ block: 'nearest' });
              return;
            }
            return;
          }

          // ArrowUp / ArrowDown → jump between sections and cards on the page
          if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
            var targets = [];
            document.querySelectorAll('section, a.card, a.row, .prose-doc h2').forEach(function (el) {
              targets.push({ el: el, top: el.offsetTop });
            });
            targets.sort(function (a, b) { return a.top - b.top; });
            if (targets.length > 1) {
              e.preventDefault();
              var scrollY = window.scrollY;
              var found = -1;
              for (var i = 0; i < targets.length; i++) {
                if (e.key === 'ArrowDown') {
                  if (targets[i].top > scrollY + 4) { found = i; break; }
                } else {
                  if (targets[i].top < scrollY - 4) { found = i; break; }
                }
              }
              if (found === -1) found = e.key === 'ArrowDown' ? targets.length - 1 : 0;
              targets[found].el.scrollIntoView({ block: 'start' });
              return;
            }
          }

          // Enter → follow the focused card link (if palette is closed)
          if (e.key === 'Enter' && !isOpen() && expFocusIndex !== -1) {
            var focused = document.activeElement;
            if (focused && focused.matches('a.card, a.row') && focused.hasAttribute('href')) {
              e.preventDefault();
              window.location.href = focused.getAttribute('href') || '/';
            }
          }
        });
      })();
    </script>

    {/* WebMCP (AGR2): registers the lab's four read-only tools on browsers that
        ship `modelContext`. On every other browser this module finds no API and
        returns before doing anything — no registration, no request. */}
    <script>
      import '../lib/webmcp';
    </script>
    <script>
      import '../lib/mission-date-ui';
    </script>
  </body>
</html>
