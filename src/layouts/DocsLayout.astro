---
import BaseLayout from './BaseLayout.astro';
import { byId } from '../lib/experiments';
import { getLang, useTranslations } from '../i18n';

interface DocLink { slug: string; title: string; }
interface Props {
  id: string;
  title: string;
  description?: string;
  links: DocLink[];
  current: string;
}
const { id, title, description, links, current } = Astro.props;
const exp = byId(id);
const lang = getLang(Astro.url);
const t = useTranslations(lang);
// Trailing slash is canonical (astro.config.mjs `trailingSlash: 'always'`);
// without it Cloudflare Pages answers every docs link with a 308.
const base = `/${id}/docs/`;
---
<BaseLayout title={`${title} · ${exp.name} docs`} description={description} bg={exp.bg} circadian mutedCanvas>
  <div class="wrap docs">
    <aside>
      <a class="back label" href={`/${id}/`}>← {exp.name}</a>
      <span class="label head">{t.common.docsHome}</span>
      <nav>
        {links.map((l) => (
          <a
            href={l.slug ? `${base}${l.slug}/` : base}
            class:list={['item', { active: l.slug === current }]}
          >{l.title}</a>
        ))}
      </nav>
    </aside>
    <article class="prose-doc">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 3rem;
    padding-block: 2.5rem 5rem;
    align-items: start;
  }
  @media (max-width: 52rem) { .docs { grid-template-columns: 1fr; gap: 1.5rem; } }

  aside { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  @media (max-width: 52rem) { aside { position: static; } }
  .back { text-decoration: none; color: var(--accent); margin-bottom: 0.8rem; }
  .head { color: var(--ink-faint); margin-bottom: 0.3rem; }
  nav { display: flex; flex-direction: column; border-left: 1px solid var(--line); }
  .item {
    text-decoration: none; color: var(--ink-dim); font-size: 0.92rem;
    padding: 0.32rem 0 0.32rem 0.9rem; margin-left: -1px;
    border-left: 1px solid transparent;
  }
  .item:hover { color: var(--ink); }
  .item.active { color: var(--accent); border-left-color: var(--accent); }

  .prose-doc { max-width: 46rem; min-width: 0; }
</style>

<style is:global>
  /* Markdown rendering for repo docs */
  .prose-doc h1 { font-size: 1.9rem; margin: 0 0 1rem; letter-spacing: -0.015em; }
  .prose-doc h2 { font-size: 1.35rem; margin: 2.4rem 0 0.8rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .prose-doc h3 { font-size: 1.08rem; margin: 1.8rem 0 0.6rem; }
  .prose-doc p, .prose-doc li { color: var(--ink-dim); line-height: 1.7; }
  .prose-doc a { color: var(--accent); }
  .prose-doc strong { color: var(--ink); font-weight: 500; }
  .prose-doc ul, .prose-doc ol { padding-left: 1.2rem; }
  .prose-doc li { margin: 0.3rem 0; }
  .prose-doc code {
    font-family: var(--font-mono); font-size: 0.86em;
    background: var(--bg-raise); padding: 0.12em 0.38em; border-radius: 3px; color: var(--ink);
  }
  .prose-doc pre {
    /* Shiki (github-dark) supplies its own background/text colors inline. */
    position: relative;
    border: 1px solid var(--line);
    padding: 1rem 1.1rem; overflow-x: auto; font-size: 0.82rem; line-height: 1.6; border-radius: 4px;
  }
  .prose-doc pre code { background: none; padding: 0; color: inherit; }
  .prose-doc .copy-btn {
    position: absolute; top: 0.45rem; right: 0.45rem;
    display: flex; align-items: center; justify-content: center;
    width: 1.8rem; height: 1.8rem;
    background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px; cursor: pointer; opacity: 0; transition: opacity 0.15s ease;
    color: rgba(255, 255, 255, 0.85);
  }
  .prose-doc pre:hover .copy-btn, .prose-doc .copy-btn:focus { opacity: 1; }
  .prose-doc .copy-btn:hover { background: rgba(0, 0, 0, 0.55); color: #fff; }
  .prose-doc .copy-btn:focus-visible {
    opacity: 1;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .prose-doc .copy-btn svg { width: 1rem; height: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .prose-doc table { width: 100%; border-collapse: collapse; margin: 1.2rem 0; font-size: 0.9rem; }
  .prose-doc th, .prose-doc td { text-align: left; padding: 0.55rem 0.8rem; border: 1px solid var(--line); }
  .prose-doc th { color: var(--ink); font-weight: 500; background: var(--bg-raise); }
  .prose-doc td { color: var(--ink-dim); }
  .prose-doc blockquote {
    border-left: 2px solid var(--accent); margin: 1.2rem 0; padding: 0.2rem 0 0.2rem 1.1rem;
    color: var(--ink-dim); font-style: italic;
  }
  .prose-doc hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }

  /* Mermaid diagrams */
  .prose-doc .mermaid {
    margin: 1.5rem 0;
    display: flex;
    justify-content: center;
  }
  .prose-doc .mermaid svg {
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  // Mermaid diagrams — render on client side using site CSS variables.
  // Re-renders when the site theme changes via the univerlab:themechange event.
  let mermaidReady = false;
  let hasDiagrams = false;
  let mermaidRendering = false;
  let mermaidPendingRerender = false;
  let rerenderTimer;

  function getThemeColors() {
    const root = getComputedStyle(document.documentElement);
    const get = (v, fb) => root.getPropertyValue(v).trim() || fb;
    return {
      primaryBg: get('--bg-raise', '#2a2a2e'),
      bg:        get('--bg', '#1e1e22'),
      textColor: get('--ink', '#e0e0e0'),
      border:    get('--accent', '#d4a843'),
      line:      get('--line', '#8a8d93'),
    };
  }

  function configureMermaid() {
    const colors = getThemeColors();
    try {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          primaryColor: colors.primaryBg, primaryTextColor: colors.textColor, primaryBorderColor: colors.border,
          secondaryColor: colors.bg, secondaryTextColor: colors.textColor, secondaryBorderColor: colors.line,
          tertiaryColor: colors.bg, tertiaryTextColor: colors.textColor, tertiaryBorderColor: colors.line,
          background: colors.bg,
          nodeBkg: colors.primaryBg, nodeBorder: colors.border, nodeTextColor: colors.textColor,
          mainBkg: colors.primaryBg, secondBkg: colors.bg, tertiaryBkg: colors.bg,
          lineColor: colors.line, defaultLinkColor: colors.line,
          edgeLabelBackground: colors.bg, edgeLabelText: colors.textColor,
          clusterBkg: colors.bg, clusterBorder: colors.border, titleColor: colors.textColor,
          classText: colors.textColor,
          actorBkg: colors.primaryBg, actorBorder: colors.border, actorTextColor: colors.textColor, actorLineColor: colors.line,
          signalColor: colors.textColor, signalTextColor: colors.textColor,
          activationBkgColor: colors.primaryBg, activationBorderColor: colors.border,
          noteBkgColor: colors.bg, noteBorderColor: colors.border, noteTextColor: colors.textColor,
          loopTextColor: colors.textColor, labelBoxBkgColor: colors.bg, labelBoxBorderColor: colors.line, labelTextColor: colors.textColor,
          sectionBkgColor: colors.primaryBg, altSectionBkgColor: colors.bg, sectionTextColor: colors.textColor,
          taskBkgColor: colors.primaryBg, taskTextColor: colors.textColor, taskTextLightColor: colors.textColor, taskTextOutsideColor: colors.textColor,
          gridColor: colors.line,
          pieOuterStrokeWidth: '1px', pieStrokeColor: colors.border, pieTitleTextSize: '16px', pieTitleTextColor: colors.textColor,
          textColor: colors.textColor,
          fontFamily: 'var(--font-sans, system-ui, sans-serif)',
        },
        themeCSS: `
          .node rect, .node circle, .node polygon, .node ellipse { fill: var(--bg-raise); stroke: var(--accent); }
          .node .label, .nodeLabel, .label { color: var(--ink); fill: var(--ink); }
          .edgeLabel .label { color: var(--ink); fill: var(--ink); background: var(--bg); }
          .edge-thickness-normal, .edge-pattern-solid { stroke: var(--line); }
          .arrowheadPath { fill: var(--line); }
          .cluster rect { fill: var(--bg); stroke: var(--line); }
          .titleText { fill: var(--ink); }
        `,
      });
    } catch (e) {
      console.warn('Mermaid configure failed:', e);
    }
  }

  function renderMermaid() {
    if (!mermaidReady || !hasDiagrams) return;
    configureMermaid();
    try {
      mermaid.run().catch(e => console.warn('Mermaid render failed:', e));
    } catch (e) {
      console.warn('Mermaid run failed:', e);
    }
  }

  function rerenderMermaid() {
    if (!mermaidReady || !hasDiagrams) return;
    if (mermaidRendering) { mermaidPendingRerender = true; return; }
    mermaidRendering = true;
    document.querySelectorAll('.mermaid').forEach(function (el) {
      const src = el.getAttribute('data-src');
      if (!src) return;
      el.innerHTML = src;
      el.removeAttribute('data-processed');
    });
    configureMermaid();
    mermaid.run().catch(e => console.warn('Mermaid re-render failed:', e))
      .finally(function () {
        mermaidRendering = false;
        if (mermaidPendingRerender) { mermaidPendingRerender = false; rerenderMermaid(); }
      });
  }

  function initMermaid() {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (!blocks.length) return;
    hasDiagrams = true;

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11.9.0/dist/mermaid.min.js';
    script.integrity = 'sha384-UzWEhMP22MxNnr2bzqAdmtf1FDy5iKDUq6hLXJFLqC7dfGkc6W/hshbx9m71zyt5';
    script.crossOrigin = 'anonymous';
    script.onerror = function () {
      script.removeAttribute('integrity');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    };
    script.onload = function () {
      mermaidReady = true;
      blocks.forEach(function (el) {
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.setAttribute('role', 'img');
        const src = el.textContent;
        div.setAttribute('data-src', src);
        div.setAttribute('aria-label', 'Diagram: ' + (src.split('\n')[0] || 'mermaid diagram'));
        div.textContent = src;
        el.parentNode.replaceChild(div, el);
      });
      configureMermaid();
      renderMermaid();
    };
    document.head.appendChild(script);
  }

  // Re-render when the site theme changes.
  window.addEventListener('univerlab:themechange', function () {
    clearTimeout(rerenderTimer);
    rerenderTimer = setTimeout(rerenderMermaid, 50);
  });

  // Copy buttons for code blocks.
  function initCopyButtons() {
    document.querySelectorAll('.prose-doc pre').forEach(function (pre) {
      if (pre.querySelector('.copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.setAttribute('aria-label', 'Copy code');
      btn.setAttribute('title', 'Copy');
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      var status = document.createElement('span');
      status.className = 'sr-only';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      pre.appendChild(status);
      btn.addEventListener('click', function () {
        const code = pre.querySelector('code');
        const text = code ? code.textContent : pre.textContent;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(onCopied).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }
        function onCopied() {
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          btn.setAttribute('aria-label', 'Copied!');
          status.textContent = 'Copied!';
          setTimeout(function () {
            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
            btn.setAttribute('aria-label', 'Copy code');
            status.textContent = '';
          }, 1500);
        }
        function fallbackCopy() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); onCopied(); } catch (e) { console.warn('Copy failed:', e); }
          document.body.removeChild(ta);
        }
      });
      pre.appendChild(btn);
    });
  }

  // Init after styles are applied.
  function initDocsScripts() {
    initMermaid();
    initCopyButtons();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDocsScripts);
  } else {
    requestAnimationFrame(initDocsScripts);
  }
</script>
